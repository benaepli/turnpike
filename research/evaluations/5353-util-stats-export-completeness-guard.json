  "hypothesis": {
    "id": "util-stats-export-completeness-guard",
    "parent": "steer-steps-provenance-ablate",
    "kind": "enabling",
    "title": "Make util_stats export total: fail the build if any counter field is missing from the emitted JSON",
    "description": "In spur-core/src/simulator/util_stats.rs, replace the hand-written serialization of the stats structs (steerAuthority, termination, deliveryEffects) with a derived/reflective emit so every field is exported by construction. Add spur-core/tests/util_stats_export_completeness.rs that builds each stats struct with a distinct nonzero sentinel per field, serializes via the exact code path the harness uses to write the run artifact, parses the JSON back, and asserts the parsed object's key set equals the struct's field set (and that every sentinel round-trips). This must catch the concrete bug just observed: steerAuthority.stepsTotal existed in code but never appeared in the run JSON. No policy change, no new config field, no scheduler edits.",
    "category": "tooling",
    "buildsOn": [
      "util_stats",
      "run artifact writer",
      "steer-stats-export-parity-test"
    ],
    "expectedGain": 4,
    "expectedCost": 1,
    "rationale": "Three hypotheses in this lineage have now burned full campaigns producing counters that were never observable. Every future instrumentation experiment is unfalsifiable until export is total; this converts a recurring silent failure into a compile/test-time error and costs no exposure time to validate.",
    "generalityArgument": "Purely about serialization completeness of the simulator's own stats structs; references no protocol entity, no VR/Raft-specific field, and holds for any spec run through the harness.",
    "status": "proposed",
    "branch": null,
