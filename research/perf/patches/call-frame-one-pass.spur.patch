+/// The local call frame for `func` with `args` in its parameter slots.
+pub fn build_frame<H: HashPolicy>(func: &FunctionInfo, args: &[Value<H>]) -> Env<H> {
+    let mut builder = FrameBuilder::<H>::new(func);
