+#[cfg(test)]
+mod record_move_tests {
+    use super::*;
+    use crate::compiler::cfg::VarSlot;
+    use crate::simulator::hash_utils::NoHashing;
+
+    type V = Value<NoHashing>;
+    type Seq = EcoVec<V>;
+
+    fn node(index: usize) -> NodeId {
+        NodeId {
+            role: NameId(0),
+            index,
+        }
+    }
+
+    /// A payload whose reference count the test observes through the handle
+    /// it keeps: the handle is unique exactly when no record holds a copy.
+    fn handle(tag: i64) -> Seq {
+        let mut seq = Seq::new();
+        seq.push(V::int(tag));
+        seq
+    }
+
+    fn record(dest: usize, pc: usize, payload: &Seq) -> Record<NoHashing> {
+        let mut env = Env::<NoHashing>::with_slots(2);
+        env.set(0, V::list(payload.clone()));
+        Record {
+            pc,
+            node: node(dest),
+            origin_node: node(dest),
+            continuation: Continuation::Recover,
+            entry_pc: pc,
+            initial_args: EcoVec::new(),
+            entry_func: NameId(0),
+            env,
+            priority: 0.5,
+            causal_operation_id: None,
+            trace_id: None,
+            trace_payload: None,
+            link_seq: None,
+            origin_incarnation: 0,
+            bias: DeliveryBias::NONE,
+            timer_entry: Some(3),
+            send_ordinal: pc as u32,
+            receiver_token_at_send: 0,
+        }
+    }
+
+    fn mixed_queue(payload: &Seq) -> Vec<Runnable<NoHashing>> {
+        vec![
+            Runnable::Record(record(0, 10, payload)),
+            Runnable::Crash {
+                node_id: node(0),
+                priority: 1.0,
+            },
+            Runnable::Record(record(0, 11, payload)),
+            Runnable::Recover {
+                node_id: node(0),
+                priority: 1.0,
+            },
+            Runnable::Record(record(0, 12, payload)),
+        ]
+    }
+
+    #[test]
+    fn remove_record_matches_vec_remove_and_drops_each_record_once() {
+        for idx in [0, 2, 4] {
+            let mut ours_payload = handle(1);
+            let mut theirs_payload = handle(1);
+            let mut ours = mixed_queue(&ours_payload);
+            let mut theirs = mixed_queue(&theirs_payload);
+            let got = remove_record(&mut ours, idx);
+            let Runnable::Record(want) = theirs.remove(idx) else {
+                panic!("index {idx} holds a record")
+            };
+            assert_eq!(format!("{:?}", got), format!("{:?}", want), "returned record at index {idx}");
+            assert_eq!(format!("{:?}", ours), format!("{:?}", theirs), "remaining order at index {idx}");
+            drop(ours);
+            assert!(
+                !ours_payload.is_unique(),
+                "the removed record still holds its payload at index {idx}"
+            );
+            drop(got);
+            assert!(
+                ours_payload.is_unique(),
+                "every record dropped its payload exactly once at index {idx}"
+            );
+            drop((theirs, want));
+            assert!(theirs_payload.is_unique());
+        }
+    }
+
+    /// Appending past capacity, at capacity and into spare room leaves the
+    /// queue `Vec::push` leaves, and each record is dropped exactly once.
+    #[test]
+    fn push_record_into_matches_vec_push_and_drops_each_record_once() {
+        for spare in [0, 1, 4] {
+            let mut ours_payload = handle(6);
+            let mut theirs_payload = handle(6);
+            let mut ours: Vec<Runnable<NoHashing>> = Vec::with_capacity(spare);
+            let mut theirs: Vec<Runnable<NoHashing>> = Vec::with_capacity(spare);
+            for pc in 0..6 {
+                push_record_into(&mut ours, record(0, pc, &ours_payload));
+                theirs.push(Runnable::Record(record(0, pc, &theirs_payload)));
+                ours.push(Runnable::Crash {
+                    node_id: node(0),
+                    priority: 1.0,
+                });
+                theirs.push(Runnable::Crash {
+                    node_id: node(0),
+                    priority: 1.0,
+                });
+            }
+            assert_eq!(
+                format!("{:?}", ours),
+                format!("{:?}", theirs),
+                "queue with {spare} spare"
+            );
+            let last = remove_record(&mut ours, 10);
+            drop(ours);
+            assert!(!ours_payload.is_unique(), "the last record still holds its payload");
+            drop(last);
+            assert!(
+                ours_payload.is_unique(),
+                "every pushed record dropped its payload exactly once with {spare} spare"
+            );
+            drop(theirs);
+            assert!(theirs_payload.is_unique());
+        }
+    }
+
+    fn local(slot: u32) -> Lhs {
+        Lhs::Var(VarSlot::Local(slot, NameId(slot as usize)))
+    }
+
+    fn node_lhs(slot: u32) -> Lhs {
+        Lhs::Var(VarSlot::Node(slot, NameId(100 + slot as usize)))
+    }
