+/// Removes the record at `idx` of `queue`, keeping the order of the rest,
+/// with the record read once out of its slot. The entry must be a record.
+#[inline]
+fn remove_record<H: HashPolicy>(queue: &mut Vec<Runnable<H>>, idx: usize) -> Record<H> {
+    let len = queue.len();
+    let Runnable::Record(rec) = &queue[idx] else {
+        unreachable!("remove_record on an entry that is not a record")
+    };
+    let src: *const Record<H> = rec;
+    // SAFETY: the indexing above proved `idx < len` and the pattern proved the
+    // entry at `idx` is a record, both before anything is read. The record is
+    // read exactly once, then the tail is shifted down over its slot and the
+    // length drops by one, so the returned value is its only owner and no
+    // entry is dropped twice or lost. Between the read and `set_len` there is
+    // only pointer arithmetic and a copy, which cannot unwind. `&mut queue`
+    // rules out any live reference into the buffer, and the pointer taken from
+    // the shared borrow is not used after the mutable pointer is taken.
+    unsafe {
+        let r = std::ptr::read(src);
+        let p = queue.as_mut_ptr().add(idx);
+        std::ptr::copy(p.add(1), p, len - idx - 1);
+        queue.set_len(len - 1);
+        r
+    }
+}
+
+/// Appends `record` to `queue` with room reserved first, so the record is
+/// written once, into its slot: `Vec::push` takes the wrapped entry by value
+/// and copies it once more.
+#[inline(always)]
+fn push_record_into<H: HashPolicy>(queue: &mut Vec<Runnable<H>>, record: Record<H>) {
+    queue.reserve(1);
+    let len = queue.len();
+    // SAFETY: `reserve(1)` guarantees capacity for at least `len + 1` entries,
+    // so the slot at `len` lies inside the allocation and holds no live entry.
+    // The entry is written exactly once into that slot and `set_len` then makes
+    // it part of the queue, so it is owned only by the queue. Nothing between
+    // `reserve` and `set_len` can unwind: a failed reservation panics or aborts
+    // before the write, and the write and `set_len` cannot fail.
+    unsafe {
+        std::ptr::write(queue.as_mut_ptr().add(len), Runnable::Record(record));
+        queue.set_len(len + 1);
+    }
+}
+
+/// What a woken reader's `timer_entry` is set to.
+pub enum ReaderEntry {
+    Unchanged,
+    TimerFired,
+    Cleared,
+}
+
+/// Gives `val` to the longest-waiting reader of `chan` and queues that reader
+/// on its node's local queue, or buffers `val` when no reader waits. The
+/// reader is changed where it waits and moved once, into the queue. With
+/// `strict`, a failed store returns its error before the node env is written
+/// back or the reader is queued, and the reader is dropped; otherwise the
+/// reader is queued and the error is returned after.
+#[inline]
+pub fn deliver_to_channel<H: HashPolicy>(
+    chan: &mut ChannelState<H>,
+    nodes: &mut [Env<H>],
+    local_queues: &mut [Vec<Runnable<H>>],
+    val: Value<H>,
+    entry: ReaderEntry,
+    strict: bool,
+) -> Result<(), RuntimeError> {
+    deliver_with_store(chan, nodes, local_queues, val, entry, strict, store)
+}
+
+/// `deliver_to_channel` with the store passed in, so a failing store can be
+/// exercised: the production store never fails.
+#[inline(always)]
+fn deliver_with_store<H: HashPolicy, S>(
+    chan: &mut ChannelState<H>,
+    nodes: &mut [Env<H>],
+    local_queues: &mut [Vec<Runnable<H>>],
+    val: Value<H>,
+    entry: ReaderEntry,
+    strict: bool,
+    store: S,
+) -> Result<(), RuntimeError>
+where
+    S: FnOnce(&Lhs, Value<H>, &mut Env<H>, &mut Env<H>) -> Result<(), RuntimeError>,
+{
+    let Some(mut waiting) = chan.waiting_readers.pop_front() else {
+        chan.buffer.push_back(val);
+        return Ok(());
+    };
+    // Uniqueness is read from the two counts rather than through
+    // `Arc::get_mut`, whose check is an atomic compare-and-swap: the caller
+    // holds the only handle it counts, so no other thread can add one.
+    if Arc::strong_count(&waiting) != 1 || Arc::weak_count(&waiting) != 0 {
+        waiting = Arc::new((*waiting).clone());
+    }
+    // SAFETY: `waiting` is owned here and its counts read one strong owner and
+    // no weak one, or it is a fresh copy, so no other handle can reach the
+    // entry and none can be made while this borrow lives. The pointer comes
+    // from the allocation, not from a shared reference, so it may be written.
+    let (reader, lhs) = unsafe { &mut *Arc::as_ptr(&waiting).cast_mut() };
+    let node_index = reader.node.index;
+    let mut node_env = nodes[node_index].clone();
+    let stored = store(lhs, val, &mut reader.env, &mut node_env);
+    if strict && stored.is_err() {
+        return stored;
+    }
+    nodes[node_index] = node_env;
+    match entry {
+        ReaderEntry::Unchanged => {}
+        ReaderEntry::TimerFired => reader.timer_entry = Some(reader.pc),
+        ReaderEntry::Cleared => reader.timer_entry = None,
+    }
+    let queue = &mut local_queues[node_index];
+    queue.reserve(1);
+    let raw = Arc::into_raw(waiting);
+    // SAFETY: the counts read one strong owner and no weak one above (or the
+    // entry was replaced by a fresh copy), and nothing since has cloned it, so
+    // the allocation has exactly one strong owner and no weak one when it is
+    // turned into a raw pointer. Room for one more queue entry was reserved before that, and
+    // between `into_raw` and `from_raw` there is only a read, pointer writes,
+    // `set_len` and the in-place drop of `Lhs`, which has no drop glue, so
+    // nothing can unwind while the allocation is held raw. The record is read
+    // exactly once, into the reserved slot, which `set_len` then makes part of
+    // the queue. `Lhs` is dropped in place, and the allocation is then freed
+    // as `Arc<MaybeUninit<_>>`, which has the same size and alignment and
+    // drops no field, so neither field is dropped twice.
+    unsafe {
+        let len = queue.len();
+        std::ptr::write(
+            queue.as_mut_ptr().add(len),
+            Runnable::Record(std::ptr::read(std::ptr::addr_of!((*raw).0))),
+        );
+        queue.set_len(len + 1);
+        std::ptr::drop_in_place(std::ptr::addr_of!((*raw).1).cast_mut());
+        drop(Arc::from_raw(raw.cast::<std::mem::MaybeUninit<(Record<H>, Lhs)>>()));
+    }
+    stored
+}
