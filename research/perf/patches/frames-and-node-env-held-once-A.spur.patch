+/// The never-yield entry bits of `program`, one word per 64 vertices. The
+/// walk follows each function's own graph from its entry and does not enter
+/// callees: a synchronous callee that reaches a yield fails the run instead
+/// of yielding, and an asynchronous callee runs as a record of its own. A
+/// successor outside the graph counts as a yield.
+fn never_yield_entries(program: &Program) -> Vec<u64> {
+    let graph = &program.cfg.graph;
+    let mut bits = vec![0u64; graph.len().div_ceil(64)];
+    let mut seen = vec![false; graph.len()];
+    let mut stack: Vec<Vertex> = Vec::new();
+    for func in program.rpc.values() {
+        if func.entry >= graph.len() {
+            continue;
+        }
+        seen.iter_mut().for_each(|s| *s = false);
+        stack.clear();
+        stack.push(func.entry);
+        let mut yields = false;
+        while let Some(v) = stack.pop() {
+            if v >= graph.len() {
+                yields = true;
+                break;
+            }
+            if seen[v] {
+                continue;
+            }
+            seen[v] = true;
+            match &graph[v] {
+                Label::Recv(..) | Label::Pause(..) | Label::SpinAwait(..) => {
+                    yields = true;
+                    break;
+                }
+                label => stack.extend(super::frame_layout::successors(label).into_iter().flatten()),
+            }
+        }
+        if !yields {
+            bits[func.entry / 64] |= 1u64 << (func.entry % 64);
+        }
+    }
+    bits
 }
 
