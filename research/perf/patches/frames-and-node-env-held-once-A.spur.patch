+
+    /// Two nodes, with the sender's two records on the network queue. The
+    /// yielding record is given a later pc and a written frame, as a record
+    /// that ran and was put back would have.
+    fn state_with_sent_records(program: &Program) -> State<NoHashing> {
+        let mut state = State::<NoHashing>::new(&[(ROLE, 2)], 3);
+        let sender = &program.rpc[&SENDER];
+        let mut env = build_frame::<NoHashing>(sender, &[]);
+        env.set(2, Value::node(node(1)));
+        let record = Record {
+            pc: sender.entry,
+            node: node(0),
+            origin_node: node(0),
+            continuation: Continuation::Recover,
+            entry_pc: sender.entry,
+            initial_args: EcoVec::new(),
+            entry_func: SENDER,
+            env,
+            priority: 0.5,
+            causal_operation_id: None,
+            trace_id: None,
+            trace_payload: None,
+            link_seq: None,
+            origin_incarnation: 0,
+            bias: DeliveryBias::NONE,
+            timer_entry: None,
+            send_ordinal: 0,
+            receiver_token_at_send: 0,
+        };
+        let mut logs = crate::simulator::path::Logs::default();
+        let result = exec::<NoHashing, _, NoFeedback>(
+            &mut state,
+            &mut logs,
+            program,
+            record,
+            &(),
+            &mut (),
+            &SchedulePolicy::Fixed,
+            &PurgatoryConfig::default(),
+            &mut StdRng::seed_from_u64(3),
+        );
+        assert!(matches!(result, Ok(None)), "{result:?}");
+        assert_eq!(state.network_queue.len(), 2);
+        for r in state.network_queue.iter_mut() {
+            if let Runnable::Record(r) = r
+                && r.entry_func == PAUSES
+            {
+                r.pc = 2;
+                r.env.set(0, Value::int(-1));
