+/// A receive reached only through a branch or a loop body marks its function
+/// as yielding, the same shapes without one do not, and a call does not
+/// carry its callee's receive into the caller. Both decodes agree.
+#[test]
+fn a_function_yields_when_any_path_reaches_a_receive() {
+    let mut builder = TestProgramBuilder::new();
+    let branch_ret = builder.add(Label::Return(Expr::Unit));
+    let branch_recv = builder.add(Label::Recv(Lhs::Var(slot(1)), Expr::Var(slot(0)), branch_ret));
+    let branch = builder.add(Label::Cond(Expr::Var(slot(2)), branch_ret, branch_recv));
+
+    let loop_ret = builder.add(Label::Return(Expr::Unit));
+    let loop_head = builder.add(Label::Return(Expr::Unit));
+    let loop_back = builder.add(Label::Continue(loop_head));
+    let loop_recv = builder.add(Label::Recv(Lhs::Var(slot(1)), Expr::Var(slot(0)), loop_back));
+    builder.labels[loop_head] = Label::ForLoopIn(
+        Lhs::Var(slot(3)),
+        Expr::List(vec![Expr::Int(1)]),
+        slot(4),
+        loop_recv,
+        loop_ret,
+    );
+
+    let quiet_ret = builder.add(Label::Return(Expr::Unit));
+    let quiet_head = builder.add(Label::Return(Expr::Unit));
+    let quiet_back = builder.add(Label::Continue(quiet_head));
+    let quiet_print = builder.add(Label::Print(Expr::Var(slot(3)), quiet_back));
+    builder.labels[quiet_head] = Label::ForLoopIn(
+        Lhs::Var(slot(3)),
+        Expr::List(vec![Expr::Int(1)]),
+        slot(4),
+        quiet_print,
+        quiet_ret,
+    );
+    let quiet = builder.add(Label::Cond(Expr::Bool(true), quiet_head, quiet_ret));
+
+    let sync_ret = builder.add(Label::Return(Expr::Unit));
+    let sync_recv = builder.add(Label::Recv(Lhs::Var(slot(1)), Expr::Var(slot(0)), sync_ret));
+    let sync_entry = builder.add(Label::MakeChannel(Lhs::Var(slot(0)), None, sync_recv));
+    let caller_ret = builder.add(Label::Return(Expr::Var(slot(0))));
+    let caller = builder.add(Label::Instr(
+        Instr::SyncCall(Lhs::Var(slot(0)), "s".to_string(), vec![]),
+        caller_ret,
+    ));
+
+    let mut program = builder.build_undecoded();
+    register(&mut program, "branch", function(branch, 20, 0, 3, false));
+    register(&mut program, "loop", function(loop_head, 21, 0, 5, false));
+    register(&mut program, "quiet", function(quiet, 22, 0, 5, false));
+    register(&mut program, "s", function(sync_entry, 23, 0, 2, true));
+    register(&mut program, "caller", function(caller, 24, 0, 1, false));
+    program.decode();
+
+    let c = &program.compiled;
+    assert!(!c.never_yields(branch), "a receive in a branch");
+    assert!(!c.never_yields(loop_head), "a receive in a loop body");
+    assert!(c.never_yields(quiet), "a branch and a loop with no receive");
+    assert!(!c.never_yields(sync_entry), "the sync callee's own graph receives");
+    assert!(c.never_yields(caller), "a call does not enter its callee");
+    assert!(!c.never_yields(quiet_print), "a vertex that is no entry");
+    assert!(!c.never_yields(c.ops.len() + 64), "a vertex past the graph");
+    let off = CompiledProgram::build_with(&program, Rewrites::Off);
+    assert_eq!(off.never_yield_entries, c.never_yield_entries);
+}
