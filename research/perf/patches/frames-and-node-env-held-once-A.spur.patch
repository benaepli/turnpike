+            .find_map(|r| match r {
+                Runnable::Record(r) if r.entry_func == NEVER_YIELDS => Some(r.env.slots.as_ptr()),
+                _ => None,
+            })
+            .expect("the never-yield record is queued")
+    }
+
+    /// Every held record is at its entry with the frame its arguments build.
+    /// The never-yield record holds no argument sequence and kept the slot
+    /// buffer it was sent with; the yielding one was rebuilt from its
+    /// arguments.
+    fn assert_reset_frames(
+        program: &Program,
+        held: Vec<Record<NoHashing>>,
+        sent_frame: *const Value<NoHashing>,
+        site: &str,
+    ) {
+        assert_eq!(held.len(), 2, "{site}");
+        for r in held {
+            assert_eq!(r.pc, r.entry_pc, "{site}");
+            let (func, args) = if r.entry_func == NEVER_YIELDS {
+                assert!(r.initial_args.is_empty(), "{site}");
+                assert_eq!(r.env.slots.as_ptr(), sent_frame, "{site}: the frame was rebuilt");
+                (&program.rpc[&NEVER_YIELDS], vec![Value::int(7), Value::bool(true)])
+            } else {
+                assert_eq!(r.initial_args.as_slice(), &[Value::int(9)], "{site}");
+                (&program.rpc[&PAUSES], vec![Value::int(9)])
+            };
+            let fresh = build_frame::<NoHashing>(func, &args);
+            assert_eq!(r.env, fresh, "{site}");
+            assert_eq!(r.env.slots.len(), fresh.slots.len(), "{site}");
+            assert_eq!(r.env.sig, fresh.sig, "{site}");
+            assert_eq!(r.env.writes, fresh.writes, "{site}");
+        }
+    }
+
+    fn crash_held(state: &State<NoHashing>) -> Vec<Record<NoHashing>> {
+        state.crash_info.queued_messages.iter().map(|(_, r)| r.clone()).collect()
+    }
+
+    fn partition_held(state: &State<NoHashing>) -> Vec<Record<NoHashing>> {
+        state
+            .partition_info
+            .queued_messages
+            .iter()
+            .filter_map(|m| match m {
+                crate::simulator::core::partition::QueuedMessage::Record { record, .. } => {
+                    Some(record.clone())
+                }
+                _ => None,
+            })
+            .collect()
+    }
+
+    fn deliver_all(state: &mut State<NoHashing>, program: &Program) {
+        let mut logs = crate::simulator::path::Logs::default();
+        let mut rng = StdRng::seed_from_u64(8);
+        for _ in 0..8 {
+            if state.network_queue.is_empty() {
+                return;
+            }
+            schedule_runnable::<NoHashing, _, _, NoFeedback>(
+                state,
+                &mut logs,
+                program,
+                &(),
+                &mut (),
+                &TopologyInfo {
+                    topology: Topology::Full,
+                    num_servers: 2,
+                },
+                &GlobalState::<NoFeedback>::new(),
+                &SchedulePolicy::Fixed,
+                false,
+                &mut crate::simulator::core::queue_selector::ProbabilisticSelector {
+                    p_local: 0.0,
+                    p_timer: 0.0,
+                },
+                &crate::simulator::core::queue_selector::WithinQueueSelector::default(),
+                &ResolvedTerms::default(),
+                &PurgatoryConfig::default(),
+                0.0,
+                timer_context::RunMode::Probe,
+                &[],
+                &mut Vec::new(),
+                &mut rng,
+            )
+            .expect("a held delivery does not fail");
+        }
+        panic!("the network queue did not drain");
+    }
+
+    /// At each of the five places a record is reset for re-delivery - a
+    /// crashed destination at delivery, a partitioned pair at delivery, a
+    /// crashed node's local queue, a crashed node's network filter and a
+    /// partition's activation - a never-yield record keeps the frame it was
+    /// sent with, which equals a rebuild in every slot, in signature and in
+    /// write count, and a yielding record is rebuilt from its arguments.
+    #[test]
+    fn a_never_yield_record_keeps_its_frame_at_every_reset() {
+        let program = redelivery_program();
+        assert!(program.compiled.never_yields(0));
+        assert!(!program.compiled.never_yields(1));
+
+        let mut state = state_with_sent_records(&program);
+        let sent = never_yield_frame_address(&state);
+        state.crash_info.currently_crashed.insert(node(1));
+        deliver_all(&mut state, &program);
+        assert_reset_frames(&program, crash_held(&state), sent, "crashed destination at delivery");
+
+        let mut state = state_with_sent_records(&program);
+        let sent = never_yield_frame_address(&state);
+        state.partition_info.active = Some(crate::simulator::core::partition::PartitionType::IsolateOne(node(1)));
+        deliver_all(&mut state, &program);
+        assert_reset_frames(&program, partition_held(&state), sent, "partitioned at delivery");
+
+        let mut state = state_with_sent_records(&program);
+        let sent = never_yield_frame_address(&state);
+        for _ in 0..2 {
+            let r = state.take_network(0);
+            state.local_queues[1].push(r);
+        }
+        crash_node(&mut state, &program, node(1));
+        assert_reset_frames(&program, crash_held(&state), sent, "crashed node's local queue");
+
+        let mut state = state_with_sent_records(&program);
+        let sent = never_yield_frame_address(&state);
+        crash_node(&mut state, &program, node(1));
+        assert_reset_frames(&program, crash_held(&state), sent, "crashed node's network filter");
+
+        let mut state = state_with_sent_records(&program);
+        let sent = never_yield_frame_address(&state);
+        activate_partition(
+            &mut state,
+            &program,
+            crate::simulator::core::partition::PartitionType::IsolateOne(node(1)),
+        );
+        assert_reset_frames(&program, partition_held(&state), sent, "partition activation");
+    }
 }
