+/// Integer columns of the executions, logs and traces tables written with
+/// DELTA_BINARY_PACKED and no dictionary. Statistics stay at the default so
+/// readers keep min/max per row group and page.
+const DELTA_ENCODED_COLUMNS: [&str; 7] = [
+    "run_id",
+    "seq_num",
+    "step",
+    "unique_id",
+    "trace_id",
+    "schedulable_count",
+    "causal_operation_id",
+];
+
 /// Helper: creates a new ArrowWriter for the given path and schema.
+/// `delta_columns` names the columns written with DELTA_BINARY_PACKED instead
+/// of a dictionary; a name the schema does not carry has no effect.
 fn open_parquet_writer(
     path: &Path,
     schema: Arc<Schema>,
+    delta_columns: &[&str],
 ) -> Result<ArrowWriter<File>, Box<dyn Error>> {
     let file = File::create(path)?;
-    let props = WriterProperties::builder()
-        .set_compression(Compression::SNAPPY)
-        .build();
-    Ok(ArrowWriter::try_new(file, schema, Some(props))?)
+    let mut builder = WriterProperties::builder().set_compression(Compression::SNAPPY);
+    for &column in delta_columns {
+        builder = builder
+            .set_column_dictionary_enabled(ColumnPath::from(column), false)
+            .set_column_encoding(ColumnPath::from(column), Encoding::DELTA_BINARY_PACKED);
+    }
+    Ok(ArrowWriter::try_new(file, schema, Some(builder.build()))?)
 }
 
