+    #[test]
+    fn event_integer_columns_are_delta_encoded_without_a_dictionary_and_keep_statistics() {
+        let dir = std::env::temp_dir().join(format!("spur-history-encoding-test-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        let writer = ParquetWriter::spawn(&dir, 1, 20).unwrap();
+        for run_id in 0..3 {
+            writer.write(
+                run_rows(&[("Write", "{}"); 4], &["a", "b", "c"], &["{}"; 4]),
+                run_record(run_id, 4),
+            );
+        }
+        writer.shutdown();
+
+        for table in ["executions", "logs", "traces", "runs"] {
+            let path = dir.join(table).join(batch_filename(1));
+            let builder = ParquetRecordBatchReaderBuilder::try_new(File::open(&path).unwrap()).unwrap();
+            let metadata = builder.metadata().clone();
+            let mut delta_columns = 0;
+            for column in metadata.row_group(0).columns() {
+                let name = column.column_path().string();
+                let encodings: Vec<Encoding> = column.encodings().collect();
+                let dictionary = encodings
+                    .iter()
+                    .any(|e| matches!(e, Encoding::RLE_DICTIONARY | Encoding::PLAIN_DICTIONARY));
+                if table != "runs" && DELTA_ENCODED_COLUMNS.contains(&name.as_str()) {
+                    delta_columns += 1;
+                    assert!(encodings.contains(&Encoding::DELTA_BINARY_PACKED), "{table}.{name}: {encodings:?}");
+                    assert!(!dictionary, "{table}.{name}: {encodings:?}");
+                    assert_eq!(column.dictionary_page_offset(), None, "{table}.{name} has a dictionary page");
+                    let stats = column.statistics().unwrap_or_else(|| panic!("{table}.{name} has no statistics"));
+                    assert!(stats.min_bytes_opt().is_some() && stats.max_bytes_opt().is_some(), "{table}.{name} min/max");
+                } else {
+                    assert!(dictionary, "{table}.{name}: {encodings:?}");
+                    assert!(column.dictionary_page_offset().is_some(), "{table}.{name} lost its dictionary page");
+                }
+            }
+            let expected = match table {
+                "executions" => 4,
+                "logs" => 3,
+                "traces" => 6,
+                _ => 0,
+            };
+            assert_eq!(delta_columns, expected, "{table}: delta-encoded column count");
+        }
+        let _ = std::fs::remove_dir_all(&dir);
+    }
