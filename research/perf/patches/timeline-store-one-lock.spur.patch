+    /// A sharded concurrent map with the same merge and decay rules as
+    /// `GlobalTimeline`, used as the reference its snapshots must match.
+    #[derive(Default)]
+    struct ShardedTimeline {
+        counts: DashMap<TimelineTuple, u64>,
+        total: AtomicU64,
+    }
+
+    impl ShardedTimeline {
+        fn snapshot(&self) -> TimelineSnap {
+            TimelineSnap {
+                counts: self.counts.iter().map(|e| (*e.key(), *e.value())).collect(),
+                total: self.total.load(Ordering::Relaxed),
+            }
+        }
+
+        fn merge(&self, local: &LocalTimeline) {
+            for t in &local.tuples {
+                *self.counts.entry(*t).or_default() += 1;
+            }
+            self.total
+                .fetch_add(local.tuples.len() as u64, Ordering::Relaxed);
+        }
+
+        fn decay(&self, factor: f64) {
+            let factor = factor.clamp(0.0, 1.0);
+            self.counts.retain(|_, c| {
+                *c = ((*c as f64) * factor).floor() as u64;
+                *c > 0
+            });
+            let new_total: u64 = self.counts.iter().map(|e| *e.value()).sum();
+            self.total.store(new_total, Ordering::Relaxed);
+        }
+    }
+
