+/// One read of the shared timeline store, taken under a single lock.
+/// Counted on the session total rather than a run's counter block, so it does
+/// not add to the folded increments.
+#[inline]
+pub fn record_timeline_store_snapshot() {
+    if !enabled() {
+        return;
+    }
+    TIMELINE_STORE_SNAPSHOTS.fetch_add(1, Ordering::Relaxed);
+}
+
+/// One run's keys folded into the shared timeline store under a single lock.
+/// Counted on the session total like `record_timeline_store_snapshot`.
+#[inline]
+pub fn record_timeline_store_merge() {
+    if !enabled() {
+        return;
+    }
+    TIMELINE_STORE_MERGES.fetch_add(1, Ordering::Relaxed);
+}
+
+/// Acquisitions of the shared timeline store's lock: `snapshots` reads taken
+/// at run start and `merges` writes at run end, one each per run that uses
+/// timeline feedback.
+#[derive(Serialize, Debug)]
+pub struct TimelineStoreStats {
+    pub snapshots: u64,
+    pub merges: u64,
+}
+
+impl TimelineStoreStats {
+    fn read() -> Self {
+        Self {
+            snapshots: TIMELINE_STORE_SNAPSHOTS.load(Ordering::Relaxed),
+            merges: TIMELINE_STORE_MERGES.load(Ordering::Relaxed),
+        }
