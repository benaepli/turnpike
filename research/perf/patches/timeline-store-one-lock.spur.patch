+            store.merge(&tl);
+            reference.merge(&tl);
+            if run % 50 == 49 {
+                let factor = [0.5, 0.9, 0.0, 1.0][(run / 50) % 4];
+                store.decay(factor);
+                reference.decay(factor);
+            }
+            let got = store.snapshot();
