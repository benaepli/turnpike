+/// One run's queue-eligibility accounting, added to the process totals once
+/// when the run ends. The per-step tally is kept in the run's own state, so
+/// no step touches a shared counter.
+pub fn record_queue_scan(fast_steps: u64, slow_steps: u64, elements_skipped: u64) {
+    if !enabled() {
+        return;
+    }
+    QS_FAST_STEPS.fetch_add(fast_steps, Ordering::Relaxed);
+    QS_SLOW_STEPS.fetch_add(slow_steps, Ordering::Relaxed);
+    QS_ELEMENTS_SKIPPED.fetch_add(elements_skipped, Ordering::Relaxed);
+}
