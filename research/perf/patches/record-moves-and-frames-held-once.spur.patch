+/// A finished frame's buffer is kept only when nothing else holds it, comes
+/// back empty with its capacity, is taken only when large enough, and a full
+/// pool keeps no more. A clone of the state starts with an empty pool and the
+/// pool's debug text shows nothing it holds.
+#[test]
+fn a_shared_frame_buffer_is_not_kept() {
+    let mut state = State::<NoHashing>::new(&[(NameId(0), 1)], 2);
+    let mut slots: EcoVec<Value<NoHashing>> = EcoVec::with_capacity(6);
+    slots.push(Value::int(1));
+    slots.push(Value::int(2));
+    let holder = slots.clone();
+    state.recycle_frame(slots);
+    assert_eq!(state.frame_pool.len(), 0);
+    assert_eq!(holder.as_slice(), &[Value::int(1), Value::int(2)]);
+
+    state.recycle_frame(holder);
+    assert_eq!(state.frame_pool.len(), 1);
+    let taken = state.frame_buffer(4);
+    assert!(taken.is_empty());
+    assert!(taken.capacity() >= 6);
+    assert!(state.frame_pool.is_empty());
+
+    let mut small: EcoVec<Value<NoHashing>> = EcoVec::with_capacity(2);
+    small.push(Value::unit());
+    state.recycle_frame(small);
+    assert_eq!(state.frame_pool.len(), 1);
+    let large = state.frame_buffer(64);
+    assert!(large.is_empty() && large.capacity() >= 64);
+    assert_eq!(state.frame_pool.len(), 1, "a buffer too small is left in the pool");
+    assert!(state.frame_buffer(0).capacity() == 0);
+    assert_eq!(state.frame_pool.len(), 1);
+
+    for _ in 0..40 {
+        let mut b: EcoVec<Value<NoHashing>> = EcoVec::with_capacity(3);
+        b.push(Value::unit());
+        state.recycle_frame(b);
+    }
+    assert_eq!(state.frame_pool.len(), 32);
+    state.recycle_frame(EcoVec::new());
+    assert_eq!(state.frame_pool.len(), 32);
+
+    assert!(state.clone().frame_pool.is_empty());
+    assert_eq!(format!("{:?}", state.frame_pool), "FramePool");
+}
