+fn spec_paths(dir: &std::path::Path, out: &mut Vec<std::path::PathBuf>) {
+    for entry in std::fs::read_dir(dir).expect("the spec directory is readable") {
+        let path = entry.expect("a directory entry").path();
+        if path.is_dir() {
+            spec_paths(&path, out);
+        } else if path.extension().is_some_and(|e| e == "spur") {
+            out.push(path);
+        }
+    }
+}
+
+/// Whether frames for `func` built into kept buffers larger than they need,
+/// with every argument count up to the parameter count, equal fresh frames
+/// slot by slot, in signature and in write count.
+fn pooled_frames_match<H: HashPolicy>(func: &FunctionInfo) -> bool {
+    let slots = func.local_slot_count as usize;
+    let params = (func.param_count as usize).min(slots);
+    let mut state = State::<H>::new(&[(NameId(0), 1)], 2);
+    let refill = |state: &mut State<H>| {
+        let mut junk: EcoVec<Value<H>> = EcoVec::with_capacity(slots + 7);
+        for i in 0..slots + 7 {
+            junk.push(Value::int(-(i as i64)));
+        }
+        state.recycle_frame(junk);
+    };
+    (0..=params).all(|given| {
+        let args: Vec<Value<H>> = (0..given).map(|i| Value::int(i as i64 + 1)).collect();
+        let fresh = build_frame::<H>(func, &args);
+        refill(&mut state);
+        let pooled = build_frame_in(state.frame_buffer(slots), func, &args);
+        refill(&mut state);
+        let mut held = state.frame_buffer(slots);
+        for a in &args {
+            held.push(a.clone());
+        }
+        let held = FrameBuilder::<H>::from_args(held).finish(func);
+        [pooled, held].iter().all(|f| {
+            f.slots.len() == fresh.slots.len()
+                && *f == fresh
+                && f.sig == fresh.sig
+                && f.writes == fresh.writes
+        })
+    })
+}
+
+/// For every function of every spec that compiles, a frame written into a
+/// kept buffer and a frame whose arguments were pushed into one equal a
+/// fresh frame, on either hash policy.
+#[test]
+fn pooled_frames_equal_fresh_frames_in_every_spec() {
+    std::thread::Builder::new()
+        .stack_size(64 * 1024 * 1024)
+        .spawn(|| {
+            let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../../bin/spur");
+            let mut files = Vec::new();
+            spec_paths(&root, &mut files);
+            files.sort();
+            let (mut compiled, mut functions) = (0, 0);
+            let mut failures = Vec::new();
+            for file in &files {
+                let name = file.display().to_string();
+                let source = std::fs::read_to_string(file).expect("the spec is readable");
+                let Ok(program) = crate::compiler::compile_with(
+                    &source,
+                    &name,
+                    crate::compiler::cfg::Compiler::new(),
+                )
+                .into_program() else {
+                    continue;
+                };
+                compiled += 1;
+                let mut funcs: Vec<_> = program.func_name_to_id.iter().collect();
+                funcs.sort();
+                for (func_name, id) in funcs {
+                    let func = &program.rpc[id];
+                    functions += 1;
+                    if !pooled_frames_match::<NoHashing>(func) || !pooled_frames_match::<WithHashing>(func) {
+                        failures.push(format!("{name} {func_name}"));
+                    }
+                }
+            }
+            assert!(compiled > 0 && functions > 0, "no spec compiled");
+            assert!(failures.is_empty(), "pooled frames differ:\n{}", failures.join("\n"));
+        })
+        .expect("the test thread starts")
+        .join()
+        .expect("the test thread finishes");
+}
+
+/// A record the decoded loop parks on an empty channel comes back out of its
+/// waiting entry equal to the record and destination the label loop parks,
+/// and it holds its values exactly once.
+#[test]
+fn a_parked_record_round_trips_through_its_waiting_entry() {
+    let mut builder = TestProgramBuilder::new();
+    let ret = builder.add(Label::Return(Expr::Unit));
+    let recv = builder.add(Label::Recv(Lhs::Var(slot(1)), Expr::Var(slot(0)), ret));
+    let make = builder.add(Label::MakeChannel(Lhs::Var(slot(0)), Some(1), recv));
+    let program = builder.build();
+    assert!(program.compiled.covers(program.cfg.graph.len()));
+    let mut undecoded = program.clone();
+    undecoded.compiled = Default::default();
+
+    let park = |program: &Program, payload: &ValueSeq<WithHashing>| {
+        let mut state = State::<WithHashing>::new(&[(NameId(0), 1)], 2);
+        let mut logger = TestLogger::new();
+        let mut record = make_record(make, 3);
+        record.env.set(2, Value::list(payload.clone()));
+        let mut coverage = LocalCoverage::new();
+        let result = exec::<WithHashing, TestLogger, CfgFeedback>(
+            &mut state,
+            &mut logger,
+            program,
+            record,
+            &VertexMap::new(),
+            &mut coverage,
+            &SchedulePolicy::Fixed,
+            &PurgatoryConfig::default(),
+            &mut SmallRng::seed_from_u64(0),
+        );
+        assert!(matches!(result, Ok(None)), "the record parks");
+        let cid = *state.channels.keys().next().expect("one channel");
+        let chan = state.channels.get_mut(&cid).expect("the channel exists");
+        assert_eq!(chan.waiting_readers.len(), 1);
+        let entry = chan.pop_waiting_reader().expect("one reader waits");
+        assert!(chan.waiting_readers.is_empty());
+        entry
+    };
+
+    let mut decoded_payload: ValueSeq<WithHashing> = ecow::EcoVec::new();
+    decoded_payload.push(Value::int(4));
+    let mut legacy_payload = decoded_payload.clone();
+    legacy_payload.make_mut();
+    let (decoded, decoded_lhs) = park(&program, &decoded_payload);
+    let (legacy, legacy_lhs) = park(&undecoded, &legacy_payload);
+    assert_eq!(format!("{:?}", decoded), format!("{:?}", legacy));
+    assert_eq!(decoded_lhs, legacy_lhs);
+    assert_eq!(decoded_lhs, Lhs::Var(slot(1)));
+    assert_eq!(decoded.pc, ret);
+    assert_eq!(decoded.env.get(2), &Value::list(decoded_payload.clone()));
+
+    drop((legacy, legacy_lhs));
+    assert!(legacy_payload.is_unique());
+    assert!(!decoded_payload.is_unique(), "the parked record still holds its payload");
+    drop(decoded);
+    assert!(decoded_payload.is_unique(), "the parked record dropped its payload exactly once");
+}
