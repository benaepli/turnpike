+/// Removes the record at `idx` of `queue`, keeping the order of the rest,
+/// with the record read once out of its slot. The entry must be a record.
+#[inline]
+fn remove_record<H: HashPolicy>(queue: &mut Vec<Runnable<H>>, idx: usize) -> Record<H> {
+    let len = queue.len();
+    let Runnable::Record(rec) = &queue[idx] else {
+        unreachable!("remove_record on an entry that is not a record")
+    };
+    let src: *const Record<H> = rec;
+    // SAFETY: the indexing above proved `idx < len` and the pattern proved the
+    // entry at `idx` is a record, both before anything is read. The record is
+    // read exactly once, then the tail is shifted down over its slot and the
+    // length drops by one, so the returned value is its only owner and no
+    // entry is dropped twice or lost. Between the read and `set_len` there is
+    // only pointer arithmetic and a copy, which cannot unwind. `&mut queue`
+    // rules out any live reference into the buffer, and the pointer taken from
+    // the shared borrow is not used after the mutable pointer is taken.
+    unsafe {
+        let r = std::ptr::read(src);
+        let p = queue.as_mut_ptr().add(idx);
+        std::ptr::copy(p.add(1), p, len - idx - 1);
+        queue.set_len(len - 1);
+        r
+    }
+}
