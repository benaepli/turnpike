+/// A sync function that reaches a receive fails the run with the sync
+/// instruction error on either hash policy, so a never-yield caller cannot
+/// yield through it.
+#[test]
+fn a_sync_callee_that_receives_fails_the_never_yield_caller() {
+    let mut builder = TestProgramBuilder::new();
+    let sync_ret = builder.add(Label::Return(Expr::Unit));
+    let sync_recv = builder.add(Label::Recv(Lhs::Var(slot(1)), Expr::Var(slot(0)), sync_ret));
+    let sync_entry = builder.add(Label::MakeChannel(Lhs::Var(slot(0)), None, sync_recv));
+    let caller_ret = builder.add(Label::Return(Expr::Var(slot(0))));
+    let caller = builder.add(Label::Instr(
+        Instr::SyncCall(Lhs::Var(slot(0)), "s".to_string(), vec![]),
+        caller_ret,
+    ));
+    let mut program = builder.build_undecoded();
+    register(&mut program, "s", function(sync_entry, 23, 0, 2, true));
+    register(&mut program, "caller", function(caller, 24, 0, 1, false));
+    program.decode();
+    assert!(program.compiled.never_yields(caller));
+
+    let (plain, _) = run_on_one_node::<NoHashing>(&program, make_record_for(caller, 1, Continuation::Recover));
+    let (hashed, _) =
+        run_on_one_node::<WithHashing>(&program, make_record_for(caller, 1, Continuation::Recover));
+    for result in [plain.map(|_| ()), hashed.map(|_| ())] {
+        match result {
+            Err(RuntimeError::UnsupportedSyncInstruction(text)) => {
+                assert!(text.starts_with("Recv("), "{text}")
+            }
+            other => panic!("expected the sync instruction error, got {other:?}"),
+        }
+    }
+}
