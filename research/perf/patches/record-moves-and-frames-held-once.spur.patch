+    fn push_record_into_matches_vec_push_and_drops_each_record_once() {
+        for spare in [0, 1, 4] {
+            let mut ours_payload = handle(6);
+            let mut theirs_payload = handle(6);
+            let mut ours: Vec<Runnable<NoHashing>> = Vec::with_capacity(spare);
+            let mut theirs: Vec<Runnable<NoHashing>> = Vec::with_capacity(spare);
+            for pc in 0..6 {
+                push_record_into(&mut ours, record(0, pc, &ours_payload));
+                theirs.push(Runnable::Record(record(0, pc, &theirs_payload)));
+                ours.push(Runnable::Crash {
+                    node_id: node(0),
+                    priority: 1.0,
+                });
+                theirs.push(Runnable::Crash {
+                    node_id: node(0),
+                    priority: 1.0,
+                });
+            }
+            assert_eq!(
+                format!("{:?}", ours),
+                format!("{:?}", theirs),
+                "queue with {spare} spare"
+            );
+            let last = remove_record(&mut ours, 10);
+            drop(ours);
+            assert!(!ours_payload.is_unique(), "the last record still holds its payload");
+            drop(last);
+            assert!(
+                ours_payload.is_unique(),
+                "every pushed record dropped its payload exactly once with {spare} spare"
+            );
+            drop(theirs);
+            assert!(theirs_payload.is_unique());
+        }
+    }
+
+    fn local(slot: u32) -> Lhs {
+        Lhs::Var(VarSlot::Local(slot, NameId(slot as usize)))
+    }
+
+    fn node_lhs(slot: u32) -> Lhs {
+        Lhs::Var(VarSlot::Node(slot, NameId(100 + slot as usize)))
+    }
+
+    struct World {
+        chan: ChannelState<NoHashing>,
+        nodes: Vec<Env<NoHashing>>,
+        queues: Vec<Vec<Runnable<NoHashing>>>,
+    }
+
+    fn world() -> World {
+        World {
+            chan: ChannelState::new(),
+            nodes: vec![Env::with_slots(2), Env::with_slots(2)],
+            queues: vec![Vec::new(), Vec::new()],
+        }
+    }
+
+    /// The wake by value, which the in-place delivery must match: take the
+    /// reader out, store into it, write the node env back, set its timer entry
+    /// and queue it.
+    fn wake_by_pop(w: &mut World, val: V, entry: ReaderEntry) {
+        match w.chan.pop_waiting_reader() {
+            None => w.chan.buffer.push_back(val),
+            Some((mut reader, lhs)) => {
+                let node_index = reader.node.index;
+                let mut node_env = w.nodes[node_index].clone();
+                store(&lhs, val, &mut reader.env, &mut node_env).expect("store succeeds");
+                w.nodes[node_index] = node_env;
+                match entry {
+                    ReaderEntry::Unchanged => {}
+                    ReaderEntry::TimerFired => reader.timer_entry = Some(reader.pc),
+                    ReaderEntry::Cleared => reader.timer_entry = None,
+                }
+                w.queues[node_index].push(Runnable::Record(reader));
+            }
+        }
+    }
+
+    fn deliver(w: &mut World, val: V, entry: ReaderEntry, strict: bool) -> Result<(), RuntimeError> {
+        deliver_to_channel(&mut w.chan, &mut w.nodes, &mut w.queues, val, entry, strict)
+    }
+
+    fn assert_same(ours: &World, theirs: &World, when: &str) {
+        assert_eq!(ours.chan.buffer, theirs.chan.buffer, "buffer {when}");
+        assert_eq!(
+            ours.chan.waiting_readers.len(),
+            theirs.chan.waiting_readers.len(),
+            "waiting readers {when}"
+        );
+        for (o, t) in ours.chan.waiting_readers.iter().zip(theirs.chan.waiting_readers.iter()) {
+            assert_eq!(format!("{:?}", **o), format!("{:?}", **t), "waiting reader {when}");
+        }
+        assert_eq!(ours.nodes, theirs.nodes, "node envs {when}");
+        assert_eq!(format!("{:?}", ours.queues), format!("{:?}", theirs.queues), "local queues {when}");
+    }
+
+    #[test]
+    fn delivery_with_no_reader_buffers_the_value() {
+        let mut ours = world();
+        let mut theirs = world();
+        assert!(deliver(&mut ours, V::int(5), ReaderEntry::Unchanged, true).is_ok());
+        wake_by_pop(&mut theirs, V::int(5), ReaderEntry::Unchanged);
+        assert_same(&ours, &theirs, "with no reader");
+        assert_eq!(ours.chan.buffer.len(), 1);
+        assert!(ours.queues.iter().all(|q| q.is_empty()));
+    }
+
+    #[test]
+    fn delivery_to_a_unique_reader_stores_and_queues_it_as_the_pop_did() {
+        let entries: [(&str, fn() -> ReaderEntry); 3] = [
+            ("unchanged", || ReaderEntry::Unchanged),
+            ("timer fired", || ReaderEntry::TimerFired),
+            ("cleared", || ReaderEntry::Cleared),
+        ];
+        for (kind, entry) in entries {
+            for (strict, lhs) in [(true, local(1)), (false, node_lhs(1))] {
+                let mut ours_payload = handle(2);
+                let mut theirs_payload = handle(2);
+                let mut ours = world();
+                let mut theirs = world();
+                ours.chan.push_waiting_reader(record(1, 20, &ours_payload), lhs.clone());
+                ours.chan.push_waiting_reader(record(0, 21, &ours_payload), local(1));
+                theirs.chan.push_waiting_reader(record(1, 20, &theirs_payload), lhs.clone());
+                theirs.chan.push_waiting_reader(record(0, 21, &theirs_payload), local(1));
+                assert!(deliver(&mut ours, V::int(9), entry(), strict).is_ok());
+                wake_by_pop(&mut theirs, V::int(9), entry());
+                assert_same(&ours, &theirs, kind);
+                let Runnable::Record(woken) = &ours.queues[1][0] else {
+                    panic!("the woken reader is queued on its node")
+                };
+                let expected_entry = match entry() {
+                    ReaderEntry::Unchanged => Some(3),
+                    ReaderEntry::TimerFired => Some(20),
+                    ReaderEntry::Cleared => None,
+                };
+                assert_eq!(woken.timer_entry, expected_entry, "timer entry when {kind}");
+                match lhs {
+                    Lhs::Var(VarSlot::Local(..)) => assert_eq!(woken.env.get(1), &V::int(9)),
+                    Lhs::Var(VarSlot::Node(..)) => assert_eq!(ours.nodes[1].get(1), &V::int(9)),
+                }
+                drop(ours);
+                assert!(ours_payload.is_unique(), "no reader leaked or dropped twice when {kind}");
+                drop(theirs);
+                assert!(theirs_payload.is_unique());
+            }
+        }
+    }
+
+    /// A reader whose channel state is still shared with a copy is cloned
+    /// before it is changed: the copy's reader keeps its value.
+    #[test]
+    fn delivery_to_a_shared_reader_changes_only_its_own_copy() {
+        let mut payload = handle(3);
+        let mut ours = world();
+        ours.chan.push_waiting_reader(record(1, 30, &payload), local(1));
+        let copy = ours.chan.clone();
+        let before = (*copy.waiting_readers[0]).clone();
+        let mut theirs = World {
+            chan: copy.clone(),
+            nodes: ours.nodes.clone(),
+            queues: ours.queues.clone(),
+        };
+        assert!(deliver(&mut ours, V::int(4), ReaderEntry::Cleared, true).is_ok());
+        wake_by_pop(&mut theirs, V::int(4), ReaderEntry::Cleared);
+        assert_same(&ours, &theirs, "from a shared entry");
+        assert_eq!(copy.waiting_readers.len(), 1);
+        assert_eq!(format!("{:?}", *copy.waiting_readers[0]), format!("{:?}", before), "the copy's reader is unchanged");
+        assert_eq!(copy.waiting_readers[0].0.env.get(1), &V::unit());
+        drop((ours, theirs, before));
+        assert!(!payload.is_unique(), "the copy still holds its reader");
+        drop(copy);
+        assert!(payload.is_unique(), "every reader dropped its payload exactly once");
+    }
+
+    fn failing_store(
+        _: &Lhs,
+        _: V,
+        local_env: &mut Env<NoHashing>,
+        node_env: &mut Env<NoHashing>,
+    ) -> Result<(), RuntimeError> {
+        local_env.set(1, V::int(70));
+        node_env.set(0, V::int(77));
+        Err(RuntimeError::RemoteChannelRead)
+    }
+
+    /// A strict delivery whose store fails returns the error before the node
+    /// env is written back or the reader is queued, and drops the reader.
+    #[test]
+    fn a_failing_strict_delivery_drops_the_reader_and_writes_nothing_back() {
+        let mut payload = handle(4);
+        let mut w = world();
+        w.chan.push_waiting_reader(record(1, 40, &payload), local(1));
+        let nodes_before = w.nodes.clone();
+        let result = deliver_with_store(
+            &mut w.chan,
+            &mut w.nodes,
+            &mut w.queues,
+            V::int(1),
+            ReaderEntry::TimerFired,
+            true,
+            failing_store,
+        );
+        assert!(matches!(result, Err(RuntimeError::RemoteChannelRead)));
+        assert_eq!(w.nodes, nodes_before, "the node env is not written back");
+        assert!(w.queues.iter().all(|q| q.is_empty()), "the reader is not queued");
+        assert!(w.chan.waiting_readers.is_empty(), "the reader was taken");
+        assert!(w.chan.buffer.is_empty());
+        assert!(payload.is_unique(), "the dropped reader released its payload");
+    }
+
+    /// A non-strict delivery whose store fails still writes the node env back
+    /// and queues the reader, then returns the error.
+    #[test]
+    fn a_failing_lenient_delivery_queues_the_reader_and_returns_the_error() {
+        for (kind, entry, expected) in [
+            ("unchanged", ReaderEntry::Unchanged, Some(3)),
+            ("timer fired", ReaderEntry::TimerFired, Some(50)),
+            ("cleared", ReaderEntry::Cleared, None),
+        ] {
+            let mut payload = handle(5);
+            let mut w = world();
+            w.chan.push_waiting_reader(record(1, 50, &payload), local(1));
+            let result = deliver_with_store(
+                &mut w.chan,
+                &mut w.nodes,
+                &mut w.queues,
+                V::int(1),
+                entry,
+                false,
+                failing_store,
+            );
+            assert!(matches!(result, Err(RuntimeError::RemoteChannelRead)), "{kind}");
+            assert_eq!(w.nodes[1].get(0), &V::int(77), "node env written back when {kind}");
+            assert_eq!(w.queues[1].len(), 1, "reader queued when {kind}");
+            let Runnable::Record(woken) = &w.queues[1][0] else {
+                panic!("the queued entry is the reader")
+            };
+            assert_eq!(woken.env.get(1), &V::int(70));
+            assert_eq!(woken.timer_entry, expected, "timer entry when {kind}");
+            assert!(w.chan.waiting_readers.is_empty());
+            drop(w);
+            assert!(payload.is_unique(), "no reader leaked or dropped twice when {kind}");
+        }
+    }
 }
