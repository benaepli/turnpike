+    /// A program whose sender, run on node 0, sends `f(7, true)` and then
+    /// `g(9)` to node 1. `f` never yields and has a declared nil local; `g`
+    /// pauses once.
+    fn redelivery_program() -> Program {
+        use crate::analysis::resolver::NameId;
+        use crate::compiler::cfg::{Cfg, Expr, FunctionInfo, Instr, Label, Lhs, SlotDefault, VarSlot};
+        let local = |i: u32| VarSlot::Local(i, NameId(100 + i as usize));
+        let graph = vec![
+            Label::Return(Expr::Var(local(0))),
+            Label::Pause(2),
+            Label::Return(Expr::Var(local(0))),
+            Label::Instr(
+                Instr::Async(
+                    Lhs::Var(local(0)),
+                    Expr::Var(local(2)),
+                    "f".to_string(),
+                    vec![Expr::Int(7), Expr::Bool(true)],
+                ),
+                4,
+            ),
+            Label::Instr(
+                Instr::Async(
+                    Lhs::Var(local(1)),
+                    Expr::Var(local(2)),
+                    "g".to_string(),
+                    vec![Expr::Int(9)],
+                ),
+                5,
+            ),
+            Label::Return(Expr::Unit),
+        ];
+        let info = |entry: usize, name: NameId, params: u32, slots: u32, defaults: Vec<SlotDefault>| {
+            FunctionInfo {
+                entry,
+                name,
+                param_count: params,
+                local_slot_count: slots,
+                local_defaults: defaults,
+                is_sync: false,
+                debug_slot_names: vec![],
+            }
+        };
+        let mut program = Program {
+            cfg: Cfg { graph },
+            max_node_slots: 3,
+            ..Program::default()
+        };
+        for (qualified, f) in [
+            ("f", info(0, NEVER_YIELDS, 2, 4, vec![SlotDefault::Nil])),
+            ("g", info(1, PAUSES, 1, 3, vec![])),
+            ("sender", info(3, SENDER, 0, 3, vec![])),
+        ] {
+            program.func_name_to_id.insert(qualified.to_string(), f.name);
+            program.rpc.insert(f.name, f);
+        }
+        program.decode();
+        program
+    }
