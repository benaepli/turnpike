+/// A frame took a nonempty slot buffer from a finished frame when `reused`,
+/// and allocated one otherwise.
+#[inline]
+pub fn record_frame_buffer(reused: bool) {
+    if !enabled() {
+        return;
+    }
+    FRAME_RUN.with(|f| {
+        let mut t = f.get();
+        t.buffers_reused += u64::from(reused);
+        t.buffers_allocated += u64::from(!reused);
+        f.set(t);
+    });
+}
+
+/// A finished frame's buffer was kept for a later frame.
+#[inline]
+pub fn record_frame_recycled() {
+    if !enabled() {
+        return;
+    }
+    FRAME_RUN.with(|f| {
+        let mut t = f.get();
+        t.buffers_recycled += 1;
+        f.set(t);
+    });
+}
+
+/// An asynchronous send built its callee frame, holding its arguments only
+/// in that frame when `held`.
+#[inline]
+pub fn record_async_frame(held: bool) {
+    if !enabled() {
+        return;
+    }
+    FRAME_RUN.with(|f| {
+        let mut t = f.get();
+        t.async_frames += 1;
+        t.args_held_in_frame += u64::from(held);
+        f.set(t);
+    });
+}
+
+/// A re-delivery kept the record's frame instead of rebuilding it.
+#[inline]
+pub fn record_reset_frame_kept() {
+    if !enabled() {
+        return;
+    }
+    FRAME_RUN.with(|f| {
+        let mut t = f.get();
+        t.resets_kept_frame += 1;
+        f.set(t);
+    });
+}
