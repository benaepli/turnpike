+/// timer, a channel send or a parked record and read later as vertex ids, so
+/// they keep their vertex.
+fn thread_successors(ops: &[Op]) -> Vec<Op> {
+    let t = |v: &mut u32| *v = working_vertex(ops, *v);
+    ops.iter()
+        .map(|op| {
