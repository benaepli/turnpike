+/// Requires a run of threaded operations to leave exactly what the run of
+/// plain operations left, with every interpreter count equal except that the
+/// label executions fall by the skipped stores, folded stores and gotos not
+/// executed. Returns the label executions saved.
+fn assert_threaded_agrees(
+    ops: &[Op],
+    plain: &(Seen, InterpreterTally, LocalCoverage),
+    threaded: &(Seen, InterpreterTally, LocalCoverage),
+    context: &str,
+) -> u64 {
+    let ((a, x, edges_x), (b, y, edges_y)) = (plain, threaded);
+    assert_eq!(a, b, "{context}");
+    assert_eq!(
+        [x.legacy_labels, x.leaf_operands_inline, x.tree_evals, x.legacy_evals],
+        [y.legacy_labels, y.leaf_operands_inline, y.tree_evals, y.legacy_evals],
+        "{context}"
+    );
+    assert_eq!(
+        [x.call_targets_indexed, x.call_targets_fallback, x.prints_fused, x.print_trees_folded],
+        [y.call_targets_indexed, y.call_targets_fallback, y.prints_fused, y.print_trees_folded],
+        "{context}"
+    );
+    let (gotos_plain, gotos_threaded) = (goto_executions(ops, edges_x), goto_executions(ops, edges_y));
+    assert!(x.label_execs >= y.label_execs, "{context}");
+    assert_eq!(
+        x.label_execs - y.label_execs,
+        (x.stores_skipped - y.stores_skipped) + (x.stores_folded - y.stores_folded) + gotos_plain - gotos_threaded,
+        "{context}: label executions {} -> {}, skipped {} -> {}, folded {} -> {}, gotos {gotos_plain} -> {gotos_threaded}",
+        x.label_execs,
+        y.label_execs,
+        x.stores_skipped,
+        y.stores_skipped,
+        x.stores_folded,
+        y.stores_folded
+    );
+    x.label_execs - y.label_execs
+}
