+/// The pcs a loop visits following successors of operations that only move
+/// on or assign a node slot.
+fn walk(ops: &[Op], start: usize, steps: usize) -> Vec<usize> {
+    let mut pcs = Vec::with_capacity(steps);
+    let mut pc = start;
+    for _ in 0..steps {
+        pcs.push(pc);
+        pc = match &ops[pc] {
+            Op::AssignNode { next, .. } | Op::Goto(next) | Op::StoreSkipped(next) | Op::StoreFolded(next) => {
+                *next as usize
+            }
+            other => panic!("vertex {pc}: {other:?} is not in the cycle program"),
+        };
+    }
+    pcs
+}
