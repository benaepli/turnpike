+/// `program` decoded with rewrites after adding a function entry at each
+/// start that has none, since execution may only start at an entry.
+fn decoded_with_entries(program: &Program, starts: &[usize], slots: usize) -> Program {
+    let mut on = program.clone();
+    for (i, &start) in starts.iter().enumerate() {
+        if !on.rpc.values().any(|f| f.entry == start) {
+            register(&mut on, &format!("__start{i}"), function(start, 950 + i, 0, slots as u32, false));
+        }
+    }
+    on.compiled = CompiledProgram::build_with(&on, Rewrites::On);
+    on
+}
+
+fn with_entry_program(mut p: ParkProgram) -> ParkProgram {
+    p.program = decoded_on(&p.program, p.start, 5);
+    p
+}
