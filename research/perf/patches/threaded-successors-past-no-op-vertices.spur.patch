+            match &mut op {
+                Op::AssignLocal { next, .. }
+                | Op::AssignNode { next, .. }
+                | Op::MakeChannel { next, .. }
+                | Op::MakeFifoLink { next, .. }
+                | Op::UniqueId { next, .. }
+                | Op::Print { next, .. }
+                | Op::PersistData { next, .. }
+                | Op::RetrieveData { next, .. }
+                | Op::PrintParts { next, .. }
+                | Op::SpinAwait { next, .. }
