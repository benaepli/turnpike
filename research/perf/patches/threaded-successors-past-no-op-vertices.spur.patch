+/// A vertex of `program` holding an operation of `kind`, preferring one whose
+/// stored successor only moves on.
+fn stored_vertex(program: &Program, kind: &str) -> Option<usize> {
+    let c = &program.compiled;
+    let candidates: Vec<usize> = (0..c.ops.len()).filter(|&v| is_stored_kind(&c.ops[v], kind)).collect();
+    let onto_chain = candidates.iter().copied().find(|&v| {
+        let mut op = c.ops[v].clone();
+        let next = *stored_next(&mut op).expect("a stored successor") as usize;
+        moves_only(&c.ops[next]) && c.working[next] as usize != next
+    });
+    onto_chain.or(candidates.first().copied())
+}
