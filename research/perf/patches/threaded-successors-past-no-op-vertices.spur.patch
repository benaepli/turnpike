+/// A synchronous call starts its callee at the callee's entry on a loop that
+/// records transitions and at the entry's working vertex otherwise; a callee
+/// not resolved when the program was decoded starts at its entry on both.
+#[test]
+fn sync_calls_start_at_the_working_vertex_only_when_no_transition_is_recorded() {
+    let mut builder = TestProgramBuilder::new();
+    let f_ret = builder.add(Label::Return(var(1)));
+    let f_body = builder.add(Label::Instr(
+        Instr::Assign(
+            Lhs::Var(slot(1)),
+            Expr::Plus(Box::new(var(0)), Box::new(Expr::Int(1))),
+        ),
+        f_ret,
+    ));
+    let f_goto = builder.add(Label::Continue(f_body));
+    let f_skip = dead_store(&mut builder, 1, f_goto);
+    let g_ret = builder.add(Label::Return(Expr::Int(7)));
+    let g_goto = builder.add(Label::Continue(g_ret));
+    let g_skip = dead_store(&mut builder, 0, g_goto);
+    let ret = builder.add(Label::Return(var(0)));
+    let call = builder.add(Label::Instr(
+        Instr::SyncCall(Lhs::Var(slot(0)), "f".to_string(), vec![Expr::Int(41)]),
+        ret,
+    ));
+    let missing = builder.add(Label::Instr(
+        Instr::SyncCall(Lhs::Var(slot(0)), "missing".to_string(), vec![]),
+        ret,
+    ));
+    let late = builder.add(Label::Instr(
+        Instr::SyncCall(Lhs::Var(slot(0)), "g".to_string(), vec![]),
+        ret,
+    ));
+    let mut program = builder.build_undecoded();
+    register(&mut program, "f", function(f_skip, 5, 1, 2, true));
+    register(&mut program, "caller", function(call, 6, 0, 1, false));
+    register(&mut program, "caller_missing", function(missing, 7, 0, 1, false));
+    register(&mut program, "caller_late", function(late, 8, 0, 1, false));
+    program.decode();
+    let c = &program.compiled;
+    assert!(check::check_threaded(&program, &c.ops, &c.threaded_ops, &c.working).is_empty());
+    let entry = |ops: &[Op], v: usize| match &ops[v] {
+        Op::SyncCall(call) => call.entry,
+        other => panic!("vertex {v}: {other:?} is not a call"),
+    };
+    assert_eq!(entry(&c.ops, call) as usize, f_skip);
+    assert_eq!(entry(&c.threaded_ops, call) as usize, f_body);
+    assert_eq!(c.working[f_skip] as usize, f_body);
+    for v in [missing, late] {
+        assert_eq!(entry(&c.ops, v), UNRESOLVED_CALLEE);
+        assert_eq!(entry(&c.threaded_ops, v), UNRESOLVED_CALLEE);
+    }
+    register(&mut program, "g", function(g_skip, 9, 0, 2, true));
+    let c = &program.compiled;
+    let edge_from = |local: &LocalCoverage, v: usize| local.edges().keys().any(|(from, _)| *from == v);
+
+    let runs = |start: usize| {
+        (
+            run_alone::<CfgFeedback>(|r| r.record(&program, record_at(start, 1))),
+            run_alone::<ThreadedEdges>(|r| r.record(&program, record_at(start, 1))),
+            run_alone::<NoFeedback>(|r| r.record(&program, record_at(start, 1))),
+        )
+    };
+
+    let (plain, threaded, none) = runs(call);
+    assert!(plain.0.results[0].contains("Int(42)"), "{:?}", plain.0.results);
+    assert!(edge_from(&plain.2, f_skip) && edge_from(&plain.2, f_goto));
+    assert!(!edge_from(&threaded.2, f_skip) && !edge_from(&threaded.2, f_goto));
+    assert_eq!(assert_threaded_agrees(&c.ops, &plain, &threaded, "call"), 2);
+    assert_eq!((none.0, none.1), (threaded.0, threaded.1));
+
+    let mut env = Env::<WithHashing>::with_slots(2);
+    env.set(0, Value::int(41));
+    let plain = run_alone::<CfgFeedback>(|r| r.sync(&program, env.clone(), node_zero(), f_skip));
+    let threaded = run_alone::<ThreadedEdges>(|r| r.sync(&program, env, node_zero(), f_skip));
+    assert!(edge_from(&plain.2, f_skip));
+    assert!(!edge_from(&threaded.2, f_skip));
+    assert_eq!(assert_threaded_agrees(&c.ops, &plain, &threaded, "sync run"), 2);
+
+    let (plain, threaded, _) = runs(missing);
+    assert!(plain.0.results[0].contains("function not found: missing"), "{:?}", plain.0.results);
+    assert_eq!(assert_threaded_agrees(&c.ops, &plain, &threaded, "missing callee"), 0);
+
+    let (plain, threaded, none) = runs(late);
+    assert!(plain.0.results[0].contains("Int(7)"), "{:?}", plain.0.results);
+    assert_eq!(plain.1.call_targets_fallback, 1);
+    assert!(edge_from(&threaded.2, g_skip), "{:?}", threaded.2.edges());
+    assert_eq!(threaded.1.stores_skipped, 1);
+    assert_eq!(assert_threaded_agrees(&c.ops, &plain, &threaded, "callee resolved by name"), 1);
+    assert_eq!((none.0, none.1), (threaded.0, threaded.1));
+}
