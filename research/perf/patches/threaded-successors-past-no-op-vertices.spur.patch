+/// The first vertex from `v` along skipped stores, folded stores and gotos
+/// that is none of those, or `v` when that walk returns to a vertex it
+/// passed. A successor outside `ops` ends the walk there.
+fn working_vertex(ops: &[Op], v: u32) -> u32 {
+    let mut cur = v;
+    for _ in 0..ops.len() {
+        match ops.get(cur as usize) {
+            Some(Op::StoreSkipped(n) | Op::StoreFolded(n) | Op::Goto(n)) => cur = *n,
+            _ => return cur,
+        }
+    }
+    v
+}
