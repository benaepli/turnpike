+/// A sequence of executions on one state under strategy `F`.
+struct Run<F: Feedback> {
+    state: State<WithHashing>,
+    logger: TestLogger,
+    snapshot: F::Snapshot,
+    local: F::Local,
+    results: Vec<String>,
+    events_before: [u64; 3],
+    tally_before: InterpreterTally,
+}
+
+impl<F: Feedback> Run<F> {
+    fn new(role: NameId, node_slots: usize) -> Self {
+        Self {
+            state: State::<WithHashing>::new(&[(role, 2)], node_slots),
+            logger: TestLogger::new(),
+            snapshot: F::snapshot(&F::Global::default()),
+            local: F::Local::default(),
+            results: Vec::new(),
+            events_before: util_stats::pending_evaluator_events(),
+            tally_before: util_stats::pending_interpreter_tally(),
+        }
+    }
+
+    fn record(&mut self, program: &Program, record: Record<WithHashing>) {
+        let result = exec::<WithHashing, TestLogger, F>(
+            &mut self.state,
+            &mut self.logger,
+            program,
+            record,
+            &self.snapshot,
+            &mut self.local,
+            &SchedulePolicy::Fixed,
+            &PurgatoryConfig::default(),
+            &mut SmallRng::seed_from_u64(0),
+        );
+        self.results.push(match result {
+            Ok(Some(op)) => format!("value {:?}", op.value),
+            Ok(None) => "yielded".to_string(),
+            Err(e) => format!("error {e} / {e:?}"),
+        });
+    }
+
+    fn sync(&mut self, program: &Program, mut env: Env<WithHashing>, node: NodeId, start: usize) {
+        let result = exec_sync_on_node::<WithHashing, TestLogger, F>(
+            &mut self.state,
+            &mut self.logger,
+            program,
+            &mut env,
+            node,
+            start,
+            &self.snapshot,
+            &mut self.local,
+            &SchedulePolicy::Fixed,
+            &PurgatoryConfig::default(),
+            &mut SmallRng::seed_from_u64(0),
+        );
+        self.results.push(match result {
+            Ok(v) => format!("value {v:?} frame {env:?}"),
+            Err(e) => format!("error {e} / {e:?} frame {env:?}"),
+        });
+    }
+
+    /// Takes the first record queued on any node.
+    fn pop_local(&mut self) -> Option<Record<WithHashing>> {
+        for q in &mut self.state.local_queues {
+            if let Some(i) = q.iter().position(|r| matches!(r, Runnable::Record(_))) {
+                if let Runnable::Record(record) = q.remove(i) {
+                    return Some(record);
+                }
+            }
+        }
+        None
+    }
+
+    fn finish(self) -> (Seen, InterpreterTally, F::Local) {
+        let events = util_stats::pending_evaluator_events();
+        let seen = Seen {
+            results: self.results,
+            logs: self
+                .logger
+                .entries
+                .iter()
+                .enumerate()
+                .map(|(i, e)| format!("{:?} {} {}", e.node, e.step, self.logger.content(i)))
+                .collect(),
+            trace_text: self.logger.trace_text.str_from(0).to_string(),
+            traces: self.logger.traces.iter().map(|t| format!("{t:?}")).collect(),
+            state: format!("{:?}", self.state),
+            events: [
+                events[0] - self.events_before[0],
+                events[1] - self.events_before[1],
+                events[2] - self.events_before[2],
+            ],
+        };
+        (seen, tally_since(self.tally_before), self.local)
+    }
+}
