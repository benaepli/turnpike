+                Op::ForLoopIn(fl) => {
+                    t(&mut fl.body);
+                    t(&mut fl.next);
+                }
+                Op::TraceDispatch(td) => t(&mut td.next),
+                Op::TraceEnter(te) => t(&mut te.next),
+                Op::TraceExit(tx) => t(&mut tx.next),
+                Op::SetTimer { .. } | Op::Send(_) | Op::Recv(_) | Op::Pause(_) | Op::Return(_) => {}
+            }
+            op
+        })
