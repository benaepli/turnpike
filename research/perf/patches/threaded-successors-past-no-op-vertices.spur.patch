+/// Everything a sequence of executions left behind that a strategy must not
+/// change.
+#[derive(Debug, PartialEq)]
+struct Seen {
+    results: Vec<String>,
+    logs: Vec<String>,
+    trace_text: String,
+    traces: Vec<String>,
+    state: String,
+    events: [u64; 3],
+}
