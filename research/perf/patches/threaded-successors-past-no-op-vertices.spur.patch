+/// A store to `slot` of `value` that the store after `next` makes unread.
+fn dead_store(builder: &mut TestProgramBuilder, slot_idx: u32, next: usize) -> usize {
+    builder.add(Label::Instr(Instr::Assign(Lhs::Var(slot(slot_idx)), Expr::Int(-1)), next))
+}
+
+struct ParkProgram {
+    program: Program,
+    start: usize,
+    after_pause: usize,
+    after_pause_work: usize,
+    after_recv: usize,
+    after_recv_work: usize,
+    spin: usize,
+}
+
+/// A record that pauses, blocks on a receive and waits on a spin-await, each
+/// followed by a skipped store and a goto before the next store.
+fn park_program() -> ParkProgram {
+    let mut builder = TestProgramBuilder::new();
+    let ret = builder.add(Label::Return(var(4)));
+    let print4 = builder.add(Label::Print(var(4), ret));
+    let e3 = builder.add(Label::Instr(Instr::Assign(Lhs::Var(slot(4)), var(1)), print4));
+    let e2 = builder.add(Label::Continue(e3));
+    let e1 = dead_store(&mut builder, 4, e2);
+    let spin = builder.add(Label::SpinAwait(Expr::Var(node_slot(0)), e1));
+    let print3 = builder.add(Label::Print(var(3), spin));
+    let d3 = builder.add(Label::Instr(Instr::Assign(Lhs::Var(slot(3)), Expr::Int(2)), print3));
+    let d2 = builder.add(Label::Continue(d3));
+    let d1 = dead_store(&mut builder, 3, d2);
+    let recv = builder.add(Label::Recv(Lhs::Var(slot(1)), var(0), d1));
+    let print2 = builder.add(Label::Print(var(2), recv));
+    let c3 = builder.add(Label::Instr(Instr::Assign(Lhs::Var(slot(2)), Expr::Int(8)), print2));
+    let c2 = builder.add(Label::Continue(c3));
+    let c1 = dead_store(&mut builder, 2, c2);
+    let pause = builder.add(Label::Pause(c1));
+    let make = builder.add(Label::MakeChannel(Lhs::Var(slot(0)), None, pause));
+    ParkProgram {
+        program: builder.build(),
+        start: make,
+        after_pause: c1,
+        after_pause_work: c3,
+        after_recv: d1,
+        after_recv_work: d3,
+        spin,
+    }
+}
+
+/// Runs the park program to completion, returning the pc each park stored.
+fn park_and_resume<F: Feedback>(program: &Program, start: usize) -> ((Seen, InterpreterTally, F::Local), Vec<usize>) {
+    let mut run = Run::<F>::new(NameId(0), 2);
+    let mut pcs = Vec::new();
+    run.state.nodes[0].set(0, Value::bool(false));
+    run.record(program, record_at(start, 5));
+    let paused = run.pop_local().expect("the pause queues the record");
+    pcs.push(paused.pc);
+    run.record(program, paused);
+    let cid = *run.state.channels.keys().next().expect("the record made a channel");
+    let (mut reader, lhs) = run
+        .state
+        .channels
+        .get_mut(&cid)
+        .expect("the channel exists")
+        .pop_waiting_reader()
+        .expect("the receive blocks");
+    pcs.push(reader.pc);
+    let mut node_env = run.state.nodes[0].clone();
+    crate::simulator::core::eval::store(&lhs, Value::int(5), &mut reader.env, &mut node_env).expect("the store");
+    run.state.nodes[0] = node_env;
+    run.record(program, reader);
+    let waiting = run.pop_local().expect("the spin-await queues the record");
+    pcs.push(waiting.pc);
+    run.state.nodes[0].set(0, Value::bool(true));
+    run.record(program, waiting);
+    (run.finish(), pcs)
+}
+
+/// Parking at a pause, a receive and a spin-await stores the vertex a plain
+/// loop stores, though what follows it only moves on, and the resumed
+/// segments leave everything alike.
+#[test]
+fn records_park_and_resume_alike_before_vertices_that_only_move_on() {
+    let p = with_entry_program(park_program());
+    let c = &p.program.compiled;
+    for v in [p.after_pause, p.after_recv] {
+        assert!(matches!(c.ops[v], Op::StoreSkipped(_)), "vertex {v}: {:?}", c.ops[v]);
+    }
+    assert_eq!(c.working[p.after_pause] as usize, p.after_pause_work);
+    assert_eq!(c.working[p.after_recv] as usize, p.after_recv_work);
+    assert!(check::check_threaded(&p.program, &c.ops, &c.threaded_ops, &c.working).is_empty());
+    let (plain, plain_pcs) = park_and_resume::<CfgFeedback>(&p.program, p.start);
+    let (threaded, threaded_pcs) = park_and_resume::<ThreadedEdges>(&p.program, p.start);
+    assert_eq!(plain_pcs, vec![p.after_pause, p.after_recv, p.spin]);
+    assert_eq!(threaded_pcs, plain_pcs);
+    assert!(plain.0.results.last().is_some_and(|r| r.contains("Int(5)")), "{:?}", plain.0.results);
+    assert_eq!(assert_threaded_agrees(&c.ops, &plain, &threaded, "park"), 6);
+    let (none, none_pcs) = park_and_resume::<NoFeedback>(&p.program, p.start);
+    assert_eq!((none.0, none.1, none_pcs), (threaded.0, threaded.1, threaded_pcs));
+
+    let mut off = p.program.clone();
+    off.compiled = CompiledProgram::build_with(&off, Rewrites::Off);
+    let (plain_off, _) = park_and_resume::<CfgFeedback>(&off, p.start);
+    let (none_off, _) = park_and_resume::<NoFeedback>(&off, p.start);
+    assert_eq!((none_off.0, none_off.1), (plain_off.0, plain_off.1));
+}
