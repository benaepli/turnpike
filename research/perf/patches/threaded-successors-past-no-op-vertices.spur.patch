+/// Each way of threading wrongly is rejected at the vertex it breaks: a
+/// successor moved past its working vertex or left on a vertex that only
+/// moves on, a stored successor threaded, a working vertex or a call entry
+/// naming another working vertex, a field other than a successor changed,
+/// and a goto cycle whose threaded target leaves the cycle.
+#[test]
+fn the_threaded_checker_rejects_broken_threading() {
+    on_big_stack(|| {
+        let program = compile_spec(&spec_root().join("VR.spur")).expect("VR compiles");
+        let c = &program.compiled;
+        let (ops, threaded, working) = (&c.ops, &c.threaded_ops, &c.working);
+        let n = ops.len();
+        assert!(check_threaded(&program, ops, threaded, working).is_empty());
+
+        let bypassing = (0..n)
+            .find(|&v| match (&ops[v], &threaded[v]) {
+                (Op::AssignLocal { next: p, .. }, Op::AssignLocal { next: t, .. }) => {
+                    p != t && first_successor(&program, ops, *t as usize).is_some_and(|s| s != *t as usize)
+                }
+                _ => false,
+            })
+            .expect("VR threads an assignment past a vertex that only moves on");
+        let (Op::AssignLocal { next: plain_next, .. }, Op::AssignLocal { next: threaded_next, .. }) =
+            (&ops[bypassing], &threaded[bypassing])
+        else {
+            unreachable!("found as an assignment")
+        };
+        let (plain_next, threaded_next) = (*plain_next, *threaded_next);
+
+        let mut t = threaded.clone();
+        let past = first_successor(&program, ops, threaded_next as usize).expect("the working vertex moves on");
+        if let Op::AssignLocal { next, .. } = &mut t[bypassing] {
+            *next = past as u32;
+        }
+        assert_rejected_at(&program, ops, &t, working, bypassing, "(a) a successor moved past its working vertex");
+
+        let mut t = threaded.clone();
+        if let Op::AssignLocal { next, .. } = &mut t[bypassing] {
+            *next = plain_next;
+        }
+        assert_rejected_at(&program, ops, &t, working, bypassing, "(d) a successor left on a vertex that only moves on");
+
+        let mut files = Vec::new();
+        spec_files(&spec_root(), &mut files);
+        files.sort();
+        let mut others = files.iter().filter(|f| !f.ends_with("VR.spur")).filter_map(|f| compile_spec(f));
+        let mut paused = program.clone();
+        let chain_head = (0..n)
+            .find(|&v| moves_only(&ops[v]) && working[v] as usize != v)
+            .expect("VR has a vertex that only moves on");
+        paused.cfg.graph.push(Label::Pause(chain_head));
+        paused.compiled.ops.push(Op::Pause(chain_head as u32));
+        paused.compiled.threaded_ops.push(Op::Pause(chain_head as u32));
+        paused.compiled.working.push(n as u32);
+        let pc = &paused.compiled;
+        assert!(check_threaded(&paused, &pc.ops, &pc.threaded_ops, &pc.working).is_empty());
+        let mut pool = vec![program.clone(), paused];
+        for kind in ["receive", "pause", "set timer", "send"] {
+            let (p, v) = loop {
+                if let Some(hit) = pool.iter().find_map(|p| stored_vertex(p, kind).map(|v| (p, v))) {
+                    break hit;
+                }
+                pool.push(others.next().unwrap_or_else(|| panic!("no spec holds a {kind}")));
+            };
+            let pc = &p.compiled;
+            let mut t = pc.threaded_ops.clone();
+            let next = stored_next(&mut t[v]).expect("a stored successor");
+            let old = *next;
+            let moved = pc.working[old as usize];
+            *next = if moved != old { moved } else { (old + 1) % pc.ops.len() as u32 };
+            let failures = check_threaded(p, &pc.ops, &t, &pc.working);
+            assert!(
+                failures.iter().any(|f| f.starts_with(&format!("vertex {v}: {kind} changed"))),
+                "(b, c) a threaded {kind} successor at {v} was accepted: {failures:?}"
+            );
+        }
+
+        let v = (0..n).find(|&v| working[v] as usize != v).expect("VR has a vertex that only moves on");
+        let other = (0..n)
+            .find(|&w| !moves_only(&ops[w]) && w != working[v] as usize)
+            .expect("VR has another working vertex");
+        let mut w = working.clone();
+        w[v] = other as u32;
+        assert_rejected_at(&program, ops, threaded, &w, v, "(e) a working vertex naming another working vertex");
+
+        let calls: Vec<(usize, u32)> = (0..n)
+            .filter_map(|v| match &ops[v] {
+                Op::SyncCall(call) if call.entry != UNRESOLVED_CALLEE => Some((v, call.entry)),
+                _ => None,
+            })
+            .collect();
+        let (call_v, entry) = calls[0];
+        let other_entry = calls
+            .iter()
+            .map(|(_, e)| working[*e as usize])
+            .find(|w| *w != working[entry as usize])
+            .expect("VR calls two callees");
+        let mut t = threaded.clone();
+        if let Op::SyncCall(call) = &mut t[call_v] {
+            call.entry = other_entry;
+        }
+        assert_rejected_at(&program, ops, &t, working, call_v, "(f) a call entry naming another callee");
+
+        let mut t = threaded.clone();
+        if let Op::AssignLocal { slot, .. } = &mut t[bypassing] {
+            *slot += 1;
+        }
+        assert_rejected_at(&program, ops, &t, working, bypassing, "(g) a field other than a successor changed");
+
+        let mut cyclic = program.clone();
+        let (a, b) = (n, n + 1);
+        cyclic.cfg.graph.push(Label::Continue(b));
+        cyclic.cfg.graph.push(Label::Continue(a));
+        let mut cyclic_ops = ops.clone();
+        cyclic_ops.extend([Op::Goto(b as u32), Op::Goto(a as u32)]);
+        let mut t = threaded.clone();
+        t.extend([Op::Goto(b as u32), Op::Goto(a as u32)]);
+        let mut w = working.clone();
+        w.extend([a as u32, b as u32]);
+        assert!(check_threaded(&cyclic, &cyclic_ops, &t, &w).is_empty());
+        t[b] = Op::Goto(threaded_next);
+        assert_rejected_at(&cyclic, &cyclic_ops, &t, &w, b, "(h) a goto cycle threaded out of the cycle");
+    });
+}
