+        let threaded = run_alone::<ThreadedEdges>(|r| r.sync(&program, Env::with_slots(2), node_zero(), start));
+        assert!(plain.0.results[0].contains("TypeError"), "{:?}", plain.0.results);
+        assert_threaded_agrees(&c.ops, &plain, &threaded, &format!("sync run from {start}"));
+    }
