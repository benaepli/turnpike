+/// The name of an operation whose successor a timer, a channel send or a
+/// parked record stores, or of a return.
+fn stored_kind(op: &Op) -> Option<&'static str> {
+    match op {
+        Op::SetTimer { .. } => Some("set timer"),
+        Op::Send(_) => Some("send"),
+        Op::Recv(_) => Some("receive"),
+        Op::Pause(_) => Some("pause"),
+        Op::Return(_) => Some("return"),
+        _ => None,
+    }
+}
+
+fn moves_only(op: &Op) -> bool {
+    matches!(op, Op::StoreSkipped(_) | Op::StoreFolded(_) | Op::Goto(_))
+}
+
+/// Where a loop running threaded operations lands when it moves to `t`: the
+/// first vertex along label successors from `t`, over vertices whose plain
+/// operation is a skipped store, a folded store or a goto, that is none of
+/// those; and the vertices passed, in order. `t` with none passed when that
+/// walk returns to a vertex it passed. Fails a passed vertex whose operation
+/// successor is not its label successor.
+fn landing(program: &Program, ops: &[Op], t: usize, failures: &mut Vec<String>) -> (usize, Vec<usize>) {
+    let mut passed = Vec::new();
+    let mut seen = BTreeSet::new();
+    let mut cur = t;
+    while cur < ops.len() && moves_only(&ops[cur]) {
+        if !seen.insert(cur) {
+            return (t, Vec::new());
+        }
+        let by_label = program.cfg.graph.get(cur).and_then(|l| super::super::frame_layout::successors(l)[0]);
+        let by_op = accesses(program, ops, cur).1.first().map(|(target, _)| *target);
+        let Some(next) = by_label else {
+            failures.push(format!("vertex {cur}: moves on from a label with no successor"));
+            return (cur, passed);
+        };
+        if by_op != Some(next) {
+            failures.push(format!("vertex {cur}: operation successor {by_op:?} is not label successor {next}"));
+        }
+        passed.push(cur);
+        cur = next;
+    }
+    (cur, passed)
+}
+
+fn carry(inn: &BTreeSet<u32>, written: &[u32], differs: &[u32]) -> BTreeSet<u32> {
+    let mut out = inn.clone();
+    for s in written {
+        out.remove(s);
+    }
+    out.extend(differs.iter().copied());
+    out
+}
+
+/// Checks `threaded` and `working` against `ops`, the decoded form of
+/// `program` they were derived from, by walking label successors rather than
+/// the derivation:
+/// every threaded operation equals its plain operation outside its followed
+/// successors; each followed successor and each resolved call entry lands
+/// where the plain operations would run the next vertex that does work, and
+/// stays put on a cycle of vertices that only move on; stored successors and
+/// returns are unchanged; `working` of each vertex is where a segment
+/// starting there does work; and the analysis of `analyze`, run over the
+/// threaded edges with each edge carrying the slots its passed vertices make
+/// differ and each function starting at its working vertex, fails no read
+/// and finds the differing slots of the plain analysis at every vertex.
+pub(crate) fn check_threaded(program: &Program, ops: &[Op], threaded: &[Op], working: &[u32]) -> Vec<String> {
+    let n = ops.len();
+    let mut failures = Vec::new();
+    if threaded.len() != n || working.len() != n {
+        failures.push(format!(
+            "threaded operations {} and working vertices {} for {n} operations",
+            threaded.len(),
+            working.len()
+        ));
+        return failures;
+    }
+    let mut walk = Vec::new();
+    for v in 0..n {
+        let (plain, thr) = (&ops[v], &threaded[v]);
+        if let Some(kind) = stored_kind(plain) {
+            if thr != plain {
+                failures.push(format!("vertex {v}: {kind} changed from {plain:?} to {thr:?}"));
+            }
+        } else if without_followed(plain) != without_followed(thr) {
+            failures.push(format!("vertex {v}: {thr:?} differs from {plain:?} outside its followed successors"));
+        }
+        let (pf, tf) = (followed(plain), followed(thr));
+        if pf.len() != tf.len() {
+            failures.push(format!("vertex {v}: {} followed successors threaded as {}", pf.len(), tf.len()));
+        } else {
+            for (i, (p, t)) in pf.iter().zip(&tf).enumerate() {
+                let (land, _) = landing(program, ops, *p as usize, &mut walk);
+                if *t as usize != land {
+                    failures.push(format!("vertex {v}: followed successor {i} moves to {t}, where {p} lands at {land}"));
+                }
+            }
+        }
+        let (land, _) = landing(program, ops, v, &mut walk);
+        if working[v] as usize != land {
+            failures.push(format!("vertex {v}: working vertex {}, where it lands at {land}", working[v]));
+        }
+        if let Op::SyncCall(call) = plain {
+            let resolved = program
+                .func_name_to_id
+                .get(&call.name)
+                .and_then(|id| program.rpc.get(id))
+                .map(|f| f.entry);
+            match (resolved, call.entry) {
+                (None, UNRESOLVED_CALLEE) => {}
+                (Some(e), entry) if entry as usize == e => {}
+                (resolved, entry) => failures.push(format!(
+                    "vertex {v}: call entry {entry} for callee {} starting at {resolved:?}",
+                    call.name
+                )),
+            }
+            if let Op::SyncCall(tcall) = thr {
+                if call.entry != UNRESOLVED_CALLEE {
+                    let (land, _) = landing(program, ops, call.entry as usize, &mut walk);
+                    if tcall.entry as usize != land {
+                        failures.push(format!(
+                            "vertex {v}: call entry moves to {}, where callee entry {} lands at {land}",
+                            tcall.entry, call.entry
+                        ));
+                    }
+                }
+            }
+        }
+    }
+    walk.sort();
+    walk.dedup();
+    failures.extend(walk);
+    failures.extend(threaded_analysis_failures(program, ops, threaded, working));
+    failures
+}
+
+/// The analysis of `analyze` over threaded edges, compared with the plain
+/// analysis. A vertex a threaded edge passes holds the slots differing where
+/// the plain operations would run it.
+fn threaded_analysis_failures(program: &Program, ops: &[Op], threaded: &[Op], working: &[u32]) -> Vec<String> {
+    let n = ops.len();
+    let entries = entries(program);
+    let mut failures = Vec::new();
+    let mut ignored = Vec::new();
+    let plain = analyze(program, ops, &entries);
+    let mut plain_steps: Vec<Step> = (0..n).map(|v| step(program, ops, v, &mut ignored)).collect();
+    let piece_reads = check_folded_prints(program, ops, &entries, &mut plain_steps, &mut ignored);
+    let steps: Vec<Step> = (0..n).map(|v| step(program, threaded, v, &mut ignored)).collect();
+    let mut hops: Vec<Vec<(usize, Vec<u32>, Vec<u32>, Vec<usize>)>> = Vec::with_capacity(n);
+    for v in 0..n {
+        let (p, t) = (&plain_steps[v], &steps[v]);
+        if p.edges.len() != t.edges.len() {
+            failures.push(format!("vertex {v}: {} threaded edges for {} plain edges", t.edges.len(), p.edges.len()));
+            hops.push(Vec::new());
+            continue;
+        }
+        let mut out = Vec::new();
+        for (pe, te) in p.edges.iter().zip(&t.edges) {
+            let mut passed = Vec::new();
+            if te.target != pe.target {
+                let (_, walked) = landing(program, ops, pe.target, &mut ignored);
+                passed = walked.into_iter().take_while(|u| *u != te.target).collect();
+            }
+            out.push((te.target, te.written.clone(), pe.differs.clone(), passed));
+        }
+        hops.push(out);
+    }
+    let mut differing_in: Vec<Option<BTreeSet<u32>>> = vec![None; n];
+    let mut passed_in: Vec<Option<BTreeSet<u32>>> = vec![None; n];
+    let mut work: Vec<usize> = Vec::new();
+    let pass = |passed_in: &mut Vec<Option<BTreeSet<u32>>>, out: BTreeSet<u32>, passed: &[usize]| {
+        let mut out = out;
+        for &u in passed {
+            let slot = passed_in[u].get_or_insert_with(BTreeSet::new);
+            slot.extend(out.iter().copied());
+            let e = &plain_steps[u].edges[0];
+            out = carry(&out, &e.written, &e.differs);
+        }
+        out
+    };
+    for &e in &entries {
+        if e >= n {
+            continue;
+        }
+        let (_, walked) = landing(program, ops, e, &mut ignored);
+        let start = working[e] as usize;
+        let passed: Vec<usize> = walked.into_iter().take_while(|u| *u != start).collect();
+        let out = pass(&mut passed_in, BTreeSet::new(), &passed);
+        if start >= n {
+            failures.push(format!("vertex {e}: working vertex {start} outside the graph"));
+            continue;
+        }
+        let merged = match &differing_in[start] {
+            None => out,
+            Some(old) if out.is_subset(old) => continue,
+            Some(old) => old.union(&out).copied().collect(),
+        };
+        differing_in[start] = Some(merged);
+        work.push(start);
+    }
+    while let Some(v) = work.pop() {
+        let Some(inn) = differing_in[v].clone() else { continue };
+        for (target, written, differs, passed) in &hops[v] {
+            let out = pass(&mut passed_in, carry(&inn, written, differs), passed);
+            if *target >= n {
+                failures.push(format!("vertex {v}: threaded successor {target} outside the graph"));
+                continue;
+            }
+            let merged = match &differing_in[*target] {
+                None => out,
+                Some(old) if out.is_subset(old) => continue,
+                Some(old) => old.union(&out).copied().collect(),
+            };
+            differing_in[*target] = Some(merged);
+            work.push(*target);
+        }
+    }
+    let mut stored_targets = BTreeSet::new();
+    for v in 0..n {
+        if differing_in[v].is_some() && matches!(threaded[v], Op::SetTimer { .. } | Op::Send(_) | Op::Recv(_) | Op::Pause(_)) {
+            stored_targets.extend(steps[v].edges.iter().map(|e| e.target));
+        }
+    }
+    for (v, s) in steps.iter().enumerate() {
+        let Some(inn) = &differing_in[v] else { continue };
+        for r in &s.reads {
+            if inn.contains(r) && !s.written_first.contains(r) {
+                failures.push(format!("vertex {v}: reads slot {r}, whose value may differ on threaded edges"));
+            }
+        }
+    }
+    let combined: Vec<Option<BTreeSet<u32>>> = (0..n)
+        .map(|v| match (&differing_in[v], &passed_in[v]) {
+            (None, None) => None,
+            (a, b) => Some(a.iter().chain(b.iter()).flatten().copied().collect()),
+        })
+        .collect();
+    for (head, p, slot) in piece_reads {
+        if combined[head].as_ref().is_some_and(|inn| inn.contains(&slot)) {
+            failures.push(format!(
+                "vertex {p}: folded print reads slot {slot}, whose value may differ at chain head {head} on threaded edges"
+            ));
+        }
+    }
+    for v in 0..n {
+        if combined[v] != plain.differing_in[v] {
+            failures.push(format!(
+                "vertex {v}: differing slots {:?} on threaded edges, {:?} on plain edges",
+                combined[v], plain.differing_in[v]
+            ));
+        }
+        let executed = differing_in[v].is_some();
+        if moves_only(&ops[v]) {
+            if executed && working[v] as usize != v && !stored_targets.contains(&v) {
+                failures.push(format!("vertex {v}: runs on threaded edges though no stored successor reaches it"));
+            }
+        } else if plain.differing_in[v].is_some() && !executed {
+            failures.push(format!("vertex {v}: runs on plain edges but not on threaded edges"));
+        }
+    }
+    failures
+}
+
+/// Checks that a build without rewrites threads nothing.
+pub(crate) fn check_unthreaded(ops: &[Op], threaded: &[Op], working: &[u32]) -> Vec<String> {
+    let mut failures = Vec::new();
+    if threaded.len() != ops.len() || working.len() != ops.len() {
+        failures.push(format!(
+            "threaded operations {} and working vertices {} for {} operations",
+            threaded.len(),
+            working.len(),
+            ops.len()
+        ));
+        return failures;
+    }
+    for v in 0..ops.len() {
+        if threaded[v] != ops[v] {
+            failures.push(format!("vertex {v}: threaded as {:?} without rewrites", threaded[v]));
+        }
+        if working[v] as usize != v {
+            failures.push(format!("vertex {v}: working vertex {} without rewrites", working[v]));
+        }
+    }
+    failures
+}
