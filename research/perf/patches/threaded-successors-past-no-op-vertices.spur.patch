+/// A cycle of gotos, entered from a store and from a skipped store, keeps its
+/// vertices as working vertices, and a threaded loop visits the same pcs as
+/// a plain loop.
+#[test]
+fn a_cycle_of_gotos_spins_alike() {
+    let mut builder = TestProgramBuilder::new();
+    let a = builder.add(Label::Return(Expr::Unit));
+    let b = builder.add(Label::Continue(a));
+    builder.labels[a] = Label::Continue(b);
+    let x = builder.add(Label::Instr(Instr::Assign(Lhs::Var(node_slot(0)), Expr::Int(1)), a));
+    let y = builder.add(Label::Instr(Instr::Assign(Lhs::Var(slot(0)), Expr::Int(1)), b));
+    let program = decoded_with_entries(&builder.build(), &[x, y], 1);
+    let c = &program.compiled;
+    assert!(matches!(c.ops[y], Op::StoreSkipped(_)), "{:?}", c.ops[y]);
+    for v in [a, b, x, y] {
+        assert_eq!(c.working[v] as usize, v);
+    }
+    assert_eq!(c.threaded_ops[a], c.ops[a]);
+    assert_eq!(c.threaded_ops[b], c.ops[b]);
+    assert!(check::check_threaded(&program, &c.ops, &c.threaded_ops, &c.working).is_empty());
+    for start in [x, y, a, b] {
+        assert_eq!(
+            walk(&c.ops, start, 1000),
+            walk(&c.threaded_ops, c.working[start] as usize, 1000),
+            "from {start}"
+        );
+    }
+}
