+fn run_function<F: Feedback>(program: &Program, f: &FunctionInfo) -> (Seen, InterpreterTally, F::Local) {
+    let role = program.compiled.server_role.unwrap_or(NameId(0));
+    let node = NodeId { role, index: 0 };
+    let mut run = Run::<F>::new(role, program.max_node_slots.max(1) as usize);
+    let mut builder = FrameBuilder::<WithHashing>::new(f);
+    for _ in 0..f.param_count {
+        builder.push(Value::unit());
+    }
+    let env = builder.finish(f);
+    if f.is_sync {
+        run.sync(program, env, node, f.entry);
+    } else {
+        let mut record = make_record_for::<WithHashing>(
+            f.entry,
+            0,
+            Continuation::ClientOp {
+                client_id: 0,
+                op_name: "test".to_string(),
+                unique_id: 0,
+            },
+        );
+        record.env = env;
+        record.node = node;
+        record.origin_node = node;
+        record.entry_func = f.name;
+        run.record(program, record);
+    }
+    for _ in 0..FOLLOW_SEGMENTS {
+        let Some(record) = run.pop_local() else { break };
+        run.record(program, record);
+    }
+    run.finish()
+}
