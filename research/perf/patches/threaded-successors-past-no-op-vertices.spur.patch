+/// The successor fields of `op` a running loop moves to without storing
+/// them anywhere, in a fixed order. A synchronous call's entry is not among
+/// them.
+fn followed(op: &Op) -> Vec<u32> {
+    match op {
+        Op::AssignLocal { next, .. }
+        | Op::AssignNode { next, .. }
+        | Op::MakeChannel { next, .. }
+        | Op::MakeFifoLink { next, .. }
+        | Op::UniqueId { next, .. }
+        | Op::Print { next, .. }
+        | Op::PersistData { next, .. }
+        | Op::RetrieveData { next, .. }
+        | Op::PrintParts { next, .. }
+        | Op::SpinAwait { next, .. }
+        | Op::DiscardData(next)
+        | Op::Goto(next)
+        | Op::StoreSkipped(next)
+        | Op::StoreFolded(next) => vec![*next],
+        Op::CondLocal { then, els, .. } | Op::CondNode { then, els, .. } | Op::Cond { then, els, .. } => {
+            vec![*then, *els]
+        }
+        Op::SyncCall(call) => vec![call.next],
+        Op::Async(call) => vec![call.next],
+        Op::ForLoopIn(fl) => vec![fl.body, fl.next],
+        Op::TraceDispatch(td) => vec![td.next],
+        Op::TraceEnter(te) => vec![te.next],
+        Op::TraceExit(tx) => vec![tx.next],
+        Op::SetTimer { .. } | Op::Send(_) | Op::Recv(_) | Op::Pause(_) | Op::Return(_) => vec![],
+    }
+}
+
+/// `op` with every followed successor, and a resolved call entry, set to
+/// zero.
+fn without_followed(op: &Op) -> Op {
+    let mut op = op.clone();
+    match &mut op {
+        Op::AssignLocal { next, .. }
+        | Op::AssignNode { next, .. }
+        | Op::MakeChannel { next, .. }
+        | Op::MakeFifoLink { next, .. }
+        | Op::UniqueId { next, .. }
+        | Op::Print { next, .. }
+        | Op::PersistData { next, .. }
+        | Op::RetrieveData { next, .. }
+        | Op::PrintParts { next, .. }
+        | Op::SpinAwait { next, .. }
+        | Op::DiscardData(next)
+        | Op::Goto(next)
+        | Op::StoreSkipped(next)
+        | Op::StoreFolded(next) => *next = 0,
+        Op::CondLocal { then, els, .. } | Op::CondNode { then, els, .. } | Op::Cond { then, els, .. } => {
+            *then = 0;
+            *els = 0;
+        }
+        Op::SyncCall(call) => {
+            call.next = 0;
+            if call.entry != UNRESOLVED_CALLEE {
+                call.entry = 0;
+            }
+        }
+        Op::Async(call) => call.next = 0,
+        Op::ForLoopIn(fl) => {
+            fl.body = 0;
+            fl.next = 0;
+        }
+        Op::TraceDispatch(td) => td.next = 0,
+        Op::TraceEnter(te) => te.next = 0,
+        Op::TraceExit(tx) => tx.next = 0,
+        Op::SetTimer { .. } | Op::Send(_) | Op::Recv(_) | Op::Pause(_) | Op::Return(_) => {}
+    }
+    op
+}
