+fn assert_rejected_at(program: &Program, ops: &[Op], threaded: &[Op], working: &[u32], v: usize, what: &str) {
+    let failures = check_threaded(program, ops, threaded, working);
+    let prefix = format!("vertex {v}:");
+    assert!(
+        failures.iter().any(|f| f.starts_with(&prefix)),
+        "{what} at vertex {v} was accepted: {failures:?}"
+    );
+}
