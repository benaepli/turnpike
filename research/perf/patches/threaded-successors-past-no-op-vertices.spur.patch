+/// A vertex that fails after vertices that only move on fails with the same
+/// error, output and state, from a record and from a synchronous run.
+#[test]
+fn a_failure_after_vertices_that_only_move_on_fails_alike() {
+    let mut builder = TestProgramBuilder::new();
+    let ret = builder.add(Label::Return(var(0)));
+    let bad = builder.add(Label::Instr(
+        Instr::Assign(
+            Lhs::Var(slot(0)),
+            Expr::Plus(Box::new(Expr::Bool(true)), Box::new(Expr::Int(5))),
+        ),
