+
+fn moves_only(op: &Op) -> bool {
+    matches!(op, Op::StoreSkipped(_) | Op::StoreFolded(_) | Op::Goto(_))
+}
+
+fn stored_next(op: &mut Op) -> Option<&mut u32> {
+    match op {
+        Op::Recv(recv) => Some(&mut recv.next),
+        Op::Pause(next) => Some(next),
+        Op::SetTimer { next, .. } => Some(next),
+        Op::Send(send) => Some(&mut send.next),
+        _ => None,
+    }
+}
+
+fn is_stored_kind(op: &Op, kind: &str) -> bool {
+    match kind {
+        "receive" => matches!(op, Op::Recv(_)),
+        "pause" => matches!(op, Op::Pause(_)),
+        "set timer" => matches!(op, Op::SetTimer { .. }),
+        _ => matches!(op, Op::Send(_)),
+    }
+}
