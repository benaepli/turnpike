+/// Every function of every spec runs alike under every strategy that records
+/// no transitions and under the strategies that do, the timeline strategies
+/// capture the same deliveries, and the label executions fall by exactly the
+/// vertices that only move on and were not executed.
+#[test]
+fn threaded_loops_agree_with_recording_loops_on_every_function_of_every_spec() {
+    on_big_stack(|| {
+        let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../../bin/spur");
+        let mut files = Vec::new();
+        spec_files(&root, &mut files);
+        files.sort();
+        let (mut functions, mut saved) = (0, 0);
+        for file in &files {
+            let name = file.display().to_string();
+            let source = std::fs::read_to_string(file).expect("the spec is readable");
+            let Ok(program) =
+                crate::compiler::compile_with(&source, &name, crate::compiler::cfg::Compiler::new()).into_program()
+            else {
+                continue;
+            };
+            let mut infos: Vec<&FunctionInfo> = program.rpc.values().collect();
+            infos.sort_by_key(|f| f.entry);
+            for f in infos {
+                let context = format!("{name} function at {}", f.entry);
+                let ops = &program.compiled.ops;
+                let plain = run_function::<CfgFeedback>(&program, f);
+                let threaded = run_function::<ThreadedEdges>(&program, f);
+                saved += assert_threaded_agrees(ops, &plain, &threaded, &context);
+                let none = run_function::<NoFeedback>(&program, f);
+                assert_eq!((&none.0, none.1), (&threaded.0, threaded.1), "{context}: no feedback");
+                let timeline = run_function::<TimelineFeedback<false>>(&program, f);
+                assert_eq!((&timeline.0, timeline.1), (&threaded.0, threaded.1), "{context}: timeline");
+                let steered = run_function::<TimelineFeedback<true>>(&program, f);
+                assert_eq!((&steered.0, steered.1), (&threaded.0, threaded.1), "{context}: steered timeline");
+                let full = run_function::<FullFeedback<false>>(&program, f);
+                assert_eq!((&full.0, full.1), (&plain.0, plain.1), "{context}: full");
+                assert_eq!(
+                    TimelineFeedback::<false>::timeline_tuples(&timeline.2),
+                    FullFeedback::<false>::timeline_tuples(&full.2),
+                    "{context}: timeline tuples"
+                );
+                functions += 1;
+            }
+        }
+        assert!(functions > 0, "no function ran");
+        assert!(saved > 0, "no label execution was saved in any function");
+    });
+}
