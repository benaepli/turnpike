+/// A build without rewrites runs its plain operations on every loop.
+#[test]
+fn nothing_is_threaded_without_rewrites() {
+    on_big_stack(|| {
+        let program = compile_spec(&spec_root().join("VR.spur")).expect("VR compiles");
+        let off = CompiledProgram::build_with(&program, Rewrites::Off);
+        assert_eq!(off.threaded_ops, off.ops);
+        assert!(off.working.iter().enumerate().all(|(v, w)| *w as usize == v));
+        assert!(check_unthreaded(&off.ops, &off.threaded_ops, &off.working).is_empty());
+        for (plain, rewritten) in off.ops.iter().zip(&program.compiled.ops) {
+            if let (Op::SyncCall(p), Op::SyncCall(r)) = (plain, rewritten) {
+                assert_eq!(p.entry, r.entry);
+            }
+        }
+        assert!(!check_unthreaded(&off.ops, &program.compiled.threaded_ops, &off.working).is_empty());
+        let mut working = off.working.clone();
+        working.swap(0, 1);
+        assert!(!check_unthreaded(&off.ops, &off.threaded_ops, &working).is_empty());
+    });
+}
