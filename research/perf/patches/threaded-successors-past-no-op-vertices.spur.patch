+/// Records the transitions of the loops that run threaded operations, which
+/// only strategies recording no transitions run.
+#[derive(Debug, Clone, Copy, Default)]
+struct ThreadedEdges;
+
+impl Feedback for ThreadedEdges {
+    type Local = LocalCoverage;
+    type Global = GlobalCoverage;
+    type Snapshot = VertexMap;
+
+    fn snapshot(global: &GlobalCoverage) -> VertexMap {
+        global.snapshot()
+    }
+    fn merge(global: &GlobalCoverage, local: &LocalCoverage) {
+        global.merge(local);
+    }
+    fn record_transition(local: &mut LocalCoverage, prev: usize, pc: usize, snap: &VertexMap) {
