+/// A timer whose stored pc only moves on, waking a reader whose stored pc
+/// only moves on.
+fn timer_run<F: Feedback>(program: &Program, start: usize) -> ((Seen, InterpreterTally, F::Local), [String; 2]) {
+    let mut run = Run::<F>::new(NameId(0), 2);
+    run.record(program, record_at(start, 3));
+    let Some(Runnable::Timer(timer)) = run.state.timer_queue.pop() else {
+        panic!("the set timer queues a timer")
+    };
+    let (mut reader, lhs) = run
+        .state
+        .channels
+        .get_mut(&timer.channel)
+        .expect("the timer channel exists")
+        .pop_waiting_reader()
+        .expect("the receive blocks");
+    let mut node_env = run.state.nodes[0].clone();
+    crate::simulator::core::eval::store(&lhs, Value::unit(), &mut reader.env, &mut node_env).expect("the store");
+    run.state.nodes[0] = node_env;
+    reader.timer_entry = Some(reader.pc);
+    let key = util_stats::TimerKey::new(reader.pc, false, 0, 0);
+    let observed = [
+        format!("timer pc {} reader pc {}", timer.pc, reader.pc),
+        format!("timer entry {} key {key:?}", reader.timer_entry == Some(reader.pc)),
+    ];
+    run.state.push_to_local(0, Runnable::Record(reader));
+    let woken = run.pop_local().expect("the woken reader is queued");
+    run.record(program, woken);
+    (run.finish(), observed)
+}
+
+/// A timer and the reader it wakes keep vertices that only move on as their
+/// stored pcs, so the firing reads the same timer entry and timer key.
+#[test]
+fn a_timer_stored_at_a_vertex_that_only_moves_on_fires_alike() {
+    let mut builder = TestProgramBuilder::new();
+    let ret = builder.add(Label::Return(var(2)));
+    let print = builder.add(Label::Print(var(2), ret));
+    let h3 = builder.add(Label::Instr(Instr::Assign(Lhs::Var(slot(2)), Expr::Int(3)), print));
+    let h2 = builder.add(Label::Continue(h3));
+    let h1 = dead_store(&mut builder, 2, h2);
+    let recv = builder.add(Label::Recv(Lhs::Var(slot(1)), var(0), h1));
+    let g1 = builder.add(Label::Continue(recv));
+    let set = builder.add(Label::SetTimer(Lhs::Var(slot(0)), g1, None));
+    let program = decoded_on(&builder.build(), set, 3);
+    let c = &program.compiled;
+    assert!(matches!(c.ops[g1], Op::Goto(_)));
+    assert_eq!(c.working[h1] as usize, h3);
+    let (plain, plain_seen) = timer_run::<CfgFeedback>(&program, set);
+    let (threaded, threaded_seen) = timer_run::<ThreadedEdges>(&program, set);
+    assert_eq!(plain_seen[0], format!("timer pc {g1} reader pc {h1}"));
+    assert_eq!(threaded_seen, plain_seen);
+    assert!(plain_seen[1].starts_with("timer entry true"));
+    assert_eq!(goto_executions(&c.ops, &threaded.2), 1);
+    assert_eq!(assert_threaded_agrees(&c.ops, &plain, &threaded, "timer"), 2);
+}
