+/// A segment put back the node environment it moved out of the state;
+/// `written` when it wrote a node slot meanwhile.
+#[inline]
+pub fn record_node_env_segment(written: bool) {
+    if !enabled() {
+        return;
+    }
+    FRAME_RUN.with(|f| {
+        let mut t = f.get();
+        t.node_env_detached += 1;
+        t.node_env_written_segments += u64::from(written);
+        f.set(t);
+    });
+}
