+/// The environment of node `index` for one segment, which the segment puts
+/// back with `put_node_env`. Under an eager signature policy it is a copy
+/// and the state keeps its own. Otherwise it is moved out, and until it is
+/// put back the state holds an environment with no slots whose `sig` and
+/// `writes` are those the node had when the segment began, which is what a
+/// kept copy would answer.
+#[inline(always)]
+fn take_node_env<H: HashPolicy>(state: &mut State<H>, index: usize) -> Env<H> {
+    if H::EAGER {
+        state.nodes[index].clone()
+    } else {
+        state.nodes[index].detach()
+    }
+}
+
+/// Puts a segment's node environment back into the state. `entry_writes`
+/// is its write count when the segment took it.
+#[inline(always)]
+fn put_node_env<H: HashPolicy>(
+    state: &mut State<H>,
+    index: usize,
+    node_env: Env<H>,
+    entry_writes: u64,
+) {
+    if !H::EAGER {
+        util_stats::record_node_env_segment(node_env.writes != entry_writes);
+    }
+    state.nodes[index] = node_env;
+}
+
+/// Writes one slot of the node environment a segment holds. A moved-out
+/// environment is held by the segment alone, so a write that finds its slot
+/// buffer shared is counted.
+#[inline(always)]
+fn set_node<H: HashPolicy>(node_env: &mut Env<H>, slot: u32, val: Value<H>) {
+    if !H::EAGER && !node_env.slots.is_unique() {
+        util_stats::record_node_env_shared_at_write();
+    }
+    node_env.set(slot, val);
+}
