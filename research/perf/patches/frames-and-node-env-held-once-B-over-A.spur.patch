+/// A segment that fails after writing a node slot puts a moved-out node
+/// environment back with its writes, whole, from a record and from a
+/// synchronous call alike; a copied one is dropped, leaving the state as the
+/// segment found it.
+#[test]
+fn a_failed_segment_puts_the_moved_out_environment_back() {
+    let mut builder = TestProgramBuilder::new();
+    let ret = builder.add(Label::Return(Expr::Unit));
+    let fail = builder.add(Label::Instr(
+        Instr::Assign(
+            Lhs::Var(slot(0)),
+            Expr::Plus(Box::new(Expr::Bool(true)), Box::new(Expr::Int(5))),
+        ),
+        ret,
+    ));
+    let write = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(node_slot(1)), Expr::Int(5)),
+        fail,
+    ));
+    let program = builder.build();
+    let me = NodeId {
+        role: NameId(0),
+        index: 0,
+    };
+
+    let mut plain = State::<NoHashing>::new(&[(NameId(0), 1)], 2);
+    let before = plain.nodes[0].writes;
+    assert!(run_at(&program, &mut plain, write, 1).is_err());
+    assert_eq!(plain.nodes[0].slots.len(), 2);
+    assert_eq!(plain.nodes[0].get(0), &Value::node(me));
+    assert_eq!(plain.nodes[0].get(1), &Value::int(5));
+    assert_eq!(plain.nodes[0].writes, before + 1);
+
+    let mut sync_plain = State::<NoHashing>::new(&[(NameId(0), 1)], 2);
+    let mut env = Env::<NoHashing>::with_slots(1);
+    let mut coverage = LocalCoverage::new();
+    let failed = exec_sync_on_node::<NoHashing, TestLogger, CfgFeedback>(
+        &mut sync_plain,
+        &mut TestLogger::new(),
+        &program,
+        &mut env,
+        me,
+        write,
+        &VertexMap::new(),
+        &mut coverage,
+        &SchedulePolicy::Fixed,
+        &PurgatoryConfig::default(),
+        &mut SmallRng::seed_from_u64(0),
+    );
+    assert!(failed.is_err());
+    assert_eq!(sync_plain.nodes[0].slots.len(), 2);
+    assert_eq!(sync_plain.nodes[0].get(1), &Value::int(5));
+    assert_eq!(sync_plain.nodes[0].writes, before + 1);
+
+    let mut hashed = State::<WithHashing>::new(&[(NameId(0), 1)], 2);
+    let (writes, sig) = (hashed.nodes[0].writes, hashed.nodes[0].sig);
+    assert!(run_at(&program, &mut hashed, write, 1).is_err());
+    assert_eq!(hashed.nodes[0].get(1), &Value::unit());
+    assert_eq!((hashed.nodes[0].writes, hashed.nodes[0].sig), (writes, sig));
+}
