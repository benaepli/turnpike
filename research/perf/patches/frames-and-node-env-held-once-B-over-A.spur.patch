+fn run_at<H: HashPolicy>(
+    program: &Program,
+    state: &mut State<H>,
+    start: usize,
+    slots: usize,
+) -> Result<Option<ClientOpResult<H>>, RuntimeError> {
+    let mut logger = TestLogger::new();
+    let mut coverage = LocalCoverage::new();
+    exec::<H, TestLogger, CfgFeedback>(
+        state,
+        &mut logger,
+        program,
+        make_record_for::<H>(start, slots, Continuation::Recover),
+        &VertexMap::new(),
+        &mut coverage,
+        &SchedulePolicy::Fixed,
+        &PurgatoryConfig::default(),
+        &mut SmallRng::seed_from_u64(0),
+    )
+}
