+/// The receiver's token at send, the node's token before the segment and
+/// its token after it, for a segment that writes its node twice and then
+/// sends to its own node.
+fn token_read_mid_segment<H: HashPolicy>(program: &Program, start: usize) -> (u64, u64, u64) {
+    let me = NodeId {
+        role: NameId(0),
+        index: 0,
+    };
+    let mut state = State::<H>::new(&[(NameId(0), 1)], 2);
+    let before = state.node_state_token(me);
+    run_at(program, &mut state, start, 1).expect("the segment runs");
+    let at_send = state.local_queues[0]
+        .iter()
+        .find_map(|r| match r {
+            Runnable::Record(r) => Some(r.receiver_token_at_send),
+            _ => None,
+        })
+        .expect("the send is queued");
+    (at_send, before, state.node_state_token(me))
+}
+
+/// A send issued after its segment wrote the receiving node reads the token
+/// the node had when the segment began, on either hash policy, and the
+/// node's token has moved by the segment's writes once it ends.
+#[test]
+fn a_send_mid_segment_reads_the_token_the_segment_began_with() {
+    let mut builder = TestProgramBuilder::new();
+    let h_entry = builder.add(Label::Return(Expr::Unit));
+    let ret = builder.add(Label::Return(Expr::Unit));
+    let send = builder.add(Label::Instr(
+        Instr::Async(
+            Lhs::Var(slot(0)),
+            Expr::Var(node_slot(0)),
+            "h".to_string(),
+            vec![Expr::Int(1)],
+        ),
+        ret,
+    ));
+    let second = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(node_slot(1)), Expr::Int(6)),
+        send,
+    ));
+    let first = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(node_slot(1)), Expr::Int(5)),
+        second,
+    ));
+    let mut program = builder.build_undecoded();
+    register(&mut program, "h", function(h_entry, 6, 1, 1, false));
+    program.decode();
+
+    let plain = token_read_mid_segment::<NoHashing>(&program, first);
+    assert_eq!(plain.0, plain.1);
+    assert_eq!(plain.2, plain.1 + 2);
+    assert_eq!(plain, token_read_mid_segment::<WithHashing>(&program, first));
+}
+
+/// The node's slot kinds and write count, and each woken record's pc and
+/// slot kinds, after a reader of node slot 1 blocks and a segment of the
+/// same node writes slot 1 and then sends to the reader's channel.
+fn wake_into_node_slot<H: HashPolicy>(
+    program: &Program,
+    reader: usize,
+    sender: usize,
+) -> (Vec<String>, u64, Vec<(usize, Vec<String>)>) {
+    let mut state = State::<H>::new(&[(NameId(0), 1)], 3);
+    assert!(matches!(run_at(program, &mut state, reader, 1), Ok(None)), "the reader blocks");
+    let after_reader = state.nodes[0].writes;
+    run_at(program, &mut state, sender, 1).expect("the sender runs");
+    assert_eq!(state.nodes[0].writes, after_reader + 1);
+    let kinds = |env: &Env<H>| env.slots.iter().map(|v| format!("{:?}", v.kind)).collect::<Vec<_>>();
+    let woken = state.local_queues[0]
+        .iter()
+        .filter_map(|r| match r {
+            Runnable::Record(r) => Some((r.pc, kinds(&r.env))),
+            _ => None,
+        })
+        .collect();
+    (kinds(&state.nodes[0]), state.nodes[0].writes, woken)
+}
+
+/// A send that wakes a reader of its own node whose receive stores into a
+/// node slot leaves the node environment, its write count and the woken
+/// record the same whether the segment moved the environment out or copied
+/// it: the store lands on what the state holds during the segment, and the
+/// segment's own environment replaces that when it ends.
+#[test]
+fn a_same_node_wake_into_a_node_slot_matches_the_copied_path() {
+    let mut builder = TestProgramBuilder::new();
+    let reader_ret = builder.add(Label::Return(Expr::Unit));
+    let reader_recv = builder.add(Label::Recv(
+        Lhs::Var(node_slot(1)),
+        Expr::Var(node_slot(2)),
+        reader_ret,
+    ));
+    let reader = builder.add(Label::MakeChannel(Lhs::Var(node_slot(2)), None, reader_recv));
+    let sender_ret = builder.add(Label::Return(Expr::Unit));
+    let sender_after = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(slot(0)), Expr::Int(1)),
+        sender_ret,
+    ));
+    let sender_send = builder.add(Label::Send(Expr::Var(node_slot(2)), Expr::Int(42), sender_after));
+    let sender = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(node_slot(1)), Expr::Int(3)),
+        sender_send,
+    ));
+    let program = builder.build();
+
+    let plain = wake_into_node_slot::<NoHashing>(&program, reader, sender);
+    assert_eq!(plain, wake_into_node_slot::<WithHashing>(&program, reader, sender));
+    assert_eq!(plain.0.len(), 3);
+    assert_eq!(plain.0[1], "Int(3)");
+    assert_eq!(plain.2.len(), 1);
+    assert_eq!(plain.2[0].0, reader_ret);
+}
