+        let mut long = 0;
+        for len in 0..=(3 * range) {
+            for density in [0u64, 1, 8, 64] {
+                let rejected: Vec<bool> = (0..len)
+                    .map(|_| density != 0 && rng.next_u64() % density == 0)
+                    .collect();
