+/// Moves the environment of node `index` out of the state for one segment.
+/// Until `put_node_env` returns it, the state holds a placeholder that
+/// answers only `sig` and `writes`.
+#[inline(always)]
+fn take_node_env<H: HashPolicy>(state: &mut State<H>, index: usize) -> Env<H> {
+    util_stats::record_node_env_moved_out();
+    state.nodes[index].detach()
+}
+
+/// Returns a node environment taken by `take_node_env` to the state.
+#[inline(always)]
+fn put_node_env<H: HashPolicy>(state: &mut State<H>, index: usize, env: Env<H>) {
+    util_stats::record_node_env_put_back();
+    state.nodes[index] = env;
+}
+
+/// How a record's segment left its loop.
+enum RecordExit<H: HashPolicy> {
+    /// The record was parked on a channel or queued to run again.
+    Parked,
+    /// The record returned this value to its continuation, which runs once
+    /// the node's environment is back in the state.
+    Returned(Continuation<H>, Value<H>),
+}
+
+/// Ends a record segment whose node environment is already back in the
+/// state. The environment goes back on every exit, an error included, since
+/// the state holds only a placeholder while the segment runs.
+#[inline(always)]
+fn finish_segment<H: HashPolicy>(
+    state: &mut State<H>,
+    exit: Result<RecordExit<H>, RuntimeError>,
+) -> Result<Option<ClientOpResult<H>>, RuntimeError> {
+    match exit? {
+        RecordExit::Parked => Ok(None),
+        RecordExit::Returned(continuation, val) => Ok(continuation.call(state, val)),
+    }
+}
