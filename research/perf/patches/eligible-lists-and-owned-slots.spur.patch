+fn node_zero_record<H: HashPolicy>(pc: usize, local_slots: usize) -> Record<H> {
+    let nid = NodeId {
+        role: NameId(0),
+        index: 0,
+    };
+    Record {
+        pc,
+        node: nid,
+        origin_node: nid,
+        continuation: Continuation::Recover,
+        entry_pc: pc,
+        initial_args: ecow::EcoVec::new(),
+        entry_func: NameId(0),
+        env: Env::<H>::with_slots(local_slots),
+        priority: 0.5,
+        causal_operation_id: None,
+        trace_id: None,
+        trace_payload: None,
+        link_seq: None,
+        origin_incarnation: 0,
+        send_ordinal: 0,
+        receiver_token_at_send: 0,
+        bias: crate::simulator::util_stats::DeliveryBias::NONE,
+        timer_entry: None,
+    }
+}
+
+/// The difference of two readings of the buffer copy, move out and put back
+/// counts.
+fn env_counts_since(before: [u64; 3]) -> [u64; 3] {
+    let after = util_stats::pending_env_counts();
+    std::array::from_fn(|i| after[i] - before[i])
+}
+
+/// A program whose record segments leave by an error after a node write, by
+/// a pause with and without a node write, and by a return after one.
+struct SegmentExits {
+    program: Program,
+    write_then_fail: usize,
+    pause: usize,
+    write_then_pause: usize,
+    write_then_return: usize,
+}
+
+fn segment_exits() -> SegmentExits {
+    let mut builder = TestProgramBuilder::new();
+    let ret = builder.add(Label::Return(Expr::Unit));
+    let fail = builder.add(Label::Instr(
+        Instr::Assign(
+            Lhs::Var(slot(0)),
+            Expr::Plus(Box::new(Expr::Bool(true)), Box::new(Expr::Int(5))),
+        ),
+        ret,
+    ));
+    let write_then_fail = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(node_slot(0)), Expr::Int(5)),
+        fail,
+    ));
+    let pause = builder.add(Label::Pause(ret));
+    let write_then_pause = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(node_slot(1)), Expr::Int(3)),
+        pause,
+    ));
+    let write_then_return = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(node_slot(1)), Expr::Int(4)),
+        ret,
+    ));
+    SegmentExits {
+        program: builder.build(),
+        write_then_fail,
+        pause,
+        write_then_pause,
+        write_then_return,
+    }
+}
+
+fn assert_segments_put_the_node_environment_back<H: HashPolicy>(
+    program: &Program,
+    exits: &SegmentExits,
+) {
+    let run = |state: &mut State<H>, pc: usize| {
+        let before = util_stats::pending_env_counts();
+        let mut logger = TestLogger::new();
+        let mut coverage = LocalCoverage::new();
+        let result = exec::<H, TestLogger, CfgFeedback>(
+            state,
+            &mut logger,
+            program,
+            node_zero_record::<H>(pc, 2),
+            &VertexMap::new(),
+            &mut coverage,
+            &SchedulePolicy::Fixed,
+            &PurgatoryConfig::default(),
+            &mut SmallRng::seed_from_u64(0),
+        );
+        (result.map(|r| r.is_none()), env_counts_since(before))
+    };
+    let mut state = State::<H>::new(&[(NameId(0), 1)], 2);
+    let writes = state.nodes[0].writes;
+
+    let (result, counts) = run(&mut state, exits.write_then_fail);
+    assert!(result.is_err());
+    assert_eq!(counts, [0, 1, 1]);
+    assert_eq!(state.nodes[0].len(), 2);
+    assert_eq!(state.nodes[0].get(0), &Value::<H>::int(5), "a write before the error is kept");
+    assert_eq!(state.nodes[0].writes, writes + 1);
+
+    for pc in [exits.write_then_pause, exits.pause, exits.write_then_return] {
+        let (result, counts) = run(&mut state, pc);
+        assert_eq!(result.ok(), Some(true));
+        assert_eq!(counts, [0, 1, 1]);
+        assert_eq!(state.nodes[0].len(), 2);
+    }
+    assert_eq!(state.local_queues[0].len(), 2, "each pause queued its record");
+    assert_eq!(state.nodes[0].get(0), &Value::<H>::int(5));
+    assert_eq!(state.nodes[0].get(1), &Value::<H>::int(4));
+    assert_eq!(state.nodes[0].writes, writes + 3);
+
+    state.nodes[0].set(1, Value::<H>::int(0));
+    let before = util_stats::pending_env_counts();
+    let mut logger = TestLogger::new();
+    let mut coverage = LocalCoverage::new();
+    let mut frame = Env::<H>::with_slots(1);
+    let result = exec_sync_on_node::<H, TestLogger, CfgFeedback>(
+        &mut state,
+        &mut logger,
+        program,
+        &mut frame,
+        NodeId {
+            role: NameId(0),
+            index: 0,
+        },
+        exits.write_then_return,
+        &VertexMap::new(),
+        &mut coverage,
+        &SchedulePolicy::Fixed,
+        &PurgatoryConfig::default(),
+        &mut SmallRng::seed_from_u64(0),
+    );
+    assert!(result.is_ok());
+    assert_eq!(env_counts_since(before), [0, 1, 1]);
+    assert_eq!(state.nodes[0].len(), 2);
+    assert_eq!(state.nodes[0].get(1), &Value::<H>::int(4));
+}
