+impl<T: Clone, const I: bool, const N: usize> TryFrom<LocalVec<T, I>> for [T; N] {
+    type Error = LocalVec<T, I>;
+
+    fn try_from(mut vec: LocalVec<T, I>) -> Result<Self, Self::Error> {
+        if vec.len() != N {
+            return Err(vec);
+        }
+
+        Ok(if vec.is_unique() {
+            // The length is zeroed so the vector's drop does not drop the
+            // moved elements.
+            vec.len = 0;
+
+            // Safety: the allocation is owned alone and valid for `N` reads.
+            unsafe { ptr::read(vec.data() as *const [T; N]) }
+        } else {
+            // Safety: the length is `N`.
+            unsafe { array::from_fn(|i| vec.get_unchecked(i).clone()) }
+        })
+    }
+}
