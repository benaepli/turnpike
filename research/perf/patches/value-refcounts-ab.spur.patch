+/// The text of a program literal, shared by every thread that runs the
+/// program.
+///
+/// Text longer than `LIMIT` bytes lives behind a header whose count is
+/// immortal and is never freed; shorter text is inline. Cloning the handle
+/// copies it without touching any count. A run turns a literal into its own
+/// string with `to_local`.
+pub struct SharedLiteral(ManuallyDrop<LocalStr>);
+
+/// Immortal literal handles by text, so interning the same text again, as a
+/// long-lived process that compiles repeatedly does, reuses one header.
+static LITERALS: LazyLock<Mutex<HashMap<Box<str>, SharedLiteral>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+impl SharedLiteral {
+    /// The literal for `text`. Text longer than the inline limit gets an
+    /// immortal header, created on the first call for that text.
+    pub fn intern(text: &str) -> Self {
+        if text.len() <= LIMIT {
+            return Self(ManuallyDrop::new(LocalStr::from_str(text)));
+        }
+        let mut table = LITERALS.lock().unwrap_or_else(|p| p.into_inner());
+        if let Some(existing) = table.get(text) {
+            return existing.clone();
+        }
+        let spilled = Spilled::immortal_from_slice(text.as_bytes());
+        let literal = Self(ManuallyDrop::new(LocalStr(DynamicVec::from_spilled(spilled))));
+        table.insert(Box::from(text), literal.clone());
+        literal
+    }
+
+    #[inline]
+    pub fn as_str(&self) -> &str {
+        self.0.as_str()
+    }
+
+    /// A string of the literal's text for the calling thread. Shares the
+    /// immortal header when the text is not inline.
+    #[inline]
+    pub fn to_local(&self) -> LocalStr {
+        LocalStr::clone(&self.0)
+    }
+
+    #[cfg(test)]
+    pub(crate) fn header_count(&self) -> Option<usize> {
+        self.0.0.header_count()
+    }
+}
+
+// The header of a literal is marked immortal before any program that holds
+// it is shared, and is never written or freed afterwards: clone, drop and
+// uniqueness checks of an immortal header only read it. Nothing may hand
+// out a mutable reference to the inner string.
+unsafe impl Send for SharedLiteral {}
+unsafe impl Sync for SharedLiteral {}
+
+impl Clone for SharedLiteral {
+    #[inline]
+    fn clone(&self) -> Self {
+        // Safety: the inner string is inline or holds an immortal header,
+        // which a bitwise copy may share without a count, and the handle is
+        // never dropped.
+        Self(unsafe { ptr::read(&self.0) })
+    }
+}
+
+impl Deref for SharedLiteral {
+    type Target = str;
+
+    #[inline]
+    fn deref(&self) -> &str {
+        self.as_str()
+    }
+}
+
+/// Formats exactly as the `str` does.
+impl Debug for SharedLiteral {
+    #[inline]
+    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
+        Debug::fmt(self.as_str(), f)
+    }
+}
+
+impl Display for SharedLiteral {
+    #[inline]
+    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
+        Display::fmt(self.as_str(), f)
+    }
+}
+
+impl Eq for SharedLiteral {}
+
+impl PartialEq for SharedLiteral {
+    #[inline]
+    fn eq(&self, other: &Self) -> bool {
+        self.as_str().eq(other.as_str())
+    }
+}
+
+impl PartialEq<str> for SharedLiteral {
+    #[inline]
+    fn eq(&self, other: &str) -> bool {
+        self.as_str().eq(other)
+    }
+}
+
+impl Ord for SharedLiteral {
+    #[inline]
+    fn cmp(&self, other: &Self) -> Ordering {
+        self.as_str().cmp(other.as_str())
+    }
+}
+
+impl PartialOrd for SharedLiteral {
+    #[inline]
+    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
+        Some(self.cmp(other))
+    }
+}
+
+impl Hash for SharedLiteral {
+    #[inline]
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        self.as_str().hash(state);
+    }
+}
+
+impl Borrow<str> for SharedLiteral {
+    #[inline]
+    fn borrow(&self) -> &str {
+        self
+    }
+}
+
+impl From<&str> for SharedLiteral {
+    #[inline]
+    fn from(text: &str) -> Self {
+        Self::intern(text)
+    }
+}
+
+/// Serializes as the plain string.
+impl serde::Serialize for SharedLiteral {
+    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
+    where
+        S: serde::Serializer,
+    {
+        self.as_str().serialize(serializer)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{LIMIT, LocalStr, SharedLiteral};
+    use crate::simulator::core::local_vec::IMMORTAL_COUNT;
+    use crate::simulator::util_stats;
+    use std::hash::{DefaultHasher, Hash, Hasher};
+
+    fn hash_of<T: Hash + ?Sized>(t: &T) -> u64 {
+        let mut h = DefaultHasher::new();
+        t.hash(&mut h);
+        h.finish()
+    }
+
+    #[test]
+    fn layout_and_inline_limit() {
+        assert_eq!(std::mem::size_of::<LocalStr>(), 16);
+        assert_eq!(LIMIT, 15);
+        assert_eq!(LocalStr::from("exactly15bytes!").0.header_count(), None);
+        assert_eq!(LocalStr::from("sixteen bytes!!!").0.header_count(), Some(1));
+    }
+
+    #[test]
+    fn observations_match_str() {
+        for text in ["", "short", "exactly15bytes!", "sixteen bytes!!!", "unicode \u{e9}\u{4e2d}\u{1f600} past the limit"] {
+            let s = LocalStr::from(text);
+            let lit = SharedLiteral::intern(text);
+            assert_eq!(s.as_str(), text);
+            assert_eq!(lit.as_str(), text);
+            assert_eq!(hash_of(&s), hash_of(text));
+            assert_eq!(hash_of(&lit), hash_of(text));
+            assert_eq!(format!("{s:?}"), format!("{text:?}"));
+            assert_eq!(format!("{lit:?}"), format!("{text:?}"));
+            assert_eq!(format!("{s}"), text);
+            assert!(s == lit);
+            assert!(lit == *text);
+            assert_eq!(serde_json::to_string(&lit).unwrap(), serde_json::to_string(text).unwrap());
+        }
+        let mut a = vec![LocalStr::from("b long enough to spill"), LocalStr::from("a"), LocalStr::from("ab")];
+        a.sort();
+        assert_eq!(a, [LocalStr::from("a"), LocalStr::from("ab"), LocalStr::from("b long enough to spill")]);
+    }
+
+    #[test]
+    fn push_pop_and_clear_across_the_inline_limit() {
+        let mut s = LocalStr::new();
+        for c in "a string that grows past the inline limit".chars() {
+            s.push(c);
+        }
+        assert_eq!(s, "a string that grows past the inline limit");
+        let t = s.clone();
+        assert_eq!(s.pop(), Some('t'));
+        assert_eq!(t, "a string that grows past the inline limit");
+        s.push_str(" \u{1f600}");
+        assert_eq!(s.pop(), Some('\u{1f600}'));
+        s.truncate(8);
+        assert_eq!(s, "a string");
+        s.clear();
+        assert!(s.is_empty());
+        let mut w = LocalStr::with_capacity(40);
+        write!(w, "{}-{}", 12, "x").unwrap();
+        assert_eq!(w, "12-x");
+        use std::fmt::Write;
+    }
+
+    #[test]
+    fn interning_reuses_one_immortal_header() {
+        let a = SharedLiteral::intern("an interned literal of some length");
+        let b = SharedLiteral::intern("an interned literal of some length");
+        assert_eq!(a.as_ptr(), b.as_ptr());
+        assert_eq!(a.header_count(), Some(IMMORTAL_COUNT));
+        let short = SharedLiteral::intern("short");
+        assert_eq!(short.header_count(), None);
+    }
+
+    #[test]
+    fn literal_strings_count_their_clones_drops_and_copies() {
+        let lit = SharedLiteral::intern("a literal long enough to have a header");
+        let before = util_stats::pending_value_refs();
+        let local = lit.to_local();
+        let again = local.clone();
+        assert_eq!(local.as_ptr(), lit.as_ptr());
+        let mut copied = again.clone();
+        copied.make_mut();
+        assert_ne!(copied.as_ptr(), lit.as_ptr());
+        let mut unique = LocalStr::from("a run string long enough to spill");
+        unique.push_str(" and more");
+        unique.make_mut();
+        drop((local, again, copied, unique));
+        let after = util_stats::pending_value_refs();
+        assert_eq!(after[0] - before[0], 3, "clones");
+        assert_eq!(after[1] - before[1], 3, "drops");
+        assert_eq!(after[2] - before[2], 1, "shared string copies");
+        assert_eq!(lit.header_count(), Some(IMMORTAL_COUNT));
+
+        let mut run = LocalStr::from("a run string long enough to spill");
+        let keep = run.clone();
+        let before = util_stats::pending_value_refs();
+        run.push_str("!");
+        let after = util_stats::pending_value_refs();
+        assert_eq!(after[2] - before[2], 1, "a copy of a shared run string counts");
+        assert_eq!(after[0], before[0]);
+        drop((run, keep));
+    }
+
+    #[test]
+    fn literal_headers_stay_immortal_under_concurrent_use() {
+        const THREADS: usize = 30;
+        const PER_THREAD: usize = 340_000;
+        let texts: Vec<String> = [16usize, 23, 31, 40, 48, 57, 64]
+            .iter()
+            .map(|&n| (0..n).map(|i| (b'a' + (i % 26) as u8) as char).collect())
+            .collect();
+        let literals: Vec<SharedLiteral> = texts.iter().map(|t| SharedLiteral::intern(t)).collect();
+        for lit in &literals {
+            assert_eq!(lit.header_count(), Some(IMMORTAL_COUNT));
+        }
+        std::thread::scope(|scope| {
+            for t in 0..THREADS {
+                let literals = &literals;
+                let texts = &texts;
+                scope.spawn(move || {
+                    for i in 0..PER_THREAD {
+                        let k = (t + i) % literals.len();
+                        let lit = &literals[k];
+                        let local = lit.to_local();
+                        let mut pushed = local.clone();
+                        pushed.push_str("!");
+                        let mut edited = lit.to_local();
+                        edited.make_mut().make_ascii_uppercase();
+                        assert_eq!(local.as_str(), texts[k]);
+                        assert_eq!(&pushed[..texts[k].len()], texts[k]);
+                        assert!(edited.eq_ignore_ascii_case(&texts[k]));
+                        drop((local, pushed, edited));
+                    }
+                });
+            }
+        });
+        for (lit, text) in literals.iter().zip(&texts) {
+            assert_eq!(lit.header_count(), Some(IMMORTAL_COUNT));
+            assert_eq!(lit.as_str(), text);
+        }
+    }
+}
