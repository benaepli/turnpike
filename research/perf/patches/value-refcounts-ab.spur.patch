+//! A clone-on-write string whose reference count is a plain integer, and the
+//! handle program literals are held by.
+//!
+//! Derived from the ecow crate, version 0.2.6, files src/string.rs and
+//! src/dynamic.rs. Copyright the ecow authors; licensed under the MIT license
+//! or the Apache License, Version 2.0, at the user's option.
+//!
+//! A string of at most `LIMIT` bytes is stored inline and has no count. A
+//! longer string lives in a `LocalVec` whose count is not atomic, so a string
+//! and all of its clones must stay on the thread that created them. The one
+//! exception is a program literal: its header is immortal, and every clone,
+//! drop and uniqueness check of an immortal header only reads it.
+
+use crate::simulator::core::local_vec::LocalVec;
+use std::borrow::Borrow;
+use std::cmp::Ordering;
+use std::collections::HashMap;
+use std::fmt::{self, Debug, Display, Formatter, Write};
+use std::hash::{Hash, Hasher};
+use std::mem::{self, ManuallyDrop};
+use std::ops::Deref;
+use std::ptr;
+use std::sync::{LazyLock, Mutex};
+
+/// Storage of a string too long to be inline. Its header may be immortal.
+type Spilled = LocalVec<u8, true>;
+
+/// A byte vector that holds up to `LIMIT` bytes inline and spills to a
+/// `Spilled` vector beyond that.
+struct DynamicVec(Repr);
+
+/// On 64-bit little endian no valid `Spilled` vector has the highest bit of
+/// the inline `tagged_len` set: that byte is the top byte of the vector's
+/// length, which never exceeds `isize::MAX`. On 32-bit the two fields do not
+/// overlap, and on big endian `LIMIT` is raised so that they do not.
+#[repr(C)]
+union Repr {
+    inline: InlineVec,
+    spilled: ManuallyDrop<Spilled>,
+}
+
+enum Variant<'a> {
+    Inline(&'a InlineVec),
+    Spilled(&'a Spilled),
+}
+
+enum VariantMut<'a> {
+    Inline(&'a mut InlineVec),
+    Spilled(&'a mut Spilled),
+}
+
+/// The most bytes stored inline: 15 on 64-bit little endian, raised where the
+/// inline length byte would otherwise overlap a spilled vector's length.
+const LIMIT: usize = {
+    let mut limit = 15;
+    if limit < mem::size_of::<Spilled>() - 1 {
+        limit = mem::size_of::<Spilled>() - 1;
+    }
+    if cfg!(target_endian = "big") {
+        limit += mem::size_of::<usize>();
+    }
+    limit
+};
+
+/// Set in `tagged_len` exactly when the string is inline.
+const LEN_TAG: u8 = 0b1000_0000;
+
+const LEN_MASK: u8 = 0b0111_1111;
+
+impl DynamicVec {
+    #[inline]
+    const fn new() -> Self {
+        Self::from_inline(InlineVec::new())
+    }
+
+    #[inline]
+    const fn from_inline(inline: InlineVec) -> Self {
+        Self(Repr { inline })
+    }
+
+    #[inline]
+    fn from_spilled(vec: Spilled) -> Self {
+        // `tagged_len` is written as 0 first, so the byte that marks a string
+        // inline is initialized and clear for a spilled one.
+        let mut repr = Repr {
+            inline: InlineVec {
+                buf: [0; LIMIT],
+                tagged_len: 0,
+            },
+        };
+        repr.spilled = ManuallyDrop::new(vec);
+        Self(repr)
+    }
+
+    #[inline]
+    fn from_slice(bytes: &[u8]) -> Self {
+        match InlineVec::from_slice(bytes) {
+            Ok(inline) => Self::from_inline(inline),
+            _ => Self::from_spilled(Spilled::from(bytes)),
+        }
+    }
+
+    #[inline]
+    fn with_capacity(capacity: usize) -> Self {
+        if capacity <= LIMIT {
+            Self::new()
+        } else {
+            Self::from_spilled(Spilled::with_capacity(capacity))
+        }
+    }
+
+    #[inline]
+    fn len(&self) -> usize {
+        match self.variant() {
+            Variant::Inline(inline) => inline.len(),
+            Variant::Spilled(spilled) => spilled.len(),
+        }
+    }
+
+    #[inline]
+    fn as_slice(&self) -> &[u8] {
+        match self.variant() {
+            Variant::Inline(inline) => inline.as_slice(),
+            Variant::Spilled(spilled) => spilled.as_slice(),
+        }
+    }
+
+    #[inline]
+    fn make_mut(&mut self) -> &mut [u8] {
+        match self.variant_mut() {
+            VariantMut::Inline(inline) => inline.as_mut_slice(),
+            VariantMut::Spilled(spilled) => spilled.make_mut(),
+        }
+    }
+
+    #[inline]
+    fn push(&mut self, byte: u8) {
+        match self.variant_mut() {
+            VariantMut::Inline(inline) => {
+                if inline.push(byte).is_err() {
+                    let mut spilled = Spilled::with_capacity(LIMIT * 2);
+                    spilled.extend_from_byte_slice(self.as_slice());
+                    spilled.push(byte);
+                    *self = Self::from_spilled(spilled);
+                }
+            }
+            VariantMut::Spilled(spilled) => {
+                spilled.push(byte);
+            }
+        }
+    }
+
+    #[inline]
+    fn extend_from_slice(&mut self, bytes: &[u8]) {
+        match self.variant_mut() {
+            VariantMut::Inline(inline) => {
+                if inline.extend_from_slice(bytes).is_err() {
+                    let needed = inline.len() + bytes.len();
+                    let mut spilled = Spilled::with_capacity(needed.next_power_of_two());
+                    spilled.extend_from_byte_slice(self.as_slice());
+                    spilled.extend_from_byte_slice(bytes);
+                    *self = Self::from_spilled(spilled);
+                }
+            }
+            VariantMut::Spilled(spilled) => {
+                spilled.extend_from_byte_slice(bytes);
+            }
+        }
+    }
+
+    #[inline]
+    fn clear(&mut self) {
+        match self.variant_mut() {
+            VariantMut::Inline(inline) => inline.clear(),
+            VariantMut::Spilled(spilled) => spilled.clear(),
+        }
+    }
+
+    #[inline]
+    fn truncate(&mut self, target: usize) {
+        match self.variant_mut() {
+            VariantMut::Inline(inline) => inline.truncate(target),
+            VariantMut::Spilled(spilled) => spilled.truncate(target),
+        }
+    }
+
+    /// True when `self.0.inline` is the initialized field, false when
+    /// `self.0.spilled` is.
+    #[inline]
+    fn is_inline(&self) -> bool {
+        // Safety: `tagged_len` is initialized for both fields; see `Repr`.
+        unsafe { self.0.inline.tagged_len & LEN_TAG != 0 }
+    }
+
+    #[inline]
+    fn variant(&self) -> Variant<'_> {
+        // Safety: the field read is the one `is_inline` reports initialized.
+        unsafe {
+            if self.is_inline() {
+                Variant::Inline(&self.0.inline)
+            } else {
+                Variant::Spilled(&self.0.spilled)
+            }
+        }
+    }
+
+    #[inline]
+    fn variant_mut(&mut self) -> VariantMut<'_> {
+        // Safety: the field read is the one `is_inline` reports initialized.
+        unsafe {
+            if self.is_inline() {
+                VariantMut::Inline(&mut self.0.inline)
+            } else {
+                VariantMut::Spilled(&mut self.0.spilled)
+            }
+        }
+    }
+
+    #[cfg(test)]
+    fn header_count(&self) -> Option<usize> {
+        match self.variant() {
+            Variant::Inline(_) => None,
+            Variant::Spilled(spilled) => Some(spilled.ref_count()),
+        }
+    }
+}
+
+impl Clone for DynamicVec {
+    #[inline]
+    fn clone(&self) -> Self {
+        match self.variant() {
+            Variant::Inline(inline) => Self::from_inline(*inline),
+            Variant::Spilled(spilled) => Self::from_spilled(spilled.clone()),
+        }
+    }
+}
+
+impl Drop for DynamicVec {
+    #[inline]
+    fn drop(&mut self) {
+        if let VariantMut::Spilled(spilled) = self.variant_mut() {
+            // Safety: the spilled field is initialized and dropped only here.
+            unsafe {
+                ptr::drop_in_place(spilled);
+            }
+        }
+    }
+}
+
+#[repr(C)]
+#[derive(Debug, Copy, Clone)]
+struct InlineVec {
+    buf: [u8; LIMIT],
+    /// Invariant: after masking off the tag, never exceeds `LIMIT`.
+    tagged_len: u8,
+}
+
+impl InlineVec {
+    #[inline]
+    const fn new() -> Self {
+        // Safety: 0 <= LIMIT.
+        unsafe { Self::from_buf([0; LIMIT], 0) }
+    }
+
+    #[inline]
+    const fn from_slice(bytes: &[u8]) -> Result<Self, ()> {
+        let len = bytes.len();
+        if len > LIMIT {
+            return Err(());
+        }
+
+        let mut buf = [0; LIMIT];
+        let mut i = 0;
+        while i < len {
+            buf[i] = bytes[i];
+            i += 1;
+        }
+
+        // Safety: `len <= LIMIT` was checked above.
+        unsafe { Ok(Self::from_buf(buf, len)) }
+    }
+
+    /// `len` must not exceed `LIMIT`.
+    #[inline]
+    const unsafe fn from_buf(buf: [u8; LIMIT], len: usize) -> Self {
+        debug_assert!(len <= LIMIT);
+        Self {
+            buf,
+            tagged_len: len as u8 | LEN_TAG,
+        }
+    }
+
+    #[inline]
+    fn len(&self) -> usize {
+        usize::from(self.tagged_len & LEN_MASK)
+    }
+
+    /// `len` must not exceed `LIMIT`.
+    #[inline]
+    unsafe fn set_len(&mut self, len: usize) {
+        debug_assert!(len <= LIMIT);
+        self.tagged_len = len as u8 | LEN_TAG;
+    }
+
+    #[inline]
+    fn as_slice(&self) -> &[u8] {
+        // Safety: `len <= LIMIT`.
+        unsafe { self.buf.get_unchecked(..self.len()) }
+    }
+
+    #[inline]
+    fn as_mut_slice(&mut self) -> &mut [u8] {
+        let len = self.len();
+        // Safety: `len <= LIMIT`.
+        unsafe { self.buf.get_unchecked_mut(..len) }
+    }
+
+    #[inline]
+    fn clear(&mut self) {
+        // Safety: 0 <= LIMIT.
+        unsafe {
+            self.set_len(0);
+        }
+    }
+
+    #[inline]
+    fn push(&mut self, byte: u8) -> Result<(), ()> {
+        let len = self.len();
+        if let Some(slot) = self.buf.get_mut(len) {
+            *slot = byte;
+            // Safety: `get_mut` succeeded, so `len < LIMIT`.
+            unsafe {
+                self.set_len(len + 1);
+            }
+            Ok(())
+        } else {
+            Err(())
+        }
+    }
+
+    #[inline]
+    fn extend_from_slice(&mut self, bytes: &[u8]) -> Result<(), ()> {
+        let len = self.len();
+        let grown = len + bytes.len();
+        if let Some(segment) = self.buf.get_mut(len..grown) {
+            segment.copy_from_slice(bytes);
+            // Safety: `get_mut` succeeded, so `grown <= LIMIT`.
+            unsafe {
+                self.set_len(grown);
+            }
+            Ok(())
+        } else {
+            Err(())
+        }
+    }
+
+    #[inline]
+    fn truncate(&mut self, target: usize) {
+        if target < self.len() {
+            // Safety: `target` is below the current length, which is at most
+            // `LIMIT`.
+            unsafe {
+                self.set_len(target);
+            }
+        }
+    }
+}
+
+/// A string with inline storage for short text and clone-on-write heap
+/// storage beyond that. Two words wide on 64-bit little endian.
+#[derive(Clone)]
+pub struct LocalStr(DynamicVec);
+
+impl LocalStr {
+    /// An empty string.
+    #[inline]
+    pub const fn new() -> Self {
+        Self(DynamicVec::new())
+    }
+
+    /// An empty string with room for at least `capacity` bytes.
+    #[inline]
+    pub fn with_capacity(capacity: usize) -> Self {
+        Self(DynamicVec::with_capacity(capacity))
+    }
+
+    #[inline]
+    fn from_str(string: &str) -> Self {
+        Self(DynamicVec::from_slice(string.as_bytes()))
+    }
+
+    #[inline]
+    pub fn is_empty(&self) -> bool {
+        self.len() == 0
+    }
+
+    /// The length in bytes.
+    #[inline]
+    pub fn len(&self) -> usize {
+        self.0.len()
+    }
+
+    #[inline]
+    pub fn as_str(&self) -> &str {
+        // Safety: the bytes only ever come from string slices and from chars
+        // encoded as UTF-8, and are only ever cut at char boundaries.
+        unsafe { std::str::from_utf8_unchecked(self.0.as_slice()) }
+    }
+
+    /// The string as a mutable slice, copying it first when its storage is
+    /// shared.
+    #[inline]
+    pub fn make_mut(&mut self) -> &mut str {
+        // Safety: see `as_str`; a `&mut str` cannot break UTF-8 validity.
+        unsafe { std::str::from_utf8_unchecked_mut(self.0.make_mut()) }
+    }
+
+    /// Appends a character.
+    #[inline]
+    pub fn push(&mut self, c: char) {
+        if c.len_utf8() == 1 {
+            self.0.push(c as u8);
+        } else {
+            self.push_str(c.encode_utf8(&mut [0; 4]));
+        }
+    }
+
+    /// Appends a string slice.
+    pub fn push_str(&mut self, string: &str) {
+        self.0.extend_from_slice(string.as_bytes());
+    }
+
+    /// Removes and returns the last character.
+    #[inline]
+    pub fn pop(&mut self) -> Option<char> {
+        let slice = self.as_str();
+        let c = slice.chars().next_back()?;
+        self.0.truncate(slice.len() - c.len_utf8());
+        Some(c)
+    }
+
+    #[inline]
+    pub fn clear(&mut self) {
+        self.0.clear();
+    }
+
+    /// Shortens the string to `new_len` bytes. Panics if `new_len` is not a
+    /// char boundary.
+    #[inline]
+    pub fn truncate(&mut self, new_len: usize) {
+        if new_len <= self.len() {
+            assert!(self.is_char_boundary(new_len));
+            self.0.truncate(new_len);
+        }
+    }
+}
