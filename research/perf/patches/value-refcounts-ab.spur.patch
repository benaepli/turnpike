+        let result = std::panic::catch_unwind(|| {
+            drop(LocalVec::<Once>::from([Once(true), Once(false), Once(false)]));
+        });
+        assert!(result.is_err());
+        assert_eq!(DROPS.load(SeqCst), 3);
+    }
+
+    #[test]
+    fn array_from_vector() {
+        let array = [String::from("foo"), String::from("bar")];
+        let a = LocalVec::<String>::from(array.clone());
+        let b = a.clone();
+        let c: [String; 2] = a.try_into().unwrap();
+        assert_eq!(b, c);
+        let d = b.clone();
+        assert_eq!(c, array);
+        assert_eq!(d, array);
+        drop(b);
+        drop(d);
+        assert_eq!(c, array);
+
+        assert_eq!(<[String; 0]>::try_from(LocalVec::<String>::new()).unwrap(), <[String; 0]>::default());
+    }
+
+    #[test]
+    fn hash_and_debug_match_the_slice() {
+        use std::hash::{DefaultHasher, Hash, Hasher};
+        let vec = LocalVec::<Box<i32>>::from([v(1), v(2), v(3)]);
+        let slice: &[Box<i32>] = &[v(1), v(2), v(3)];
+        let hash = |x: &dyn Fn(&mut DefaultHasher)| {
+            let mut h = DefaultHasher::new();
+            x(&mut h);
+            h.finish()
+        };
+        assert_eq!(hash(&|h| vec.hash(h)), hash(&|h| slice.hash(h)));
+        assert_eq!(format!("{vec:?}"), format!("{slice:?}"));
+        assert_eq!(format!("{vec:#?}"), format!("{slice:#?}"));
+    }
+
+    #[test]
+    fn immortal_header_is_only_read() {
+        let bytes = b"immortal bytes of some length";
+        let mut immortal = LocalVec::<u8, true>::immortal_from_slice(bytes);
+        assert_eq!(immortal.ref_count(), IMMORTAL_COUNT);
+        assert_eq!(immortal.capacity(), LocalVec::<u8, true>::from(&bytes[..]).capacity());
+        assert!(!immortal.is_unique());
+
