+impl<T: Clone, const I: bool> From<Vec<T>> for LocalVec<T, I> {
+    /// Moves the elements of `other` into a new allocation.
+    fn from(mut other: Vec<T>) -> Self {
+        let len = other.len();
+        let mut vec = Self::with_capacity(len);
+        unsafe {
+            // The source length is zeroed first so its elements are owned by
+            // the new vector alone.
+            other.set_len(0);
+
+            // Safety: the source is valid for `len` reads, the destination was
+            // just allocated for `len` writes, and they do not overlap.
+            ptr::copy_nonoverlapping(other.as_ptr(), vec.data_mut(), len);
+            vec.len = len;
+        }
+        vec
+    }
+}
