+impl Deref for LocalStr {
+    type Target = str;
+
+    #[inline]
+    fn deref(&self) -> &str {
+        self.as_str()
+    }
+}
+
+impl Default for LocalStr {
+    #[inline]
+    fn default() -> Self {
