+        let a = immortal.clone();
+        let mut b = a.clone();
+        assert_eq!(immortal.ref_count(), IMMORTAL_COUNT);
+        b.make_mut()[0] = b'I';
+        assert_ne!(b.as_ptr(), immortal.as_ptr());
+        assert_eq!(b.ref_count(), 1);
+        let mut c = immortal.clone();
+        c.extend_from_byte_slice(b"!");
+        assert_eq!(&c[..bytes.len()], bytes);
+        drop((a, b, c));
+        let after = util_stats::pending_value_refs();
+        assert_eq!(after[0] - before[0], 3, "clones of an immortal header");
+        assert_eq!(after[1] - before[1], 3, "drops of an immortal header");
+        assert_eq!(after[2] - before[2], 2, "copies of a shared string");
+        assert_eq!(immortal.ref_count(), IMMORTAL_COUNT);
+        assert_eq!(immortal.as_slice(), bytes);
+
+        let mut ordinary = LocalVec::<u8, true>::from(&bytes[..]);
+        let keep = ordinary.clone();
+        let before = util_stats::pending_value_refs();
+        ordinary.truncate(3);
+        let after = util_stats::pending_value_refs();
+        assert_eq!(after[2] - before[2], 1, "a truncate of a shared string copies it");
+        assert_eq!(after[0], before[0]);
+        drop((ordinary, keep));
+
+        let mut values = LocalVec::<u8>::from(&bytes[..]);
+        let keep = values.clone();
+        let before = util_stats::pending_value_refs();
+        values.make_mut();
+        let after = util_stats::pending_value_refs();
+        assert_eq!(after, before, "vectors that cannot hold an immortal header are not counted");
+        drop((values, keep));
+
+        let empty = LocalVec::<u8, true>::immortal_from_slice(&[]);
+        assert_eq!(empty.ref_count(), 0);
+    }
