+/// An owned iterator over a [`LocalVec`]. Moves the elements out when the
+/// vector owned its allocation alone, and clones them otherwise.
+pub struct IntoIter<T, const I: bool = false> {
+    vec: LocalVec<T, I>,
+    /// Whether the vector owned its allocation alone.
+    unique: bool,
+    /// Elements taken from the front. When `unique`, these are moved out and
+    /// must not be dropped again.
+    ///
+    /// Invariant: `front <= back`.
+    front: usize,
+    /// End of the elements not yet taken from the back. When `unique`, those
+    /// past it are moved out and must not be dropped again.
+    ///
+    /// Invariant: `back <= len`.
+    back: usize,
+}
+
+impl<T, const I: bool> IntoIter<T, I> {
+    /// The elements not yet yielded.
+    #[inline]
+    pub fn as_slice(&self) -> &[T] {
+        // Safety: `front <= back <= len`, so `data() + front` is valid for
+        // `back - front` reads.
+        unsafe {
+            std::slice::from_raw_parts(self.vec.data().add(self.front), self.back - self.front)
+        }
+    }
+}
+
+impl<T: Clone, const I: bool> Iterator for IntoIter<T, I> {
+    type Item = T;
+
+    #[inline]
+    fn next(&mut self) -> Option<Self::Item> {
+        (self.front < self.back).then(|| {
+            let prev = self.front;
+            self.front += 1;
+            if self.unique {
+                // Safety: the allocation is owned alone, `prev < back <= len`,
+                // and the element is never dropped again.
+                unsafe { ptr::read(self.vec.data().add(prev)) }
+            } else {
+                // Safety: `prev < back <= len`.
+                unsafe { self.vec.get_unchecked(prev).clone() }
+            }
+        })
+    }
+
+    #[inline]
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        let len = self.back - self.front;
+        (len, Some(len))
+    }
+
+    #[inline]
+    fn count(self) -> usize {
+        self.len()
+    }
+}
+
+impl<T: Clone, const I: bool> DoubleEndedIterator for IntoIter<T, I> {
+    #[inline]
+    fn next_back(&mut self) -> Option<Self::Item> {
+        (self.back > self.front).then(|| {
+            self.back -= 1;
+            if self.unique {
+                // Safety: the allocation is owned alone, `back < len`, and the
+                // element is never dropped again.
+                unsafe { ptr::read(self.vec.data().add(self.back)) }
+            } else {
+                // Safety: `back < len`.
+                unsafe { self.vec.get_unchecked(self.back).clone() }
+            }
+        })
+    }
+}
+
+impl<T: Clone, const I: bool> ExactSizeIterator for IntoIter<T, I> {}
+
+impl<T, const I: bool> Drop for IntoIter<T, I> {
+    fn drop(&mut self) {
+        if !self.unique || !self.vec.is_allocated() {
+            return;
+        }
+
+        unsafe {
+            // The length is zeroed first so the vector's drop cannot drop an
+            // element twice if an element drop panics.
+            self.vec.len = 0;
+
+            // Safety: the allocation is owned alone; only the elements between
+            // `front` and `back` are still initialized.
+            ptr::drop_in_place(ptr::slice_from_raw_parts_mut(
+                self.vec.data_mut().add(self.front),
+                self.back - self.front,
+            ));
+        }
+    }
+}
+
+impl<T: Debug, const I: bool> Debug for IntoIter<T, I> {
+    #[inline]
+    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
+        f.debug_tuple("IntoIter").field(&self.as_slice()).finish()
+    }
+}
