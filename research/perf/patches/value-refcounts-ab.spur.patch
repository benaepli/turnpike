+/// Fails to compile if `LocalVec` is ever `Send` or `Sync`: each probe is
+/// ambiguous exactly when the auto trait holds.
+#[allow(dead_code)]
+const _: () = {
+    trait AmbiguousIfSend<A> {
+        fn probe() {}
+    }
+    impl<T: ?Sized> AmbiguousIfSend<()> for T {}
+    impl<T: ?Sized + Send> AmbiguousIfSend<u8> for T {}
+
+    trait AmbiguousIfSync<A> {
+        fn probe() {}
+    }
+    impl<T: ?Sized> AmbiguousIfSync<()> for T {}
+    impl<T: ?Sized + Sync> AmbiguousIfSync<u8> for T {}
+
+    fn assert_neither_send_nor_sync() {
+        let _ = <LocalVec<u8> as AmbiguousIfSend<_>>::probe;
+        let _ = <LocalVec<u8> as AmbiguousIfSync<_>>::probe;
+        let _ = <LocalVec<u8, true> as AmbiguousIfSend<_>>::probe;
+        let _ = <LocalVec<u8, true> as AmbiguousIfSync<_>>::probe;
+    }
+};
