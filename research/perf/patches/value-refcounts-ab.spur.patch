+        /// `IMMORTAL_ALLOWED` parameter is true may hold it.
+        #[inline]
+        pub(super) const fn new_immortal(capacity: usize) -> Self {
+            Self {
+                refs: Cell::new(IMMORTAL),
+                capacity,
+            }
+        }
+
+        /// Adds one owner. An immortal header is only read.
+        #[inline]
+        pub(super) fn inc_ref<const IMMORTAL_ALLOWED: bool>(&self) {
+            let prev = self.refs.get();
+            if IMMORTAL_ALLOWED && prev == IMMORTAL {
+                util_stats::record_literal_clone();
+                return;
+            }
+            if prev > isize::MAX as usize {
+                super::ref_count_overflow();
+            }
+            self.refs.set(prev + 1);
+        }
+
+        /// Removes one owner; true when none is left. An immortal header is
+        /// only read and always has owners left.
+        #[inline]
+        pub(super) fn dec_ref<const IMMORTAL_ALLOWED: bool>(&self) -> bool {
+            let prev = self.refs.get();
+            if IMMORTAL_ALLOWED && prev == IMMORTAL {
+                util_stats::record_literal_drop();
+                return false;
+            }
+            self.refs.set(prev - 1);
+            prev == 1
+        }
+
+        /// Whether exactly one vector owns the allocation. Never true of an
+        /// immortal header.
+        #[inline]
+        pub(super) fn is_unique_count(&self) -> bool {
+            self.refs.get() == 1
+        }
+
+        #[cfg(test)]
+        pub(super) fn count(&self) -> usize {
+            self.refs.get()
+        }
+    }
+}
+
+/// A vector with clone-on-write semantics.
+///
+/// Two words wide: a pointer to the first element and a length. The pointer
+/// is null-pointer optimized. The allocation holds the reference count and
+/// the capacity ahead of the elements.
+#[repr(C)]
+pub struct LocalVec<T, const IMMORTAL_ALLOWED: bool = false> {
+    /// `Self::dangling()` when the vector is unallocated. Otherwise it points
+    /// `Self::offset()` bytes after the start of a valid allocation and
+    /// header, at the first element, aligned to the larger of the header's and
+    /// `T`'s alignment. It is valid for `len` reads and `capacity` writes of
+    /// `T`. The elements may only be accessed mutably while the count is 1.
+    ptr: NonNull<T>,
+    /// Invariant: `len <= capacity`.
+    len: usize,
+    /// The raw pointer type keeps the vector neither `Send` nor `Sync` whatever
+    /// type `ptr` has.
+    phantom: PhantomData<(T, *const ())>,
+}
+
+impl<T, const I: bool> LocalVec<T, I> {
+    /// An empty vector. Does not allocate.
+    #[inline]
+    pub const fn new() -> Self {
+        Self {
+            ptr: Self::dangling(),
+            len: 0,
+            phantom: PhantomData,
+        }
+    }
+
+    /// An empty vector with room for at least `capacity` elements.
+    #[inline]
+    pub fn with_capacity(capacity: usize) -> Self {
+        let mut vec = Self::new();
+        if capacity > 0 {
+            // Safety: the count of a new vector is 1 and its capacity is 0,
+            // which is below the target.
+            unsafe {
+                vec.grow(capacity);
+            }
+        }
+        vec
+    }
+
+    #[inline]
+    pub const fn is_empty(&self) -> bool {
+        self.len == 0
+    }
+
+    #[inline]
+    pub const fn len(&self) -> usize {
+        self.len
+    }
+
+    /// How many elements the allocation can hold. Pushing may still allocate
+    /// below this when the allocation is shared.
+    #[inline]
+    pub fn capacity(&self) -> usize {
+        self.header().map_or(0, |header| header.capacity)
+    }
+
+    #[inline]
+    pub fn as_slice(&self) -> &[T] {
+        // Safety:
+        // - `data()` is non-null, aligned and valid for `len` reads.
+        // - `len <= capacity <= isize::MAX`.
+        // - No vector can mutate the elements while this borrow lives: `self`
+        //   is borrowed, and any other owner sees a count above 1.
+        unsafe { std::slice::from_raw_parts(self.data(), self.len) }
+    }
+
+    /// Removes all elements. A shared allocation is left to its other owners.
+    pub fn clear(&mut self) {
+        if self.is_empty() {
+            return;
+        }
+
+        if !self.is_unique() {
+            *self = Self::new();
+            return;
+        }
+
+        unsafe {
+            let prev = self.len;
+            // The length is zeroed first so a panicking element drop leaks
+            // instead of dropping twice.
+            self.len = 0;
+
+            // Safety: the allocation is owned by this vector alone and
+            // `data_mut()` is valid for `prev <= capacity` writes.
+            ptr::drop_in_place(ptr::slice_from_raw_parts_mut(self.data_mut(), prev));
+        }
+    }
+}
+
+impl<T: Clone, const I: bool> LocalVec<T, I> {
+    /// A vector of `n` clones of `value`.
+    pub fn from_elem(value: T, n: usize) -> Self {
+        let mut vec = Self::with_capacity(n);
+        for _ in 0..n {
+            // Safety: `with_capacity(n)` reserved room for `n` elements.
+            unsafe { vec.push_unchecked(value.clone()) }
+        }
+        vec
+    }
+
+    /// The elements as a mutable slice, copying them first when the
+    /// allocation is shared.
+    pub fn make_mut(&mut self) -> &mut [T] {
+        self.make_unique();
+
+        // Safety: the count is 1 after `make_unique`.
+        unsafe { std::slice::from_raw_parts_mut(self.data_mut(), self.len) }
+    }
+
+    /// Appends `value`, copying the elements first when the allocation is
+    /// shared.
+    #[inline]
+    pub fn push(&mut self, value: T) {
+        self.reserve((self.len == self.capacity()) as usize);
+
+        // Safety: `reserve` made the count 1 and left room for one element.
+        unsafe {
+            self.push_unchecked(value);
+        }
+    }
+
+    /// Appends without reallocating. The caller must ensure the count is 1 and
+    /// `len < capacity`.
+    #[inline]
+    unsafe fn push_unchecked(&mut self, value: T) {
+        debug_assert!(self.is_unique());
+        debug_assert!(self.len < self.capacity());
+
+        unsafe {
+            // Safety: `data_mut()` is valid for `capacity` writes and the
+            // caller guarantees `len < capacity`.
+            ptr::write(self.data_mut().add(self.len), value);
+            self.len += 1;
+        }
+    }
+
+    /// Removes and returns the last element, copying the elements first when
+    /// the allocation is shared.
+    #[inline]
+    pub fn pop(&mut self) -> Option<T> {
+        if self.is_empty() {
+            return None;
+        }
+
+        self.make_unique();
+
+        unsafe {
+            self.len -= 1;
+            // Safety: the count is 1 and `data() + len` is within the old
+            // length.
+            Some(ptr::read(self.data().add(self.len)))
+        }
+    }
+
+    /// Inserts `value` at `index`, shifting later elements right. Panics if
+    /// `index > len`.
+    pub fn insert(&mut self, index: usize, value: T) {
+        if index > self.len {
+            out_of_bounds(index, self.len);
+        }
+
+        self.reserve((self.len == self.capacity()) as usize);
+
+        unsafe {
+            // Safety: the count is 1 after `reserve`, `index <= len < capacity`,
+            // so `at` is valid for `len - index` reads and `at + 1` for as
+            // many writes.
+            let at = self.data_mut().add(index);
+            ptr::copy(at, at.add(1), self.len - index);
+            ptr::write(at, value);
+            self.len += 1;
+        }
+    }
+
+    /// Removes and returns the element at `index`, shifting later elements
+    /// left. Panics if `index >= len`.
+    pub fn remove(&mut self, index: usize) -> T {
+        if index >= self.len {
+            out_of_bounds(index, self.len);
+        }
+
+        self.make_unique();
+
+        unsafe {
+            // Safety: the count is 1 and `index < len`, so `at` is valid for
+            // one read and `at + 1` for `len - index - 1` reads.
+            let at = self.data_mut().add(index);
+            let value = ptr::read(at);
+            ptr::copy(at.add(1), at, self.len - index - 1);
+            self.len -= 1;
+            value
+        }
+    }
+
+    /// Keeps only the elements for which `f` returns true. Copies a shared
+    /// allocation even when every element is kept.
+    pub fn retain<F>(&mut self, mut f: F)
+    where
+        F: FnMut(&mut T) -> bool,
+    {
+        let len = self.len;
+        let values = self.make_mut();
+
+        let mut del = 0;
+        for i in 0..len {
+            if !f(&mut values[i]) {
+                del += 1;
+            } else if del > 0 {
+                values.swap(i - del, i);
+            }
+        }
+
+        if del > 0 {
+            self.truncate(len - del);
+        }
+    }
+
+    /// Keeps the first `target` elements. A shared allocation is copied only
+    /// when `target < len`.
+    pub fn truncate(&mut self, target: usize) {
+        if target >= self.len {
+            return;
+        }
+
+        if !self.is_unique() {
+            Self::note_shared_copy();
+            // Safety: `target < len`.
+            *self = Self::from(unsafe { self.get_unchecked(..target) });
+            return;
+        }
+
+        let rest = self.len - target;
+        unsafe {
+            self.len = target;
+
+            // Safety: the count is 1 and `data_mut() + target` is valid for
+            // `rest` elements that are still initialized.
+            ptr::drop_in_place(ptr::slice_from_raw_parts_mut(
+                self.data_mut().add(target),
+                rest,
+            ));
+        }
+    }
+
+    /// Leaves the vector with count 1 and room for `additional` more elements.
+    pub fn reserve(&mut self, additional: usize) {
+        let capacity = self.capacity();
+        let mut target = capacity;
+
+        if additional > capacity - self.len {
+            // At least the requested room, at least double the capacity, and
+            // at least the minimum capacity.
+            target = self
+                .len
+                .checked_add(additional)
+                .unwrap_or_else(|| capacity_overflow())
+                .max(2 * capacity)
+                .max(Self::min_cap());
+        }
+
+        if !self.is_unique() {
+            Self::note_shared_copy();
+            let mut vec = Self::with_capacity(target);
+            vec.extend(self.iter().cloned());
+            *self = vec;
+        } else if target > capacity {
+            // Safety: the count is 1 and `target > capacity`.
+            unsafe {
+                self.grow(target);
+            }
+        }
+    }
+
+    /// Appends clones of every element of `slice`.
+    pub fn extend_from_slice(&mut self, slice: &[T]) {
+        if slice.is_empty() {
+            return;
+        }
+
+        self.reserve(slice.len());
+
+        for value in slice {
+            // Safety: `reserve` made the count 1 and left room for
+            // `slice.len()` elements.
+            unsafe {
+                self.push_unchecked(value.clone());
+            }
+        }
+    }
+
+    /// Appends every element of an iterator whose `len` is exact.
+    ///
+    /// # Safety
+    /// `ExactSizeIterator::len` must return the exact number of elements the
+    /// iterator yields.
+    pub unsafe fn extend_from_trusted<It>(&mut self, iter: It)
+    where
+        It: IntoIterator<Item = T>,
+        It::IntoIter: ExactSizeIterator,
+    {
+        let iter = iter.into_iter();
+        let count = iter.len();
+
+        if count == 0 {
+            return;
+        }
+
+        self.reserve(count);
+
+        for value in iter {
+            // Safety: `reserve` made the count 1 and left room for `count`
+            // elements, which the caller guarantees is exact.
+            unsafe {
+                self.push_unchecked(value);
+            }
+        }
+    }
+
+    /// Leaves the vector the only owner of its allocation. May change the
+    /// capacity.
+    fn make_unique(&mut self) {
+        if !self.is_unique() {
+            Self::note_shared_copy();
+            *self = Self::from(self.as_slice());
+        }
+    }
+
+    /// Counts a copy of a shared allocation. Only string storage allows
+    /// immortal headers, so only copies of shared strings are counted.
+    #[inline]
+    fn note_shared_copy() {
+        if I {
+            crate::simulator::util_stats::record_shared_string_copy();
+        }
+    }
+}
+
+impl<T: Copy> LocalVec<T, true> {
+    /// A vector of the elements of `slice` behind an immortal header. The
+    /// capacity is the one `From<&[T]>` gives the same slice, so a copy made
+    /// from this vector is sized as a copy of an ordinary one would be.
+    pub(crate) fn immortal_from_slice(slice: &[T]) -> Self {
+        let mut vec = Self::new();
+        if slice.is_empty() {
+            return vec;
+        }
+        let target = slice.len().max(Self::min_cap());
+        // Safety: the vector is unallocated and `target > 0`.
+        unsafe {
+            vec.reallocate(target, true);
+        }
+        // Safety: the allocation was just created for `target >= slice.len()`
+        // elements, no other vector can see it yet, and it does not overlap
+        // `slice`.
+        unsafe {
+            ptr::copy_nonoverlapping(slice.as_ptr(), vec.data_mut(), slice.len());
+        }
+        vec.len = slice.len();
+        vec
+    }
+}
+
+impl<const I: bool> LocalVec<u8, I> {
+    /// Appends a copy of `bytes`, copying the vector first when it is shared.
+    #[inline]
+    pub(crate) fn extend_from_byte_slice(&mut self, bytes: &[u8]) {
+        if bytes.is_empty() {
+            return;
+        }
+
+        self.reserve(bytes.len());
+
+        // Safety: `reserve` made the count 1 and left room for `bytes.len()`
+        // more elements, and the destination cannot overlap `bytes` because
+        // `self` is borrowed mutably.
+        unsafe {
+            ptr::copy_nonoverlapping(bytes.as_ptr(), self.data_mut().add(self.len), bytes.len());
+        }
+
+        self.len += bytes.len();
+    }
+}
+
+impl<T, const I: bool> LocalVec<T, I> {
+    /// Grows the capacity to at least `target`.
+    ///
+    /// The caller must ensure the count is 1 and `target > capacity`.
+    unsafe fn grow(&mut self, target: usize) {
+        debug_assert!(self.is_unique());
+        debug_assert!(target > self.capacity());
+
+        // Safety: guaranteed by the caller.
+        unsafe {
+            self.reallocate(target, false);
+        }
+    }
+
+    /// Allocates or reallocates storage for at least `target` elements and
+    /// writes a new header, immortal when `immortal` is set.
+    ///
+    /// The caller must ensure `target > capacity` and that no other vector
+    /// owns the allocation. An immortal header may only be written to a
+    /// vector that is unallocated and whose parameter allows it.
+    unsafe fn reallocate(&mut self, mut target: usize, immortal: bool) {
+        debug_assert!(!immortal || (I && !self.is_allocated()));
+
+        if target > isize::MAX as usize {
+            capacity_overflow();
+        }
+
+        if mem::size_of::<T>() == 0 {
+            target = isize::MAX as usize;
+        }
+
+        let layout = Self::layout(target);
+        let allocation = if !self.is_allocated() {
+            // Safety: the layout has non-zero size because `target > 0`.
+            unsafe { std::alloc::alloc(layout) }
+        } else {
+            // Safety: the block was allocated with the layout of the current
+            // capacity, and `Self::size(target)` is non-zero and does not
+            // overflow `isize::MAX` when rounded up to the alignment.
+            unsafe {
+                std::alloc::realloc(
+                    self.allocation_mut(),
+                    Self::layout(self.capacity()),
+                    Self::size(target),
+                )
+            }
+        };
+
+        if allocation.is_null() {
+            std::alloc::handle_alloc_error(layout);
+        }
+
+        // Safety: the allocation is non-null and valid for `Self::size(target)`
+        // bytes, which exceeds `Self::offset()`.
+        unsafe {
+            self.ptr = NonNull::new_unchecked(allocation.add(Self::offset()).cast());
+        }
+        debug_assert_ne!(self.ptr, Self::dangling());
+
+        let header = if immortal {
+            Header::new_immortal(target)
+        } else {
+            Header::new(target)
+        };
+        // Safety: the allocation is valid for a write of the header. On a
+        // reallocation the header written holds count 1, which the caller
+        // guarantees was the count before.
+        unsafe {
+            ptr::write(allocation.cast::<Header>(), header);
+        }
+    }
+
+    #[inline]
+    fn is_allocated(&self) -> bool {
+        !ptr::eq(self.ptr.as_ptr(), Self::dangling().as_ptr())
+    }
+
+    /// The start of the backing allocation. Only valid when allocated.
+    #[inline]
+    unsafe fn allocation(&self) -> *const u8 {
+        debug_assert!(self.is_allocated());
+        unsafe { self.ptr.as_ptr().cast::<u8>().sub(Self::offset()) }
+    }
+
+    /// The start of the backing allocation, mutably. Only valid when
+    /// allocated.
+    #[inline]
+    unsafe fn allocation_mut(&mut self) -> *mut u8 {
+        debug_assert!(self.is_allocated());
+        unsafe { self.ptr.as_ptr().cast::<u8>().sub(Self::offset()) }
+    }
+
+    #[inline]
+    fn header(&self) -> Option<&Header> {
+        // Safety: an allocated vector always has a valid header.
+        self.is_allocated()
+            .then(|| unsafe { &*self.allocation().cast::<Header>() })
+    }
+
+    /// Non-null, aligned and valid for `len` reads of `T`.
+    #[inline]
+    fn data(&self) -> *const T {
+        self.ptr.as_ptr()
+    }
+
+    /// Valid for `capacity` writes of `T`. Only valid while the count is 1,
+    /// or while the allocation is being filled before any other vector can
+    /// see it.
+    #[inline]
+    unsafe fn data_mut(&mut self) -> *mut T {
+        self.ptr.as_ptr()
+    }
+
+    #[inline]
+    fn layout(capacity: usize) -> Layout {
+        // Safety: `Self::size` does not overflow `isize::MAX` when rounded up
+        // to `Self::align()`, which is a valid alignment.
+        unsafe { Layout::from_size_align_unchecked(Self::size(capacity), Self::align()) }
+    }
+
+    /// Always `> 0`, and `<= isize::MAX` when rounded up to `Self::align()`.
+    #[inline]
+    fn size(capacity: usize) -> usize {
+        mem::size_of::<T>()
+            .checked_mul(capacity)
+            .and_then(|size| Self::offset().checked_add(size))
+            .filter(|&size| size < isize::MAX as usize - Self::align())
+            .unwrap_or_else(|| capacity_overflow())
+    }
+
+    #[inline]
+    const fn align() -> usize {
+        max(mem::align_of::<Header>(), mem::align_of::<T>())
+    }
+
+    /// Always `> 0`: `ptr - offset` is the header.
+    #[inline]
+    const fn offset() -> usize {
+        max(mem::size_of::<Header>(), Self::align())
+    }
+
+    /// The pointer of an unallocated vector. It has no provenance and must not
+    /// be read, written or offset, but it is aligned, so it can back empty
+    /// slices. No allocated element pointer equals it, because elements start
+    /// `Self::offset()` bytes into an allocation that cannot start at 0.
+    #[inline]
+    const fn dangling() -> NonNull<T> {
+        unsafe {
+            #[allow(clippy::useless_transmute)]
+            let ptr = mem::transmute::<usize, *mut T>(Self::offset());
+            // Safety: `Self::offset()` is never 0.
+            NonNull::new_unchecked(ptr)
+        }
+    }
+
+    /// The smallest non-zero capacity.
+    #[inline]
+    const fn min_cap() -> usize {
+        if mem::size_of::<T>() == 1 {
+            8
+        } else if mem::size_of::<T>() <= 32 {
+            4
+        } else {
+            1
+        }
+    }
+
+    /// Whether no other vector shares the allocation. Takes `&mut self` so
+    /// the answer cannot go stale before the caller mutates.
+    #[inline]
+    pub fn is_unique(&mut self) -> bool {
+        self.header().map_or(true, |header| header.is_unique_count())
+    }
+
+    #[cfg(test)]
+    pub(crate) fn ref_count(&self) -> usize {
+        self.header().map_or(0, |header| header.count())
+    }
+}
+
+impl<T: Clone, const I: bool> Clone for LocalVec<T, I> {
+    #[inline]
+    fn clone(&self) -> Self {
+        if let Some(header) = self.header() {
+            header.inc_ref::<I>();
+        }
+
+        Self {
+            ptr: self.ptr,
+            len: self.len,
+            phantom: PhantomData,
+        }
+    }
