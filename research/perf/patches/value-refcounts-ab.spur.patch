+impl<T, const I: bool> Drop for LocalVec<T, I> {
+    fn drop(&mut self) {
+        if self.header().map_or(true, |header| !header.dec_ref::<I>()) {
+            return;
+        }
+
+        // Frees the allocation even if an element drop panics.
+        struct Dealloc(*mut u8, Layout);
+
+        impl Drop for Dealloc {
+            fn drop(&mut self) {
+                // Safety: the pointer and layout describe the allocation.
+                unsafe {
+                    std::alloc::dealloc(self.0, self.1);
+                }
+            }
+        }
+
+        // Safety: the vector has a header, so the allocation has the layout
+        // of the current capacity.
+        let _dealloc = unsafe { Dealloc(self.allocation_mut(), Self::layout(self.capacity())) };
+
+        // Safety: no other vector owns the allocation.
+        unsafe {
+            ptr::drop_in_place(ptr::slice_from_raw_parts_mut(self.data_mut(), self.len));
+        }
+    }
+}
