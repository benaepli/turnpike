+        use crate::simulator::core::queue_selector::{LOCAL_QUEUE_SIZES_INLINE, LocalQueueSizes};
+        for nodes in 0..(2 * LOCAL_QUEUE_SIZES_INLINE) {
+            let reference: Vec<usize> = (0..nodes).map(|n| (n * 7) % 4).collect();
+            let list: LocalQueueSizes = (0..nodes).map(|n| (n * 7) % 4).collect();
+            assert_eq!(list.as_slice(), reference.as_slice());
+            assert_eq!(list.spilled(), nodes > LOCAL_QUEUE_SIZES_INLINE);
+        }
+    }
