+    /// An eligible list holds exactly the indices a `Vec` collect of the same
+    /// filter holds, in the same order, whether it stays inline or spills,
+    /// and it spills exactly when it outgrows its inline capacity.
+    #[test]
+    fn eligible_lists_match_a_vec_collect_inline_and_spilled() {
+        for len in 0..(3 * ELIGIBLE_INLINE) {
+            for stride in 1..4 {
+                let keep = |i: &usize| i % stride == 0 || i % 5 == 3;
+                let reference: Vec<usize> = (0..len).filter(keep).collect();
+                let list: EligibleList = (0..len).filter(keep).collect();
+                assert_eq!(list.as_slice(), reference.as_slice());
+                assert_eq!(list.spilled(), reference.len() > ELIGIBLE_INLINE);
+            }
+        }
+        assert_eq!(std::mem::size_of::<EligibleList>(), 128);
+    }
+
+    /// The per-node size list keeps the sizes of every node in node order,
