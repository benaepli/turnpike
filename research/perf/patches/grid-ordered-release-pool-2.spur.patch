+        assert_eq!(timed.next_batch(0, 0, &mut cancelled), Some(usize::MAX));
+        assert_eq!(timed.next_batch(60, 1, &mut cancelled), None);
+        flag.store(true, Ordering::Relaxed);
+        assert_eq!(limit.next_batch(0, 0, &mut cancelled), None);
+        assert!(cancelled);
