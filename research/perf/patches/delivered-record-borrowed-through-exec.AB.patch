+/// Where a record goes once a segment of it has run. The record itself stays
+/// with its owner, which must apply the outcome with `settle_record` before
+/// anything else reads the queues or the channel: running the segment left
+/// the record exactly as the destination must hold it.
+pub enum RecordOutcome<H: HashPolicy> {
+    /// Blocked reading this channel of its own node; `Lhs` receives the value.
+    Parked(ChannelId, Lhs),
+    /// Yielded; it goes back to its node's local queue.
+    Requeued,
+    /// Returned; carries what its continuation produced.
+    Finished(Option<ClientOpResult<H>>),
+}
