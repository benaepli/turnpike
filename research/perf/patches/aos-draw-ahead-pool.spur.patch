+/// What one campaign adaptive-operator-selection slice's pool did.
+/// `pool_wall_ns` spans the whole slice, including the time the coordinator
+/// spends drawing and crediting between completions. A batch is drawn ahead
+/// when an earlier batch was still uncredited at its draw;
+/// `uncredited_at_draw_sum` sums those earlier uncredited batches over every
+/// draw. `gated_seed_batches` counts the waits of a seed batch that could not
+/// be drawn because an earlier batch was uncredited.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct AosPoolSession {
+    pub workers: u64,
+    pub pool_wall_ns: u64,
+    pub job_wall_ns: u64,
+    pub runs: u64,
+    pub batches: u64,
+    pub drawn_ahead_batches: u64,
+    pub gated_seed_batches: u64,
+    pub uncredited_at_draw_sum: u64,
+}
+
+/// One campaign adaptive-operator-selection slice's pool drained. Its clocks
+/// and counts land in the `batched_` leaves with capacity taken over the
+/// slice's whole pool wall.
+pub fn record_aos_pool(s: &AosPoolSession) {
+    if !enabled() {
+        return;
+    }
+    let capacity = s.workers.saturating_mul(s.pool_wall_ns);
+    GP_BATCHED_WORKER_IDLE_NS.fetch_add(capacity.saturating_sub(s.job_wall_ns), Ordering::Relaxed);
+    GP_BATCHED_RUN_WALL_NS.fetch_add(s.job_wall_ns, Ordering::Relaxed);
+    GP_BATCHED_POOL_WALL_NS.fetch_add(s.pool_wall_ns, Ordering::Relaxed);
+    GP_BATCHED_BATCHES.fetch_add(s.batches, Ordering::Relaxed);
+    GP_BATCHED_RUNS.fetch_add(s.runs, Ordering::Relaxed);
+    AP_DRAWN_AHEAD_BATCHES.fetch_add(s.drawn_ahead_batches, Ordering::Relaxed);
+    AP_GATED_SEED_BATCHES.fetch_add(s.gated_seed_batches, Ordering::Relaxed);
+    AP_UNCREDITED_AT_DRAW_SUM.fetch_add(s.uncredited_at_draw_sum, Ordering::Relaxed);
+}
