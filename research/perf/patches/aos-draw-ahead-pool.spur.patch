+    #[test]
+    fn aos_pool_draws_at_most_two_batches_ahead() {
+        let batch_size = 60usize;
+        let mut plan = SyntheticPlan::new();
+        let counter = AtomicI64::new(0);
+        let runs = SyntheticAosRuns::new(true);
+        let mut total = util_stats::AosPoolSession::default();
+        for _ in 0..2 {
+            let twenty_batches = |_: u64, batches: u64| (batches < 20).then_some(usize::MAX);
+            let result = run_aos_release(
+                &mut plan,
+                batch_size,
+                30,
+                &counter,
+                twenty_batches,
+                &|run_id, work| runs.run(run_id, work),
+            );
+            assert_eq!(result.session.batches, 20);
+            assert_eq!(plan.closed, plan.draws / batch_size as u64, "a batch was left open");
+            total.batches += result.session.batches;
+            total.drawn_ahead_batches += result.session.drawn_ahead_batches;
+            total.gated_seed_batches += result.session.gated_seed_batches;
+            total.uncredited_at_draw_sum += result.session.uncredited_at_draw_sum;
+        }
+        let mut credits = Vec::new();
+        let mut closes = 0u64;
+        for event in &plan.events {
+            match event {
+                PlanEvent::Draw {
+                    index,
+                    seed,
+                    closed,
+                    credited,
+                } => {
+                    let batch = index / batch_size as u64;
+                    assert!(
+                        batch - closed <= AOS_LOOKAHEAD_BATCHES as u64,
+                        "draw {index} saw {closed} closed batches"
+                    );
+                    assert!(
+                        batch * batch_size as u64 - credited <= 2 * batch_size as u64,
+                        "draw {index} saw {credited} credited children"
+                    );
+                    if *seed {
+                        assert_eq!(batch, *closed, "a seed batch was drawn ahead");
+                    }
+                }
+                PlanEvent::Credit(run_id) => credits.push(*run_id),
+                PlanEvent::Close(_) => {
+                    closes += 1;
+                    assert_eq!(credits.len() as u64, closes * batch_size as u64);
+                }
+            }
+        }
+        assert_eq!(credits, (0..2400).collect::<Vec<i64>>(), "credit order");
+        assert!(total.drawn_ahead_batches > 0, "nothing was drawn ahead: {total:?}");
+        assert!(total.uncredited_at_draw_sum >= total.drawn_ahead_batches);
+        assert!(total.uncredited_at_draw_sum <= 2 * total.drawn_ahead_batches);
+        assert_eq!(total.gated_seed_batches, 1, "{total:?}");
+    }
