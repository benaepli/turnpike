+    /// One event a synthetic adaptive-operator-selection controller saw.
+    #[derive(Clone, Debug, PartialEq, Eq)]
+    enum PlanEvent {
+        /// A position drawn: its draw index, whether it seeds, and how many
+        /// batches and children had been credited by then.
+        Draw {
+            index: u64,
+            seed: bool,
+            closed: u64,
+            credited: u64,
+        },
+        Credit(i64),
+        Close(bool),
+    }
+
+    /// A synthetic controller that seeds until its first batch closes and
+    /// logs every draw, credit and close.
+    struct SyntheticPlan {
+        seeded: bool,
+        draws: u64,
+        closed: u64,
+        credited: u64,
+        events: Vec<PlanEvent>,
+    }
+
+    impl SyntheticPlan {
+        fn new() -> Self {
+            Self {
+                seeded: false,
+                draws: 0,
+                closed: 0,
+                credited: 0,
+                events: Vec::new(),
+            }
+        }
+    }
+
+    impl AosPlan for SyntheticPlan {
+        type Work = u64;
+        type Child = i64;
+        fn seeding(&self) -> bool {
+            !self.seeded
+        }
+        fn draw(&mut self, seed: bool) -> u64 {
+            let index = self.draws;
+            self.draws += 1;
+            self.events.push(PlanEvent::Draw {
+                index,
+                seed,
+                closed: self.closed,
+                credited: self.credited,
+            });
+            index
+        }
+        fn credit(&mut self, child: i64) {
+            self.credited += 1;
+            self.events.push(PlanEvent::Credit(child));
+        }
+        fn finish_batch(&mut self, seed: bool) {
+            self.closed += 1;
+            if seed {
+                self.seeded = true;
+            }
+            self.events.push(PlanEvent::Close(seed));
+        }
+    }
+
+    /// A synthetic run: the child is the run id, the draw index must equal
+    /// the run id, and the run sleeps a hash of its id when `sleep` is set so
+    /// completions arrive out of order.
+    struct SyntheticAosRuns {
+        sleep: bool,
+        finished: std::sync::atomic::AtomicU64,
+        starts: std::sync::Mutex<Vec<i64>>,
+    }
+
+    impl SyntheticAosRuns {
+        fn new(sleep: bool) -> Self {
+            Self {
+                sleep,
+                finished: std::sync::atomic::AtomicU64::new(0),
+                starts: std::sync::Mutex::new(Vec::new()),
+            }
+        }
+
+        fn run(&self, run_id: i64, index: &u64) -> i64 {
+            self.starts.lock().unwrap().push(run_id);
+            assert_eq!(*index, run_id as u64, "work drawn out of run id order");
+            if self.sleep {
+                std::thread::sleep(std::time::Duration::from_micros(mix(run_id) % 400));
+            }
+            self.finished.fetch_add(1, Ordering::Relaxed);
+            run_id
+        }
+    }
+
+    /// Batches drawn whole, run in position order, credited in position order
+    /// and closed, one at a time.
+    fn sequential_aos_reference(
+        plan: &mut SyntheticPlan,
+        batch_size: usize,
+        run_counter: &AtomicI64,
+        mut next_batch: impl FnMut(u64, u64) -> Option<usize>,
+    ) {
+        let (mut issued, mut batches) = (0u64, 0u64);
+        while next_batch(issued, batches).is_some() {
+            let seed = plan.seeding();
+            let works: Vec<(i64, u64)> = (0..batch_size)
+                .map(|_| (run_counter.fetch_add(1, Ordering::Relaxed), plan.draw(seed)))
+                .collect();
+            for (run_id, _) in works {
+                plan.credit(run_id);
+            }
+            plan.finish_batch(seed);
+            issued += batch_size as u64;
+            batches += 1;
+        }
+    }
+
