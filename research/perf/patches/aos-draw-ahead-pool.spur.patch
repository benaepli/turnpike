+                writer: &writer,
+                run_counter: &counter,
+                weights: &weights,
+                session_seed: config.session_seed,
+                attribution: &attribution,
+            };
+            let mut explorer =
+                AosExplorer::<TimelineFeedback<false>>::new(config.clone(), batch_size, weights, config.session_seed);
+            for slice_runs in slices {
+                let mut issued = 0u64;
+                while issued < slice_runs {
+                    one.install(|| explorer.step(&ctx));
