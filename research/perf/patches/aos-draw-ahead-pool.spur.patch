+/// Earlier batches that may still be uncredited when an
+/// adaptive-operator-selection batch is drawn.
+const AOS_LOOKAHEAD_BATCHES: usize = 2;
+
+/// The controller an adaptive-operator-selection pool draws work from and
+/// credits children to.
+trait AosPlan {
+    type Work: Send;
+    type Child: Send;
+    /// Whether the next batch seeds, judged on the batches credited so far.
+    fn seeding(&self) -> bool;
+    /// The next run id's work, in run id order.
+    fn draw(&mut self, seed: bool) -> Self::Work;
+    /// One finished child, in batch order and then position order.
+    fn credit(&mut self, child: Self::Child);
+    /// Closes a batch once every one of its children is credited.
+    fn finish_batch(&mut self, seed: bool);
+}
+
+impl AosPlan for AosController<'_> {
+    type Work = AosWork;
+    type Child = AosChild;
+    fn seeding(&self) -> bool {
+        AosController::seeding(self)
+    }
+    fn draw(&mut self, seed: bool) -> AosWork {
+        AosController::draw(self, seed)
+    }
+    fn credit(&mut self, child: AosChild) {
+        AosController::credit(self, child)
+    }
+    fn finish_batch(&mut self, seed: bool) {
+        AosController::finish_batch(self, seed)
+    }
+}
+
+/// The adaptive-operator-selection bandit as an arm. Its batches overlap on
+/// the pool, but every run id's work is drawn from the same random stream
+/// positions, and children are credited in the same order with one bandit
+/// recompute per batch, as when each batch runs whole before the next is
+/// drawn. Only the controller state a batch drawn ahead reads can differ.
+struct AosArm<F: Feedback> {
+    explorer: AosExplorer<F>,
+    batch_size: usize,
+}
+
+impl<F: Feedback> Arm for AosArm<F> {
+    fn run_slice(&mut self, ctx: &StepCtx, limit: &SliceLimit) -> SliceOutcome {
+        let mut cancelled = false;
+        let (runner, mut controller) = self.explorer.split();
+        let pool = run_aos_release(
+            &mut controller,
+            self.batch_size,
+            rayon::current_num_threads(),
+            ctx.run_counter,
+            |issued, batches| limit.next_batch(issued, batches, &mut cancelled),
+            &|run_id, work| runner.run(ctx, run_id, work),
+        );
+        util_stats::record_aos_pool(&pool.session);
+        SliceOutcome {
+            runs: pool.session.runs,
+            failed: pool.failed,
+            cancelled,
+        }
+    }
+
+    fn vertex_coverage(&self) -> Option<HashMap<usize, u64>> {
+        Strategy::vertex_coverage(&self.explorer)
+    }
+}
+
+/// One batch of the adaptive-operator-selection pool. Positions start in
+/// order, so `launched` is both a count and the next position to start.
+struct AosBatch<W, C> {
+    first_id: i64,
+    seed: bool,
+    works: Vec<Option<W>>,
+    children: Vec<Option<C>>,
+    launched: usize,
+    unfinished: usize,
+}
+
+struct AosPoolResult {
+    session: util_stats::AosPoolSession,
+    failed: u64,
+}
+
+/// Runs batches of `batch_size` runs on `workers` workers until
+/// `next_batch` ends the slice, then drains: when this returns, every batch
+/// it issued has finished, been credited and been closed.
+///
+/// A batch is issued whole whenever `next_batch(issued, batches)` gives
+/// `Some`, whatever limit it gives. Run ids are taken from `run_counter` a
+/// batch at a time, and nothing else may take ids while this runs. Each wake
+/// credits finished batches in batch order before it draws, and draws only
+/// while workers would otherwise go without work, so with one worker every
+/// batch is drawn after its predecessor is credited. A batch drawn while
+/// earlier batches are uncredited reads the controller as credited so far;
+/// at most `AOS_LOOKAHEAD_BATCHES` earlier batches may be uncredited then, and
+/// a seed batch is never drawn that way.
+fn run_aos_release<P, R>(
+    plan: &mut P,
+    batch_size: usize,
+    workers: usize,
+    run_counter: &AtomicI64,
+    mut next_batch: impl FnMut(u64, u64) -> Option<usize>,
+    run: &R,
+) -> AosPoolResult
+where
+    P: AosPlan,
+    R: Fn(i64, &P::Work) -> P::Child + Sync,
+{
+    let workers = workers.max(1);
+    let batch_size = batch_size.max(1);
+    let mut session = util_stats::AosPoolSession {
+        workers: workers as u64,
+        ..Default::default()
+    };
+    let mut failed = 0u64;
+    let mut window: VecDeque<AosBatch<P::Work, P::Child>> = VecDeque::new();
+    let mut front_seq = 0u64;
+    let mut in_flight = 0usize;
+    let mut ready = 0usize;
+    let mut stopped = false;
+    let mut seed_wait_counted = false;
+    let pool_started = Instant::now();
+    let (tx, rx) = mpsc::channel::<Completion<P::Child>>();
+
+    rayon::in_place_scope(|scope| {
+        loop {
+            // Credit finished batches in batch order, then position order.
+            while window.front().is_some_and(|b| b.unfinished == 0) {
+                let Some(batch) = window.pop_front() else {
+                    break;
+                };
+                front_seq += 1;
+                for child in batch.children.into_iter().flatten() {
+                    plan.credit(child);
+                }
+                plan.finish_batch(batch.seed);
+            }
+
+            // Draw batches only while workers would otherwise go without work.
+            while !stopped && in_flight + ready < workers {
+                let uncredited = window.len();
+                if uncredited > AOS_LOOKAHEAD_BATCHES {
+                    break;
+                }
+                let seed = plan.seeding();
+                if seed && uncredited > 0 {
+                    if !seed_wait_counted {
+                        session.gated_seed_batches += 1;
+                        seed_wait_counted = true;
+                    }
+                    break;
+                }
+                if next_batch(session.runs, session.batches).is_none() {
+                    stopped = true;
+                    break;
+                }
+                let first_id = run_counter.fetch_add(batch_size as i64, Ordering::Relaxed);
+                let works = (0..batch_size).map(|_| Some(plan.draw(seed))).collect();
+                if uncredited > 0 {
+                    session.drawn_ahead_batches += 1;
+                    session.uncredited_at_draw_sum += uncredited as u64;
+                }
+                seed_wait_counted = false;
+                session.runs += batch_size as u64;
+                session.batches += 1;
+                ready += batch_size;
+                window.push_back(AosBatch {
+                    first_id,
+                    seed,
+                    works,
+                    children: (0..batch_size).map(|_| None).collect(),
+                    launched: 0,
+                    unfinished: batch_size,
+                });
+            }
+
+            // Start runs oldest batch first, in position order.
+            for (i, batch) in window.iter_mut().enumerate() {
+                while in_flight < workers && batch.launched < batch.works.len() {
+                    let pos = batch.launched;
+                    batch.launched += 1;
+                    ready -= 1;
+                    let Some(work) = batch.works[pos].take() else {
+                        continue;
+                    };
+                    in_flight += 1;
+                    let run_id = batch.first_id + pos as i64;
+                    let tx = tx.clone();
+                    let seq = front_seq + i as u64;
+                    scope.spawn(move |_| {
+                        let sender = CompletionSender {
+                            tx,
+                            batch: seq,
+                            pos,
+                            started: Instant::now(),
+                            sent: false,
+                        };
+                        let child = run(run_id, &work);
+                        drop(work);
+                        sender.send(child);
+                    });
+                }
+                if in_flight >= workers {
+                    break;
+                }
+            }
+
+            if in_flight == 0 {
+                break;
+            }
+
+            let mut next = rx.recv().ok();
+            while let Some(done) = next {
+                in_flight -= 1;
+                session.job_wall_ns += done.wall_ns;
+                let batch = &mut window[(done.batch - front_seq) as usize];
+                batch.unfinished -= 1;
+                match done.outcome {
+                    Some(child) => batch.children[done.pos] = Some(child),
+                    None => failed += 1,
+                }
+                next = rx.try_recv().ok();
+            }
+        }
+    });
+    session.pool_wall_ns = pool_started.elapsed().as_nanos() as u64;
+    AosPoolResult { session, failed }
+}
