+/// One position of an adaptive-operator-selection batch: a fresh random
+/// scenario when the batch seeds the population, otherwise the operator and
+/// parent drawn for it.
+pub(crate) struct AosWork(Option<(Operator, Individual)>);
+
+/// What every run of an adaptive-operator-selection batch reads, borrowed
+/// apart from the controller so runs can execute while it draws and credits.
+pub(crate) struct AosRunner<'a, F: Feedback> {
+    envelope: &'a ExplorerConfig,
+    global_state: &'a GlobalState<F>,
+    weights: &'a CoverageConfig,
+}
+
+/// The adaptive-operator-selection controller: the random stream, bandit and
+/// population that pick each run's work, and the per-scenario tuple sets that
+/// finished runs are credited against.
+pub(crate) struct AosController<'a> {
+    ctrl_rng: &'a mut SmallRng,
+    bandit: &'a mut Bandit,
+    scenario_tuples: &'a mut HashMap<u64, HashSet<TimelineTuple>>,
+    population: &'a mut Population,
+    seeded: &'a mut bool,
+}
+
+impl<F: Feedback> AosExplorer<F> {
+    pub(crate) fn split(&mut self) -> (AosRunner<'_, F>, AosController<'_>) {
+        (
+            AosRunner {
+                envelope: &self.envelope,
+                global_state: &self.global_state,
+                weights: &self.weights,
+            },
+            AosController {
+                ctrl_rng: &mut self.ctrl_rng,
+                bandit: &mut self.bandit,
+                scenario_tuples: &mut self.scenario_tuples,
+                population: &mut self.population,
+                seeded: &mut self.seeded,
+            },
+        )
+    }
+
+    /// The controller state a pick depends on, for comparing two explorers.
+    #[cfg(test)]
+    pub(crate) fn controller_fingerprint(&self) -> (SmallRng, [u64; 4], Vec<(u64, u64, u64)>, bool) {
+        (
+            self.ctrl_rng.clone(),
+            [
+                self.bandit.q[0].to_bits(),
+                self.bandit.q[1].to_bits(),
+                self.bandit.p[0].to_bits(),
+                self.bandit.p[1].to_bits(),
+            ],
+            self.population
+                .individuals
+                .iter()
+                .map(|x| (x.workload_seed, x.timeline_hash, x.score.to_bits()))
+                .collect(),
+            self.seeded,
+        )
+    }
+}
+
+impl<F: Feedback> AosRunner<'_, F> {
+    /// Runs one position with the same seeds and inputs `AosExplorer::step`
+    /// gives it.
+    pub(crate) fn run(&self, ctx: &StepCtx, run_id: i64, work: &AosWork) -> AosChild {
+        match &work.0 {
+            None => {
+                let mut cfg_rng =
+                    SmallRng::seed_from_u64(derive_seed(ctx.session_seed, run_id, CONFIG_SALT));
+                let cfg = SingleRunConfig::random(self.envelope, &mut cfg_rng);
+                run_recorded::<F>(
+                    ctx.program,
+                    ctx.writer,
+                    self.global_state,
+                    self.weights,
+                    cfg,
+                    ctx.session_seed,
+                    run_id,
+                    ctx.attribution,
+                )
+            }
+            Some((op, parent)) => run_aos_child::<F>(
+                ctx.program,
+                ctx.writer,
+                self.global_state,
+                self.weights,
+                self.envelope,
+                run_id,
+                *op,
+                parent,
+                ctx.attribution,
+            ),
+        }
+    }
+}
+
+impl AosController<'_> {
+    /// Whether the next batch seeds the population with fresh scenarios.
+    pub(crate) fn seeding(&self) -> bool {
+        !*self.seeded || self.population.individuals.is_empty()
+    }
+
+    /// The next position's work. A seed position draws nothing from the
+    /// random stream; any other position draws an operator, then a parent.
+    pub(crate) fn draw(&mut self, seed: bool) -> AosWork {
+        if seed {
+            return AosWork(None);
+        }
+        let op = self.bandit.pick(&mut *self.ctrl_rng);
+        let parent = self
+            .population
+            .select_parent(&mut *self.ctrl_rng)
+            .unwrap()
+            .clone();
+        AosWork(Some((op, parent)))
+    }
+
+    pub(crate) fn credit(&mut self, child: AosChild) {
+        aos_credit_and_insert(child, self.scenario_tuples, self.bandit, self.population);
+    }
+
+    /// Closes a batch once every one of its children is credited.
+    pub(crate) fn finish_batch(&mut self, seed: bool) {
+        self.bandit.recompute();
+        if seed {
+            *self.seeded = true;
+        }
+    }
+}
