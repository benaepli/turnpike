+                        Field::new_list_field(DataType::Utf8, true)
+                            .with_metadata(meta(&[(PARQUET_FIELD_ID_META_KEY, "10")])),
+                        true,
+                    )
+                    .with_metadata(meta(&[(PARQUET_FIELD_ID_META_KEY, "9")])),
+                    false, // fails to roundtrip keys_sorted
+                    true,
