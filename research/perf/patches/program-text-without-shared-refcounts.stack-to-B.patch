+        // We parse it as struct with `phone` repeated field as array.
+        let rows = test_file_reader_rows("repeated_no_annotation.parquet", None).unwrap();
+        let expected_rows = vec![
+            row![
+                ("id".to_string(), Field::Int(1)),
