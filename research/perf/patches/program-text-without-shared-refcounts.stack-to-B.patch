+        assert_eq!(levels.len(), 5);
+
+        // test "a" levels
+        let list_level = &levels[0];
+
+        let expected_level = ArrayLevels {
+            def_levels: None,
+            rep_levels: None,
+            non_null_indices: vec![0, 1, 2, 3, 4],
