+
+        let b_logical_nulls = b.logical_nulls();
+        let expected_level = ArrayLevels {
+            def_levels: Some(vec![1, 0, 0, 1, 1]),
+            rep_levels: None,
+            non_null_indices: vec![0, 3, 4],
