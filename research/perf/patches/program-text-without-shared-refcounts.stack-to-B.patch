+    ($case_num:literal $(, $expected_error:literal )? ) => {
+        paste::paste! {
+            #[test]
+            $( #[should_panic(expected = $expected_error)] )?
+            fn [<test_variant_integration_case_ $case_num>]() {
+                all_cases()[$case_num - 1].run()
+            }
+        }
+    };
+}
