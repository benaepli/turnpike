+        assert_eq!(list_level, &expected_level);
+
+        // test "d" levels
+        let list_level = levels.get(2).unwrap();
+
+        let d_logical_nulls = d.logical_nulls();
+        let expected_level = ArrayLevels {
+            def_levels: Some(vec![1, 1, 1, 2, 1]),
+            rep_levels: None,
+            non_null_indices: vec![3],
