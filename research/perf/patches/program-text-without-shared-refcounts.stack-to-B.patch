+/// Macro as a shortcut to generate 'not yet implemented' panic error.
+macro_rules! nyi {
+    ($column_descr:ident, $value:ident) => {{
+        unimplemented!(
+            "Conversion for physical type {}, converted type {}, value {:?}",
+            $column_descr.physical_type(),
