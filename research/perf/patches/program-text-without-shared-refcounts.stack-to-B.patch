+#[derive(Default)]
+struct SerializedPageReaderContext {
+    /// Controls decoding of page-level statistics
+    read_stats: bool,
+    /// Crypto context carrying objects required for decryption
+    #[cfg(feature = "encryption")]
+    crypto_context: Option<Arc<CryptoContext>>,
+}
