diff --git a/spur-core/src/simulator/core/program_text.rs b/spur-core/src/simulator/core/program_text.rs
new file mode 100644
index 0000000..08e4107
--- /dev/null
+++ b/spur-core/src/simulator/core/program_text.rs
@@ -0,0 +1,47 @@
+//! Thread-private copies of the long string literals of a decoded program.
+
+use crate::compiler::cfg::compiled::LongLiteral;
+use crate::simulator::util_stats::{self, InterpreterTally};
+use ecow::EcoString;
+use std::cell::RefCell;
+
+/// The running thread's copies of one decode's long literals, by slot.
+struct PrivateLiterals {
+    /// 0 until the thread first reads a literal; decodes number from 1.
+    generation: u64,
+    texts: Vec<Option<EcoString>>,
+}
+
+thread_local! {
+    static PRIVATE: RefCell<PrivateLiterals> = const {
+        RefCell::new(PrivateLiterals {
+            generation: 0,
+            texts: Vec::new(),
+        })
+    };
+}
+
+/// Returns a clone of this thread's copy of `lit`, equal to `lit.text`. The
+/// copy's reference count is written only by this thread and by the values
+/// the clone moves into. The table keeps one reference, so a clone is never
+/// the sole owner and an append to it copies, as it would for a clone of the
+/// shared text.
+#[inline]
+pub fn private_clone(lit: &LongLiteral, t: &mut InterpreterTally) -> EcoString {
+    t.private_literal_clones += 1;
+    PRIVATE.with(|cell| {
+        let mut private = cell.borrow_mut();
+        if private.generation != lit.generation {
+            private.generation = lit.generation;
+            private.texts.clear();
+            util_stats::record_literal_table_built();
+        }
+        let slot = lit.slot as usize;
+        if slot >= private.texts.len() {
+            private.texts.resize(slot + 1, None);
+        }
+        private.texts[slot]
+            .get_or_insert_with(|| EcoString::from(lit.text.as_str()))
+            .clone()
+    })
+}
