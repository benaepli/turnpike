+    let array = make_large_binary_array();
+    let file = write_parquet_with_encoding(array, Encoding::PLAIN);
+
+    let mut reader = ParquetRecordBatchReaderBuilder::try_new(file)
+        .unwrap()
+        .build()
+        .unwrap();
+
+    let _ = reader.next().unwrap();
+}
