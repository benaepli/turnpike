+        .await
+        .unwrap()
+        .with_projection(mask.clone())
+        .with_batch_size(1024)
+        .with_row_filter(filter)
+        .build()
+        .unwrap();
+
+    let batches: Vec<_> = stream.try_collect().await.unwrap();
+    assert_eq!(batches.len(), 1);
+
+    let batch = &batches[0];
