+/// Moves the subtree of a local store `t = e` into the next vertex `b` when
+/// `b` is entered only from the store and reads `t` as its whole condition,
+/// returned value or printed value, with `t` not live after `b`. The store
+/// becomes a jump, so `e` is evaluated at `b` against the same frame and node
+/// state it would have seen at the store: nothing runs in between, and the
+/// old value of `t` stays in place for `e` to read.
+fn fuse_consumed_temps(ops: &mut [Op], liveness: &super::frame_layout::LocalLiveness) {
+    for v in 0..ops.len() {
+        let (t, b) = match &ops[v] {
+            Op::AssignLocal {
+                slot,
+                next,
+                rhs: Opnd::Tree(_),
+            } => (*slot, *next as usize),
+            _ => continue,
+        };
+        if b == v || b >= ops.len() || liveness.preds(b) != 1 {
+            continue;
+        }
+        let consumes = match &ops[b] {
+            Op::CondLocal { slot, .. } => *slot == t && liveness.dead_after(b, t),
+            Op::ReturnTake(slot) | Op::Return(Opnd::Local(slot)) => *slot == t,
+            Op::Print {
+                value: Opnd::Local(slot),
+                ..
+            } => *slot == t && liveness.dead_after(b, t),
+            _ => false,
+        };
+        if !consumes {
+            continue;
+        }
+        let Op::AssignLocal { rhs, .. } = std::mem::replace(&mut ops[v], Op::TempMoved(b as u32))
+        else {
+            unreachable!("the store was matched above")
+        };
+        ops[b] = match std::mem::replace(&mut ops[b], Op::Goto(b as u32)) {
+            Op::CondLocal { then, els, .. } => Op::Cond {
+                cond: rhs,
+                then,
+                els,
+            },
+            Op::ReturnTake(_) | Op::Return(_) => Op::Return(rhs),
+            Op::Print { next, .. } => Op::Print { value: rhs, next },
+            _ => unreachable!("the consumer was matched above"),
+        };
+    }
+}
