+    let k_print = builder.add(Label::Print(Expr::Var(slot(0)), k_ret));
+    let k_entry = builder.add(Label::Instr(
+        Instr::Copy(Lhs::Var(slot(1)), Expr::Var(slot(0))),
+        k_print,
+    ));
+    let g_ret = builder.add(Label::Return(Expr::Var(slot(1))));
+    let g_entry = builder.add(Label::Instr(
+        Instr::Assign(
+            Lhs::Var(slot(1)),
+            Expr::Plus(Box::new(Expr::Var(slot(0))), Box::new(Expr::Int(1))),
+        ),
+        g_ret,
+    ));
+
+    let ret = builder.add(Label::Return(Expr::Var(slot(0))));
+    let final_print = builder.add(Label::Print(Expr::Var(slot(5)), ret));
+    let final_store = builder.add(Label::Instr(
+        Instr::Assign(
+            Lhs::Var(slot(5)),
+            Expr::Plus(Box::new(Expr::Var(slot(0))), Box::new(Expr::Int(100))),
+        ),
+        final_print,
+    ));
+    let head = builder.add(Label::Return(Expr::Unit));
+    let back = builder.add(Label::Continue(head));
+    let big_print = builder.add(Label::Print(Expr::Var(slot(0)), back));
+    let cond = builder.add(Label::Cond(Expr::Var(slot(3)), big_print, back));
+    let test = builder.add(Label::Instr(
+        Instr::Assign(
+            Lhs::Var(slot(3)),
+            Expr::GreaterThan(Box::new(Expr::Var(slot(0))), Box::new(Expr::Int(5))),
+        ),
+        cond,
+    ));
+    let acc = builder.add(Label::Instr(
+        Instr::Assign(
+            Lhs::Var(slot(0)),
+            Expr::Plus(Box::new(Expr::Var(slot(0))), Box::new(Expr::Var(slot(4)))),
+        ),
+        test,
+    ));
+    let call_g = builder.add(Label::Instr(
+        Instr::SyncCall(Lhs::Var(slot(4)), "g".to_string(), vec![Expr::Var(slot(3))]),
+        acc,
+    ));
+    let call_k = builder.add(Label::Instr(
+        Instr::SyncCall(Lhs::Var(slot(3)), "k".to_string(), vec![Expr::Var(slot(1))]),
+        call_g,
+    ));
+    builder.labels[head] = Label::ForLoopIn(
+        Lhs::Var(slot(1)),
+        Expr::List(vec![Expr::Int(1), Expr::Int(2), Expr::Int(3)]),
+        slot(2),
+        call_k,
+        final_store,
+    );
+    let iter_reset = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(slot(2)), Expr::Unit),
+        head,
+    ));
+    let init = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(slot(0)), Expr::Int(0)),
+        iter_reset,
+    ));
+    let mut program = builder.build_undecoded();
+    register(&mut program, "k", function(k_entry, 5, 1, 2, true));
+    register(&mut program, "g", function(g_entry, 6, 1, 2, true));
+    program.decode();
+
+    let on = CompiledProgram::build_with(&with_entry(program.clone(), init, 6), Rewrites::On);
+    for v in [test, g_entry, final_store] {
+        assert!(matches!(on.ops[v], Op::TempMoved(_)), "vertex {v}: {:?}", on.ops[v]);
+    }
+    assert!(matches!(on.ops[cond], Op::Cond { cond: Opnd::Tree(_), .. }));
+    assert!(matches!(on.ops[final_print], Op::Print { value: Opnd::Tree(_), .. }));
+    assert!(matches!(on.ops[g_ret], Op::Return(Opnd::Tree(_))));
+    for v in [k_ret, ret] {
+        assert!(matches!(on.ops[v], Op::ReturnTake(_)), "vertex {v}: {:?}", on.ops[v]);
+    }
+
+    for tally in assert_rewrites_agree(&program, init, 6) {
+        assert_eq!(tally.temps_fused, 7);
+        assert_eq!(tally.returns_taken, 4);
+    }
+}
+
+fn assert_failing_move_matches<H: HashPolicy>(
+    off: &Program,
+    on: &Program,
+    labels: &Program,
+    start: usize,
+    store: usize,
+    consumer: usize,
+    differing: &[Option<BTreeSet<u32>>],
+) {
+    let a = observe_rewrites::<H>(off, start, 2, differing);
+    let b = observe_rewrites::<H>(on, start, 2, differing);
+    let l = observe_rewrites::<H>(labels, start, 2, differing);
+    assert!(a.result.starts_with("error"), "{}", a.result);
+    for other in [&b, &l] {
+        assert_eq!(other.result, a.result);
+        assert_eq!(other.logs, a.logs);
+        assert_eq!(other.trace_text, a.trace_text);
+        assert_eq!(other.traces, a.traces);
+        assert_eq!(other.state, a.state);
+    }
+    assert_eq!(l.edges, a.edges);
+    let mut edges = a.edges.clone();
+    edges.push(((store, consumer), 1));
+    edges.sort_unstable();
+    assert_eq!(b.edges, edges);
+    assert_eq!(b.tally.label_execs, a.tally.label_execs + 1);
+    assert_eq!(b.tally.temps_fused, 1);
+    assert_eq!(b.tally.tree_evals, a.tally.tree_evals);
+}
+
+/// A moved subtree that fails raises the same error one vertex later, so the
+/// run fails alike: the result, logs, traces and state match the unrewritten
+/// form and the label loop, the moved store is the one extra vertex run, and
+/// its edge to the consumer is the one extra edge.
+#[test]
+fn a_failing_moved_subtree_fails_alike_one_vertex_later() {
+    let mut cases = Vec::new();
+
+    let mut builder = TestProgramBuilder::new();
+    let one = builder.add(Label::Return(Expr::Int(1)));
+    let zero = builder.add(Label::Return(Expr::Int(0)));
+    let cond = builder.add(Label::Cond(Expr::Var(slot(0)), one, zero));
+    let store = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(slot(0)), Expr::Unwrap(Box::new(Expr::Nil))),
+        cond,
+    ));
+    cases.push((builder.build_undecoded(), store, store, cond));
+
+    let mut builder = TestProgramBuilder::new();
+    let ret = builder.add(Label::Return(Expr::Unit));
+    let print = builder.add(Label::Print(Expr::Var(slot(0)), ret));
+    let store = builder.add(Label::Instr(
+        Instr::Assign(
+            Lhs::Var(slot(0)),
+            Expr::Find(
+                Box::new(Expr::Map(vec![(Expr::Int(1), Expr::Int(2))])),
+                Box::new(Expr::Int(5)),
+            ),
+        ),
+        print,
+    ));
+    cases.push((builder.build_undecoded(), store, store, print));
+
+    let mut builder = TestProgramBuilder::new();
+    let ret = builder.add(Label::Return(Expr::Var(slot(0))));
+    let store = builder.add(Label::Instr(
+        Instr::Assign(
+            Lhs::Var(slot(0)),
+            Expr::Plus(Box::new(Expr::Var(slot(1))), Box::new(Expr::Int(5))),
+        ),
+        ret,
+    ));
+    let init = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(slot(1)), Expr::Bool(true)),
+        store,
+    ));
+    cases.push((builder.build_undecoded(), init, store, ret));
+
+    for (program, start, store, consumer) in cases {
+        let program = with_entry(program, start, 2);
+        let mut off = program.clone();
+        off.compiled = CompiledProgram::build_with(&program, Rewrites::Off);
+        let mut on = program.clone();
+        on.compiled = CompiledProgram::build_with(&program, Rewrites::On);
+        assert_eq!(on.compiled.ops[store], Op::TempMoved(consumer as u32));
+        let analysis = check::analyze(&on, &on.compiled.ops, &check::entries(&on));
+        assert!(analysis.failures.is_empty(), "{:?}", analysis.failures);
+        let d = &analysis.differing_in;
+        assert_failing_move_matches::<NoHashing>(&off, &on, &program, start, store, consumer, d);
+        assert_failing_move_matches::<WithHashing>(&off, &on, &program, start, store, consumer, d);
+    }
+}
