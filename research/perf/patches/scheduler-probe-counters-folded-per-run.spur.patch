+    /// Scheduling-step probe counts made inside a run stay on the running
+    /// thread until the run's block folds, then read the totals a direct
+    /// session write would have given; outside a run they write the session
+    /// totals directly.
+    #[test]
+    fn scheduling_probe_counters_fold_into_the_session_totals_at_run_end() {
+        let _serial = config_override::exclusive_session();
+        set_enabled(true);
+        let session_totals = || {
+            [
+                &TIMER_CONTEXT_BIASED_STEPS,
+                &TIMER_CONTEXT_BIASED_STEPS_PROMOTED,
+                &TIMER_CONTEXT_BIASED_STEPS_SUPPRESSED,
+                &TIMER_CONTEXT_STEPS_EXCLUDED_SELECTOR,
+                &CA_TIMING_BIAS_EXAMINED,
+                &CA_TIMING_BIAS_WITHHELD,
+                &CRASH_PLACE_HOLDS,
+                &VS_VICTIM_CRASHED_HOLDS,
+            ]
+            .map(|c| c.load(Ordering::Relaxed))
+        };
+        let leaves = |s: &UtilizationSnapshot| {
+            [
+                s.timer_context.biased_steps,
+                s.timer_context.biased_steps_promoted,
+                s.timer_context.biased_steps_suppressed,
+                s.timer_context.steps_excluded_selector,
+                s.crash_anchor.timing_bias_examined,
+                s.crash_anchor.timing_bias_withheld,
+                s.crash_place.holds,
+                s.victim_swap.victim_crashed_holds,
+            ]
+        };
+        let before = snapshot();
+
+        begin_run();
+        record_timer_context_bias(2.0);
+        record_timer_context_bias(0.5);
+        record_timer_context_bias(1.0);
+        record_timer_context_excluded();
+        record_crash_timing_bias(true);
+        record_crash_timing_bias(false);
+        record_crash_place_hold();
+        record_crash_place_hold();
+        record_victim_crashed_hold();
+        let unfolded = session_totals();
+        let folded = snapshot();
+
+        record_crash_place_hold();
+        let direct = snapshot();
+        set_enabled(false);
+
+        assert_eq!(leaves(&before), [0; 8]);
+        assert_eq!(unfolded, [0; 8], "an unfinished run's counts reached the session totals");
+        let expected = [3, 1, 1, 1, 2, 1, 2, 1];
+        assert_eq!(leaves(&folded), expected);
+        assert_eq!(
+            folded.stats_local.folded_increments - before.stats_local.folded_increments,
+            expected.iter().sum::<u64>()
+        );
+        assert_eq!(folded.stats_local.folds - before.stats_local.folds, 1);
+        assert_eq!(direct.crash_place.holds, 3, "a write outside a run was not counted");
+        assert_eq!(
+            direct.stats_local.folded_increments,
+            folded.stats_local.folded_increments
+        );
+    }
+
