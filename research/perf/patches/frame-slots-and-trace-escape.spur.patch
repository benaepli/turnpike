+//! The trace payload written straight from the values must be the JSON array
+//! of the values' plain text, byte for byte.
+
+use super::*;
+use crate::analysis::resolver::NameId;
+use crate::simulator::core::values::{LinkId, ValueMap};
+use crate::simulator::hash_utils::WithHashing;
+use ecow::EcoString;
+use proptest::prelude::*;
+use std::sync::Arc;
+
+type V = Value<WithHashing>;
+
+/// One parameter: a value, or `None` for a failed evaluation.
+type Piece = Option<V>;
+
+fn evaluated(pieces: &[Piece]) -> impl Iterator<Item = Result<V, RuntimeError>> + '_ {
+    pieces.iter().map(|p| {
+        p.clone().ok_or(RuntimeError::TypeError {
+            expected: "int",
+            got: "bool",
+        })
+    })
+}
+
+fn reference(pieces: &[Piece]) -> String {
+    let mut text = String::new();
+    let mut ends = Vec::new();
+    for p in pieces {
+        match p {
+            Some(v) => v.write_to(&mut text).unwrap(),
+            None => text.push_str("<error>"),
+        }
+        ends.push(text.len());
+    }
+    let mut out = TextBuffer::default();
+    out.push_str("before");
+    json_string_array(&text, &ends, &mut out);
+    out.str_from("before".len()).to_string()
+}
+
+fn streamed(pieces: &[Piece]) -> String {
+    let mut out = TextBuffer::default();
+    out.push_str("before");
+    write_trace_payload(evaluated(pieces), &mut out);
+    out.str_from("before".len()).to_string()
+}
+
+fn assert_same(pieces: &[Piece]) {
+    let expected = reference(pieces);
+    assert_eq!(streamed(pieces), expected, "{pieces:?}");
+    let as_json: Vec<String> = serde_json::from_str(&expected).expect("the payload is JSON");
+    assert_eq!(as_json.len(), pieces.len());
+}
+
+fn node(role: usize, index: usize) -> NodeId {
+    NodeId {
+        role: NameId(role),
+        index,
+    }
+}
+
+fn every_awkward_character() -> String {
+    let mut s: String = (0u8..0x20).map(char::from).collect();
+    s.push('\u{7f}');
+    s.push_str("\"\\/ plain \u{e9}\u{4e2d}\u{1f600}\u{2028}");
+    s
+}
+
+#[test]
+fn streamed_payload_matches_the_array_of_plain_texts_on_enumerated_values() {
+    let awkward = every_awkward_character();
+    let s = |t: &str| V::string(EcoString::from(t));
+    let mut map = ValueMap::<WithHashing>::default();
+    map.insert(s(&awkward), V::list(ValueSeq::from(vec![V::int(-3), s("\n")])));
+    map.insert(V::int(7), V::option_some(V::tuple(ValueSeq::from(vec![V::unit(), V::bool(true)]))));
+    let leaves: Vec<V> = vec![
+        V::int(i64::MIN),
+        V::int(0),
+        V::bool(false),
+        V::unit(),
+        s(""),
+        s(&awkward),
+        V::node(node(usize::MAX, 3)),
+        V::channel(ChannelId {
+            node: node(2, 0),
+            id: 11,
+        }),
+        V::fifo_link(LinkId(5), node(1, 2)),
+        V::option_none(),
+        V::variant(0, EcoString::from("Empty"), None),
+        V::variant(1, EcoString::from(awkward.as_str()), None),
+        V::variant(2, EcoString::from("Wrap\"\\"), Some(Arc::new(s(&awkward)))),
+        V::map(map),
+    ];
+    assert_same(&[]);
+    assert_same(&[None]);
+    assert_same(&[None, None]);
+    for leaf in &leaves {
+        assert_same(&[Some(leaf.clone())]);
+    }
+    let mut all: Vec<Piece> = leaves.iter().cloned().map(Some).collect();
+    all.insert(3, None);
+    all.push(Some(V::list(ValueSeq::from(leaves.clone()))));
+    assert_same(&all);
+    for b in 0u8..0x80 {
+        assert_same(&[Some(s(&char::from(b).to_string())), None]);
+    }
+}
+
+fn arb_char() -> impl Strategy<Value = char> {
+    prop_oneof![
+        proptest::char::range('\u{0}', '\u{7f}'),
+        Just('"'),
+        Just('\\'),
+        Just('\u{7f}'),
+        Just('\u{e9}'),
+        Just('\u{4e2d}'),
+        Just('\u{1f600}'),
+        any::<char>(),
+    ]
+}
+
+fn arb_text() -> impl Strategy<Value = String> {
+    proptest::collection::vec(arb_char(), 0..12).prop_map(|cs| cs.into_iter().collect())
+}
+
+fn arb_node() -> impl Strategy<Value = NodeId> {
+    (any::<usize>(), any::<usize>()).prop_map(|(r, i)| node(r, i))
+}
+
+fn arb_value() -> impl Strategy<Value = V> {
+    let leaf = prop_oneof![
+        any::<i64>().prop_map(V::int),
+        any::<bool>().prop_map(V::bool),
+        arb_text().prop_map(|t| V::string(EcoString::from(t))),
+        arb_node().prop_map(V::node),
+        Just(V::unit()),
+        Just(V::option_none()),
+        (arb_node(), any::<usize>()).prop_map(|(n, id)| V::channel(ChannelId { node: n, id })),
+        (any::<usize>(), arb_node()).prop_map(|(l, n)| V::fifo_link(LinkId(l), n)),
+        (any::<u32>(), arb_text()).prop_map(|(e, name)| V::variant(e, EcoString::from(name), None)),
+    ];
+    leaf.prop_recursive(4, 48, 6, |inner| {
+        prop_oneof![
+            proptest::collection::vec(inner.clone(), 0..5).prop_map(|v| V::list(ValueSeq::from(v))),
+            proptest::collection::vec(inner.clone(), 0..5).prop_map(|v| V::tuple(ValueSeq::from(v))),
+            proptest::collection::vec((inner.clone(), inner.clone()), 0..4).prop_map(|pairs| {
+                let mut m = ValueMap::<WithHashing>::default();
+                for (k, v) in pairs {
+                    m.insert(k, v);
+                }
+                V::map(m)
+            }),
+            inner.clone().prop_map(V::option_some),
+            (any::<u32>(), arb_text(), inner)
+                .prop_map(|(e, name, p)| V::variant(e, EcoString::from(name), Some(Arc::new(p)))),
+        ]
+    })
+}
+
+proptest! {
+    #![proptest_config(ProptestConfig::with_cases(2048))]
+    #[test]
+    fn streamed_payload_matches_the_array_of_plain_texts_on_generated_values(
+        pieces in proptest::collection::vec(proptest::option::weighted(0.9, arb_value()), 0..6)
+    ) {
+        let expected = reference(&pieces);
+        prop_assert_eq!(streamed(&pieces), expected);
+    }
+}
