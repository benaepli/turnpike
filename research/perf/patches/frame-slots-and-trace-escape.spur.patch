+const HEX_DIGITS: &[u8; 16] = b"0123456789abcdef";
+
+/// For each byte: 0 when a JSON string holds it unchanged, otherwise the
+/// letter following the backslash of its escape, `u` meaning `\u00` and two
+/// lowercase hex digits. Matches `serde_json`'s compact formatter.
+static JSON_ESCAPE: [u8; 256] = {
+    let mut table = [0u8; 256];
+    let mut b = 0;
+    while b < 0x20 {
+        table[b] = b'u';
+        b += 1;
+    }
+    table[0x08] = b'b';
+    table[0x09] = b't';
+    table[0x0A] = b'n';
+    table[0x0C] = b'f';
+    table[0x0D] = b'r';
+    table[b'"' as usize] = b'"';
+    table[b'\\' as usize] = b'\\';
+    table
+};
+
