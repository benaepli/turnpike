+    /// Appends the characters of `s` as they appear inside a JSON string
+    /// literal, without the surrounding quotes: byte for byte what
+    /// `serde_json` writes between them. Escaping maps each byte on its own
+    /// and every escaped byte is ASCII, so the text of pieces escaped one by
+    /// one equals the text of their concatenation escaped at once.
+    pub fn push_json_string_content(&mut self, s: &str) {
+        let bytes = s.as_bytes();
+        let mut start = 0;
+        for (i, &b) in bytes.iter().enumerate() {
+            let escape = JSON_ESCAPE[b as usize];
+            if escape == 0 {
+                continue;
+            }
+            self.0.extend_from_slice(&bytes[start..i]);
+            if escape == b'u' {
+                self.0.extend_from_slice(&[
+                    b'\\',
+                    b'u',
+                    b'0',
+                    b'0',
+                    HEX_DIGITS[(b >> 4) as usize],
+                    HEX_DIGITS[(b & 0xF) as usize],
+                ]);
+            } else {
+                self.0.extend_from_slice(&[b'\\', escape]);
+            }
+            start = i + 1;
+        }
+        self.0.extend_from_slice(&bytes[start..]);
+    }
+
