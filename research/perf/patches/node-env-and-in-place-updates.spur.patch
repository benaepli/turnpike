+/// What running one decoded operation left behind.
+#[derive(Debug, PartialEq)]
+struct OpEffect {
+    outcome: String,
+    local: String,
+    node: String,
+    local_writes: u64,
+    node_writes: u64,
+    map_orders: Vec<Vec<String>>,
+    tally: InterpreterTally,
+    events: [u64; 3],
+    shared_at_write: u64,
+}
+
+/// What else holds the destination's contents while the operation runs.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Hold {
+    Nothing,
+    Collection,
+    Envs,
+}
+
+fn env_of(values: Vec<Value<NoHashing>>) -> Env<NoHashing> {
+    let mut env = Env::<NoHashing>::with_slots(values.len());
+    for (i, v) in values.into_iter().enumerate() {
+        env.set(i as u32, v);
+    }
+    env
+}
+
+fn map_orders(envs: [&Env<NoHashing>; 2]) -> Vec<Vec<String>> {
+    envs.iter()
+        .flat_map(|e| e.slots.iter())
+        .filter_map(|v| match &v.kind {
+            ValueKind::Map(m) => Some(m.iter().map(|(k, v)| format!("{k:?}={v:?}")).collect()),
+            _ => None,
+        })
+        .collect()
+}
+
+/// Runs `op` on freshly built environments, each slot holding its value
+/// alone unless `hold` keeps another reference, and returns what it left
+/// with the self update counts it recorded.
+fn run_one_op(
+    op: &Op,
+    make: &dyn Fn() -> (Vec<Value<NoHashing>>, Vec<Value<NoHashing>>),
+    dest: Dest,
+    hold: Hold,
+) -> (OpEffect, [u64; 5]) {
+    let (locals, nodes) = make();
+    let mut local_env = env_of(locals);
+    let mut node_env = env_of(nodes);
+    let held: Vec<Box<dyn std::fmt::Debug>> = match hold {
+        Hold::Nothing => vec![],
+        Hold::Collection => vec![Box::new(match dest {
+            Dest::Local(s) => local_env.get(s).clone(),
+            Dest::Node(s) => node_env.get(s).clone(),
+        })],
+        Hold::Envs => vec![Box::new(local_env.slots.clone()), Box::new(node_env.slots.clone())],
+    };
+    let held_before: Vec<String> = held.iter().map(|h| format!("{h:?}")).collect();
+    let program = TestProgramBuilder::new().build_undecoded();
+    let mut state = State::<NoHashing>::new(&[(NameId(0), 1)], 2);
+    let mut logger = TestLogger::new();
+    let mut coverage = LocalCoverage::new();
+    let mut tally = InterpreterTally::new();
+    let (node_counts_before, update_before) = util_stats::pending_in_place_counts();
+    let events_before = util_stats::pending_evaluator_events();
+    let result = run_common_op::<NoHashing, TestLogger, CfgFeedback>(
+        op,
+        &mut state,
+        &mut logger,
+        &program,
+        &mut local_env,
+        &mut node_env,
+        NodeId {
+            role: NameId(0),
+            index: 0,
+        },
+        &VertexMap::new(),
+        &mut coverage,
+        &SchedulePolicy::Fixed,
+        &PurgatoryConfig::default(),
+        None,
+        &mut None,
+        &mut None,
+        &mut SmallRng::seed_from_u64(0),
+        &mut tally,
+    );
+    let events_after = util_stats::pending_evaluator_events();
+    let (node_counts_after, update_after) = util_stats::pending_in_place_counts();
+    let outcome = match result {
+        Ok(Flow::Next(n)) => format!("next {n}"),
+        Ok(Flow::Return(v)) => format!("return {v:?}"),
+        Ok(Flow::RecordOnly) => "record only".to_string(),
+        Err(e) => format!("error {e} / {e:?}"),
+    };
+    let held_after: Vec<String> = held.iter().map(|h| format!("{h:?}")).collect();
+    assert_eq!(held_before, held_after, "a reference held outside the slot changed");
+    let effect = OpEffect {
+        outcome,
+        local: format!("{:?}", local_env.slots),
+        node: format!("{:?}", node_env.slots),
+        local_writes: local_env.writes,
+        node_writes: node_env.writes,
+        map_orders: map_orders([&local_env, &node_env]),
+        tally,
+        events: std::array::from_fn(|i| events_after[i] - events_before[i]),
+        shared_at_write: node_counts_after[2] - node_counts_before[2],
+    };
+    (effect, std::array::from_fn(|i| update_after[i] - update_before[i]))
+}
+
+/// A collection or scalar of one of twelve shapes, rebuilt identically on
+/// every call. Every non-empty map holds the key 1.
+fn shaped_value(shape: usize) -> Value<NoHashing> {
+    let mut rng = SmallRng::seed_from_u64(shape as u64);
+    let map = |n: usize, strings: bool, rng: &mut SmallRng| {
+        let mut m = ValueMap::<NoHashing>::new();
+        for i in 0..n {
+            let key = if i == 0 {
+                Value::int(1)
+            } else if strings && i % 2 == 0 {
+                Value::string(format!("k{}", rng.random_range(0..300)).into())
+            } else {
+                Value::int(rng.random_range(-50..300))
+            };
+            let inner = if i % 3 == 0 {
+                let mut inner = ValueMap::<NoHashing>::new();
+                inner.insert(Value::int(i as i64), Value::bool(true));
+                Value::map(inner)
+            } else {
+                Value::int(rng.random_range(0..1000))
+            };
+            m.insert(key, inner);
+        }
+        Value::map(m)
+    };
+    let list = |n: usize, rng: &mut SmallRng| {
+        Value::list((0..n).map(|_| Value::int(rng.random_range(0..1000))).collect())
+    };
+    match shape {
+        0 => map(0, false, &mut rng),
+        1 => map(1, false, &mut rng),
+        2 => map(5, false, &mut rng),
+        3 => map(40, false, &mut rng),
+        4 => map(100, true, &mut rng),
+        5 => map(700, false, &mut rng),
+        6 => list(0, &mut rng),
+        7 => list(1, &mut rng),
+        8 => list(7, &mut rng),
+        9 => list(40, &mut rng),
+        10 => Value::int(3),
+        _ => Value::string("s".into()),
+    }
+}
+
+fn self_update_rhs(d: Expr, same0: Expr, other1: Expr, other3: Expr) -> Vec<Expr> {
+    let b = |e: Expr| Box::new(e);
+    let int = |i: i64| Box::new(Expr::Int(i));
+    let missing = || Expr::Find(b(d.clone()), int(100_000));
+    vec![
+        Expr::Store(b(d.clone()), int(1), int(9)),
+        Expr::Store(b(d.clone()), int(100_000), int(9)),
+        Expr::Store(
+            b(d.clone()),
+            b(same0.clone()),
+            b(Expr::Plus(b(Expr::Find(b(d.clone()), b(same0.clone()))), int(1))),
+        ),
+        Expr::Store(b(d.clone()), int(1), b(d.clone())),
+        Expr::Store(b(d.clone()), b(missing()), int(1)),
+        Expr::Store(b(d.clone()), b(Expr::String("k1".into())), int(1)),
+        Expr::Store(b(d.clone()), int(-1), int(1)),
+        Expr::Store(b(d.clone()), int(40), int(1)),
+        Expr::Store(
+            b(d.clone()),
+            b(Expr::Find(b(other3.clone()), int(1))),
+            b(Expr::Find(b(other3.clone()), int(1))),
+        ),
+        Expr::Store(b(d.clone()), b(d.clone()), int(1)),
+        Expr::Store(b(d.clone()), int(1), b(missing())),
+        Expr::ListAppend(b(d.clone()), int(5)),
+        Expr::ListAppend(b(d.clone()), b(d.clone())),
+        Expr::ListAppend(b(d.clone()), b(missing())),
+        Expr::ListAppend(b(d.clone()), b(other1.clone())),
+        Expr::MapErase(int(1), b(d.clone())),
+        Expr::MapErase(int(100_000), b(d.clone())),
+        Expr::MapErase(b(missing()), b(d.clone())),
+        Expr::MapErase(b(d.clone()), b(d.clone())),
+        Expr::MapErase(b(Expr::String("k1".into())), b(d.clone())),
+        Expr::MapErase(b(other3), b(d)),
+    ]
+}
