+/// Whether `expr` reads the slot `dest` names. Slots of different kinds are
+/// different slots even at the same index.
+fn is_dest(dest: Dest, expr: &Expr) -> bool {
+    match (expr, dest) {
+        (Expr::Var(VarSlot::Local(idx, _)), Dest::Local(d))
+        | (Expr::Var(VarSlot::Node(idx, _)), Dest::Node(d)) => *idx == d,
+        _ => false,
+    }
+}
+
+/// The update an assignment to `dest` makes when its right side changes the
+/// collection `dest` itself holds, matched on the slot rather than the source
+/// name.
+fn self_update(dest: Dest, rhs: &Expr) -> Option<SelfUpdate> {
+    match rhs {
+        Expr::Store(col, key, value) if is_dest(dest, col) => Some(SelfUpdate::Store {
+            key: opnd(key),
+            value: opnd(value),
+        }),
+        Expr::ListAppend(list, item) if is_dest(dest, list) => {
+            Some(SelfUpdate::Append { item: opnd(item) })
+        }
+        Expr::MapErase(key, map) if is_dest(dest, map) => {
+            Some(SelfUpdate::Erase { key: opnd(key) })
+        }
+        _ => None,
+    }
+}
