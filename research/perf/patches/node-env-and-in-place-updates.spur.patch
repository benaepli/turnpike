+                    let mut col = take_slot(op.dest, local_env, node_env);
+                    if let ValueKind::Map(m) = &mut col.kind {
+                        m.insert(k, v);
+                    }
+                    put_slot(op.dest, col, local_env, node_env);
+                    util_stats::record_map_in_place(node);
+                }
+                ValueKind::List(l) => {
+                    let len = l.len();
+                    let idx = k.as_int()? as usize;
+                    if idx >= len {
+                        return Err(RuntimeError::IndexOutOfBounds { index: idx, len });
+                    }
+                    drop(k);
