+#[test]
+fn self_updates_in_place_match_the_tree_evaluator_and_assignment() {
+    let mut outcomes = std::collections::BTreeSet::new();
+    let mut runs = 0;
+    for dest_is_node in [false, true] {
+        let slot_of = |node: bool, i: u32, name: usize| {
+            if node {
+                VarSlot::Node(i, NameId(name))
+            } else {
+                VarSlot::Local(i, NameId(name))
+            }
+        };
+        let lhs = slot_of(dest_is_node, 1, 1);
+        let dest = if dest_is_node { Dest::Node(1) } else { Dest::Local(1) };
+        let rhs_cases = self_update_rhs(
+            Expr::Var(slot_of(dest_is_node, 1, 2)),
+            Expr::Var(slot_of(dest_is_node, 0, 3)),
+            Expr::Var(slot_of(!dest_is_node, 1, 4)),
+            Expr::Var(slot_of(!dest_is_node, 3, 5)),
+        );
+        for (case, rhs) in rhs_cases.iter().enumerate() {
+            let mut builder = TestProgramBuilder::new();
+            builder.add(Label::Instr(Instr::Assign(Lhs::Var(lhs), rhs.clone()), 0));
+            let program = builder.build();
+            let in_place = program.compiled.ops[0].clone();
+            let Op::SelfUpdate(update) = &in_place else {
+                panic!("case {case} did not decode to a self update: {in_place:?}");
+            };
+            let tree = match dest {
+                Dest::Local(slot) => Op::AssignLocal {
+                    slot,
+                    next: 0,
+                    rhs: crate::compiler::cfg::compiled::opnd(rhs),
+                },
+                Dest::Node(slot) => Op::AssignNode {
+                    slot,
+                    next: 0,
+                    rhs: crate::compiler::cfg::compiled::opnd(rhs),
+                },
+            };
+            for shape in 0..12 {
+                for other_shape in [shape, 3, 8] {
+                    let make = || {
+                        let env = |collection| {
+                            let mut lookup = ValueMap::<NoHashing>::new();
+                            lookup.insert(Value::int(1), Value::int(1));
+                            vec![
+                                Value::int(1),
+                                collection,
+                                Value::int(7),
+                                Value::map(lookup),
+                            ]
+                        };
+                        let (dest_env, other_env) =
+                            (env(shaped_value(shape)), env(shaped_value(other_shape)));
+                        if dest_is_node {
+                            (other_env, dest_env)
+                        } else {
+                            (dest_env, other_env)
+                        }
+                    };
+                    for hold in [Hold::Nothing, Hold::Collection, Hold::Envs] {
+                        let (want, tree_counts) = run_one_op(&tree, &make, dest, hold);
+                        let (got, counts) = run_one_op(&in_place, &make, dest, hold);
+                        let what = format!(
+                            "case {case} shape {shape} other {other_shape} hold {hold:?} dest {dest:?}"
+                        );
+                        assert_eq!(got, want, "{what}");
+                        assert_eq!(tree_counts, [0; 5], "{what}");
+                        runs += 1;
+                        let ok = got.outcome.starts_with("next");
+                        let is_map = shape <= 5;
+                        let kind = match (&update.update, is_map) {
+                            (SelfUpdate::Append { .. }, _) => "append",
+                            (_, true) => "map",
+                            (_, false) => "list",
+                        };
+                        let class = match got.outcome.split_once(" / ") {
+                            Some((_, debug)) => format!(
+                                "error {}",
+                                debug.split([' ', '(', '{']).next().unwrap_or("")
+                            ),
+                            None => "ok".to_string(),
+                        };
+                        outcomes.insert(format!("{kind} {class}"));
+                        let [map_local, map_node, list_local, list_node, list_shared] = counts;
+                        if !ok {
+                            assert_eq!(counts, [0; 5], "{what}");
+                            continue;
+                        }
+                        let (map, list) = if dest_is_node {
+                            (map_node + map_local * 100, list_node + list_local * 100)
+                        } else {
+                            (map_local + map_node * 100, list_local + list_node * 100)
+                        };
+                        if is_map {
+                            assert_eq!((map, list), (1, 0), "{what}");
+                        } else {
+                            assert_eq!((map, list), (0, 1), "{what}");
+                        }
+                        if matches!(update.update, SelfUpdate::Append { .. }) && case == 11 {
+                            let allocated = shape != 6;
+                            assert_eq!(
+                                list_shared,
+                                (hold != Hold::Nothing && allocated) as u64,
+                                "{what}"
+                            );
+                        }
+                        if !matches!(update.update, SelfUpdate::Append { .. }) {
+                            assert_eq!(list_shared, 0, "{what}");
+                        }
+                        if hold == Hold::Nothing {
+                            assert_eq!(got.shared_at_write, 0, "{what}");
+                        }
+                    }
+                }
+            }
+        }
+    }
+    assert!(runs > 1000);
+    for expected in [
+        "map ok",
+        "list ok",
+        "append ok",
+        "map error KeyNotFound",
+        "list error IndexOutOfBounds",
+        "list error TypeError",
+        "list error NotACollection",
+        "append error TypeError",
+        "append error IndexOutOfBounds",
+    ] {
+        assert!(outcomes.contains(expected), "no case reached {expected}: {outcomes:?}");
+    }
+}
