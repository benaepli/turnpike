+            Ok(node_env.get(*idx).clone())
+        }
+        Opnd::Int(i) => {
+            t.leaf_operands_inline += 1;
+            Ok(Value::<H>::int(*i))
+        }
+        Opnd::Str(s) => {
+            t.leaf_operands_inline += 1;
+            Ok(Value::<H>::string(s.clone()))
