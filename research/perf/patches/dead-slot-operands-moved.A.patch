+/// arguments, a channel send and returns, some of whose slots are read again.
+fn moving_program() -> (Program, usize) {
+    let mut builder = TestProgramBuilder::new();
+    let f_entry = builder.add(Label::Return(Expr::Var(slot(0))));
+    let h_entry = builder.add(Label::Return(Expr::Var(slot(0))));
+    let ret = builder.add(Label::Return(Expr::Var(slot(1))));
+    let print = builder.add(Label::Print(Expr::Var(slot(1)), ret));
+    let spawn = builder.add(Label::Instr(
+        Instr::Async(
+            Lhs::Var(slot(7)),
+            Expr::Var(node_slot(0)),
+            "h".to_string(),
+            vec![Expr::Var(slot(6))],
+        ),
+        print,
+    ));
+    let recv = builder.add(Label::Recv(Lhs::Var(slot(6)), Expr::Var(slot(5)), spawn));
+    let send = builder.add(Label::Send(Expr::Var(slot(5)), Expr::Var(slot(4)), recv));
+    let make = builder.add(Label::MakeChannel(Lhs::Var(slot(5)), None, send));
+    let call = builder.add(Label::Instr(
+        Instr::SyncCall(
+            Lhs::Var(slot(4)),
+            "f".to_string(),
+            vec![Expr::Var(slot(3)), Expr::Var(slot(1))],
+        ),
+        make,
+    ));
+    let to_node = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(node_slot(1)), Expr::Var(slot(3))),
+        call,
+    ));
+    let self_copy = builder.add(Label::Instr(
+        Instr::Copy(Lhs::Var(slot(3)), Expr::Var(slot(3))),
+        to_node,
+    ));
+    let moved = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(slot(3)), Expr::Var(slot(2))),
+        self_copy,
+    ));
+    let list = builder.add(Label::Instr(
+        Instr::Assign(
+            Lhs::Var(slot(2)),
+            Expr::List(vec![Expr::Var(slot(0)), Expr::Var(slot(1))]),
+        ),
+        moved,
+    ));
+    let copy = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(slot(1)), Expr::Var(slot(0))),
+        list,
+    ));
+    let init = builder.add(Label::Instr(
+        Instr::Assign(Lhs::Var(slot(0)), Expr::Int(5)),
+        copy,
+    ));
+    let mut program = builder.build_undecoded();
+    register(&mut program, "f", function(f_entry, 5, 2, 2, true));
+    register(&mut program, "h", function(h_entry, 6, 1, 1, false));
+    register(&mut program, "main", function(init, 7, 0, 8, false));
+    program.decode();
+    (program, init)
+}
+
+#[test]
+fn decoded_moves_match_the_label_loop_with_deferred_signatures() {
+    let (program, init) = moving_program();
+    let (decoded, _) = assert_loops_agree(program.clone(), init, 8);
+    assert!(decoded.result.contains("Int(5)"), "{}", decoded.result);
+
+    let (decoded, _) = assert_loops_agree_deferred(program, init, 8);
+    let t = decoded.tally;
+    assert_eq!(t.moves_self_copies, 1);
+    assert_eq!(t.moves_sends, 1);
+    assert_eq!(t.moves_returns, 2);
+    assert_eq!(t.moves_call_args, 2);
+    assert_eq!(t.moves_assigns, 1);
+    assert!(decoded.result.contains("Int(5)"), "{}", decoded.result);
+    assert_eq!(decoded.logs.len(), 1);
+}
