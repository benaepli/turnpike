+/// For every vertex of `program`, the local slots that some path leaving the
+/// vertex reads before writing, as bit words over the slots of the function
+/// whose entry reaches the vertex. A slot the vertex itself writes is not
+/// live after it on the edges that write reaches. The row is `None` when no
+/// function entry reaches the vertex, when entries of functions with
+/// different frames reach it, or when that function names a slot or a
+/// successor outside itself: nothing is known dead there.
+pub(super) fn live_after_vertices(program: &Program) -> Vec<Option<Vec<u64>>> {
+    let graph = &program.cfg.graph;
+    let len = graph.len();
+    let mut slot_counts: std::collections::BTreeMap<Vertex, Option<u32>> =
+        std::collections::BTreeMap::new();
+    for info in program.rpc.values() {
+        slot_counts
+            .entry(info.entry)
+            .and_modify(|n| {
+                if *n != Some(info.local_slot_count) {
+                    *n = None;
+                }
+            })
+            .or_insert(Some(info.local_slot_count));
+    }
+
+    let mut claims = vec![0u8; len];
+    let mut position = vec![usize::MAX; len];
+    let mut solved: Vec<(Vec<Vertex>, Option<Bits>)> = Vec::new();
+    for (&entry, &slots) in &slot_counts {
+        if entry >= len {
+            continue;
+        }
+        let mut reach = vec![entry];
+        let mut in_range = true;
+        position[entry] = 0;
+        let mut next = 0;
+        while next < reach.len() {
+            let v = reach[next];
+            next += 1;
+            for t in successors(&graph[v]).into_iter().flatten() {
+                if t >= len {
+                    in_range = false;
+                } else if position[t] == usize::MAX {
+                    position[t] = reach.len();
+                    reach.push(t);
+                }
+            }
+        }
+        for &v in &reach {
+            claims[v] = claims[v].saturating_add(1);
+        }
+        let rows = match slots {
+            Some(n) if in_range => live_after_rows(graph, &reach, &position, n as usize),
+            _ => None,
+        };
+        for &v in &reach {
+            position[v] = usize::MAX;
+        }
+        solved.push((reach, rows));
+    }
+
+    let mut out = vec![None; len];
+    for (reach, rows) in solved {
+        let Some(rows) = rows else { continue };
+        for (i, &v) in reach.iter().enumerate() {
+            if claims[v] == 1 {
+                out[v] = Some(rows.row(i).to_vec());
+            }
+        }
+    }
+    out
+}
+
+/// Live-after rows, in the order of `reach`, of the function whose labels are
+/// `reach` (every successor of a label in it is in it, and `position` maps
+/// each to its index), with `n` local slots; `None` when a label names a slot
+/// at or beyond `n`.
+fn live_after_rows(
+    graph: &[Label],
+    reach: &[Vertex],
+    position: &[usize],
+    n: usize,
+) -> Option<Bits> {
+    let m = reach.len();
+    let mut reads = Bits::new(m, n);
+    let mut kill_all = Bits::new(m, n);
+    let mut kill_first = Bits::new(m, n);
+    let mut succ: Vec<[Option<usize>; 2]> = Vec::with_capacity(m);
+    for (i, &v) in reach.iter().enumerate() {
+        let mut in_range = true;
+        visit_label(&mut graph[v].clone(), &mut |access, idx| {
+            let idx = *idx as usize;
+            if idx >= n {
+                in_range = false;
+                return;
+            }
+            match access {
+                Access::Read => reads.set(i, idx),
+                Access::Write => kill_all.set(i, idx),
+                Access::WriteFirstEdge => kill_first.set(i, idx),
+            }
+        });
+        if !in_range {
+            return None;
+        }
+        succ.push(successors(&graph[v]).map(|t| t.map(|t| position[t])));
+    }
+
+    let words = reads.words;
+    let mut live_in = Bits::new(m, n);
+    let mut after = Bits::new(m, n);
+    let mut changed = true;
+    while changed {
+        changed = false;
+        for i in (0..m).rev() {
+            let row_after = &mut after.data[i * words..(i + 1) * words];
+            row_after.iter_mut().for_each(|w| *w = 0);
+            for (e, target) in succ[i].iter().enumerate() {
+                let Some(t) = *target else { continue };
+                for w in 0..words {
+                    let mut kill = kill_all.row(i)[w];
+                    if e == 0 {
+                        kill |= kill_first.row(i)[w];
+                    }
+                    row_after[w] |= live_in.row(t)[w] & !kill;
+                }
+            }
+            for w in 0..words {
+                let value = reads.row(i)[w] | after.data[i * words + w];
+                if live_in.data[i * words + w] != value {
+                    live_in.data[i * words + w] = value;
+                    changed = true;
+                }
+            }
+        }
+    }
+    Some(after)
+}
