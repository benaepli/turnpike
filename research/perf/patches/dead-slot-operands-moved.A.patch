+//! Checks the moves decoding introduces by a separate method: a forward
+//! analysis over the decoded operations of every function, tracking the local
+//! slots that may hold a value moved out. No operation may read such a slot
+//! before writing it, and moves may only sit at the positions whose value the
+//! operation keeps.
+
+use super::*;
+use crate::compiler::cfg::Compiler;
+use crate::compiler::compile_with;
+use std::collections::{BTreeSet, HashMap, VecDeque};
+use std::path::{Path, PathBuf};
+
+/// One local slot event of an operation, in execution order.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Event {
+    Read(u32),
+    /// A read that leaves the slot's value moved out.
+    Move(u32),
+    Write(u32),
+    /// A write that happens only on the way to the first successor.
+    WriteFirst(u32),
+}
+
+fn tree_events(e: &CExpr, out: &mut Vec<Event>) -> Result<(), String> {
+    let mut stack: Vec<&Opnd> = Vec::new();
+    match e {
+        CExpr::Find(a, b)
+        | CExpr::And(a, b)
+        | CExpr::Or(a, b)
+        | CExpr::EqualsEquals(a, b)
+        | CExpr::NotEquals(a, b)
+        | CExpr::ListPrepend(a, b)
+        | CExpr::ListAppend(a, b)
+        | CExpr::LessThan(a, b)
+        | CExpr::LessThanEquals(a, b)
+        | CExpr::GreaterThan(a, b)
+        | CExpr::GreaterThanEquals(a, b)
+        | CExpr::KeyExists(a, b)
+        | CExpr::MapErase(a, b)
+        | CExpr::Plus(a, b)
+        | CExpr::Minus(a, b)
+        | CExpr::Times(a, b)
+        | CExpr::Div(a, b)
+        | CExpr::Mod(a, b)
+        | CExpr::Min(a, b)
+        | CExpr::Coalesce(a, b)
+        | CExpr::SafeFind(a, b) => stack.extend([a, b]),
+        CExpr::ListSubsequence(a, b, c) | CExpr::Store(a, b, c) => stack.extend([a, b, c]),
+        CExpr::FieldGet(a, _)
+        | CExpr::Not(a)
+        | CExpr::ListLen(a)
+        | CExpr::ListAccess(a, _)
+        | CExpr::TupleAccess(a, _)
+        | CExpr::Unwrap(a)
+        | CExpr::Some(a)
+        | CExpr::IntToString(a)
+        | CExpr::BoolToString(a)
+        | CExpr::NodeToString(a)
+        | CExpr::IsVariant(a, _)
+        | CExpr::VariantPayload(a)
+        | CExpr::SafeTupleAccess(a, _) => stack.push(a),
+        CExpr::Map(pairs) => pairs.iter().for_each(|(k, v)| stack.extend([k, v])),
+        CExpr::List(items) | CExpr::Tuple(items) => stack.extend(items),
+        CExpr::Variant(_, _, payload) => stack.extend(payload),
+    }
+    for o in stack {
+        read_events(o, out)?;
+    }
+    Ok(())
+}
+
+/// Events of a position that only reads.
+fn read_events(o: &Opnd, out: &mut Vec<Event>) -> Result<(), String> {
+    match o {
+        Opnd::Local(s) => out.push(Event::Read(*s)),
+        Opnd::Take(s) => return Err(format!("a move of slot {s} at a position that only reads")),
+        Opnd::Tree(e) => tree_events(e, out)?,
+        Opnd::Node(_) | Opnd::Int(_) | Opnd::Str(_) | Opnd::Bool(_) | Opnd::Unit | Opnd::Nil => {}
+    }
+    Ok(())
+}
+
+/// Events of a position whose value the operation keeps.
+fn kept_events(o: &Opnd, out: &mut Vec<Event>) -> Result<(), String> {
+    match o {
+        Opnd::Take(s) => {
+            out.push(Event::Move(*s));
+            Ok(())
+        }
+        other => read_events(other, out),
+    }
+}
+
+fn dest_event(d: &Dest, first_only: bool, out: &mut Vec<Event>) {
+    if let Dest::Local(s) = d {
+        out.push(if first_only {
+            Event::WriteFirst(*s)
+        } else {
+            Event::Write(*s)
+        });
+    }
+}
+
+/// The operation's local slot events in execution order and its successors.
+/// A spin-await runs itself again until its condition holds.
+fn op_events(op: &Op, at: usize) -> Result<(Vec<Event>, Vec<usize>), String> {
+    let mut ev = Vec::new();
+    let n = |x: &u32| *x as usize;
+    let succ = match op {
+        Op::AssignLocal { slot, next, rhs } => {
+            kept_events(rhs, &mut ev)?;
+            ev.push(Event::Write(*slot));
+            vec![n(next)]
+        }
+        Op::SelfCopy { slot, next } => {
+            ev.push(Event::Read(*slot));
+            ev.push(Event::Write(*slot));
+            vec![n(next)]
+        }
+        Op::AssignNode { next, rhs, .. } => {
+            kept_events(rhs, &mut ev)?;
+            vec![n(next)]
+        }
+        Op::SyncCall(call) => {
+            for a in &call.args {
+                kept_events(a, &mut ev)?;
+            }
+            dest_event(&call.dest, false, &mut ev);
+            vec![n(&call.next)]
+        }
+        Op::Async(call) => {
+            read_events(&call.target, &mut ev)?;
+            for a in &call.args {
+                kept_events(a, &mut ev)?;
+            }
+            dest_event(&call.dest, false, &mut ev);
+            vec![n(&call.next)]
+        }
+        Op::MakeChannel { dest, next }
+        | Op::SetTimer { dest, next, .. }
+        | Op::UniqueId { dest, next }
+        | Op::RetrieveData { dest, next, .. } => {
+            dest_event(dest, false, &mut ev);
+            vec![n(next)]
+        }
+        Op::MakeFifoLink { dest, next, peer } => {
+            read_events(peer, &mut ev)?;
+            dest_event(dest, false, &mut ev);
+            vec![n(next)]
+        }
+        Op::CondLocal { slot, then, els } => {
+            ev.push(Event::Read(*slot));
+            vec![n(then), n(els)]
+        }
+        Op::CondNode { then, els, .. } => vec![n(then), n(els)],
+        Op::Cond { cond, then, els } => {
+            read_events(cond, &mut ev)?;
+            vec![n(then), n(els)]
+        }
+        Op::Return(rhs) => {
+            kept_events(rhs, &mut ev)?;
+            vec![]
+        }
+        Op::Print { value, next } | Op::PersistData { value, next, .. } => {
+            read_events(value, &mut ev)?;
+            vec![n(next)]
+        }
+        Op::Goto(next) | Op::DiscardData(next) | Op::Pause(next) => vec![n(next)],
+        Op::ForLoopIn(fl) => {
+            if let Some(s) = fl.iter_slot {
+                ev.push(Event::Read(s));
+            }
+            read_events(&fl.collection, &mut ev)?;
+            if let Some(s) = fl.iter_slot {
+                ev.push(Event::Write(s));
+            }
+            dest_event(&fl.dest, true, &mut ev);
+            vec![n(&fl.body), n(&fl.next)]
+        }
+        Op::TraceDispatch(td) => {
+            for p in &td.params {
+                read_events(p, &mut ev)?;
+            }
+            vec![n(&td.next)]
+        }
+        Op::TraceEnter(te) => {
+            dest_event(&te.dest, false, &mut ev);
+            for p in &te.params {
+                read_events(p, &mut ev)?;
+            }
+            vec![n(&te.next)]
+        }
+        Op::TraceExit(tx) => {
+            read_events(&tx.trace_id, &mut ev)?;
+            read_events(&tx.return_value, &mut ev)?;
+            vec![n(&tx.next)]
+        }
+        Op::Send(send) => {
+            read_events(&send.chan, &mut ev)?;
+            kept_events(&send.value, &mut ev)?;
+            vec![n(&send.next)]
+        }
+        Op::Recv(recv) => {
+            read_events(&recv.chan, &mut ev)?;
+            dest_event(&recv.dest, false, &mut ev);
+            vec![n(&recv.next)]
+        }
+        Op::SpinAwait { cond, next } => {
+            read_events(cond, &mut ev)?;
+            vec![n(next), at]
+        }
+    };
+    Ok((ev, succ))
+}
+
+/// Accepts the decoded operations of the function entered at `entry` when no
+/// path reads a slot between a move out of it and the next write to it.
+fn check_moves(ops: &[Op], entry: usize) -> Result<usize, String> {
+    let mut moved_in: HashMap<usize, BTreeSet<u32>> = HashMap::from([(entry, BTreeSet::new())]);
+    let mut work = VecDeque::from([entry]);
+    let mut moves = 0;
+    let mut seen = BTreeSet::new();
+    while let Some(v) = work.pop_front() {
+        let op = ops.get(v).ok_or_else(|| format!("vertex {v} is outside the program"))?;
+        let (events, succ) = op_events(op, v).map_err(|e| format!("vertex {v}: {e}"))?;
+        let mut moved = moved_in[&v].clone();
+        let mut first_only = Vec::new();
+        for event in events {
+            match event {
+                Event::Read(s) | Event::Move(s) if moved.contains(&s) => {
+                    return Err(format!("vertex {v} reads slot {s} after its value was moved out"));
+                }
+                Event::Read(_) => {}
+                Event::Move(s) => {
+                    if seen.insert((v, s)) {
+                        moves += 1;
+                    }
+                    moved.insert(s);
+                }
+                Event::Write(s) => {
+                    moved.remove(&s);
+                }
+                Event::WriteFirst(s) => first_only.push(s),
+            }
+        }
+        for (edge, &target) in succ.iter().enumerate() {
+            let mut out = moved.clone();
+            if edge == 0 {
+                for s in &first_only {
+                    out.remove(s);
+                }
+            }
+            let entry = moved_in.entry(target).or_default();
+            let before = entry.len();
+            entry.extend(out);
+            if entry.len() != before || !seen.contains(&(target, u32::MAX)) {
+                seen.insert((target, u32::MAX));
+                work.push_back(target);
+            }
+        }
+    }
+    Ok(moves)
+}
+
+/// Every vertex some function entry reaches through the decoded operations.
+fn reached(program: &Program) -> BTreeSet<usize> {
+    let mut out = BTreeSet::new();
+    let mut work: VecDeque<usize> = program.rpc.values().map(|f| f.entry).collect();
+    while let Some(v) = work.pop_front() {
+        if v >= program.compiled.ops.len() || !out.insert(v) {
+            continue;
+        }
+        if let Ok((_, succ)) = op_events(&program.compiled.ops[v], v) {
+            work.extend(succ);
+        }
+    }
+    out
+}
+
+fn has_move(op: &Op) -> bool {
+    matches!(op, Op::SelfCopy { .. })
+        || op_events(op, 0).map_or(true, |(ev, _)| ev.iter().any(|e| matches!(e, Event::Move(_))))
+}
+
+fn spec_files(dir: &Path, out: &mut Vec<PathBuf>) {
+    for entry in std::fs::read_dir(dir).expect("the spec directory is readable") {
+        let path = entry.expect("a directory entry").path();
+        if path.is_dir() {
+            spec_files(&path, out);
+        } else if path.extension().is_some_and(|e| e == "spur") {
+            out.push(path);
+        }
+    }
+}
+
+fn on_big_stack(f: impl FnOnce() + Send + 'static) {
+    std::thread::Builder::new()
+        .stack_size(64 * 1024 * 1024)
+        .spawn(f)
+        .expect("the test thread starts")
+        .join()
+        .expect("the test thread finishes");
+}
+
+/// The spec directory: `SPUR_SPEC_DIR` when set, the repository's otherwise.
+fn spec_root() -> PathBuf {
+    std::env::var_os("SPUR_SPEC_DIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| Path::new(env!("CARGO_MANIFEST_DIR")).join("../../bin/spur"))
+}
+
+#[test]
+fn every_spec_reads_no_slot_after_moving_its_value_out() {
+    on_big_stack(|| {
+        let root = spec_root();
+        let mut files = Vec::new();
+        spec_files(&root, &mut files);
+        files.sort();
+        assert!(!files.is_empty(), "no spec under {}", root.display());
+        let mut failures = Vec::new();
+        let (mut compiled, mut total_moves) = (0, 0);
+        for file in &files {
+            let name = file.display().to_string();
+            let source = std::fs::read_to_string(file).expect("the spec is readable");
+            let Ok(program) = compile_with(&source, &name, Compiler::new()).into_program() else {
+                eprintln!("{name}: does not compile, skipped");
+                continue;
+            };
+            compiled += 1;
+            assert!(program.compiled.covers(program.cfg.graph.len()), "{name}");
+            let mut moves = 0;
+            let mut entries: Vec<_> = program.rpc.values().map(|f| f.entry).collect();
+            entries.sort();
+            entries.dedup();
+            for entry in entries {
+                match check_moves(&program.compiled.ops, entry) {
+                    Ok(m) => moves += m,
+                    Err(e) => failures.push(format!("{name} entry {entry}: {e}")),
+                }
+            }
+            let reach = reached(&program);
+            for (v, op) in program.compiled.ops.iter().enumerate() {
+                if !reach.contains(&v) && has_move(op) {
+                    failures.push(format!("{name}: vertex {v} is in no function but moves"));
+                }
+            }
+            eprintln!("{name}: {moves} move positions");
+            total_moves += moves;
+        }
+        assert!(compiled > 0, "no spec compiled");
+        assert!(total_moves > 0, "no spec decoded a move");
+        assert!(failures.is_empty(), "moves that a later read sees:\n{}", failures.join("\n"));
+    });
+}
+
+const COPY_SPEC: &str = r#"
+role Node {
+    var total: int = 0;
+
+    fn Mix(x: int, xs: list<int>): int {
+        var y: int = x;
+        var ys: list<int> = xs;
+        total = y;
+        for var i: int = 0; i < x; i = i + 1 {
+            ys = append(ys, i);
+        }
+        return x + y + len(ys) + len(xs);
+    }
+
+    fn Pass(x: int): int {
+        var z: int = Mix(x, [x]);
+        return z;
+    }
+}
+"#;
+
+/// Every position of a function's operations that keeps a value from a
+/// local slot without moving it.
+fn kept_locals(ops: &[Op], reach: &BTreeSet<usize>) -> Vec<(usize, usize)> {
+    let mut out = Vec::new();
+    for &v in reach {
+        let count = match &ops[v] {
+            Op::AssignLocal { rhs: Opnd::Local(_), .. }
+            | Op::AssignNode { rhs: Opnd::Local(_), .. }
+            | Op::Return(Opnd::Local(_)) => 1,
+            Op::SyncCall(call) => call.args.len(),
+            Op::Async(call) => call.args.len(),
+            Op::Send(send) if matches!(send.value, Opnd::Local(_)) => 1,
+            _ => 0,
+        };
+        for k in 0..count {
+            out.push((v, k));
+        }
+    }
+    out
+}
+
+/// Turns the `k`-th kept position of vertex `v` into a move when it reads a
+/// local slot, and says whether it did.
+fn force_move(op: &mut Op, k: usize) -> bool {
+    let target = match op {
+        Op::AssignLocal { rhs, .. } | Op::AssignNode { rhs, .. } | Op::Return(rhs) => rhs,
+        Op::SyncCall(call) => &mut call.args[k],
+        Op::Async(call) => &mut call.args[k],
+        Op::Send(send) => &mut send.value,
+        _ => return false,
+    };
+    match *target {
+        Opnd::Local(s) => {
+            *target = Opnd::Take(s);
+            true
+        }
+        _ => false,
+    }
+}
+
+#[test]
+fn the_checker_rejects_a_move_out_of_a_live_slot() {
+    on_big_stack(|| {
+        let program = compile_with(COPY_SPEC, "copy.spur", Compiler::new())
+            .into_program()
+            .expect("the copy spec compiles");
+        let reach = reached(&program);
+        let mut entries: Vec<_> = program.rpc.values().map(|f| f.entry).collect();
+        entries.sort();
+        entries.dedup();
+        for &entry in &entries {
+            assert!(check_moves(&program.compiled.ops, entry).is_ok(), "the decoded program");
+        }
+        let mut mutations = 0;
+        for (v, k) in kept_locals(&program.compiled.ops, &reach) {
+            let mut ops = program.compiled.ops.clone();
+            if !force_move(&mut ops[v], k) {
+                continue;
+            }
+            mutations += 1;
+            let rejected = entries.iter().any(|&entry| check_moves(&ops, entry).is_err());
+            assert!(rejected, "a move out of the live slot at vertex {v} position {k} is accepted: {:?}", ops[v]);
+        }
+        assert!(mutations > 0, "no kept position reads a live local slot");
+    });
+}
