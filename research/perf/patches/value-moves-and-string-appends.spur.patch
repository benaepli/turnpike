+/// Requires every record in `records` to be at its entry with the frame its
+/// original arguments build, and returns how many there were.
+fn assert_redelivered_frames<'a, H: HashPolicy>(
+    program: &Program,
+    records: impl Iterator<Item = &'a Record<H>>,
+) -> usize {
+    let handle = program.get_func_by_name("handle").unwrap();
+    let park = program.get_func_by_name("park").unwrap();
+    let mut n = 0;
+    for r in records {
+        assert_eq!(r.pc, r.entry_pc);
+        let expected = if r.entry_func == handle.name {
+            build_frame::<H>(
+                handle,
+                &[Value::<H>::int(5), Value::<H>::int(7), Value::<H>::int(8)],
+            )
+        } else {
+            assert_eq!(r.entry_func, park.name);
+            build_frame::<H>(park, &[Value::<H>::int(5)])
+        };
+        assert_eq!(format!("{:?}", r.env), format!("{expected:?}"));
+        n += 1;
+    }
+    n
+}
