+/// A function `caller` that starts a record of `handle`, which cannot park,
+/// with one argument beyond its parameters, and a record of `park`, which
+/// can. Its first parameter is the receiver.
+fn spawning_program() -> (Program, usize) {
+    let mut builder = TestProgramBuilder::new();
+    let handle_entry = builder.add(Label::Return(Expr::Plus(
+        Box::new(Expr::Var(slot(0))),
+        Box::new(Expr::Var(slot(1))),
+    )));
+    let park_ret = builder.add(Label::Return(Expr::Var(slot(0))));
+    let park_entry = builder.add(Label::Pause(park_ret));
+    let done = builder.add(Label::Return(Expr::Unit));
+    let spawn_park = builder.add(Label::Instr(
+        Instr::Async(
+            Lhs::Var(slot(3)),
+            Expr::Var(slot(0)),
+            "park".to_string(),
+            vec![Expr::Var(slot(1))],
+        ),
+        done,
+    ));
+    let spawn_handle = builder.add(Label::Instr(
+        Instr::Async(
+            Lhs::Var(slot(2)),
+            Expr::Var(slot(0)),
+            "handle".to_string(),
+            vec![Expr::Var(slot(1)), Expr::Int(7), Expr::Int(8)],
+        ),
+        spawn_park,
+    ));
+    let mut program = builder.build_undecoded();
+    let mut handle = function(handle_entry, 10, 2, 3, false);
+    handle.local_defaults = vec![crate::compiler::cfg::SlotDefault::Nil];
+    register(&mut program, "handle", handle);
+    register(&mut program, "park", function(park_entry, 11, 1, 1, false));
+    register(&mut program, "caller", function(spawn_handle, 12, 2, 4, false));
+    program.decode();
+    (program, spawn_handle)
+}
