+/// Whether a Recv, Pause or SpinAwait label is reachable from `entry` in
+/// `graph`. An entry or successor outside the graph counts as one.
+pub fn may_park(graph: &[Label], entry: Vertex) -> bool {
+    let mut seen = vec![false; graph.len()];
+    let mut work = vec![entry];
+    while let Some(v) = work.pop() {
+        let Some(label) = graph.get(v) else {
+            return true;
+        };
+        if std::mem::replace(&mut seen[v], true) {
+            continue;
+        }
+        if matches!(label, Label::Recv(..) | Label::Pause(_) | Label::SpinAwait(..)) {
+            return true;
+        }
+        work.extend(super::frame_layout::successors(label).into_iter().flatten());
+    }
+    false
+}
