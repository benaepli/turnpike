+
+/// Every position of a function's operations that keeps a value from a
+/// local slot without moving it.
+fn kept_locals(ops: &[Op], reach: &BTreeSet<usize>) -> Vec<(usize, usize)> {
+    let mut out = Vec::new();
+    for &v in reach {
+        let count = match &ops[v] {
+            Op::AssignLocal { rhs: Opnd::Local(_), .. }
+            | Op::AssignNode { rhs: Opnd::Local(_), .. }
+            | Op::Return(Opnd::Local(_)) => 1,
+            Op::SyncCall(call) => call.args.len(),
+            Op::Async(call) => call.args.len(),
+            Op::Send(send) if matches!(send.value, Opnd::Local(_)) => 1,
+            _ => 0,
+        };
+        for k in 0..count {
+            out.push((v, k));
+        }
+    }
+    out
+}
+
+/// Turns the `k`-th kept position of vertex `v` into a move when it reads a
+/// local slot, and says whether it did.
+fn force_move(op: &mut Op, k: usize) -> bool {
+    let target = match op {
+        Op::AssignLocal { rhs, .. } | Op::AssignNode { rhs, .. } | Op::Return(rhs) => rhs,
+        Op::SyncCall(call) => &mut call.args[k],
+        Op::Async(call) => &mut call.args[k],
+        Op::Send(send) => &mut send.value,
+        _ => return false,
+    };
+    match *target {
+        Opnd::Local(s) => {
+            *target = Opnd::Take(s);
+            true
+        }
+        _ => false,
+    }
+}
+
+#[test]
+fn the_checker_rejects_a_move_out_of_a_live_slot() {
+    on_big_stack(|| {
+        let program = compile_with(COPY_SPEC, "copy.spur", Compiler::new())
+            .into_program()
+            .expect("the copy spec compiles");
+        let reach = reached(&program);
+        let mut entries: Vec<_> = program.rpc.values().map(|f| f.entry).collect();
+        entries.sort();
+        entries.dedup();
+        for &entry in &entries {
+            assert!(check_moves(&program.compiled.ops, entry).is_ok(), "the decoded program");
+        }
+        let mut mutations = 0;
+        for (v, k) in kept_locals(&program.compiled.ops, &reach) {
+            let mut ops = program.compiled.ops.clone();
+            if !force_move(&mut ops[v], k) {
+                continue;
+            }
+            mutations += 1;
+            let rejected = entries.iter().any(|&entry| check_moves(&ops, entry).is_err());
+            assert!(rejected, "a move out of the live slot at vertex {v} position {k} is accepted: {:?}", ops[v]);
+        }
+        assert!(mutations > 0, "no kept position reads a live local slot");
+    });
+}
