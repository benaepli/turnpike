+/// Runs `program` with its string additions decoded and left as trees, and
+/// requires every observation and count other than the addition counts to
+/// agree, then runs both loops against each other under both signature
+/// policies.
+fn assert_appends_agree(program: Program, start: usize) -> Observed {
+    let mut trees = program.clone();
+    trees.compiled = crate::compiler::cfg::CompiledProgram::build_without_string_appends(&program);
+    let decoded = observe::<NoHashing>(&program, start, 8);
+    let tree = observe::<NoHashing>(&trees, start, 8);
+    assert_eq!(decoded.result, tree.result);
+    assert_eq!(decoded.logs, tree.logs);
+    assert_eq!(decoded.reachable_state, tree.reachable_state);
+    assert_eq!(decoded.edges, tree.edges);
+    assert_eq!(decoded.events, tree.events);
+    assert_eq!(without_string_counts(decoded.tally), tree.tally);
+    assert_no_string_counts(&tree.tally);
+
+    let (eager, _) = assert_loops_agree(program.clone(), start, 8);
+    assert_no_string_counts(&eager.tally);
+    let (_, legacy) = assert_loops_agree_deferred(program, start, 8);
+    assert_no_string_counts(&legacy.tally);
+    assert_eq!(legacy.result, decoded.result);
+    decoded
+}
