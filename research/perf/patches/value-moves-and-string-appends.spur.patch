+/// The state after `caller` ran once on node 0, and the interpreter counts
+/// it added.
+fn spawned<H: HashPolicy>(program: &Program) -> (State<H>, util_stats::InterpreterTally) {
+    let mut state = State::<H>::new(&[(NameId(0), 3)], 2);
+    let mut logger = TestLogger::new();
+    let caller = program.get_func_by_name("caller").unwrap();
+    let mut record = make_record_for::<H>(caller.entry, 4, Continuation::Recover);
+    record.env = build_frame::<H>(caller, &[Value::<H>::node(receiver()), Value::<H>::int(5)]);
+    let mut coverage = LocalCoverage::new();
+    let before = util_stats::pending_interpreter_tally();
+    exec::<H, TestLogger, CfgFeedback>(
+        &mut state,
+        &mut logger,
+        program,
+        record,
+        &VertexMap::new(),
+        &mut coverage,
+        &SchedulePolicy::Fixed,
+        &PurgatoryConfig::default(),
+        &mut SmallRng::seed_from_u64(0),
+    )
+    .expect("the caller runs");
+    let tally = util_stats::pending_interpreter_tally().since(before);
+    (state, tally)
+}
