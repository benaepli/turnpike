+/// `prefix` then `addition` as the whole of `main`, where `prefix` stores
+/// slots 0, 1 and 5 and `addition` fails.
+fn failing_chain(prefix: Vec<(u32, Expr)>, addition: (u32, u32, u32)) -> (Program, usize) {
+    let mut builder = TestProgramBuilder::new();
+    let ret = builder.add(Label::Return(Expr::Var(slot(1))));
+    let (dest, a, b) = addition;
+    let mut next = builder.add(Label::Instr(
+        Instr::Assign(
+            Lhs::Var(slot(dest)),
+            Expr::Plus(Box::new(Expr::Var(slot(a))), Box::new(Expr::Var(slot(b)))),
+        ),
+        ret,
+    ));
+    for (d, e) in prefix.into_iter().rev() {
+        next = builder.add(Label::Instr(Instr::Assign(Lhs::Var(slot(d)), e), next));
+    }
+    let mut program = builder.build_undecoded();
+    register(&mut program, "main", function(next, 7, 0, 8, false));
+    program.decode();
+    (program, next)
+}
