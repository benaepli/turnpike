+//! Checks the moves decoding introduces by a separate method: a forward
+//! analysis over the decoded operations of every function, tracking the local
+//! slots that may hold a value moved out. No operation may read such a slot
+//! before writing it, and moves may only sit at the positions whose value the
+//! operation keeps.
+
+use super::*;
+use crate::compiler::cfg::Compiler;
+use crate::compiler::compile_with;
+use std::collections::{BTreeSet, HashMap, VecDeque};
+use std::path::{Path, PathBuf};
+
+/// One local slot event of an operation, in execution order.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Event {
+    Read(u32),
+    /// A read that leaves the slot's value moved out.
+    Move(u32),
+    Write(u32),
+    /// A write that happens only on the way to the first successor.
+    WriteFirst(u32),
+    /// A store skipped with deferred signatures: the slot keeps a value that
+    /// the program never meant it to hold.
+    Stale(u32),
+}
+
+fn tree_events(e: &CExpr, out: &mut Vec<Event>) -> Result<(), String> {
+    let mut stack: Vec<&Opnd> = Vec::new();
+    match e {
+        CExpr::Find(a, b)
+        | CExpr::And(a, b)
+        | CExpr::Or(a, b)
+        | CExpr::EqualsEquals(a, b)
+        | CExpr::NotEquals(a, b)
+        | CExpr::ListPrepend(a, b)
+        | CExpr::ListAppend(a, b)
+        | CExpr::LessThan(a, b)
+        | CExpr::LessThanEquals(a, b)
+        | CExpr::GreaterThan(a, b)
+        | CExpr::GreaterThanEquals(a, b)
+        | CExpr::KeyExists(a, b)
+        | CExpr::MapErase(a, b)
+        | CExpr::Plus(a, b)
+        | CExpr::Minus(a, b)
+        | CExpr::Times(a, b)
+        | CExpr::Div(a, b)
+        | CExpr::Mod(a, b)
+        | CExpr::Min(a, b)
+        | CExpr::Coalesce(a, b)
+        | CExpr::SafeFind(a, b) => stack.extend([a, b]),
+        CExpr::ListSubsequence(a, b, c) | CExpr::Store(a, b, c) => stack.extend([a, b, c]),
+        CExpr::FieldGet(a, _)
+        | CExpr::Not(a)
+        | CExpr::ListLen(a)
+        | CExpr::ListAccess(a, _)
+        | CExpr::TupleAccess(a, _)
+        | CExpr::Unwrap(a)
+        | CExpr::Some(a)
+        | CExpr::IntToString(a)
+        | CExpr::BoolToString(a)
+        | CExpr::NodeToString(a)
+        | CExpr::IsVariant(a, _)
+        | CExpr::VariantPayload(a)
+        | CExpr::SafeTupleAccess(a, _) => stack.push(a),
+        CExpr::Map(pairs) => pairs.iter().for_each(|(k, v)| stack.extend([k, v])),
+        CExpr::List(items) | CExpr::Tuple(items) => stack.extend(items),
+        CExpr::Variant(_, _, payload) => stack.extend(payload),
+    }
+    for o in stack {
+        read_events(o, out)?;
+    }
+    Ok(())
+}
+
+/// Events of a position that only reads.
+fn read_events(o: &Opnd, out: &mut Vec<Event>) -> Result<(), String> {
+    match o {
+        Opnd::Local(s) => out.push(Event::Read(*s)),
+        Opnd::Take(s) => return Err(format!("a move of slot {s} at a position that only reads")),
+        Opnd::Tree(e) => tree_events(e, out)?,
+        Opnd::Node(_) | Opnd::Int(_) | Opnd::Str(_) | Opnd::Bool(_) | Opnd::Unit | Opnd::Nil => {}
+    }
+    Ok(())
+}
+
+/// Events of a position whose value the operation keeps.
+fn kept_events(o: &Opnd, out: &mut Vec<Event>) -> Result<(), String> {
+    match o {
+        Opnd::Take(s) => {
+            out.push(Event::Move(*s));
+            Ok(())
+        }
+        other => read_events(other, out),
+    }
+}
+
+fn dest_event(d: &Dest, first_only: bool, out: &mut Vec<Event>) {
+    if let Dest::Local(s) = d {
+        out.push(if first_only {
+            Event::WriteFirst(*s)
+        } else {
+            Event::Write(*s)
+        });
+    }
+}
+
+/// The operation's local slot events in execution order and its successors.
+/// A spin-await runs itself again until its condition holds.
+fn op_events(op: &Op, at: usize) -> Result<(Vec<Event>, Vec<usize>), String> {
+    let mut ev = Vec::new();
+    let n = |x: &u32| *x as usize;
+    let succ = match op {
+        Op::AssignLocal { slot, next, rhs } => {
+            kept_events(rhs, &mut ev)?;
+            ev.push(Event::Write(*slot));
+            vec![n(next)]
+        }
+        Op::SelfCopy { slot, next } => {
+            ev.push(Event::Read(*slot));
+            ev.push(Event::Write(*slot));
+            vec![n(next)]
+        }
+        Op::AppendLocal { slot, next, rhs } => {
+            ev.push(Event::Read(*slot));
+            ev.push(Event::Read(*rhs));
+            ev.push(Event::Write(*slot));
+            vec![n(next)]
+        }
+        Op::AppendLiteral(op) => {
+            ev.push(Event::Read(op.other));
+            ev.push(Event::Write(op.slot));
+            vec![n(&op.next)]
+        }
+        Op::LiteralStore { slot, next, rhs } => {
+            if !matches!(rhs, Opnd::Str(_)) {
+                return Err(format!("a folded store of {rhs:?}"));
+            }
+            ev.push(Event::Stale(*slot));
+            vec![n(next)]
+        }
+        Op::AssignNode { next, rhs, .. } => {
+            kept_events(rhs, &mut ev)?;
+            vec![n(next)]
+        }
+        Op::SyncCall(call) => {
+            for a in &call.args {
+                kept_events(a, &mut ev)?;
+            }
+            dest_event(&call.dest, false, &mut ev);
+            vec![n(&call.next)]
+        }
+        Op::Async(call) => {
+            read_events(&call.target, &mut ev)?;
+            for a in &call.args {
+                kept_events(a, &mut ev)?;
+            }
+            dest_event(&call.dest, false, &mut ev);
+            vec![n(&call.next)]
+        }
+        Op::MakeChannel { dest, next }
+        | Op::SetTimer { dest, next, .. }
+        | Op::UniqueId { dest, next }
+        | Op::RetrieveData { dest, next, .. } => {
+            dest_event(dest, false, &mut ev);
+            vec![n(next)]
+        }
+        Op::MakeFifoLink { dest, next, peer } => {
+            read_events(peer, &mut ev)?;
+            dest_event(dest, false, &mut ev);
+            vec![n(next)]
+        }
+        Op::CondLocal { slot, then, els } => {
+            ev.push(Event::Read(*slot));
+            vec![n(then), n(els)]
+        }
+        Op::CondNode { then, els, .. } => vec![n(then), n(els)],
+        Op::Cond { cond, then, els } => {
+            read_events(cond, &mut ev)?;
+            vec![n(then), n(els)]
+        }
+        Op::Return(rhs) => {
+            kept_events(rhs, &mut ev)?;
+            vec![]
+        }
+        Op::Print { value, next } | Op::PersistData { value, next, .. } => {
+            read_events(value, &mut ev)?;
+            vec![n(next)]
+        }
+        Op::Goto(next) | Op::DiscardData(next) | Op::Pause(next) => vec![n(next)],
+        Op::ForLoopIn(fl) => {
+            if let Some(s) = fl.iter_slot {
+                ev.push(Event::Read(s));
+            }
+            read_events(&fl.collection, &mut ev)?;
+            if let Some(s) = fl.iter_slot {
+                ev.push(Event::Write(s));
+            }
+            dest_event(&fl.dest, true, &mut ev);
+            vec![n(&fl.body), n(&fl.next)]
+        }
+        Op::TraceDispatch(td) => {
+            for p in &td.params {
+                read_events(p, &mut ev)?;
+            }
+            vec![n(&td.next)]
+        }
+        Op::TraceEnter(te) => {
+            dest_event(&te.dest, false, &mut ev);
+            for p in &te.params {
+                read_events(p, &mut ev)?;
+            }
+            vec![n(&te.next)]
+        }
+        Op::TraceExit(tx) => {
+            read_events(&tx.trace_id, &mut ev)?;
+            read_events(&tx.return_value, &mut ev)?;
+            vec![n(&tx.next)]
+        }
+        Op::Send(send) => {
+            read_events(&send.chan, &mut ev)?;
+            kept_events(&send.value, &mut ev)?;
+            vec![n(&send.next)]
