+/// A function `main` that builds strings the way print lines do: a literal
+/// folded as the left operand, one folded as the right operand, appends into
+/// an owned buffer, onto a shared literal and onto an inline string, and an
+/// integer addition.
+fn chain_program() -> (Program, usize) {
+    let mut builder = TestProgramBuilder::new();
+    let local = |l: &mut TestProgramBuilder, label: Label| l.add(label);
+    let assign = |dest: u32, e: Expr, next: usize| Label::Instr(Instr::Assign(Lhs::Var(slot(dest)), e), next);
+    let plus = |a: u32, b: u32| Expr::Plus(Box::new(Expr::Var(slot(a))), Box::new(Expr::Var(slot(b))));
+    let ret = local(&mut builder, Label::Return(Expr::Var(slot(4))));
+    let p3 = local(&mut builder, Label::Print(Expr::Var(slot(7)), ret));
+    let s17 = local(&mut builder, assign(4, plus(4, 0), p3));
+    let s16 = local(&mut builder, assign(4, Expr::Int(3), s17));
+    let s15 = local(&mut builder, assign(7, plus(7, 2), s16));
+    let s14 = local(
+        &mut builder,
+        assign(7, Expr::IntToString(Box::new(Expr::Var(slot(0)))), s15),
+    );
+    let p2b = local(&mut builder, Label::Print(Expr::Var(slot(3)), s14));
+    let p2 = local(&mut builder, Label::Print(Expr::Var(slot(6)), p2b));
+    let s11 = local(&mut builder, assign(6, plus(6, 2), p2));
+    let s10 = local(&mut builder, assign(6, Expr::Var(slot(3)), s11));
+    let s9 = local(
+        &mut builder,
+        assign(3, Expr::String("a literal copied before it is appended to".into()), s10),
+    );
+    let p1 = local(&mut builder, Label::Print(Expr::Var(slot(1)), s9));
+    let s7 = local(&mut builder, assign(1, plus(1, 2), p1));
+    let s6 = local(
+        &mut builder,
+        assign(2, Expr::IntToString(Box::new(Expr::Var(slot(0)))), s7),
+    );
+    let s5 = local(&mut builder, assign(1, plus(1, 5), s6));
+    let s4 = local(&mut builder, assign(5, Expr::String(" at view ".into()), s5));
+    let s3 = local(&mut builder, assign(1, plus(1, 2), s4));
+    let s2 = local(
+        &mut builder,
+        assign(2, Expr::IntToString(Box::new(Expr::Var(slot(0)))), s3),
+    );
+    let s1 = local(
+        &mut builder,
+        assign(1, Expr::String("Received a prepare for op number ".into()), s2),
+    );
+    let init = local(&mut builder, assign(0, Expr::Int(42), s1));
+    let mut program = builder.build_undecoded();
+    register(&mut program, "main", function(init, 7, 0, 8, false));
+    program.decode();
+    (program, init)
+}
