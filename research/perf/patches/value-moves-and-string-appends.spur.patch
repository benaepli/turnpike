+/// take moves the slot's value out. Taking is skipped when signatures are
+/// kept eagerly: a later write would update the frame signature against the
+/// Unit left behind instead of the value that was there.
+#[inline(always)]
+fn cvalue_kept<H: HashPolicy>(
+    local_env: &mut Env<H>,
+    node_env: &Env<H>,
+    o: &Opnd,
+    role_names: &HashMap<NameId, String>,
+    t: &mut InterpreterTally,
+    site: MoveSite,
