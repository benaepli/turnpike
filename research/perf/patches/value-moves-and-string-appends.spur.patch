+fn check_redelivery<H: HashPolicy>(owned: u64) {
+    let (program, _) = spawning_program();
+    assert!(!program.get_func_by_name("handle").unwrap().may_park);
+    assert!(program.get_func_by_name("park").unwrap().may_park);
+    let (state, tally) = spawned::<H>(&program);
+    let queued: Vec<&Record<H>> = state
+        .network_queue
+        .iter()
+        .filter_map(|r| match r {
+            Runnable::Record(r) => Some(r),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(queued.len(), 2);
+    assert_eq!(tally.async_args_owned + tally.async_args_kept, queued.len() as u64);
+    assert_eq!(tally.async_args_owned, owned);
+    for r in &queued {
+        let parks = program.rpc[&r.entry_func].may_park;
+        assert_eq!(r.initial_args.is_empty(), owned == 1 && !parks);
+    }
+    assert_eq!(assert_redelivered_frames::<H>(&program, queued.into_iter()), 2);
+
+    let mut crashed = state.clone();
+    let resets_before = util_stats::pending_resets_frame_kept();
+    crate::simulator::core::scheduler::crash_node(&mut crashed, &program, receiver());
+    assert_eq!(util_stats::pending_resets_frame_kept() - resets_before, owned);
+    let held = crashed.crash_info.queued_messages.iter().map(|(_, r)| r);
+    assert_eq!(assert_redelivered_frames::<H>(&program, held), 2);
+
+    let mut parted = state.clone();
+    let resets_before = util_stats::pending_resets_frame_kept();
+    crate::simulator::core::partition::activate_partition(
+        &mut parted,
+        &program,
+        crate::simulator::core::partition::PartitionType::IsolateOne(receiver()),
+    );
+    assert_eq!(util_stats::pending_resets_frame_kept() - resets_before, owned);
+    assert!(parted.network_queue.is_empty());
+    crate::simulator::core::partition::heal_partition(&mut parted);
+    let released = parted.network_queue.iter().filter_map(|r| match r {
+        Runnable::Record(r) => Some(r),
+        _ => None,
+    });
+    assert_eq!(assert_redelivered_frames::<H>(&program, released), 2);
+}
