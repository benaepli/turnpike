+/// Moves a local slot's value out and leaves Unit. A frame that is still
+/// shared is copied first and counted, as a write to it is.
+#[inline(always)]
+fn take_local<H: HashPolicy>(local_env: &mut Env<H>, slot: u32) -> Value<H> {
+    if !local_env.slots.is_unique() {
+        util_stats::record_entry_frame_copy();
+    }
+    std::mem::replace(
+        &mut local_env.slots.make_mut()[slot as usize],
+        Value::<H>::unit(),
+    )
