+        Op::Recv(recv) => {
+            read_events(&recv.chan, &mut ev)?;
+            dest_event(&recv.dest, false, &mut ev);
+            vec![n(&recv.next)]
+        }
+        Op::SpinAwait { cond, next } => {
+            read_events(cond, &mut ev)?;
+            vec![n(next), at]
+        }
+    };
+    Ok((ev, succ))
+}
+
+/// Accepts the decoded operations of the function entered at `entry` when no
+/// path reads a slot between a move out of it and the next write to it.
+fn check_moves(ops: &[Op], entry: usize) -> Result<usize, String> {
+    let mut moved_in: HashMap<usize, BTreeSet<u32>> = HashMap::from([(entry, BTreeSet::new())]);
+    let mut work = VecDeque::from([entry]);
+    let mut moves = 0;
+    let mut seen = BTreeSet::new();
+    while let Some(v) = work.pop_front() {
+        let op = ops.get(v).ok_or_else(|| format!("vertex {v} is outside the program"))?;
+        let (events, succ) = op_events(op, v).map_err(|e| format!("vertex {v}: {e}"))?;
+        let mut moved = moved_in[&v].clone();
+        let mut first_only = Vec::new();
+        for event in events {
+            match event {
+                Event::Read(s) | Event::Move(s) if moved.contains(&s) => {
+                    return Err(format!("vertex {v} reads slot {s} after its value was moved out"));
+                }
+                Event::Read(_) => {}
+                Event::Move(s) | Event::Stale(s) => {
+                    if seen.insert((v, s)) {
+                        moves += 1;
+                    }
+                    moved.insert(s);
+                }
+                Event::Write(s) => {
+                    moved.remove(&s);
+                }
+                Event::WriteFirst(s) => first_only.push(s),
+            }
+        }
+        for (edge, &target) in succ.iter().enumerate() {
+            let mut out = moved.clone();
+            if edge == 0 {
+                for s in &first_only {
+                    out.remove(s);
+                }
+            }
+            let entry = moved_in.entry(target).or_default();
+            let before = entry.len();
+            entry.extend(out);
+            if entry.len() != before || !seen.contains(&(target, u32::MAX)) {
+                seen.insert((target, u32::MAX));
+                work.push_back(target);
+            }
+        }
+    }
+    Ok(moves)
+}
+
+/// Every vertex some function entry reaches through the decoded operations.
+fn reached(program: &Program) -> BTreeSet<usize> {
+    let mut out = BTreeSet::new();
+    let mut work: VecDeque<usize> = program.rpc.values().map(|f| f.entry).collect();
+    while let Some(v) = work.pop_front() {
+        if v >= program.compiled.ops.len() || !out.insert(v) {
+            continue;
+        }
+        if let Ok((_, succ)) = op_events(&program.compiled.ops[v], v) {
+            work.extend(succ);
+        }
+    }
+    out
+}
+
+fn has_move(op: &Op) -> bool {
+    matches!(op, Op::SelfCopy { .. })
+        || op_events(op, 0)
+            .map_or(true, |(ev, _)| ev.iter().any(|e| matches!(e, Event::Move(_) | Event::Stale(_))))
+}
+
+fn spec_files(dir: &Path, out: &mut Vec<PathBuf>) {
+    for entry in std::fs::read_dir(dir).expect("the spec directory is readable") {
+        let path = entry.expect("a directory entry").path();
+        if path.is_dir() {
+            spec_files(&path, out);
+        } else if path.extension().is_some_and(|e| e == "spur") {
+            out.push(path);
+        }
+    }
+}
+
+fn on_big_stack(f: impl FnOnce() + Send + 'static) {
+    std::thread::Builder::new()
+        .stack_size(64 * 1024 * 1024)
+        .spawn(f)
+        .expect("the test thread starts")
+        .join()
+        .expect("the test thread finishes");
+}
+
+/// The spec directory: `SPUR_SPEC_DIR` when set, the repository's otherwise.
+fn spec_root() -> PathBuf {
+    std::env::var_os("SPUR_SPEC_DIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| Path::new(env!("CARGO_MANIFEST_DIR")).join("../../bin/spur"))
+}
