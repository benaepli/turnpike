{
  "deploy": "Main",
  "params": {
    "n": 3
  },
  "num_runs": 5000,
  "max_iterations": 10000,
  "strict_timers": true,
  "events": {
    "w1": {
      "write": {
        "dest": "nodes[0]",
        "key": "key1"
      }
    },
    "allow_t1": {
      "allow_timer": {
        "node": "nodes[1]",
        "label": "timeout"
      }
    },
    "crash_nl": {
      "crash": "nodes[1]"
    },
    "recover_nl": {
      "recover": "nodes[1]"
    },
    "deliver_svc_1_to_2": {
      "deliver": {
        "function": "Node.StartViewChange",
        "from": "nodes[1]",
        "to": "nodes[2]"
      }
    },
    "crash_2": {
      "crash": "nodes[2]"
    },
    "recover_2": {
      "recover": "nodes[2]"
    },
    "deliver_svc_1_to_0": {
      "deliver": {
        "function": "Node.StartViewChange",
        "from": "nodes[1]",
        "to": "nodes[0]"
      }
    },
    "deliver_svc_2_to_0": {
      "deliver": {
        "function": "Node.StartViewChange",
        "from": "nodes[2]",
        "to": "nodes[0]"
      }
    },
    "w2": {
      "write": {
        "dest": "nodes[0]",
        "key": "key1"
      }
    },
    "r1": {
      "read": {
        "dest": "nodes[0]",
        "key": "key1"
      }
    },
    "r2": {
      "read": {
        "dest": "nodes[1]",
        "key": "key1"
      }
    },
    "r3": {
      "read": {
        "dest": "nodes[2]",
        "key": "key1"
      }
    },
    "deliver_rec_2_to_1": {
      "deliver": {
        "function": "Node.Recovery",
        "from": "nodes[2]",
        "to": "nodes[1]"
      }
    },
    "deliver_svc_2_to_1": {
      "deliver": {
        "function": "Node.StartViewChange",
        "from": "nodes[2]",
        "to": "nodes[1]"
      }
    },
    "deliver_dvc_2_to_1": {
      "deliver": {
        "function": "Node.DoViewChange",
        "from": "nodes[2]",
        "to": "nodes[1]"
      }
    },
    "deliver_rr_1_to_2": {
      "deliver": {
        "function": "Node.RecoveryResponse",
        "from": "nodes[1]",
        "to": "nodes[2]"
      }
    },
    "deliver_rr_0_to_2": {
      "deliver": {
        "function": "Node.RecoveryResponse",
        "from": "nodes[0]",
        "to": "nodes[2]"
      }
    },
    "deliver_pok_2_to_0": {
      "deliver": {
        "function": "Node.PrepareOK",
        "from": "nodes[2]",
        "to": "nodes[0]"
      }
    },
    "deliver_sv_1_to_0": {
      "deliver": {
        "function": "Node.StartView",
        "from": "nodes[1]",
        "to": "nodes[0]"
      }
    }
  },
  "dependencies": [
    [
      "w1",
      "allow_t1"
    ],
    [
      "allow_t1",
      "crash_nl"
    ],
    [
      "crash_nl",
      "recover_nl"
    ],
    [
      "crash_nl",
      "deliver_svc_1_to_2"
    ],
    [
      "deliver_svc_1_to_2",
      "crash_2"
    ],
    [
      "crash_2",
      "recover_2"
    ],
    [
      "recover_nl",
      "w2"
    ],
    [
      "recover_2",
      "w2"
    ],
    [
      "w2",
      "deliver_svc_1_to_0"
    ],
    [
      "w2",
      "deliver_svc_2_to_0"
    ],
    [
      "recover_2",
      "deliver_rec_2_to_1"
    ],
    [
      "recover_nl",
      "deliver_rec_2_to_1"
    ],
    [
      "deliver_rec_2_to_1",
      "deliver_svc_2_to_1"
    ],
    [
      "deliver_svc_2_to_1",
      "deliver_dvc_2_to_1"
    ],
    [
      "deliver_rec_2_to_1",
      "deliver_rr_1_to_2"
    ],
    [
      "recover_2",
      "deliver_rr_0_to_2"
    ],
    [
      "w2",
      "deliver_pok_2_to_0"
    ],
    [
      "deliver_rr_1_to_2",
      "deliver_pok_2_to_0"
    ],
    [
      "deliver_rr_0_to_2",
      "deliver_pok_2_to_0"
    ],
    [
      "deliver_pok_2_to_0",
      "deliver_sv_1_to_0"
    ],
    [
      "deliver_pok_2_to_0",
      "deliver_svc_1_to_0"
    ],
    [
      "deliver_pok_2_to_0",
      "deliver_svc_2_to_0"
    ],
    [
      "deliver_sv_1_to_0",
      "r1"
    ],
    [
      "deliver_sv_1_to_0",
      "r2"
    ],
    [
      "deliver_sv_1_to_0",
      "r3"
    ],
    [
      "deliver_dvc_2_to_1",
      "w2"
    ]
  ]
}