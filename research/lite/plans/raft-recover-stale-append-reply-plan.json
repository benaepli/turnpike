{
  "note": "Needs five servers: the ghost acknowledgement can only complete a majority when an intermediate leader was elected without the vote of either node holding the acknowledged entries.",
  "num_servers": 5,
  "num_runs": 5,
  "max_iterations": 4000,
  "strict_timers": true,
  "queue_policy": { "type": "Probabilistic", "p_local": 0.8, "p_timer": 0.0 },
  "events": {
    "t0_elect1": { "allow_timer": [0, "election"] },
    "t0_hb1": { "allow_timer": [0, "election"] },
    "t2_clear": { "allow_timer": [2, "election"] },
    "t2_elect2": { "allow_timer": [2, "election"] },
    "t2_hb2": { "allow_timer": [2, "election"] },
    "ra": { "read": [0, "x"] },
    "rb": { "read": [0, "x"] },
    "read_at_0": { "deliver": { "function": "Node.Read", "to": 0 } },
    "t2_settle_reads": { "allow_timer": [2, "election"] },
    "crash_0": { "crash": 0 },
    "crash_1": { "crash": 1 },
    "recover_0": { "recover": 0 },
    "w2": { "write": [2, "x"] },
    "write_at_2": { "deliver": { "function": "Node.Write", "to": 2 } },
    "rel_ae_2_to_0": { "deliver": { "function": "Node.AppendEntries", "from": 2, "to": 0 } },
    "t2_settle_w2": { "allow_timer": [2, "election"] },
    "crash_2": { "crash": 2 },
    "t0_clear": { "allow_timer": [0, "election"] },
    "t0_elect3": { "allow_timer": [0, "election"] },
    "t0_hb3": { "allow_timer": [0, "election"] },
    "w3": { "write": [0, "x"] },
    "write_at_0": { "deliver": { "function": "Node.Write", "to": 0 } },
    "t0_hb3_w3": { "allow_timer": [0, "election"] },
    "rel_aer_3_to_0": { "deliver": { "function": "Node.AppendEntriesReply", "from": 3, "to": 0 } },
    "t0_settle_3": { "allow_timer": [0, "election"] },
    "ghost_aer_1_to_0": { "deliver": { "function": "Node.AppendEntriesReply", "from": 1, "to": 0 } },
    "t0_settle_ghost": { "allow_timer": [0, "election"] },
    "crash_0b": { "crash": 0 },
    "recover_1": { "recover": 1 },
    "recover_2": { "recover": 2 },
    "t4_clear": { "allow_timer": [4, "election"] },
    "t4_elect4": { "allow_timer": [4, "election"] },
    "t4_hb4": { "allow_timer": [4, "election"] },
    "r4": { "read": [4, "x"] },
    "end_rv_2_to_0": { "deliver": { "function": "Node.RequestVote", "from": 2, "to": 0 } },
    "end_rv_2_to_1": { "deliver": { "function": "Node.RequestVote", "from": 2, "to": 1 } },
    "end_ae_2_to_1": { "deliver": { "function": "Node.AppendEntries", "from": 2, "to": 1 } },
    "end_ae_2_to_3": { "deliver": { "function": "Node.AppendEntries", "from": 2, "to": 3 } },
    "end_ae_0_to_2": { "deliver": { "function": "Node.AppendEntries", "from": 0, "to": 2 } },
    "end_ae_0_to_4": { "deliver": { "function": "Node.AppendEntries", "from": 0, "to": 4 } },
    "end_aer_2_to_0": { "deliver": { "function": "Node.AppendEntriesReply", "from": 2, "to": 0 } },
    "end_aer_4_to_0": { "deliver": { "function": "Node.AppendEntriesReply", "from": 4, "to": 0 } }
  },
  "dependencies": [
    ["t0_elect1", "t0_hb1"],
    ["t0_hb1", "t2_clear"],
    ["t2_clear", "t2_elect2"],
    ["t2_elect2", "t2_hb2"],
    ["t2_hb2", "ra"],
    ["t2_hb2", "rb"],
    ["t2_hb2", "read_at_0"],
    ["read_at_0", "t2_settle_reads"],
    ["t2_settle_reads", "crash_0"],
    ["t2_settle_reads", "crash_1"],
    ["crash_0", "recover_0"],
    ["recover_0", "w2"],
    ["recover_0", "write_at_2"],
    ["crash_1", "w2"],
    ["crash_1", "write_at_2"],
    ["write_at_2", "rel_ae_2_to_0"],
    ["rel_ae_2_to_0", "t2_settle_w2"],
    ["t2_settle_w2", "crash_2"],
    ["w2", "crash_2"],
    ["crash_2", "t0_clear"],
    ["t0_clear", "t0_elect3"],
    ["t0_elect3", "t0_hb3"],
    ["t0_hb3", "w3"],
    ["t0_hb3", "write_at_0"],
    ["write_at_0", "t0_hb3_w3"],
    ["t0_hb3_w3", "rel_aer_3_to_0"],
    ["rel_aer_3_to_0", "t0_settle_3"],
    ["t0_settle_3", "ghost_aer_1_to_0"],
    ["ghost_aer_1_to_0", "t0_settle_ghost"],
    ["t0_settle_ghost", "crash_0b"],
    ["w3", "crash_0b"],
    ["crash_0b", "recover_1"],
    ["crash_0b", "recover_2"],
    ["recover_1", "t4_clear"],
    ["recover_2", "t4_clear"],
    ["t4_clear", "t4_elect4"],
    ["t4_elect4", "t4_hb4"],
    ["t4_hb4", "r4"],
    ["r4", "end_rv_2_to_0"],
    ["r4", "end_rv_2_to_1"],
    ["r4", "end_ae_2_to_1"],
    ["r4", "end_ae_2_to_3"],
    ["r4", "end_ae_0_to_2"],
    ["r4", "end_ae_0_to_4"],
    ["r4", "end_aer_2_to_0"],
    ["r4", "end_aer_4_to_0"]
  ]
}
