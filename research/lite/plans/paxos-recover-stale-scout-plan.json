{
  "deploy": "Main",
  "params": { "n": 3 },
  "num_runs": 300,
  "max_iterations": 4000,
  "strict_timers": true,
  "events": {
    "allow_t1": { "allow_timer": { "node": "nodes[1]", "label": "leader" } },
    "p1a_1_to_0": { "deliver": { "function": "Node.HandleP1a", "from": "nodes[1]", "to": "nodes[0]" } },
    "p1a_1_to_2": { "deliver": { "function": "Node.HandleP1a", "from": "nodes[1]", "to": "nodes[2]" } },
    "w1": { "write": { "dest": "nodes[0]", "key": "x" } },
    "propose_0_to_1": { "deliver": { "function": "Node.HandlePropose", "from": "nodes[0]", "to": "nodes[1]" } },
    "p2b_0_to_2": { "deliver": { "function": "Node.HandleP2bResponse", "from": "nodes[0]", "to": "nodes[2]" } },
    "allow_t2": { "allow_timer": { "node": "nodes[2]", "label": "leader" } },
    "crash_1": { "crash": "nodes[1]" },
    "recover_1": { "recover": "nodes[1]" },
    "p1b_0_to_1": { "deliver": { "function": "Node.HandleP1bResponse", "from": "nodes[0]", "to": "nodes[1]" } },
    "p1b_2_to_1": { "deliver": { "function": "Node.HandleP1bResponse", "from": "nodes[2]", "to": "nodes[1]" } },
    "w2": { "write": { "dest": "nodes[1]", "key": "x" } },
    "dec_2_to_1": { "deliver": { "function": "Node.HandleDecision", "from": "nodes[2]", "to": "nodes[1]" } },
    "r0": { "read": { "dest": "nodes[0]", "key": "x" } },
    "r1": { "read": { "dest": "nodes[1]", "key": "x" } },
    "r2": { "read": { "dest": "nodes[2]", "key": "x" } }
  },
  "dependencies": [
    ["allow_t1", "p1a_1_to_0"],
    ["allow_t1", "p1a_1_to_2"],
    ["p1a_1_to_0", "w1"],
    ["p1a_1_to_2", "w1"],
    ["p1a_1_to_0", "propose_0_to_1"],
    ["p1a_1_to_2", "propose_0_to_1"],
    ["p1a_1_to_0", "p2b_0_to_2"],
    ["p1a_1_to_2", "p2b_0_to_2"],
    ["p2b_0_to_2", "allow_t2"],
    ["w1", "crash_1"],
    ["propose_0_to_1", "crash_1"],
    ["crash_1", "recover_1"],
    ["recover_1", "p1b_0_to_1"],
    ["recover_1", "p1b_2_to_1"],
    ["p1b_0_to_1", "w2"],
    ["p1b_2_to_1", "w2"],
    ["w2", "dec_2_to_1"],
    ["w2", "r0"],
    ["w2", "r1"],
    ["w2", "r2"]
  ]
}
