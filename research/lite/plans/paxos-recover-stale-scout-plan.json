{
  "num_servers": 3,
  "num_runs": 300,
  "max_iterations": 4000,
  "strict_timers": true,
  "events": {
    "allow_t1": { "allow_timer": [1, "leader"] },
    "p1a_1_to_0": { "deliver": { "function": "Node.HandleP1a", "from": 1, "to": 0 } },
    "p1a_1_to_2": { "deliver": { "function": "Node.HandleP1a", "from": 1, "to": 2 } },
    "w1": { "write": [0, "x"] },
    "propose_0_to_1": { "deliver": { "function": "Node.HandlePropose", "from": 0, "to": 1 } },
    "p2b_0_to_2": { "deliver": { "function": "Node.HandleP2bResponse", "from": 0, "to": 2 } },
    "allow_t2": { "allow_timer": [2, "leader"] },
    "crash_1": { "crash": 1 },
    "recover_1": { "recover": 1 },
    "p1b_0_to_1": { "deliver": { "function": "Node.HandleP1bResponse", "from": 0, "to": 1 } },
    "p1b_2_to_1": { "deliver": { "function": "Node.HandleP1bResponse", "from": 2, "to": 1 } },
    "w2": { "write": [1, "x"] },
    "dec_2_to_1": { "deliver": { "function": "Node.HandleDecision", "from": 2, "to": 1 } },
    "r0": { "read": [0, "x"] },
    "r1": { "read": [1, "x"] },
    "r2": { "read": [2, "x"] }
  },
  "dependencies": [
    ["allow_t1", "p1a_1_to_0"],
    ["allow_t1", "p1a_1_to_2"],
    ["p1a_1_to_0", "w1"],
    ["p1a_1_to_2", "w1"],
    ["p1a_1_to_0", "propose_0_to_1"],
    ["p1a_1_to_2", "propose_0_to_1"],
    ["p1a_1_to_0", "p2b_0_to_2"],
    ["p1a_1_to_2", "p2b_0_to_2"],
    ["p2b_0_to_2", "allow_t2"],
    ["w1", "crash_1"],
    ["propose_0_to_1", "crash_1"],
    ["crash_1", "recover_1"],
    ["recover_1", "p1b_0_to_1"],
    ["recover_1", "p1b_2_to_1"],
    ["p1b_0_to_1", "w2"],
    ["p1b_2_to_1", "w2"],
    ["w2", "dec_2_to_1"],
    ["w2", "r0"],
    ["w2", "r1"],
    ["w2", "r2"]
  ]
}
