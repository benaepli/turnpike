    ],
    [
      "p2b_1_to_0",
      "allow_t0"
    ],
    [
      "recover_1",
      "dec_0_to_0"
    ],
    [
      "dec_0_to_0",
      "dec_2_to_0"
    ],
    [
      "w1",
      "r0"
    ],
    [
      "w2",
      "r0"
    ],
    [
      "r0",
      "propose_2_to_0"
    ],
    [
      "r0",
      "propose_0_to_2"
    ],
    [
      "r0",
      "p2a_2_to_0"
    ],
    [
      "r0",
      "p2a_0_to_2"
    ],
    [
      "r0",
      "r2"
    ],
    [
      "r2",
      "p1a_0_to_2"
    ],
    [
      "r2",
      "p1a_1_to_0"
    ],
    [
      "r2",
      "p1a_2_to_0"
    ],
    [
      "r2",
      "p1a_1_to_1"
    ]
  ]
}
