{
  "deploy": "Main",
  "params": {
    "n": 3
  },
  "num_runs": 300,
  "max_iterations": 4000,
  "strict_timers": true,
  "events": {
    "p1a_0_to_1": {
      "deliver": {
        "function": "Node.HandleP1a",
        "from": "nodes[0]",
        "to": "nodes[1]"
      }
    },
    "p1a_1_to_1": {
      "deliver": {
        "function": "Node.HandleP1a",
        "from": "nodes[1]",
        "to": "nodes[1]"
      }
    },
    "p1a_2_to_1": {
      "deliver": {
        "function": "Node.HandleP1a",
        "from": "nodes[2]",
        "to": "nodes[1]"
      }
    },
    "p1a_0_to_2": {
      "deliver": {
        "function": "Node.HandleP1a",
        "from": "nodes[0]",
        "to": "nodes[2]"
      }
    },
    "p1a_1_to_0": {
      "deliver": {
        "function": "Node.HandleP1a",
        "from": "nodes[1]",
        "to": "nodes[0]"
      }
    },
    "p1a_2_to_0": {
      "deliver": {
        "function": "Node.HandleP1a",
        "from": "nodes[2]",
        "to": "nodes[0]"
      }
    },
    "w2": {
      "write": {
        "dest": "nodes[2]",
        "key": "x"
      }
    },
    "propose_2_to_0": {
      "deliver": {
        "function": "Node.HandlePropose",
        "from": "nodes[2]",
        "to": "nodes[0]"
      }
    },
    "propose_0_to_2": {
      "deliver": {
        "function": "Node.HandlePropose",
        "from": "nodes[0]",
        "to": "nodes[2]"
      }
    },
    "p2a_2_to_0": {
      "deliver": {
        "function": "Node.HandleP2a",
        "from": "nodes[2]",
        "to": "nodes[0]"
      }
    },
    "p2a_0_to_2": {
      "deliver": {
        "function": "Node.HandleP2a",
        "from": "nodes[0]",
        "to": "nodes[2]"
      }
    },
    "crash_1": {
      "crash": "nodes[1]"
    },
    "recover_1": {
      "recover": "nodes[1]"
    },
    "w1": {
      "write": {
        "dest": "nodes[0]",
        "key": "x"
      }
    },
    "p2b_1_to_0": {
      "deliver": {
        "function": "Node.HandleP2bResponse",
        "from": "nodes[1]",
        "to": "nodes[0]"
      }
    },
    "allow_t0": {
      "allow_timer": {
        "node": "nodes[0]",
        "label": "leader"
      }
    },
    "dec_0_to_0": {
      "deliver": {
        "function": "Node.HandleDecision",
        "from": "nodes[0]",
        "to": "nodes[0]"
      }
    },
    "dec_2_to_0": {
      "deliver": {
        "function": "Node.HandleDecision",
        "from": "nodes[2]",
        "to": "nodes[0]"
      }
    },
    "r0": {
      "read": {
        "dest": "nodes[0]",
        "key": "x"
      }
    },
    "r2": {
      "read": {
        "dest": "nodes[2]",
        "key": "x"
      }
    }
  },
  "dependencies": [
    [
      "p1a_0_to_1",
      "p1a_2_to_1"
    ],
    [
      "p1a_2_to_1",
      "w2"
    ],
    [
      "w2",
      "crash_1"
    ],
    [
      "crash_1",
