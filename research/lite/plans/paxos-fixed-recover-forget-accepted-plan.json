{
  "num_servers": 3,
  "num_runs": 5,
  "max_iterations": 4000,
  "strict_timers": true,
  "queue_policy": {
    "type": "Probabilistic",
    "p_local": 0.8,
    "p_timer": 0.0
  },
  "events": {
    "t2_settle_init": { "allow_timer": [2, "leader"] },
    "w1": { "write": [2, "x"] },
    "t2_settle_w1": { "allow_timer": [2, "leader"] },
    "crash_1": { "crash": 1 },
    "recover_1": { "recover": 1 },
    "t2_settle_adopt": { "allow_timer": [2, "leader"] },
    "w2": { "write": [0, "x"] },
    "r0": { "read": [0, "x"] },
    "r2": { "read": [2, "x"] },
    "r1": { "read": [1, "x"] },
    "end_p2a_2_to_0": { "deliver": { "function": "Node.HandleP2a", "from": 2, "to": 0 } },
    "end_dec_2_to_0": { "deliver": { "function": "Node.HandleDecision", "from": 2, "to": 0 } },
    "end_p1b_2_to_1": { "deliver": { "function": "Node.HandleP1bResponse", "from": 2, "to": 1 } }
  },
  "dependencies": [
    ["t2_settle_init", "w1"],
    ["w1", "t2_settle_w1"],
    ["t2_settle_w1", "crash_1"],
    ["crash_1", "recover_1"],
    ["recover_1", "t2_settle_adopt"],
    ["t2_settle_adopt", "w2"],
    ["w2", "r0"],
    ["r0", "r2"],
    ["r2", "r1"],
    ["r1", "end_p2a_2_to_0"],
    ["r1", "end_dec_2_to_0"],
    ["r1", "end_p1b_2_to_1"]
  ]
}
