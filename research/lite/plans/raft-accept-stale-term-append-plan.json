{
  "num_servers": 3,
  "num_runs": 5,
  "max_iterations": 3000,
  "strict_timers": true,
  "queue_policy": { "type": "Probabilistic", "p_local": 0.8, "p_timer": 0.0 },
  "events": {
    "t0_elect1": { "allow_timer": [0, "election"] },
    "t0_hb1": { "allow_timer": [0, "election"] },
    "w1": { "write": [0, "x"] },
    "write_at_0": { "deliver": { "function": "Node.Write", "to": 0 } },
    "crash_0": { "crash": 0 },
    "t2_clear": { "allow_timer": [2, "election"] },
    "t2_elect2": { "allow_timer": [2, "election"] },
    "t2_hb2": { "allow_timer": [2, "election"] },
    "w2": { "write": [2, "x"] },
    "t2_settle_w2": { "allow_timer": [2, "election"] },
    "ghost_ae_0_to_1": { "deliver": { "function": "Node.AppendEntries", "from": 0, "to": 1 } },
    "crash_2": { "crash": 2 },
    "recover_0": { "recover": 0 },
    "t0_elect3": { "allow_timer": [0, "election"] },
    "t0_hb3": { "allow_timer": [0, "election"] },
    "r0": { "read": [0, "x"] },
    "end_ae_0_to_2": { "deliver": { "function": "Node.AppendEntries", "from": 0, "to": 2 } },
    "end_ae_2_to_0": { "deliver": { "function": "Node.AppendEntries", "from": 2, "to": 0 } }
  },
  "dependencies": [
    ["t0_elect1", "t0_hb1"],
    ["t0_hb1", "w1"],
    ["t0_hb1", "write_at_0"],
    ["write_at_0", "crash_0"],
    ["crash_0", "t2_clear"],
    ["t2_clear", "t2_elect2"],
    ["t2_elect2", "t2_hb2"],
    ["t2_hb2", "w2"],
    ["w2", "t2_settle_w2"],
    ["t2_settle_w2", "ghost_ae_0_to_1"],
    ["ghost_ae_0_to_1", "crash_2"],
    ["crash_2", "recover_0"],
    ["recover_0", "t0_elect3"],
    ["t0_elect3", "t0_hb3"],
    ["t0_hb3", "r0"],
    ["r0", "end_ae_0_to_2"],
    ["r0", "end_ae_2_to_0"]
  ]
}
