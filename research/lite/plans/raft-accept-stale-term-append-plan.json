{
  "deploy": "Main",
  "params": { "n": 3 },
  "num_runs": 5,
  "max_iterations": 3000,
  "strict_timers": true,
  "queue_policy": { "type": "Probabilistic", "p_local": 0.8, "p_timer": 0.0 },
  "events": {
    "t0_elect1": { "allow_timer": { "node": "nodes[0]", "label": "election" } },
    "t0_hb1": { "allow_timer": { "node": "nodes[0]", "label": "election" } },
    "w1": { "write": { "dest": "nodes[0]", "key": "x" } },
    "write_at_0": { "deliver": { "function": "Node.Write", "to": "nodes[0]" } },
    "crash_0": { "crash": "nodes[0]" },
    "t2_clear": { "allow_timer": { "node": "nodes[2]", "label": "election" } },
    "t2_elect2": { "allow_timer": { "node": "nodes[2]", "label": "election" } },
    "t2_hb2": { "allow_timer": { "node": "nodes[2]", "label": "election" } },
    "w2": { "write": { "dest": "nodes[2]", "key": "x" } },
    "t2_settle_w2": { "allow_timer": { "node": "nodes[2]", "label": "election" } },
    "ghost_ae_0_to_1": { "deliver": { "function": "Node.AppendEntries", "from": "nodes[0]", "to": "nodes[1]" } },
    "crash_2": { "crash": "nodes[2]" },
    "recover_0": { "recover": "nodes[0]" },
    "t0_elect3": { "allow_timer": { "node": "nodes[0]", "label": "election" } },
    "t0_hb3": { "allow_timer": { "node": "nodes[0]", "label": "election" } },
    "r0": { "read": { "dest": "nodes[0]", "key": "x" } },
    "end_ae_0_to_2": { "deliver": { "function": "Node.AppendEntries", "from": "nodes[0]", "to": "nodes[2]" } },
    "end_ae_2_to_0": { "deliver": { "function": "Node.AppendEntries", "from": "nodes[2]", "to": "nodes[0]" } }
  },
  "dependencies": [
    ["t0_elect1", "t0_hb1"],
    ["t0_hb1", "w1"],
    ["t0_hb1", "write_at_0"],
    ["write_at_0", "crash_0"],
    ["crash_0", "t2_clear"],
    ["t2_clear", "t2_elect2"],
    ["t2_elect2", "t2_hb2"],
    ["t2_hb2", "w2"],
    ["w2", "t2_settle_w2"],
    ["t2_settle_w2", "ghost_ae_0_to_1"],
    ["ghost_ae_0_to_1", "crash_2"],
    ["crash_2", "recover_0"],
    ["recover_0", "t0_elect3"],
    ["t0_elect3", "t0_hb3"],
    ["t0_hb3", "r0"],
    ["r0", "end_ae_0_to_2"],
    ["r0", "end_ae_2_to_0"]
  ]
}
