+enum EvalValue<'a, H: HashPolicy> {
+    Borrowed(&'a Value<H>),
+    Int(i64),
+    Bool(bool),
+    Owned(Value<H>),
+}
+
+impl<'a, H: HashPolicy> EvalValue<'a, H> {
+    fn consumed(&self) {
+        match self {
+            Self::Borrowed(_) => crate::simulator::util_stats::record_eval_transient(0),
+            Self::Int(_) | Self::Bool(_) => crate::simulator::util_stats::record_eval_transient(1),
+            Self::Owned(_) => {}
+        }
+    }
+
+    fn materialize(self) -> Value<H> {
+        if !matches!(self, Self::Owned(_)) {
+            crate::simulator::util_stats::record_eval_transient(2);
+        }
+        match self {
+            Self::Borrowed(v) => v.clone(),
+            Self::Int(i) => Value::int(i),
+            Self::Bool(b) => Value::bool(b),
+            Self::Owned(v) => v,
+        }
+    }
+
+    fn type_name(&self) -> &'static str {
+        match self {
+            Self::Int(_) => "int",
+            Self::Bool(_) => "bool",
+            Self::Borrowed(v) => v.type_name(),
+            Self::Owned(v) => v.type_name(),
+        }
+    }
+
+    fn int(&self) -> Result<i64, RuntimeError> {
+        self.consumed();
+        match self {
+            Self::Int(i) => Ok(*i),
+            Self::Borrowed(v) => v.as_int(),
+            Self::Owned(v) => v.as_int(),
+            Self::Bool(_) => Err(RuntimeError::TypeError {
+                expected: "int",
+                got: "bool",
+            }),
+        }
+    }
+
+    fn bool(&self) -> Result<bool, RuntimeError> {
+        self.consumed();
+        match self {
+            Self::Bool(b) => Ok(*b),
+            Self::Borrowed(v) => v.as_bool(),
+            Self::Owned(v) => v.as_bool(),
+            Self::Int(_) => Err(RuntimeError::TypeError {
+                expected: "bool",
+                got: "int",
+            }),
+        }
+    }
+
+    fn kind(&self) -> Option<&ValueKind<H>> {
+        match self {
+            Self::Borrowed(v) => Some(&v.kind),
+            Self::Owned(v) => Some(&v.kind),
+            _ => None,
+        }
+    }
+
+    fn native_int(&self) -> Option<i64> {
+        match self {
+            Self::Int(i) => Some(*i),
+            _ => match self.kind() {
+                Some(ValueKind::Int(i)) => Some(*i),
+                _ => None,
+            },
+        }
+    }
+
+    fn native_bool(&self) -> Option<bool> {
+        match self {
+            Self::Bool(b) => Some(*b),
+            _ => match self.kind() {
+                Some(ValueKind::Bool(b)) => Some(*b),
+                _ => None,
+            },
+        }
+    }
+
+    fn equals(self, rhs: Self) -> bool {
+        if let (Some(a), Some(b)) = (self.native_int(), rhs.native_int()) {
+            self.consumed();
+            rhs.consumed();
+            return a == b;
+        }
+        if let (Some(a), Some(b)) = (self.native_bool(), rhs.native_bool()) {
+            self.consumed();
+            rhs.consumed();
+            return a == b;
+        }
+        self.with_value(|a| rhs.with_value(|b| a == b))
+    }
+
+    fn compare(self, rhs: Self) -> std::cmp::Ordering {
+        if let (Some(a), Some(b)) = (self.native_int(), rhs.native_int()) {
+            self.consumed();
+            rhs.consumed();
+            return a.cmp(&b);
+        }
+        if let (Some(a), Some(b)) = (self.native_bool(), rhs.native_bool()) {
+            self.consumed();
+            rhs.consumed();
+            return a.cmp(&b);
+        }
+        self.with_value(|a| rhs.with_value(|b| a.cmp(b)))
+    }
+
+    fn with_value<T>(self, f: impl FnOnce(&Value<H>) -> T) -> T {
+        match self {
+            Self::Borrowed(v) => {
+                crate::simulator::util_stats::record_eval_transient(0);
+                f(v)
+            }
+            Self::Owned(v) => f(&v),
+            scalar => f(&scalar.materialize()),
+        }
+    }
+
+    fn project(
+        self,
+        f: impl FnOnce(&Value<H>) -> Result<&Value<H>, RuntimeError>,
+    ) -> Result<Self, RuntimeError> {
+        match self {
+            Self::Borrowed(v) => {
+                crate::simulator::util_stats::record_eval_transient(0);
+                Ok(Self::Borrowed(f(v)?))
+            }
+            Self::Owned(v) => Ok(Self::Owned(f(&v)?.clone())),
+            scalar => {
+                let v = scalar.materialize();
+                Ok(Self::Owned(f(&v)?.clone()))
+            }
+        }
+    }
+}
