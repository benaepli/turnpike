+        outcomes[4].1,
+        RunOutcome::Completed { steps: stop_step },
+        "the released plan-clock run's plan completes once its stuck operation is settled"
+    );
+    assert!(
+        matches!(outcomes[5].1, RunOutcome::IterationsExhausted { .. }),
+        "the released fine-clock-only run never stalls, got {:?}",
+        outcomes[5].1
+    );
+
+    let (before_sc, after_sc) = (&before.stall_cap, &after.stall_cap);
+    let (before_pc, after_pc) = (&before_sc.plan_clock, &after_sc.plan_clock);
+    assert_eq!(after_sc.stops, before_sc.stops, "no run was stopped by the fine clock");
+    assert_eq!(after_sc.steps_saved_sum, before_sc.steps_saved_sum);
+    assert_eq!(after_pc.stops, before_pc.stops + 1, "the release is not a stop");
+    assert_eq!(after_pc.steps_saved_sum, before_pc.steps_saved_sum + (BACKUP - stop_step) as u64);
+    assert_eq!(after_sc.treated_runs, before_sc.treated_runs + 4);
+    assert_eq!(after_sc.untreated_runs, before_sc.untreated_runs + 1);
+    assert_eq!(after_sc.untreated_runs_capped, before_sc.untreated_runs_capped + 1);
+    assert_eq!(
+        after_sc.untreated_over_cap_runs,
+        before_sc.untreated_over_cap_runs,
+        "the untreated run's fine clock stayed under the cap"
+    );
+    assert_eq!(after_pc.untreated_runs_capped, before_pc.untreated_runs_capped + 1);
+    assert_eq!(
+        after_pc.untreated_over_cap_runs,
+        before_pc.untreated_over_cap_runs + 1,
+        "the untreated run's plan clock exceeded the standing plan cap"
+    );
+    assert!(
+        after_sc.marks.acted_deliveries > before_sc.marks.acted_deliveries + 6,
+        "every run re-armed its fine clock with acted deliveries"
+    );
+    assert_eq!(after_sc.probes_keyed, before_sc.probes_keyed, "exhausted probes feed nothing");
+    assert_eq!(after_pc.probes_keyed, before_pc.probes_keyed);
+    assert_eq!(
+        after_pc.cut_plan_clock,
+        plan_clock_cell_delta(&before_pc.cut_plan_clock, 1, 0, stop_step as u64)
+    );
+    assert_eq!(
+        after_pc.cut_no_plan_clock,
+        plan_clock_cell_delta(&before_pc.cut_no_plan_clock, 1, 0, BACKUP as u64)
+    );
+    assert_eq!(
+        after_pc.release_plan_clock,
+        plan_clock_cell_delta(&before_pc.release_plan_clock, 1, 1, stop_step as u64)
+    );
+    assert_eq!(
+        after_pc.release_no_plan_clock,
+        plan_clock_cell_delta(&before_pc.release_no_plan_clock, 1, 0, BACKUP as u64)
+    );
+    assert_eq!(
+        after.termination.all.stall_cap_reached,
+        before.termination.all.stall_cap_reached + 1,
+        "a plan-clock stop is a stall-cap exit"
+    );
+    assert_eq!(
+        after.termination.all.iterations_exhausted,
+        before.termination.all.iterations_exhausted + 4
+    );
+
+    let (before_sr, after_sr) = (&before.stall_release, &after.stall_release);
+    assert_eq!(after_sr.releases, before_sr.releases + 1, "the plan clock's first stall releases");
+    assert_eq!(after_sr.ops_settled, before_sr.ops_settled + 1);
+    assert_eq!(after_sr.plan_completed_after_release, before_sr.plan_completed_after_release + 1);
+    assert_eq!(after_sr.second_stall_stops, before_sr.second_stall_stops);
+    assert_eq!(after_sr.stalls_without_ops, before_sr.stalls_without_ops);
+    assert_eq!(after_sr.release_cell.runs, before_sr.release_cell.runs + 2);
+    assert_eq!(after_sr.cut_cell.runs, before_sr.cut_cell.runs + 2);
+
+    assert_eq!(runs_row(&out, cut_plan), ("stall_cap_reached".to_string(), stop_step as i64));
+    assert_eq!(runs_row(&out, released_plan), ("plan_complete".to_string(), stop_step as i64));
+    for id in [cut_fine, untreated, cap_probe, released_fine] {
+        assert_eq!(
+            runs_row(&out, id),
+            ("iterations_exhausted".to_string(), BACKUP as i64),
+            "run {id} runs to its budget"
+        );
+    }
+    for id in [cut_plan, released_plan] {
+        assert_eq!(
+            history_rows(&out, id),
+            vec![(1, "Invocation".to_string())],
+            "run {id}: the stuck write stays a pending invocation"
+        );
+    }
+    let mask = run_variant::STALL_CAP | run_variant::STALL_RELEASE | run_variant::PLAN_PROGRESS_CLOCK;
+    assert_eq!(
+        variant_of(&out, cut_plan) & mask,
+        run_variant::STALL_CAP | run_variant::PLAN_PROGRESS_CLOCK
+    );
+    assert_eq!(variant_of(&out, cut_fine) & mask, run_variant::STALL_CAP);
+    assert_eq!(variant_of(&out, released_plan) & mask, mask, "the plan-clock bit crosses the release bit");
+    assert_eq!(
+        variant_of(&out, released_fine) & mask,
+        run_variant::STALL_CAP | run_variant::STALL_RELEASE
+    );
+    for id in [untreated, cap_probe] {
+        assert_eq!(variant_of(&out, id) & mask, 0, "run {id} carries none of the bits");
+    }
+    let _ = fs::remove_dir_all(&out);
+}
+
+#[test]
+fn a_released_plan_clock_run_releases_once_and_stops_at_its_second_plan_stall() {
+    on_session_thread(check_plan_clock_chain);
+}
+
+fn check_plan_clock_chain() {
+    let _serial = config_override::exclusive_session();
+    util_stats::set_enabled(true);
+    let cap = seed_cap();
+    let released_plan = first_grid_id(StallReleaseCell::Release, PlanClockCell::PlanClock);
+    let cut_plan = first_grid_id(StallReleaseCell::Cut, PlanClockCell::PlanClock);
+    let released_fine = first_grid_id(StallReleaseCell::Release, PlanClockCell::NoPlanClock);
+
+    let out = scratch("spur_stall_plan_clock_chain");
+    let before = util_stats::snapshot();
+    let outcomes = run_session(ACTIVE_SPEC, CHAIN_CONFIG, &out, &[released_plan, cut_plan, released_fine]);
+    let after = util_stats::snapshot();
+    run_cap::reset();
+    stall_cap::reset();
+    util_stats::set_enabled(false);
+
+    // The cut plan-clock run stops at its first plan stall with both writes
+    // outstanding. The released one settles the first write there, the
+    // second write issues on the next step and is the run's last
+    // plan-progress mark, and the run stops when the plan gap after it
+    // exceeds the plan cap again; its fine clock is re-armed throughout.
+    let first_stop = cap + 2;
+    let second_stop = 2 * cap + 4;
+    assert_eq!(
+        outcomes[1].1,
+        RunOutcome::StallCapReached {
+            cap,
+            step: first_stop,
+            outstanding_events: 2,
+        }
+    );
+    assert_eq!(
+        outcomes[0].1,
+        RunOutcome::StallCapReached {
+            cap,
+            step: second_stop,
+            outstanding_events: 1,
+        },
+        "the released run ends at its second plan stall with the second write outstanding"
+    );
+    assert!(
+        matches!(outcomes[2].1, RunOutcome::IterationsExhausted { .. }),
+        "the released fine-clock-only run never stalls, got {:?}",
+        outcomes[2].1
+    );
+
+    let (before_sr, after_sr) = (&before.stall_release, &after.stall_release);
+    assert_eq!(after_sr.releases, before_sr.releases + 1, "released exactly once");
+    assert_eq!(after_sr.ops_settled, before_sr.ops_settled + 1);
+    assert_eq!(after_sr.dependents_released.client, before_sr.dependents_released.client + 1);
+    assert_eq!(after_sr.plan_completed_after_release, before_sr.plan_completed_after_release);
+    assert_eq!(after_sr.second_stall_stops, before_sr.second_stall_stops + 1);
+    assert_eq!(
+        after_sr.steps_after_release_sum,
+        before_sr.steps_after_release_sum + (second_stop - first_stop) as u64
+    );
+    assert_eq!(after_sr.release_cell.runs, before_sr.release_cell.runs + 2);
+    assert_eq!(after_sr.release_cell.invocations, before_sr.release_cell.invocations + 3);
+    assert_eq!(after_sr.cut_cell.runs, before_sr.cut_cell.runs + 1);
+    assert_eq!(after_sr.cut_cell.invocations, before_sr.cut_cell.invocations + 1);
+
+    let (before_sc, after_sc) = (&before.stall_cap, &after.stall_cap);
+    let (before_pc, after_pc) = (&before_sc.plan_clock, &after_sc.plan_clock);
+    assert_eq!(after_sc.stops, before_sc.stops, "no run was stopped by the fine clock");
+    assert_eq!(after_pc.stops, before_pc.stops + 2, "one plan-clock stop per plan-clock run");
+    assert_eq!(after_sc.treated_runs, before_sc.treated_runs + 3);
+    assert_eq!(
+        after_pc.steps_saved_sum,
+        before_pc.steps_saved_sum + (BACKUP - first_stop) as u64 + (BACKUP - second_stop) as u64
+    );
+    assert_eq!(
+        after_pc.release_plan_clock,
+        plan_clock_cell_delta(&before_pc.release_plan_clock, 1, 0, second_stop as u64)
+    );
+    assert_eq!(
+        after_pc.cut_plan_clock,
+        plan_clock_cell_delta(&before_pc.cut_plan_clock, 1, 0, first_stop as u64)
+    );
+    assert_eq!(
+        after_pc.release_no_plan_clock,
+        plan_clock_cell_delta(&before_pc.release_no_plan_clock, 1, 0, BACKUP as u64)
+    );
+    assert_eq!(
+        after.termination.all.stall_cap_reached,
+        before.termination.all.stall_cap_reached + 2
+    );
+
+    assert_eq!(runs_row(&out, cut_plan), ("stall_cap_reached".to_string(), first_stop as i64));
+    assert_eq!(runs_row(&out, released_plan), ("stall_cap_reached".to_string(), second_stop as i64));
+    assert_eq!(runs_row(&out, released_fine), ("iterations_exhausted".to_string(), BACKUP as i64));
+    assert_eq!(
+        history_rows(&out, cut_plan),
+        vec![(1, "Invocation".to_string())],
+        "the cut run never issues the second write"
+    );
+    assert_eq!(
+        history_rows(&out, released_plan),
+        vec![(1, "Invocation".to_string()), (2, "Invocation".to_string())],
+        "the released run issues the second write and neither write responds"
+    );
+    let _ = fs::remove_dir_all(&out);
+}
