+    let cut_fine = first_grid_id(StallReleaseCell::Cut, PlanClockCell::NoPlanClock);
+    let untreated = first_id(StallCapCell::Untreated, false);
+    let cap_probe = first_id(StallCapCell::Probe, true);
+    let released_plan = first_grid_id(StallReleaseCell::Release, PlanClockCell::PlanClock);
+    let released_fine = first_grid_id(StallReleaseCell::Release, PlanClockCell::NoPlanClock);
+    assert_eq!(stall_cap::plan_clock_cell(untreated), PlanClockCell::Exempt);
+    assert_eq!(stall_cap::plan_clock_cell(cap_probe), PlanClockCell::Exempt);
+
+    let out = scratch("spur_stall_plan_clock_exit");
+    let before = util_stats::snapshot();
+    let outcomes = run_session(
+        ACTIVE_SPEC,
+        CONFIG,
+        &out,
+        &[cut_plan, cut_fine, untreated, cap_probe, released_plan, released_fine],
+    );
+    let after = util_stats::snapshot();
+    run_cap::reset();
+    stall_cap::reset();
+    util_stats::set_enabled(false);
+
+    // The request is issued at step 0, the last plan-progress mark of the
+    // run; every retry changes the node's state, so the fine clock is
+    // re-armed within a few steps while the plan clock's gap after step k
+    // is k. The plan-clock run stops on the first step past the plan cap,
+    // having run cap + 2 steps, and every other run goes to its budget.
+    let stop_step = cap + 2;
+    assert_eq!(
+        outcomes[0].1,
+        RunOutcome::StallCapReached {
+            cap,
+            step: stop_step,
+            outstanding_events: 1,
+        },
+        "the plan clock ends the plan-clock run"
+    );
+    for (what, (_, outcome)) in ["fine-clock-only", "untreated", "run-cap probe"]
+        .iter()
+        .zip(&outcomes[1..4])
