+/// An open restart window: the node that came back and the step its
+/// recover was applied on.
+#[derive(Debug, Clone, Copy)]
+struct Window {
+    node: usize,
+    opened_step: i32,
+}
+
+/// The configured selector with the restart-window switch around it.
+///
+/// Every step first takes the wrapped selector's own selection, drawing the
+/// stock roll, so the queue-choice stream is consumed the same way on every
+/// cell whether or not a window is open. Outside a window that selection
+/// stands. Inside one, the stock cell keeps it and only counts; a treated
+/// cell keeps it when it is the timer, so the timer share and the forwarded
+/// timer bias are the wrapped selector's, and otherwise replaces it by the
+/// cell's own shape, drawing on the window-shape stream. When the wrapped
+/// selector is itself the preemptive shape the window applies the same
+/// way, over that selector's selection.
+#[derive(Debug, Clone)]
+pub struct WindowedSelector<S> {
+    inner: S,
+    cell: Cell,
+    /// Open windows in opening order; a node appears at most once.
+    windows: Vec<Window>,
+    /// The local-drain shape's state, held only while a window is open.
+    active_node: Option<usize>,
+    local_steps_since_pull: i32,
+}
+
+impl<S: QueueSelector> WindowedSelector<S> {
+    pub fn new(inner: S, cell: Cell) -> Self {
+        Self {
+            inner,
+            cell,
+            windows: Vec::new(),
+            active_node: None,
+            local_steps_since_pull: 0,
+        }
+    }
+
+    /// Whether `node` is inside its own window.
+    pub fn window_open_for(&self, node: usize) -> bool {
+        self.windows.iter().any(|w| w.node == node)
+    }
+
+    /// A recover of `node` was applied at `step`. A window already open for
+    /// the node starts over, and the node becomes the most recently
+    /// restarted one; the active node is dropped so the next local pick
+    /// falls on the restarted node's queue.
+    pub fn open_window(&mut self, node: usize, step: i32) {
+        self.windows.retain(|w| w.node != node);
+        self.windows.push(Window {
+            node,
+            opened_step: step,
+        });
+        self.active_node = None;
+        util_stats::record_restart_window_opened(self.cell);
+    }
+
+    /// Close every window whose node has taken the entry limit since its
+    /// restart or whose step limit has passed, as of `step`; `entries` reads
+    /// a node's handler entries since its restart. A window spans the step
+    /// limit's worth of selections after the step it opened on.
+    pub fn advance(&mut self, step: i32, entries: impl Fn(usize) -> u32) {
+        let cell = self.cell;
+        self.windows.retain(|w| {
+            if entries(w.node) >= restart_window::ENTRY_LIMIT {
+                util_stats::record_restart_window_closed(cell, true);
+                false
+            } else if step - w.opened_step > restart_window::STEP_LIMIT {
+                util_stats::record_restart_window_closed(cell, false);
+                false
+            } else {
+                true
+            }
+        });
+        if self.windows.is_empty() {
+            self.active_node = None;
+            self.local_steps_since_pull = 0;
+        }
+    }
+
+    fn local_size(info: &QueueInfo, node: usize) -> usize {
+        info.local_queue_sizes.get(node).copied().unwrap_or(0)
+    }
+
+    /// The preemptive shape: a forced network pull once the interval of
+    /// local steps has passed, else the active node's queue while it has
+    /// items, else a new active node - the most recently restarted node
+    /// inside its window with a non-empty queue, or the size-weighted pick.
+    fn local_drain(&mut self, info: &QueueInfo, rng: &mut impl Rng) -> Option<QueueSelection> {
+        if self.local_steps_since_pull >= restart_window::NET_PULL_INTERVAL
+            && info.network_queue_size > 0
+        {
+            self.local_steps_since_pull = 0;
+            self.active_node = None;
+            return Some(QueueSelection::Network);
+        }
+        if let Some(node) = self.active_node {
+            if Self::local_size(info, node) > 0 {
+                self.local_steps_since_pull += 1;
+                return Some(QueueSelection::Local(node));
+            }
+            self.active_node = None;
+        }
+        let restarted = self
+            .windows
+            .iter()
+            .rev()
+            .map(|w| w.node)
+            .find(|&n| Self::local_size(info, n) > 0);
+        let pick = match restarted {
+            Some(node) => Some(QueueSelection::Local(node)),
+            None => pick_local(info, rng),
+        };
+        if let Some(QueueSelection::Local(node)) = pick {
+            self.active_node = Some(node);
+            self.local_steps_since_pull += 1;
+            return pick;
+        }
+        if info.network_queue_size > 0 {
+            self.local_steps_since_pull = 0;
+            return Some(QueueSelection::Network);
+        }
+        if info.timer_queue_size > 0 {
+            return Some(QueueSelection::Timer);
+        }
+        None
+    }
+
+    /// The stock roll shape between local and network only, at the
+    /// network-heavy local share.
+    fn net_heavy(info: &QueueInfo, rng: &mut impl Rng) -> Option<QueueSelection> {
+        let roll: f64 = rng.random();
+        let primary = if roll < restart_window::NET_HEAVY_P_LOCAL { 0 } else { 1 };
+        select_from(primary, info, rng)
+    }
+
+    /// The selection inside an open window given the wrapped selector's
+    /// `stock` selection for this step.
+    fn decide(
+        &mut self,
+        stock: Option<QueueSelection>,
+        info: &QueueInfo,
+        rng: &mut impl Rng,
+    ) -> Option<QueueSelection> {
+        let chosen = match (self.cell, stock) {
+            (Cell::Stock, s) => s,
+            (_, None) => None,
+            (_, Some(QueueSelection::Timer)) => Some(QueueSelection::Timer),
+            (Cell::LocalDrain, Some(_)) => self.local_drain(info, rng),
+            (Cell::NetHeavy, Some(_)) => Self::net_heavy(info, rng),
+        };
+        if chosen.is_some() && util_stats::enabled() {
+            let restarted_local = match chosen {
+                Some(QueueSelection::Local(n)) => self.window_open_for(n),
+                _ => false,
+            };
+            util_stats::record_restart_window_step(self.cell, stock != chosen, restarted_local);
+        }
+        chosen
+    }
+}
+
+impl<S: QueueSelector> QueueSelector for WindowedSelector<S> {
+    fn select(&mut self, info: &QueueInfo, rng: &mut impl Rng) -> Option<QueueSelection> {
+        let stock = self.inner.select(info, rng);
+        if self.windows.is_empty() {
+            return stock;
+        }
+        self.decide(stock, info, rng)
+    }
+
+    fn supports_timer_bias(&self) -> bool {
+        self.inner.supports_timer_bias()
+    }
+
+    fn select_timer_biased(
+        &mut self,
+        info: &QueueInfo,
+        timer_bias: f64,
+        rng: &mut impl Rng,
+    ) -> Option<QueueSelection> {
+        let stock = self.inner.select_timer_biased(info, timer_bias, rng);
+        if self.windows.is_empty() {
+            return stock;
+        }
+        self.decide(stock, info, rng)
+    }
+
+    fn select_streamed(
+        &mut self,
+        info: &QueueInfo,
+        timer_bias: Option<f64>,
+        rng: &mut impl StreamRng,
+    ) -> Option<QueueSelection> {
+        let stock = self.inner.select_streamed(info, timer_bias, rng);
+        if self.windows.is_empty() {
+            return stock;
+        }
+        rng.use_stream(Stream::WindowShape);
+        let chosen = self.decide(stock, info, rng);
+        rng.use_stream(Stream::QueueChoice);
+        chosen
+    }
+}
