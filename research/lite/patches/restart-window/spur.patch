+    }
+
+    fn info(local: &[usize], network: usize, timer: usize) -> QueueInfo {
+        QueueInfo {
+            local_queue_sizes: local.to_vec(),
+            network_queue_size: network,
+            timer_queue_size: timer,
+            step: 0,
+        }
+    }
+
+    /// A step sequence that does not depend on what was selected, so two
+    /// selectors can be driven through the same steps.
+    fn infos(n: usize, seed: u64) -> Vec<QueueInfo> {
+        let mut r = StdRng::seed_from_u64(seed);
+        (0..n)
+            .map(|i| QueueInfo {
+                local_queue_sizes: (0..3).map(|_| r.random_range(0..3)).collect(),
+                network_queue_size: r.random_range(0..3),
+                timer_queue_size: r.random_range(0..2),
+                step: i as i32,
+            })
+            .collect()
+    }
+
+    fn share<S: QueueSelector>(
+        w: &mut WindowedSelector<S>,
+        info: &QueueInfo,
+        bias: Option<f64>,
+        draws: u32,
+    ) -> (f64, f64, f64) {
+        let mut rng = StreamSet::new(7, true);
+        let (mut local, mut network, mut timer) = (0u32, 0u32, 0u32);
+        for _ in 0..draws {
+            rng.use_stream(Stream::QueueChoice);
+            match w.select_streamed(info, bias, &mut rng) {
+                Some(QueueSelection::Local(_)) => local += 1,
+                Some(QueueSelection::Network) => network += 1,
+                Some(QueueSelection::Timer) => timer += 1,
+                None => {}
+            }
+        }
+        let d = f64::from(draws);
+        (f64::from(local) / d, f64::from(network) / d, f64::from(timer) / d)
+    }
