+    fn an_untreated_run_draws_the_queue_choice_stream_exactly_as_the_stock_selector() {
+        let steps = infos(2000, 3);
+        for isolated in [false, true] {
+            let mut base = probabilistic(0.8, 0.03);
+            let mut base_rng = StreamSet::new(11, isolated);
+            let mut windowed = WindowedSelector::new(probabilistic(0.8, 0.03), Cell::Stock);
+            let mut win_rng = StreamSet::new(11, isolated);
+            windowed.open_window(0, 0);
+            windowed.open_window(2, 0);
+            for (i, step) in steps.iter().enumerate() {
+                let bias = if i % 2 == 0 { Some(2.0) } else { None };
+                base_rng.use_stream(Stream::QueueChoice);
+                win_rng.use_stream(Stream::QueueChoice);
+                let a = base.select_streamed(step, bias, &mut base_rng);
+                let b = windowed.select_streamed(step, bias, &mut win_rng);
