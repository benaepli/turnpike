+        untreated_runs_capped,
+        untreated_over_cap_runs,
+        untreated_rows_dropped,
+        untreated_gap_hist,
+    } = s;
+    let StallCapMarks {
+        rows,
+        acted_deliveries,
+        acted_timers,
+        releases,
+    } = marks;
+    let mut out = vec![
+        leaf(prefix, "stops", *stops),
+        leaf(prefix, "treated_runs", *treated_runs),
