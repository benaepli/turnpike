+    /// A remote record from `origin` to `dest` sent at `incarnation`,
+    /// queued through the ledger hooks.
+    fn queue_record(
+        state: &mut State<NoHashing>,
+        origin: NodeId,
+        dest: NodeId,
+        incarnation: u32,
+    ) -> (usize, u32) {
+        let env = Env::<NoHashing>::with_slots(1);
+        let ordinal = state.next_send_ordinal(origin);
+        let rec = Record {
+            pc: 0,
+            node: dest,
+            origin_node: origin,
+            continuation: crate::simulator::core::Continuation::Recover,
+            entry_pc: 0,
+            initial_env: env.clone(),
+            env,
+            priority: 0.5,
+            causal_operation_id: None,
+            trace_id: None,
+            link_seq: None,
+            origin_incarnation: incarnation,
+            bias: DeliveryBias::NONE,
+            timer_entry: None,
+            send_ordinal: ordinal,
+            receiver_token_at_send: state.node_state_token(dest),
+        };
+        state.push_runnable(Runnable::Record(rec));
+        (origin.index, ordinal)
+    }
+
+    fn sheltered_keys(state: &State<NoHashing>) -> Vec<(usize, u32)> {
+        let mut keys: Vec<(usize, u32)> = state
+            .purgatory
+            .iter()
+            .filter_map(|(_, r)| match r {
+                Runnable::Record(rec) if rec.bias.contains(DeliveryBias::SHELTERED) => {
+                    Some((rec.origin_node.index, rec.send_ordinal))
+                }
+                _ => None,
+            })
+            .collect();
+        keys.sort_unstable();
+        keys
+    }
