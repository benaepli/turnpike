+                        .send_ledger
+                        .get(rec.origin_node.index)
+                        .and_then(|l| l.opening_end)
+                        .is_some_and(|end| rec.send_ordinal >= end)
+                {
+                    Some(op_shelter::Class::SettledFresh)
+                } else {
+                    None
+                }
+            }
+            _ => None,
+        };
+        let Some(class) = class else {
+            continue;
+        };
+        let mut r = state.take_network(idx);
+        if let Runnable::Record(rec) = &mut r {
+            rec.bias.insert(DeliveryBias::SHELTERED);
