+    /// On a treated run the pre-pass names the masked records and counts
+    /// them once per record; when the mask would leave nothing eligible it
+    /// is lifted for the step. An untreated run masks nothing and touches
+    /// no counter.
+    #[test]
+    fn the_prepass_masks_counts_once_per_record_and_lifts_when_nothing_else_is_eligible() {
+        let _serial = crate::simulator::config_override::exclusive_session();
+        util_stats::set_enabled(true);
+        let before = util_stats::snapshot().request_wait;
+        let never = |_: &Runnable<NoHashing>| false;
+
+        let mut untreated = restarted_state();
+        queue_caused_record(&mut untreated, 0, 2, 0, Some(5));
+        assert_eq!(treatment_prepass(&mut untreated, 3, false, &never), (Vec::new(), false));
+        assert_eq!(untreated.request_wait.masked_len(), 0);
+
+        let mut state = restarted_state();
+        state.request_wait.enabled = true;
+        let caused = queue_caused_record(&mut state, 0, 2, 0, Some(5));
+        let other = queue_caused_record(&mut state, 0, 1, 0, Some(5));
+        let key = key_at(&state, caused);
+        assert_eq!(treatment_prepass(&mut state, 3, false, &never), (vec![key], false));
+        assert_eq!(treatment_prepass(&mut state, 3, false, &never), (vec![key], false));
+        let mid = util_stats::snapshot().request_wait;
+        assert_eq!(mid.masked_offers - before.masked_offers, 2, "one offer per step");
+        assert_eq!(mid.records_masked - before.records_masked, 1, "one record");
+        assert_eq!(mid.lift_steps - before.lift_steps, 0);
+
+        // Only the masked record is left: the mask is lifted, and taking
+        // the record reads as a lifted release.
+        state.take_network(other);
+        assert_eq!(treatment_prepass(&mut state, 3, false, &never), (Vec::new(), true));
+        state.crash_info.current_step = 113;
+        note_request_wait_take(&mut state, 3, 0, true);
+        let after = util_stats::snapshot().request_wait;
+        assert_eq!(after.lift_steps - mid.lift_steps, 1);
+        assert_eq!(after.released_lifted - mid.released_lifted, 1);
+        assert_eq!(after.hold_steps_sum - mid.hold_steps_sum, 3);
+        assert_eq!(state.request_wait.masked_len(), 0);
+
+        // A blocked rival does not keep the mask on: eligibility is read
+        // under the base rule.
+        let blocked = queue_caused_record(&mut state, 1, 2, 0, None);
+        let block_it = |r: &Runnable<NoHashing>| {
+            matches!(r, Runnable::Record(rec) if rec.origin_node.index == 1)
+        };
+        assert_eq!(treatment_prepass(&mut state, 3, false, &block_it), (Vec::new(), true));
+        state.take_network(blocked);
+        util_stats::set_enabled(false);
+    }
