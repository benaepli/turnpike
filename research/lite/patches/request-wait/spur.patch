+/// Whether the request wait masks `r` at this step: a remote record from a
+/// live current incarnation, caused by a post-fault client operation, whose
+/// destination is a server that has restarted, has not settled, and is
+/// within the learned bound from its restart.
+fn request_wait_masks<H: HashPolicy>(state: &State<H>, servers: usize, r: &Runnable<H>) -> bool {
+    let Runnable::Record(rec) = r else {
+        return false;
+    };
+    if rec.origin_node == rec.node
+        || rec.node.index >= servers
+        || !state.client_anchor.caused_post_fault(rec.causal_operation_id)
+        || state.fault_crossing(rec.origin_node, rec.origin_incarnation)
+        || state.incarnation(rec.node) == 0
+    {
+        return false;
+    }
+    let Some(l) = state.send_ledger.get(rec.node.index) else {
+        return false;
+    };
+    if request_wait::settled(l) {
+        return false;
+    }
+    let bound = state
+        .ghost_release
+        .bound
+        .unwrap_or(request_wait::DEFAULT_BOUND);
+    state.crash_info.current_step < l.last_restart_step.saturating_add(bound)
+}
+
+/// One pass over every queue, on the runs that need it. The request wait
+/// learns which records it masks this step and whether anything else is
+/// eligible under `base_ineligible`, so the mask is lifted rather than leave
+/// the step unfilled; the shelter learns whether nothing at all is eligible,
+/// in which case every sheltered record is released. Returns the keys of
+/// the records masked this step and whether the mask was lifted.
+fn treatment_prepass<H: HashPolicy>(
+    state: &mut State<H>,
+    servers: usize,
+    strict_timers: bool,
+    base_ineligible: &impl Fn(&Runnable<H>) -> bool,
+) -> (Vec<fresh_first::RecordKey>, bool) {
+    let wait_on = state.request_wait.enabled;
+    let shelter_pending = state.shelter.enabled && state.shelter.held_len() > 0;
+    let mut masked_now: Vec<fresh_first::RecordKey> = Vec::new();
+    if !(wait_on || shelter_pending) {
+        return (masked_now, false);
+    }
+    let mut eligible_base = state
+        .local_queues
+        .iter()
+        .flatten()
+        .any(|r| !base_ineligible(r))
+        || state
+            .timer_queue
+            .iter()
+            .any(|r| !base_ineligible(r) && !(strict_timers && timer_gate_blocks(state, r)));
+    let mut eligible_masked = eligible_base;
+    for r in &state.network_queue {
+        if base_ineligible(r) {
+            continue;
+        }
+        eligible_base = true;
+        if wait_on
+            && let Runnable::Record(rec) = r
+            && request_wait_masks(state, servers, r)
+        {
+            masked_now.push((rec.origin_node.index, rec.send_ordinal));
+        } else {
+            eligible_masked = true;
+        }
+    }
+    let step = state.crash_info.current_step;
+    if shelter_pending && !eligible_base {
+        let keys = state.shelter.mark_all(op_shelter::Release::Dry);
+        state.release_sheltered(&keys, step);
+    }
+    if masked_now.is_empty() {
+        return (masked_now, false);
+    }
+    if !eligible_masked {
+        masked_now.clear();
+        util_stats::record_request_wait_lift();
+        return (masked_now, true);
+    }
+    let mut new_records = 0;
+    for &key in &masked_now {
+        if state.request_wait.mask(key, step) {
+            new_records += 1;
+        }
+    }
+    util_stats::record_request_wait_masked(masked_now.len() as u64, new_records);
+    (masked_now, false)
+}
+
+/// The record at `idx` of the network queue is being taken: when it had
+/// been masked, count how its wait ended. `lifted` says the mask is off
+/// this step because nothing else was eligible.
+fn note_request_wait_take<H: HashPolicy>(
+    state: &mut State<H>,
+    servers: usize,
+    idx: usize,
+    lifted: bool,
+) {
+    if state.request_wait.masked_len() == 0 {
+        return;
+    }
+    let Runnable::Record(rec) = &state.network_queue[idx] else {
+        return;
+    };
+    let key = (rec.origin_node.index, rec.send_ordinal);
+    let dest = rec.node.index;
+    let still_masked = lifted && request_wait_masks(state, servers, &state.network_queue[idx]);
+    let Some(first) = state.request_wait.take(key) else {
+        return;
+    };
+    let release = if still_masked {
+        request_wait::Release::Lifted
+    } else if state.send_ledger.get(dest).is_some_and(request_wait::settled) {
+        request_wait::Release::Settled
+    } else {
+        request_wait::Release::Bound
+    };
+    let held = (state.crash_info.current_step - first).max(0) as u64;
+    util_stats::record_request_wait_release(release, held);
+}
