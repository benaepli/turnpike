+    let TreatmentHalves { treated, untreated } = h;
+    let mut out = cell(&format!("{prefix}.treated"), treated);
+    out.extend(cell(&format!("{prefix}.untreated"), untreated));
+    out
+}
+
+fn treatment_crossed_leaves<T>(
+    prefix: &str,
+    c: &TreatmentCrossed<T>,
+    cell: impl Fn(&str, &T) -> Vec<(String, Value)>,
