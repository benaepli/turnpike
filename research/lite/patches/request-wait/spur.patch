+/// The index of the cell a run occupies under the two treatment bits of the
+/// request wait and the shelter, so each contrast can be read matched on
+/// the other bit.
+pub fn treatment_cell(request_wait: bool, shelter: bool) -> usize {
+    (request_wait as usize) << 1 | shelter as usize
+}
+
+/// A treated step kept the request-wait mask on with `masked` records
+/// masked, of which `new_records` were masked for the first time in their
+/// run.
+#[inline]
+pub fn record_request_wait_masked(masked: u64, new_records: u64) {
+    if !enabled() {
+        return;
+    }
+    RQW_MASKED_OFFERS.fetch_add(masked, Ordering::Relaxed);
+    RQW_RECORDS_MASKED.fetch_add(new_records, Ordering::Relaxed);
+}
+
+/// A treated step lifted the request-wait mask because nothing else was
+/// eligible.
+#[inline]
+pub fn record_request_wait_lift() {
+    if !enabled() {
+        return;
+    }
+    RQW_LIFT_STEPS.fetch_add(1, Ordering::Relaxed);
+}
+
+/// A request-caused record entered an unsettled restarted destination at or
+/// past the bound from its restart on a treated run, never having been
+/// masked.
+#[inline]
+pub fn record_request_wait_arrival_after_bound() {
+    if !enabled() {
+        return;
+    }
+    RQW_ARRIVALS_AFTER_BOUND.fetch_add(1, Ordering::Relaxed);
+}
+
+/// A record that had been masked was taken, `hold_steps` after it was first
+/// masked.
+#[inline]
+pub fn record_request_wait_release(release: request_wait::Release, hold_steps: u64) {
+    if !enabled() {
+        return;
+    }
+    match release {
+        request_wait::Release::Settled => &RQW_RELEASED_SETTLED,
+        request_wait::Release::Bound => &RQW_RELEASED_BOUND,
+        request_wait::Release::Lifted => &RQW_RELEASED_LIFTED,
+    }
+    .fetch_add(1, Ordering::Relaxed);
+    RQW_HOLD_STEPS_SUM.fetch_add(hold_steps, Ordering::Relaxed);
+}
+
+/// A restarted node settled `steps` after its restart. Counted on both
+/// halves of the request-wait split.
+#[inline]
+pub fn record_request_wait_settled(treated: bool, steps: u64) {
+    if !enabled() {
+        return;
+    }
+    let i = treated as usize;
+    let cell = (steps as usize / SETTLE_HIST_WIDTH).min(SETTLE_HIST_CELLS - 1);
+    RQW_SETTLE_HIST[i][cell].fetch_add(1, Ordering::Relaxed);
+    RQW_SETTLED[i].fetch_add(1, Ordering::Relaxed);
+}
+
+/// A message entry caused by a post-fault client operation reached a
+/// restarted server, in the run's treatment cell; `acted` says it wrote
+/// the server's state.
+#[inline]
+pub fn record_request_wait_entry(cell: usize, acted: bool) {
+    if !enabled() {
+        return;
+    }
+    RQW_ENTRIES[cell].fetch_add(1, Ordering::Relaxed);
+    if acted {
+        RQW_ENTRIES_ACTED[cell].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Why a post-fault invocation on a treated run sheltered nothing.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ShelterSkip {
+    /// The target is still in its restart opening.
+    TargetOpening,
+    /// The target has a crash queued.
+    TargetCrashPending,
+}
+
+/// A post-fault invocation on a treated run was examined; `skip` says why
+/// nothing was sheltered, and otherwise `ghosts` and `settled_fresh` are
+/// the records of each class moved for it.
+#[inline]
+pub fn record_shelter_invocation(skip: Option<ShelterSkip>, ghosts: u64, settled_fresh: u64) {
+    if !enabled() {
+        return;
+    }
+    SH_OPS_EXAMINED.fetch_add(1, Ordering::Relaxed);
+    match skip {
+        Some(ShelterSkip::TargetOpening) => {
+            SH_SKIPPED_TARGET_OPENING.fetch_add(1, Ordering::Relaxed);
+            return;
+        }
+        Some(ShelterSkip::TargetCrashPending) => {
+            SH_SKIPPED_TARGET_CRASH_PENDING.fetch_add(1, Ordering::Relaxed);
+            return;
+        }
+        None => {}
+    }
+    if ghosts + settled_fresh == 0 {
+        return;
+    }
+    SH_OPS_SHELTERED.fetch_add(1, Ordering::Relaxed);
+    SH_RECORDS_GHOST.fetch_add(ghosts, Ordering::Relaxed);
+    SH_RECORDS_SETTLED_FRESH.fetch_add(settled_fresh, Ordering::Relaxed);
+    if ghosts > 0 {
+        SH_OPS_WITH_GHOST.fetch_add(1, Ordering::Relaxed);
+    }
+    if settled_fresh > 0 {
+        SH_OPS_WITH_SETTLED_FRESH.fetch_add(1, Ordering::Relaxed);
+    }
+    if ghosts > 0 && settled_fresh > 0 {
+        SH_OPS_WITH_BOTH.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// A sheltered record left the delay queue, `hold_steps` after it was
+/// moved there.
+#[inline]
+pub fn record_shelter_release(release: op_shelter::Release, hold_steps: u64) {
+    if !enabled() {
+        return;
+    }
+    match release {
+        op_shelter::Release::Response => &SH_RELEASED_ON_RESPONSE,
+        op_shelter::Release::Expiry => &SH_RELEASED_ON_EXPIRY,
+        op_shelter::Release::Dry => &SH_RELEASED_DRY,
+    }
+    .fetch_add(1, Ordering::Relaxed);
+    SH_HOLD_STEPS_SUM.fetch_add(hold_steps, Ordering::Relaxed);
+}
+
+/// A step whose delay queue held only sheltered records, with nothing else
+/// suspending the stall clock, so the clock ran where a delayed message
+/// would have held it.
+#[inline]
+pub fn record_shelter_stall_clock_not_suspended() {
+    if !enabled() {
+        return;
+    }
+    SH_STALL_CLOCK_STEPS_NOT_SUSPENDED.fetch_add(1, Ordering::Relaxed);
+}
+
+/// A message entry from a sender that restarted since sending, in the
+/// run's treatment cell; `acted` says it wrote the receiver's state.
+#[inline]
+pub fn record_shelter_entry(cell: usize, acted: bool) {
+    if !enabled() {
+        return;
+    }
+    SH_ENTRIES[cell].fetch_add(1, Ordering::Relaxed);
+    if acted {
+        SH_ENTRIES_ACTED[cell].fetch_add(1, Ordering::Relaxed);
+    }
+}
