+        wait_on_shelter_off,
+        wait_off_shelter_on,
+        wait_off_shelter_off,
+    } = c;
+    let mut out = cell(&format!("{prefix}.wait_on_shelter_on"), wait_on_shelter_on);
+    out.extend(cell(&format!("{prefix}.wait_on_shelter_off"), wait_on_shelter_off));
+    out.extend(cell(&format!("{prefix}.wait_off_shelter_on"), wait_off_shelter_on));
