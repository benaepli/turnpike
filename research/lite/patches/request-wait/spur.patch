+/// Whether the stall clock holds this step: a planned crash is withheld, a
+/// client request is held, or a message is delayed for a reason other than
+/// the shelter. A step on which only sheltered records sit in the delay
+/// queue and nothing else holds the clock is counted, since a delayed
+/// message would have held it there.
+fn stall_clock_suspended<H: HashPolicy>(
+    state: &State<H>,
+    crash_withheld: bool,
+    requests_held: bool,
+) -> bool {
+    let delayed_unsheltered = state
+        .purgatory
+        .iter()
+        .any(|(_, r)| !op_shelter::is_sheltered(r));
+    let suspended = crash_withheld || requests_held || delayed_unsheltered;
+    if !suspended && !state.purgatory.is_empty() {
+        util_stats::record_shelter_stall_clock_not_suspended();
+    }
+    suspended
+}
+
+/// A post-fault operation `op` is being invoked at server `target` on a run
+/// that shelters: every record in flight to the target from another server
+/// that a fault touched - sent by an incarnation that died or a sender that
+/// is down, or by a restarted sender's current incarnation after its
+/// opening - leaves the network queue for the delay queue until the
+/// operation's response, at most `BOUND_STEPS`. A target still in its own
+/// restart opening, or with a crash queued, is left alone.
+fn shelter_target<H: HashPolicy>(
+    state: &mut State<H>,
+    server_role: NameId,
+    target: usize,
+    op: i32,
+) {
+    let skip = if state.in_opening(target) {
+        Some(util_stats::ShelterSkip::TargetOpening)
+    } else if state
+        .send_ledger
+        .get(target)
+        .is_some_and(|l| l.crash_pending > 0)
+    {
+        Some(util_stats::ShelterSkip::TargetCrashPending)
+    } else {
+        None
+    };
+    if skip.is_some() {
