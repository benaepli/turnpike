+        state.shelter.enabled = true;
+        state.crash_info.current_step = 50;
+        let target = node(SERVER, 0);
+        let (n1, n2, n3, client) = (node(SERVER, 1), node(SERVER, 2), node(SERVER, 3), node(CLIENT, 4));
+        // Node 1 restarted twice and is past its opening; node 2 restarted
+        // and is still in its opening; node 3 never restarted.
+        state.incarnations[1] = 2;
+        state.send_ledger[1].opening_end = Some(2);
+        state.incarnations[2] = 1;
+        let ghost = queue_record(&mut state, n1, target, 1);
+        let opening_send_of_1 = queue_record(&mut state, n1, target, 2);
+        let fresh_past_opening = queue_record(&mut state, n1, target, 2);
+        assert_eq!(fresh_past_opening.1, 2);
+        let opening_send_of_2 = queue_record(&mut state, n2, target, 1);
+        let never_restarted = queue_record(&mut state, n3, target, 0);
+        let elsewhere = queue_record(&mut state, n1, n2, 1);
+        let from_client = queue_record(&mut state, client, target, 0);
+        state.push_runnable(Runnable::ChannelSend {
+            target,
+            channel: crate::simulator::core::values::ChannelId { node: target, id: 0 },
+            message: Value::<NoHashing>::unit(),
+            origin_node: n1,
+            pc: 0,
+            priority: 0.5,
+        });
+        // Node 3 goes down with its record in the air: a downed sender.
+        let queued_before = state.network_queue.len();
+        state.crash_info.currently_crashed.insert(n3);
+
+        shelter_target(&mut state, SERVER, 0, 9);
+
+        let mut want = vec![ghost, fresh_past_opening, never_restarted];
+        want.sort_unstable();
+        assert_eq!(sheltered_keys(&state), want);
+        assert_eq!(state.network_queue.len(), queued_before - 3);
+        for key in [opening_send_of_1, opening_send_of_2, elsewhere, from_client] {
+            assert!(
+                state.network_queue.iter().any(|r| matches!(r, Runnable::Record(rec)
+                    if (rec.origin_node.index, rec.send_ordinal) == key)),
+                "record {key:?} was moved"
