+
+        // Records sent after the invocation are never touched.
+        queue_record(&mut state, n1, target, 2);
+        assert_eq!(state.shelter.held_len(), 3);
+
+        // The response releases the operation's records to the step it is
+        // recorded at, and nothing else in the delay queue.
+        state.delay_runnable(500, Runnable::Timer(crate::simulator::core::state::Timer {
+            pc: 0,
+            node: target,
