+        assert_eq!(state.purgatory.len(), 1);
+        let end = util_stats::snapshot().shelter;
+        assert_eq!(end.released_on_response - after.released_on_response, 3);
+        assert_eq!(end.hold_steps_sum - after.hold_steps_sum, 33);
+        util_stats::set_enabled(false);
+    }
+
+    /// A target still in its own restart opening, or with a crash queued,
+    /// is skipped and nothing moves; an invocation that finds nothing to
+    /// move is examined but not counted as sheltering.
+    #[test]
+    fn the_shelter_skips_a_target_in_its_opening_or_with_a_crash_pending() {
+        let _serial = crate::simulator::config_override::exclusive_session();
+        util_stats::set_enabled(true);
+        let before = util_stats::snapshot().shelter;
+        let mut state = State::<NoHashing>::new(&[(SERVER, 3), (CLIENT, 1)], 1);
+        state.shelter.enabled = true;
+        let target = node(SERVER, 0);
+        let n1 = node(SERVER, 1);
+        state.incarnations[1] = 1;
+        queue_record(&mut state, n1, target, 0);
+
+        state.incarnations[0] = 1;
+        shelter_target(&mut state, SERVER, 0, 1);
+        assert!(state.purgatory.is_empty(), "a target in its opening is left alone");
+        state.send_ledger[0].delivery_acted_since_restart = true;
+        state.push_runnable(Runnable::Crash { node_id: target, priority: 0.5 });
+        shelter_target(&mut state, SERVER, 0, 2);
+        assert!(state.purgatory.is_empty(), "a target about to crash is left alone");
+        state.take_local(0, 0);
+        shelter_target(&mut state, SERVER, 2, 3);
+        assert!(state.purgatory.is_empty(), "nothing in flight to node 2");
+        shelter_target(&mut state, SERVER, 0, 4);
