+    /// Sheltered records in the delay queue do not hold the stall clock;
+    /// any other delayed message, a withheld crash or a held request does.
+    #[test]
+    fn sheltered_records_do_not_suspend_the_stall_clock() {
+        let _serial = crate::simulator::config_override::exclusive_session();
+        util_stats::set_enabled(true);
+        let before = util_stats::snapshot().shelter.stall_clock_steps_not_suspended;
+        let mut state = State::<NoHashing>::new(&[(SERVER, 2), (CLIENT, 1)], 1);
+        let (a, b) = (node(SERVER, 0), node(SERVER, 1));
+        assert!(!stall_clock_suspended(&state, false, false));
+        assert!(stall_clock_suspended(&state, true, false));
+        assert!(stall_clock_suspended(&state, false, true));
+        queue_record(&mut state, b, a, 0);
+        let mut r = state.take_network(0);
+        if let Runnable::Record(rec) = &mut r {
+            rec.bias.insert(DeliveryBias::SHELTERED);
+        }
+        state.delay_runnable(100, r);
+        assert!(!stall_clock_suspended(&state, false, false), "a sheltered record holds nothing");
+        assert!(stall_clock_suspended(&state, true, false));
