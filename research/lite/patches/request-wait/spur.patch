+    /// With sheltered records in the delay queue and nothing eligible, the
+    /// pre-pass releases every sheltered record to this step; with anything
+    /// eligible it leaves them alone.
+    #[test]
+    fn the_prepass_releases_sheltered_records_on_a_dry_step() {
+        let _serial = crate::simulator::config_override::exclusive_session();
+        util_stats::set_enabled(true);
