+                .shelter
+                .shelter(op, (rec.origin_node.index, rec.send_ordinal), step);
+        }
+        state.delay_runnable(step + op_shelter::BOUND_STEPS, r);
+        match class {
+            op_shelter::Class::Ghost => ghosts += 1,
+            op_shelter::Class::SettledFresh => settled_fresh += 1,
+        }
+    }
+    util_stats::record_shelter_invocation(None, ghosts, settled_fresh);
