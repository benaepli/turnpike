+    /// A remote record from `origin` to `dest`, sent at `incarnation` under
+    /// the client operation `cause`, queued through the ledger hooks.
+    fn queue_caused_record(
+        state: &mut State<NoHashing>,
+        origin: usize,
+        dest: usize,
+        incarnation: u32,
+        cause: Option<i32>,
+    ) -> usize {
+        let idx = queue_record(state, origin, dest, incarnation, 0.5);
+        if let Runnable::Record(rec) = &mut state.network_queue[idx] {
+            rec.causal_operation_id = cause;
+        }
+        idx
+    }
+
+    fn key_at(state: &State<NoHashing>, idx: usize) -> (usize, u32) {
+        match &state.network_queue[idx] {
+            Runnable::Record(rec) => (rec.origin_node.index, rec.send_ordinal),
+            other => panic!("not a record: {other:?}"),
+        }
+    }
+
+    /// Three servers, node 2 back from a crash at step 100 with an opening
+    /// that addressed nodes 0 and 1, the run past its first crash so that
+    /// operation 5 and later are post-fault, at step 110.
+    fn restarted_state() -> State<NoHashing> {
+        let mut state = State::<NoHashing>::new(&[(ROLE, 3)], 1);
+        state.incarnations[2] = 1;
+        state.send_ledger[2].last_restart_step = 100;
+        state.send_ledger[2].opening_peers = 0b011;
+        state.client_anchor.first_post_fault_op = Some(5);
+        state.crash_info.current_step = 110;
+        state
+    }
+
+    /// The wait masks a record caused by a post-fault operation, from a
+    /// live current incarnation, at a restarted server that has not settled
+    /// and is within the bound from its restart, and nothing else.
+    #[test]
+    fn the_wait_masks_only_a_request_caused_record_at_an_unsettled_restarted_destination() {
+        let mut state = restarted_state();
+        let caused = queue_caused_record(&mut state, 0, 2, 0, Some(5));
+        let uncaused = queue_caused_record(&mut state, 0, 2, 0, None);
+        let pre_fault = queue_caused_record(&mut state, 0, 2, 0, Some(4));
+        let to_settled_dest = queue_caused_record(&mut state, 0, 1, 0, Some(6));
+        let masks = |state: &State<NoHashing>, idx: usize| {
+            request_wait_masks(state, 3, &state.network_queue[idx])
+        };
+        assert!(masks(&state, caused));
+        assert!(!masks(&state, uncaused), "a record no request caused");
+        assert!(!masks(&state, pre_fault), "a record caused before the first crash");
+        assert!(!masks(&state, to_settled_dest), "a destination that never restarted");
+        let cs = queue_channel_send(&mut state, 0, 2);
+        assert!(!masks(&state, cs), "a channel send");
+        queue_timer(&mut state);
+        assert!(!request_wait_masks(&state, 3, &state.timer_queue[0]), "a timer");
+
+        // A ghost: sent by an incarnation of node 1 that has since died.
+        state.incarnations[1] = 1;
+        let ghost = queue_caused_record(&mut state, 1, 2, 0, Some(5));
+        assert!(!masks(&state, ghost), "a dead-incarnation record");
+        let fresh = queue_caused_record(&mut state, 1, 2, 1, Some(5));
+        assert!(masks(&state, fresh), "the current incarnation of a restarted origin");
+
+        // A record whose sender is down.
+        crash_node(&mut state, node(0));
+        assert!(state.network_queue.iter().all(|r| match r {
+            Runnable::Record(rec) => rec.origin_node.index != 0 || !masks(&state, 0),
+            _ => true,
+        }));
+        let down = state
+            .network_queue
+            .iter()
+            .position(|r| matches!(r, Runnable::Record(rec) if rec.origin_node.index == 0 && rec.node.index == 2))
+            .expect("node 0's record to node 2 is still queued");
+        assert!(!masks(&state, down), "a record whose sender is down");
+
+        // The bound from the restart: the default with no learned quantile,
+        // the learned one otherwise.
+        assert_eq!(state.ghost_release.bound, None);
+        state.crash_info.current_step = 100 + request_wait::DEFAULT_BOUND - 1;
+        assert!(masks(&state, fresh));
+        state.crash_info.current_step = 100 + request_wait::DEFAULT_BOUND;
+        assert!(!masks(&state, fresh), "at the bound the mask is off");
+        state.ghost_release.bound = Some(50);
+        assert!(masks(&state, fresh), "the learned bound is wider");
+        state.crash_info.current_step = 150;
+        assert!(!masks(&state, fresh));
+        state.crash_info.current_step = 110;
+
+        // Settled: a majority of the opening peers answered, or the opening
+        // addressed nobody.
+        state.send_ledger[2].opening_replied = 0b001;
+        assert!(masks(&state, fresh), "one of two peers is no majority");
+        state.send_ledger[2].opening_replied = 0b011;
+        assert!(!masks(&state, fresh), "a settled destination");
+        state.send_ledger[2].opening_replied = 0;
+        state.send_ledger[2].opening_peers = 0;
+        assert!(!masks(&state, fresh), "an empty opening is settled");
+        state.send_ledger[2].opening_peers = 0b011;
+        assert!(masks(&state, fresh));
+        assert!(!request_wait_masks(&state, 2, &state.network_queue[fresh]), "past the servers");
+    }
+
+    fn queue_timer(state: &mut State<NoHashing>) {
