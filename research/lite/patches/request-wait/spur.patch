+        queue_caused_record(&mut state, 0, 1, 0, None);
+        assert_eq!(treatment_prepass(&mut state, 3, false, &never).0.len(), 1);
+        state.send_ledger[2].opening_replied = 0b011;
+        assert_eq!(treatment_prepass(&mut state, 3, false, &never), (Vec::new(), false));
+        state.crash_info.current_step = 115;
+        note_request_wait_take(&mut state, 3, caused, false);
+        let mid = util_stats::snapshot().request_wait;
