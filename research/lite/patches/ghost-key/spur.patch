+        note_ghost_release_entry(&mut one, node(0), 0, node(1), 103, true, 4, 3);
+        assert!(one.ghost_release.trigger.is_some(), "the single half fired off the key");
+        note_ghost_release_entry(&mut one, node(0), 0, node(1), 104, true, 6, 3);
+        assert_eq!(one.ghost_release.trigger, None);
+        assert_eq!(one.crash_hold_until, vec![0, 105, 500]);
+
+        let after = util_stats::snapshot().crash_place.ghost_release;
+        let d = |f: fn(&util_stats::GhostReleaseCellStats) -> u64| {
+            (
+                f(&after.cells.stranded_on) - f(&before.cells.stranded_on),
+                f(&after.cells.stranded_off) - f(&before.cells.stranded_off),
+                f(&after.cells.release_all) - f(&before.cells.release_all),
+                f(&after.cells.single) - f(&before.cells.single),
+                f(&after.cells.defer0_early0_stranded1) - f(&before.cells.defer0_early0_stranded1),
+                f(&after.cells.defer1_early0_stranded1) - f(&before.cells.defer1_early0_stranded1),
+            )
+        };
+        assert_eq!(d(|c| c.stranded_skipped_entries), (7, 0, 6, 1, 7, 0));
+        assert_eq!(d(|c| c.stranded_fired), (3, 0, 2, 1, 3, 0));
+        assert_eq!(d(|c| c.stranded_fired_first_entry), (1, 0, 1, 0, 1, 0));
+        assert_eq!(d(|c| c.stranded_fired_later_entry), (2, 0, 1, 1, 2, 0));
+        assert_eq!(d(|c| c.triggers_armed), (5, 1, 5, 1, 5, 0));
+        assert_eq!(d(|c| c.triggers_fired), (3, 1, 3, 1, 3, 0));
+        assert_eq!(d(|c| c.triggers_expired), (1, 0, 1, 0, 1, 0));
+        assert_eq!(after.stranded.fired - before.stranded.fired, 3);
+        assert_eq!(after.stranded.fired_first_entry - before.stranded.fired_first_entry, 1);
+        assert_eq!(after.stranded.fired_later_entry - before.stranded.fired_later_entry, 2);
+        assert_eq!(after.stranded.skipped_entries - before.stranded.skipped_entries, 7);
+        assert_eq!(after.armed - before.armed, 6);
+        assert_eq!(after.fired - before.fired, 4);
+        assert_eq!(after.expired - before.expired, 1);
+
+        util_stats::set_enabled(true);
+        let zero = util_stats::snapshot().crash_place.ghost_release;
+        util_stats::set_enabled(false);
+        assert_eq!(zero.stranded.fired, 0);
+        assert_eq!(zero.stranded.skipped_entries, 0);
+        assert_eq!(zero.phase.overridden, 0);
+        assert_eq!(zero.phase.released_on_condition, 0);
+        assert_eq!(zero.defer_coin.examined, 0);
+        assert_eq!(zero.defer_coin.exempted, 0);
+        assert_eq!(zero.cells.stranded_on.stranded_skipped_entries, 0);
+        assert_eq!(zero.cells.early_on.phase_overridden_mid_to_early, 0);
+        assert_eq!(zero.cells.defer_on.defer_coin_exempted, 0);
+        assert_eq!(zero.cells.treated.triggers_armed, 0);
+    }
