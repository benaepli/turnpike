+        assert!(e.ghost_release.trigger.is_some());
+        assert_eq!(e.ghost_release.stranded_skipped_at, 0, "a new arming kept the skips");
+        // The other half fires on the first acted entry whatever its record.
+        let mut c = armed(
+            util_stats::GhostReleaseCell::ReleaseAll(GhostReleaseBits::NONE),
+            5,
+            7,
+        );
