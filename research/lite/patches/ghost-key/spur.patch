+    /// A state whose node 1 crash, held on an anchored run when `anchored`,
+    /// was released by a firing on node 2 at step 103, offered at step 104:
+    /// the planned victim's segment is silent and the ghost node's is all
+    /// undelivered.
+    fn released_onto_ghost(cell: util_stats::GhostReleaseCell, anchored: bool) -> State<NoHashing> {
+        let mut state = release_state(3, &[1], vec![0, 500, 0], cell, Some(20));
+        if anchored {
+            state.crash_phase.arm_node(1, 0);
+        }
+        state.incarnations = vec![1, 0, 0];
+        state.send_ledger[1].floor = state.send_ledger[1].issued;
+        state.send_ledger[2].issued = 2;
+        state.send_ledger[2].floor = 0;
+        state.send_ledger[2].recent = 2;
+        state.send_ledger[2].in_flight = 2;
+        arm_release_trigger(&mut state, 0, 100);
+        note_ghost_release_entry(&mut state, node(0), 0, node(2), 103, true, 0, 3);
+        assert_eq!(state.crash_hold_until[1], 104);
+        assert_eq!(state.ghost_release.released_mask, 0b010);
+        assert_eq!(state.ghost_release.ghost_node, Some(2));
+        state.crash_info.current_step = 104;
+        state
+    }
