+    /// On the early-on-ghost half an anchored run's released crash draws
+    /// its arm as the other half does, at the same stream position, then
+    /// waits for the early phase on the node whose entry fired the
+    /// trigger: released at once when that node's segment is all
+    /// undelivered whatever the draw, held through the anchor's unchanged
+    /// window when it is not, and read on the planned victim when the ghost
+    /// node is down. The other half holds as its drawn arm says, and an
+    /// unanchored run is untouched on both. Each override counts under the
+    /// cell by the arm it drew and by how it ended.
+    #[test]
+    fn a_released_crash_on_the_early_on_ghost_half_waits_for_the_early_phase_on_the_ghost_node() {
+        let _serial = crate::simulator::config_override::exclusive_session();
+        util_stats::set_enabled(true);
+        let before = util_stats::snapshot().crash_place.ghost_release;
+        let early = GhostReleaseBits {
+            early_on_ghost: true,
+            ..GhostReleaseBits::NONE
+        };
+        let treated_cell = util_stats::GhostReleaseCell::ReleaseAll(early);
+        let control_cell = util_stats::GhostReleaseCell::ReleaseAll(GhostReleaseBits::NONE);
+        let mut arms = [0u64; 3];
+        let seeds = 60u64;
+        for seed in 0..seeds {
+            let mut treated = released_onto_ghost(treated_cell, true);
+            let mut control = released_onto_ghost(control_cell, true);
+            let mut rng_t = StdRng::seed_from_u64(seed);
+            let mut rng_c = StdRng::seed_from_u64(seed);
+            let held_t = crash_hold_mask(&mut treated, 3, &mut rng_t) != 0;
+            let held_c = crash_hold_mask(&mut control, 3, &mut rng_c) != 0;
+            let drawn = control.crash_phase.arm_of(1).expect("the control drew no arm");
+            arms[drawn.index()] += 1;
+            assert!(!held_t, "seed {seed}: the ghost node's early phase did not release");
+            assert_eq!(
+                treated.crash_phase.arm_of(1),
+                Some(util_stats::CrashPhaseArm::Early),
+                "seed {seed}: the forced slot carries another arm"
+            );
+            assert_eq!(
+                held_c,
+                drawn != util_stats::CrashPhaseArm::Stock,
+                "seed {seed}: the control did not hold as its arm says"
+            );
+            assert_eq!(rng_t.next_u64(), rng_c.next_u64(), "seed {seed}: the streams diverged");
+        }
+        assert!(arms.iter().all(|&c| c > 0), "an arm was never drawn: {arms:?}");
+        let after = util_stats::snapshot().crash_place.ghost_release;
+        let on = |f: fn(&util_stats::GhostReleaseCellStats) -> u64| {
+            f(&after.cells.early_on) - f(&before.cells.early_on)
+        };
+        let off = |f: fn(&util_stats::GhostReleaseCellStats) -> u64| {
+            f(&after.cells.early_off) - f(&before.cells.early_off)
+        };
+        assert_eq!(on(|c| c.phase_overridden), seeds);
+        assert_eq!(
+            on(|c| c.phase_overridden_stock_to_early),
+            arms[util_stats::CrashPhaseArm::Stock.index()]
+        );
+        assert_eq!(
+            on(|c| c.phase_overridden_mid_to_early),
+            arms[util_stats::CrashPhaseArm::Mid.index()]
+        );
+        assert_eq!(
+            on(|c| c.phase_overridden_early_read_on_ghost),
+            arms[util_stats::CrashPhaseArm::Early.index()]
+        );
+        assert_eq!(on(|c| c.phase_released_on_condition), seeds);
+        assert_eq!(on(|c| c.phase_expired), 0);
+        assert_eq!((off(|c| c.phase_overridden), off(|c| c.phase_released_on_condition)), (0, 0));
+        assert_eq!(after.phase.overridden - before.phase.overridden, seeds);
+        assert_eq!(
+            after.phase.released_on_condition - before.phase.released_on_condition,
+            seeds
+        );
+        assert_eq!(
+            after.cells.defer0_early1_stranded0.phase_overridden
+                - before.cells.defer0_early1_stranded0.phase_overridden,
+            seeds
+        );
+
+        // A ghost node whose segment is part delivered meets the mid phase
+        // and not the early one: the forced wait holds through the anchor's
+        // window and no longer, and ends as expired.
+        let mut waits = released_onto_ghost(treated_cell, true);
+        waits.send_ledger[2].recent = 1;
+        let mut rng = StdRng::seed_from_u64(1);
+        for step in 104..104 + crash_phase::WINDOW {
+            waits.crash_info.current_step = step;
+            assert_eq!(crash_hold_mask(&mut waits, 3, &mut rng), 1 << 1, "step {step}");
+        }
+        waits.crash_info.current_step = 104 + crash_phase::WINDOW;
+        assert_eq!(crash_hold_mask(&mut waits, 3, &mut rng), 0, "the window did not end the wait");
+        let expired = util_stats::snapshot().crash_place.ghost_release;
+        assert_eq!(expired.cells.early_on.phase_expired - after.cells.early_on.phase_expired, 1);
+        assert_eq!(expired.phase.expired - after.phase.expired, 1);
+        assert_eq!(expired.phase.overridden - after.phase.overridden, 1);
+
+        // A ghost node that is down: the read falls back to the planned
+        // victim, whose early phase then releases.
+        let mut down = released_onto_ghost(treated_cell, true);
+        down.crash_info.currently_crashed.insert(node(2));
+        down.send_ledger[1].issued = 3;
+        down.send_ledger[1].floor = 2;
+        down.send_ledger[1].recent = 1;
+        down.send_ledger[2].recent = 0;
+        assert_eq!(crash_hold_mask(&mut down, 3, &mut rng), 0, "the fallback read did not release");
+        let mut silent = released_onto_ghost(treated_cell, true);
+        silent.crash_info.currently_crashed.insert(node(2));
+        assert_eq!(crash_hold_mask(&mut silent, 3, &mut rng), 1 << 1, "a silent victim released");
+
+        // An unanchored run holds nothing past its target on either half
+        // and counts nothing.
+        let settled = util_stats::snapshot().crash_place.ghost_release;
+        for cell in [treated_cell, control_cell] {
+            let mut flat = released_onto_ghost(cell, false);
+            let mut rng_a = StdRng::seed_from_u64(2);
+            let mut rng_b = StdRng::seed_from_u64(2);
+            assert_eq!(crash_hold_mask(&mut flat, 3, &mut rng_a), 0, "{cell:?}");
+            assert_eq!(rng_a.next_u64(), rng_b.next_u64(), "{cell:?}: an unanchored run drew");
+        }
+        let unmoved = util_stats::snapshot().crash_place.ghost_release;
+        assert_eq!(unmoved.phase.overridden, settled.phase.overridden);
+        util_stats::set_enabled(false);
+    }
