+    /// A crash captures the ordinal range of the sends its last handler
+    /// segment issued before the crash moves the floor, and a silent
+    /// segment leaves an empty range. On the stranded-key half only an
+    /// entry carrying a record of that range fires the trigger; every other
+    /// acted dead-incarnation entry is skipped with the trigger still armed,
+    /// an empty range fires on nothing until the bound expires, a new
+    /// arming forgets the skips, and the other half fires on the first
+    /// acted entry whatever its record. The firings count by whether the
+    /// entry was the first at its peer since arming.
+    #[test]
+    fn the_stranded_key_fires_only_on_a_record_of_the_segment_the_crash_stranded() {
+        let _serial = crate::simulator::config_override::exclusive_session();
+        util_stats::set_enabled(true);
+        let before = util_stats::snapshot().crash_place.ghost_release;
+        let mut state = State::<NoHashing>::new(&[(ROLE, 3)], 1);
+        assert_eq!(
+            (state.send_ledger[0].stranded_floor, state.send_ledger[0].stranded_end),
+            (0, 0),
+            "a node that never crashed has a range"
+        );
+        state.send_ledger[0].issued = 7;
+        state.send_ledger[0].floor = 5;
+        crash_node(&mut state, node(0));
+        let l = state.send_ledger[0];
+        assert_eq!((l.stranded_floor, l.stranded_end), (5, 7));
+        assert_eq!(l.floor, 7, "the crash did not move the floor past the capture");
+        state.crash_info.currently_crashed.remove(&node(0));
+        state.send_ledger[0].issued = 9;
+        state.send_ledger[0].floor = 9;
+        crash_node(&mut state, node(0));
+        let l = state.send_ledger[0];
+        assert_eq!((l.stranded_floor, l.stranded_end), (9, 9), "a silent segment is not empty");
+
+        let keyed = GhostReleaseBits {
+            stranded_key: true,
+            ..GhostReleaseBits::NONE
+        };
+        let armed = |cell: util_stats::GhostReleaseCell, floor: u32, end: u32| {
+            let mut state = release_state(3, &[1, 2], vec![0, 500, 500], cell, Some(20));
+            state.incarnations = vec![1, 0, 0];
+            state.send_ledger[0].stranded_floor = floor;
+            state.send_ledger[0].stranded_end = end;
+            arm_release_trigger(&mut state, 0, 100);
+            assert!(state.ghost_release.trigger.is_some());
+            state
+        };
+        let mut s = armed(util_stats::GhostReleaseCell::ReleaseAll(keyed), 5, 7);
+        let trigger = s.ghost_release.trigger;
+        // Records of earlier segments and of the range's end are skipped.
+        note_ghost_release_entry(&mut s, node(0), 0, node(2), 103, true, 4, 3);
+        note_ghost_release_entry(&mut s, node(0), 0, node(2), 104, true, 7, 3);
+        note_ghost_release_entry(&mut s, node(0), 0, node(1), 105, true, 2, 3);
+        assert_eq!(s.ghost_release.trigger, trigger, "a skipped entry disarmed the trigger");
+        assert_eq!(s.ghost_release.released_mask, 0);
+        assert_eq!(s.crash_hold_until, vec![0, 500, 500]);
+        assert_eq!(s.ghost_release.stranded_skipped_at, 0b110);
+        // An inert entry in the range neither fires nor counts as skipped.
+        note_ghost_release_entry(&mut s, node(0), 0, node(2), 106, false, 5, 3);
+        assert_eq!(s.ghost_release.trigger, trigger);
+        // The first record of the range fires as the other half does; at
+        // this peer an entry had been skipped, so it is a later entry.
+        note_ghost_release_entry(&mut s, node(0), 0, node(2), 107, true, 5, 3);
+        assert_eq!(s.ghost_release.trigger, None);
+        assert_eq!(s.ghost_release.released_mask, 0b110);
+        assert_eq!(s.crash_hold_until, vec![0, 108, 108]);
+        assert_eq!(s.ghost_release.ghost_node, Some(2));
+        // At a peer with no skipped entry the firing is a first entry.
+        let mut f = armed(util_stats::GhostReleaseCell::ReleaseAll(keyed), 5, 7);
+        note_ghost_release_entry(&mut f, node(0), 0, node(1), 103, true, 6, 3);
+        assert_eq!(f.ghost_release.trigger, None);
+        assert_eq!(f.crash_hold_until, vec![0, 104, 104]);
+        // An empty range fires on nothing; the bound expires the trigger
+        // and every hold stays; a new arming forgets the skips.
+        let mut e = armed(util_stats::GhostReleaseCell::ReleaseAll(keyed), 9, 9);
+        for ordinal in [8, 9, 10] {
+            note_ghost_release_entry(&mut e, node(0), 0, node(2), 103, true, ordinal, 3);
+        }
+        assert!(e.ghost_release.trigger.is_some(), "an empty range fired");
+        assert_eq!(e.ghost_release.stranded_skipped_at, 0b100);
+        e.crash_info.current_step = 120;
+        let mut rng = StdRng::seed_from_u64(1);
