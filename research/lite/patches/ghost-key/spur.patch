+    /// The defer coin is drawn for a released crash on both halves, at the
+    /// same stream positions, and only the exempt half ignores its
+    /// withhold; a crash no firing released is withheld on both, a victim
+    /// with exactly one send in flight draws no coin, and a zero bias draws
+    /// nothing. The reads and the overrides count under the cell.
+    #[test]
+    fn a_released_crash_is_exempt_from_the_defer_coin_only_on_the_exempt_half() {
+        let _serial = crate::simulator::config_override::exclusive_session();
+        util_stats::set_enabled(true);
+        let before = util_stats::snapshot().crash_place.ghost_release;
+        let exempt = GhostReleaseBits {
+            defer_exempt: true,
+            ..GhostReleaseBits::NONE
+        };
+        let holds = vec![0, 0, 0];
+        let mut treated = release_state(
+            3,
+            &[1, 2],
+            holds.clone(),
+            util_stats::GhostReleaseCell::ReleaseAll(exempt),
+            Some(20),
+        );
+        let mut control = release_state(
+            3,
+            &[1, 2],
+            holds,
+            util_stats::GhostReleaseCell::ReleaseAll(GhostReleaseBits::NONE),
+            Some(20),
+        );
+        // Node 1's crash was released by a firing, node 2's was not.
+        treated.ghost_release.released_mask = 0b010;
+        control.ghost_release.released_mask = 0b010;
+        let mut rng_t = StdRng::seed_from_u64(5);
+        let mut rng_c = StdRng::seed_from_u64(5);
+        let steps = 400u64;
+        let (mut withheld_1_c, mut withheld_2_t, mut withheld_2_c) = (0u64, 0u64, 0u64);
+        for _ in 0..steps {
+            let t = crash_defer_mask(&treated, 0.5, &mut rng_t);
+            let c = crash_defer_mask(&control, 0.5, &mut rng_c);
+            assert_eq!(t & 0b010, 0, "the exempt half withheld a released crash");
+            assert_eq!(t & 0b100, c & 0b100, "the halves differ on a crash no firing released");
+            assert_eq!(t & !0b110, 0);
+            withheld_1_c += (c & 0b010 != 0) as u64;
+            withheld_2_t += (t & 0b100 != 0) as u64;
+            withheld_2_c += (c & 0b100 != 0) as u64;
+        }
+        assert_eq!(rng_t.next_u64(), rng_c.next_u64(), "the streams diverged");
+        assert!(
+            withheld_1_c > steps / 3 && withheld_1_c < 2 * steps / 3,
+            "the control withheld the released crash {withheld_1_c} times of {steps}"
+        );
+        assert!(withheld_2_t > 0);
+        assert_eq!(withheld_2_t, withheld_2_c);
+        // A victim with exactly one send in flight draws no coin, and a
+        // zero bias draws nothing at all.
+        treated.send_ledger[1].in_flight = 1;
+        treated.send_ledger[2].in_flight = 1;
+        let mut rng_a = StdRng::seed_from_u64(8);
+        let mut rng_b = StdRng::seed_from_u64(8);
+        assert_eq!(crash_defer_mask(&treated, 0.5, &mut rng_a), 0);
+        assert_eq!(rng_a.next_u64(), rng_b.next_u64(), "a coin was drawn at one in flight");
+        treated.send_ledger[1].in_flight = 0;
+        assert_eq!(crash_defer_mask(&treated, 0.0, &mut rng_a), 0);
+        assert_eq!(rng_a.next_u64(), rng_b.next_u64(), "a coin was drawn at zero bias");
+        let after = util_stats::snapshot().crash_place.ghost_release;
+        let d = |f: fn(&util_stats::GhostReleaseCellStats) -> u64| {
+            (
+                f(&after.cells.defer_on) - f(&before.cells.defer_on),
+                f(&after.cells.defer_off) - f(&before.cells.defer_off),
+                f(&after.cells.defer1_early0_stranded0) - f(&before.cells.defer1_early0_stranded0),
+                f(&after.cells.defer0_early0_stranded0) - f(&before.cells.defer0_early0_stranded0),
+                f(&after.cells.treated) - f(&before.cells.treated),
+            )
+        };
+        assert_eq!(d(|c| c.defer_coin_examined), (steps, steps, steps, steps, 2 * steps));
+        assert_eq!(
+            d(|c| c.defer_coin_exempted),
+            (withheld_1_c, 0, withheld_1_c, 0, withheld_1_c)
+        );
+        assert_eq!(after.defer_coin.examined - before.defer_coin.examined, steps);
+        assert_eq!(after.defer_coin.exempted - before.defer_coin.exempted, withheld_1_c);
+        util_stats::set_enabled(false);
+    }
