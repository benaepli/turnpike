+/// The node a released crash's forced early wait is read on: the node
+/// whose entry fired the trigger while it is live, else the node
+/// `phase_read_node` names.
+fn ghost_read_node<H: HashPolicy>(state: &State<H>, n: usize, servers: usize) -> usize {
+    match state.ghost_release.ghost_node {
+        Some(g)
+            if g < state.send_ledger.len()
+                && !state.crash_info.currently_crashed.iter().any(|c| c.index == g) =>
+        {
+            g
+        }
+        _ => phase_read_node(state, n, servers),
+    }
+}
+
+/// Bitmask over the first 64 nodes of pending crashes the crash-timing bias
+/// withholds from this step: a pending crash for a node that is not in the
+/// middle of its own fan-out - it has no undelivered send of its own, or
+/// more than one - may be withheld, so the crash is more likely to be taken
+/// at a point where exactly one of the node's peers is still uninformed of
+/// its last action. Withholding is not cancelling: the crash stays queued
+/// and is offered again at the next step, which keeps the number of crashes
+/// a run takes the same and moves only when they land. Nodes past the width
+/// of the mask are never withheld. A crash a firing released draws its coin
+/// like any other, so the stream stays in step across the halves, but on
+/// the exempt half its withhold is not applied.
+fn crash_defer_mask<H: HashPolicy>(
+    state: &State<H>,
+    partial_fanout_crash_bias: f64,
+    rng: &mut impl StreamRng,
+) -> u64 {
+    if partial_fanout_crash_bias <= 0.0 {
+        return 0;
+    }
+    let mut mask = 0u64;
+    for (n, ledger) in state.send_ledger.iter().enumerate().take(u64::BITS as usize) {
+        if ledger.crash_pending == 0 || ledger.in_flight == 1 {
+            continue;
+        }
+        rng.use_stream(Stream::FaultPriority);
+        let withhold = rng.random::<f64>() < partial_fanout_crash_bias;
+        util_stats::record_crash_timing_bias(withhold);
+        let gr = &state.ghost_release;
+        if gr.released_mask & node_bit(n) != 0 {
+            let exempted = withhold && gr.defer_exempt();
+            util_stats::record_ghost_release_defer_coin(gr.cell, exempted);
+            if exempted {
+                continue;
+            }
+        }
+        if withhold {
+            mask |= 1u64 << n;
+        }
+    }
+    mask
+}
