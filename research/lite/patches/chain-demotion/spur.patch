+#[test]
+fn chain_histogram_integer_leaves_survive_render_delta_and_accumulation() {
+    fn mark(value: &mut Value, prefix: &str, expected: &mut BTreeMap<String, Value>, marks: &mut Marks) {
+        match value {
+            Value::Object(fields) => {
+                for (name, child) in fields { mark(child, &join(prefix, name), expected, marks); }
+            }
+            Value::Number(n) => {
+                let increment = marks.int();
+                *value = (n.as_u64().expect("chain counters are unsigned") + increment).into();
+                expected.insert(prefix.to_owned(), increment.into());
+            }
+            _ => panic!("chain counters must use object keys and integer leaves"),
+        }
+    }
+    let before = util_stats::snapshot_value();
+    let mut snapshot = util_stats::snapshot();
+    let mut expected = BTreeMap::new();
+    mark(&mut snapshot.replay_chain_pct, "", &mut expected, &mut Marks(0));
+    let parsed: Value = serde_json::from_str(&util_stats::render_snapshot(&snapshot).unwrap()).unwrap();
+    assert_eq!(parsed["replay_chain_pct"], snapshot.replay_chain_pct);
+    let mut acc = Value::Object(Map::new());
+    util_stats::add(&mut acc, &util_stats::delta(&before, &parsed));
+    let mut actual = BTreeMap::new();
+    leaves(&acc["replay_chain_pct"], "", &mut actual);
+    assert_eq!(actual, expected);
+    assert!(actual.contains_key("prefix.0.3.lengths_including_censored.32"));
+    assert!(actual.contains_key("plan_only.0.3.censored.32"));
+}
