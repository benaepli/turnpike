+        },
+        ChannelSend {
+            dest: NodeId,
+            channel: ChannelId,
+            message: Value<H>,
+            origin_node: NodeId,
+            pc: Vertex,
+            priority: f64,
+        },
+    }
+
+    fn check<H: HashPolicy>() {
+        let pairs = [
+            ("Record", std::mem::size_of::<UntaggedRecord<H>>(), std::mem::size_of::<Record<H>>()),
+            ("Runnable", std::mem::size_of::<UntaggedRunnable<H>>(), std::mem::size_of::<Runnable<H>>()),
+            ("QueuedMessage", std::mem::size_of::<UntaggedQueuedMessage<H>>(), std::mem::size_of::<QueuedMessage<H>>()),
+        ];
+        for (name, untagged, tagged) in pairs {
+            eprintln!("{} {name}: untagged={untagged} tagged={tagged}", std::any::type_name::<H>());
+            assert!(tagged <= untagged + 16, "{name} chain metadata exceeds the layout bound");
+        }
+    }
+
+    #[test]
+    fn chain_tags_fit_the_layout_bound() {
+        check::<NoHashing>();
+        check::<WithHashing>();
+    }
+}
