+                    .unwrap();
+                }
+                assert_eq!(format!("{:?}", qa.selected), format!("{:?}", qb.selected));
+                assert_eq!(ra.next_u64(), rb.next_u64());
+            }
+        }
+    }
+}
diff --git a/spur-core/src/simulator/replay_chain.rs b/spur-core/src/simulator/replay_chain.rs
new file mode 100644
index 0000000..2ef77cf
--- /dev/null
