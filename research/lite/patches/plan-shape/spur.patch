+            .map(|_| g.add_node(PlannedEvent { action: EventAction::ClientRequest(ClientOpSpec::Write(0, key.clone())) }))
+            .collect();
+        let rs: Vec<NodeIndex> = (0..reads)
+            .map(|_| g.add_node(PlannedEvent { action: EventAction::ClientRequest(ClientOpSpec::Read(0, key.clone())) }))
+            .collect();
+        let r1 = g.add_node(PlannedEvent { action: EventAction::RecoverNode(0) });
+        let r2 = g.add_node(PlannedEvent { action: EventAction::RecoverNode(1) });
+        (g, ws, rs, r1, r2)
+    }
