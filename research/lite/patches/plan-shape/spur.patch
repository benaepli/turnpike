+        assert!(matches!(prefer_write(&g, r1, &[r[0], r[1]]), WritePick::NoWriteAvailable));
+        g.add_edge(r1, w[2], ());
+        assert!(matches!(prefer_write(&g, r1, &[w[2], r[0]]), WritePick::NoWriteAvailable), "a write ordered after the recover is not a candidate");
+        assert!(matches!(prefer_write(&g, r2, &[w[0], w[1]]), WritePick::Write(x) if x == w[0]));
+        g.add_edge(r2, w[0], ());
