+
+enum WritePick {
+    Write(NodeIndex),
+    /// No write-like request is free of a path to or from the recover.
+    NoWriteAvailable,
+    /// Taking the write would leave the plan with no write-like request
+    /// that no recover reserves.
+    LastFreeWrite,
+}
