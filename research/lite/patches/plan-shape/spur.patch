+/// The per-run census of one plan-shape cell, summed over its runs.
+///
+/// A server has restarted when its incarnation is above zero; "two
+/// restarts" means at least two servers have. `post_restart_*_at_survivor`
+/// count client requests invoked at a target that has never restarted
+/// while two servers had, split by kind. `acked_writes_at_survivor_after_two_restarts`
+/// counts write responses whose replying server had never restarted while
+/// two servers had, whatever the invocation's target;
+/// `acked_writes_with_stranded_records` the subset answered while records
+/// from at least two distinct dead incarnations were still queued to that
+/// server, and `reads_invoked_after_such_ack` the reads invoked after one
+/// of those. `post_restart_writes_invoked` counts writes invoked while two
+/// servers had restarted, `post_restart_write_acks` their responses,
+/// `reads_invoked_after_post_restart_write_ack` the reads invoked after
+/// one of those responses, and
+/// `reads_outstanding_at_survivor_state_move_post_ack` the subset still
+/// unanswered when a never-restarted server that answered such a write
+/// took a state-changing delivery from a restarted peer's current
+/// incarnation.
+#[derive(Clone, Copy, Debug, Default, Serialize)]
+pub struct PlanShapeCensus {
+    pub runs: u64,
+    pub post_restart_invocations_at_survivor: u64,
+    pub post_restart_writes_at_survivor: u64,
+    pub post_restart_reads_at_survivor: u64,
+    pub acked_writes_at_survivor_after_two_restarts: u64,
+    pub acked_writes_with_stranded_records: u64,
+    pub reads_invoked_after_such_ack: u64,
+    pub post_restart_writes_invoked: u64,
+    pub post_restart_write_acks: u64,
+    pub reads_invoked_after_post_restart_write_ack: u64,
+    pub reads_outstanding_at_survivor_state_move_post_ack: u64,
+}
+
+impl PlanShapeCensus {
+    const fn new() -> Self {
+        Self {
+            runs: 0,
+            post_restart_invocations_at_survivor: 0,
+            post_restart_writes_at_survivor: 0,
+            post_restart_reads_at_survivor: 0,
+            acked_writes_at_survivor_after_two_restarts: 0,
+            acked_writes_with_stranded_records: 0,
+            reads_invoked_after_such_ack: 0,
+            post_restart_writes_invoked: 0,
+            post_restart_write_acks: 0,
+            reads_invoked_after_post_restart_write_ack: 0,
+            reads_outstanding_at_survivor_state_move_post_ack: 0,
+        }
+    }
+
+    fn add(&mut self, o: &Self) {
+        self.runs += o.runs;
+        self.post_restart_invocations_at_survivor += o.post_restart_invocations_at_survivor;
+        self.post_restart_writes_at_survivor += o.post_restart_writes_at_survivor;
+        self.post_restart_reads_at_survivor += o.post_restart_reads_at_survivor;
+        self.acked_writes_at_survivor_after_two_restarts +=
+            o.acked_writes_at_survivor_after_two_restarts;
+        self.acked_writes_with_stranded_records += o.acked_writes_with_stranded_records;
+        self.reads_invoked_after_such_ack += o.reads_invoked_after_such_ack;
+        self.post_restart_writes_invoked += o.post_restart_writes_invoked;
+        self.post_restart_write_acks += o.post_restart_write_acks;
+        self.reads_invoked_after_post_restart_write_ack +=
+            o.reads_invoked_after_post_restart_write_ack;
+        self.reads_outstanding_at_survivor_state_move_post_ack +=
+            o.reads_outstanding_at_survivor_state_move_post_ack;
+    }
+}
