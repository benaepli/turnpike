+    PS_PAIRS_ADDED.fetch_add(p.pairs_added, Ordering::Relaxed);
+    PS_NO_WRITE_AVAILABLE.fetch_add(p.no_write_available, Ordering::Relaxed);
+    PS_LAST_FREE_WRITE.fetch_add(p.last_free_write, Ordering::Relaxed);
