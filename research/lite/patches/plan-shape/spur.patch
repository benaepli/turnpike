+        let (g, w, r, r1, _) = hand_graph(1, 2);
+        assert!(matches!(prefer_write(&g, r1, &[r[0], w[0], r[1]]), WritePick::LastFreeWrite));
+        let (g, _, r, r1, _) = hand_graph(0, 2);
