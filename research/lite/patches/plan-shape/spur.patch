+/// The seed a run's plan is generated from in these sessions.
+fn workload_seed(run_id: i64) -> u64 {
+    0x_C0FF_EE00 ^ run_id as u64
+}
+
+/// Whether the run's plan makes every client request ready at step 0 or at
+/// a restart: the post-fault shape cells that order a read behind a
+/// reserved write's response can make a request ready inside the hold's
+/// expiry of the step budget, which the invariants here do not describe.
+fn requests_ready_at_a_restart(run_id: i64) -> bool {
+    run_variant::plan_cell_bits(workload_seed(run_id)) & run_variant::POST_FAULT_WRITE_THEN_READ == 0
+}
+
 fn placed_ids(treated: bool, n: usize) -> Vec<i64> {
     let ids: Vec<i64> = (0..1_000_000i64)
         .filter(|&id| {
             client_anchor::is_treated(id) == treated
                 && fault_timing::is_placed(id)
+                && requests_ready_at_a_restart(id)
         })
         .take(n)
         .collect();
