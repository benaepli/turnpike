+
+impl PlanShapeStats {
+    fn read() -> Self {
+        let cells = PLAN_SHAPE_CELLS
+            .lock()
+            .map(|c| *c)
+            .unwrap_or_else(|p| *p.into_inner());
+        let at = |s: SurvivorTarget, w: PostFaultShape| cells[plan_shape_cell_index(s, w)];
+        let sum = |a: PlanShapeCensus, b: PlanShapeCensus| {
+            let mut out = a;
+            out.add(&b);
+            out
+        };
+        let stock_stock = at(SurvivorTarget::Stock, PostFaultShape::Stock);
+        let survivor_only = at(SurvivorTarget::Survivor, PostFaultShape::Stock);
+        let write_only = at(SurvivorTarget::Stock, PostFaultShape::WriteThenRead);
+        let both = at(SurvivorTarget::Survivor, PostFaultShape::WriteThenRead);
+        Self {
+            survivor: PlanShapeSurvivorStats {
+                reserved_seen: PS_RESERVED_SEEN.load(Ordering::Relaxed),
+                reserved_retargeted: PS_RESERVED_RETARGETED.load(Ordering::Relaxed),
+                plans_without_survivor: PS_PLANS_WITHOUT_SURVIVOR.load(Ordering::Relaxed),
+                cell: PlanShapeSurvivorCells {
+                    stock: sum(stock_stock, write_only),
+                    survivor: sum(survivor_only, both),
+                },
+            },
+            write_read: PlanShapeWriteReadStats {
+                pairs_added: PS_PAIRS_ADDED.load(Ordering::Relaxed),
+                write_fallbacks: PlanShapeWriteFallbacks {
+                    no_write_available: PS_NO_WRITE_AVAILABLE.load(Ordering::Relaxed),
+                    last_free_write: PS_LAST_FREE_WRITE.load(Ordering::Relaxed),
+                },
+                read_unavailable: PS_READ_UNAVAILABLE.load(Ordering::Relaxed),
+                cell: PlanShapeWriteReadCells {
+                    stock: sum(stock_stock, survivor_only),
+                    write_then_read: sum(write_only, both),
+                },
+            },
+            crossed: PlanShapeCrossedCells {
+                stock: stock_stock,
+                survivor_only,
+                write_then_read_only: write_only,
+                both,
+            },
+        }
+    }
+}
