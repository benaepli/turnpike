+/// One run's plan-shape census and the operations it is following.
+#[derive(Debug, Default)]
+struct PlanShapeRun {
+    census: PlanShapeCensus,
+    /// Writes invoked while at least two servers had restarted, until
+    /// their response arrives.
+    post_restart_writes: HashSet<i32>,
+    /// Servers, as a bit set over their indices, that answered a
+    /// post-restart write while they had never restarted.
+    acking_servers: u64,
+    /// A post-restart write has been answered.
+    post_restart_ack_seen: bool,
+    /// A write was answered at a never-restarted server after two restarts
+    /// with records from two dead incarnations still queued to it.
+    stranded_ack_seen: bool,
+    /// Reads invoked after a post-restart write's ack that are still
+    /// unanswered: the acking servers as of the read's invocation, and
+    /// whether the read was already counted as outstanding at a state
+    /// move of one of them.
+    reads_after_ack: HashMap<i32, (u64, bool)>,
+}
+
+/// A planned client request was handed to a client node.
+pub fn record_plan_shape_invocation(inv: &PlanShapeInvocation) {
+    if !enabled() {
+        return;
+    }
+    PLAN_SHAPE_CENSUS.with(|c| {
+        let mut c = c.borrow_mut();
+        if inv.two_servers_restarted && inv.target_never_restarted {
+            c.census.post_restart_invocations_at_survivor += 1;
+            if inv.write_like {
+                c.census.post_restart_writes_at_survivor += 1;
+            } else {
+                c.census.post_restart_reads_at_survivor += 1;
+            }
+        }
+        if inv.write_like {
+            if inv.two_servers_restarted {
+                c.census.post_restart_writes_invoked += 1;
+                c.post_restart_writes.insert(inv.op_id);
+            }
+        } else {
+            if c.stranded_ack_seen {
+                c.census.reads_invoked_after_such_ack += 1;
+            }
+            if c.post_restart_ack_seen {
+                c.census.reads_invoked_after_post_restart_write_ack += 1;
+                let acking = c.acking_servers;
+                c.reads_after_ack.insert(inv.op_id, (acking, false));
+            }
+        }
+    });
+}
+
+/// A client operation's response was recorded.
+pub fn record_plan_shape_response(resp: &PlanShapeResponse) {
+    if !enabled() {
+        return;
+    }
+    PLAN_SHAPE_CENSUS.with(|c| {
+        let mut c = c.borrow_mut();
+        if !resp.write_like {
+            c.reads_after_ack.remove(&resp.op_id);
+            return;
+        }
+        let responder_never_restarted = resp.responder.is_some_and(|(_, inc)| inc == 0);
+        if resp.two_servers_restarted && responder_never_restarted {
+            c.census.acked_writes_at_survivor_after_two_restarts += 1;
+            if resp.stranded_dead_incarnations >= 2 {
+                c.census.acked_writes_with_stranded_records += 1;
+                c.stranded_ack_seen = true;
+            }
+        }
+        if c.post_restart_writes.remove(&resp.op_id) {
+            c.census.post_restart_write_acks += 1;
+            c.post_restart_ack_seen = true;
+            if let Some((server, 0)) = resp.responder
+                && server < u64::BITS as usize
+            {
+                c.acking_servers |= 1 << server;
+            }
+        }
+    });
+}
+
+/// `server`, which has never restarted, took a delivery from a restarted
+/// peer's current incarnation that changed its state. Counts the reads
+/// invoked after `server` answered a post-restart write and still
+/// unanswered now, each once.
+pub fn record_plan_shape_state_move(server: usize) {
+    if !enabled() {
+        return;
+    }
+    if server >= u64::BITS as usize {
+        return;
+    }
+    let bit = 1u64 << server;
+    PLAN_SHAPE_CENSUS.with(|c| {
+        let mut c = c.borrow_mut();
+        let mut newly = 0u64;
+        for (acking, counted) in c.reads_after_ack.values_mut() {
+            if *acking & bit != 0 && !*counted {
+                *counted = true;
+                newly += 1;
+            }
+        }
+        c.census.reads_outstanding_at_survivor_state_move_post_ack += newly;
+    });
+}
+
+fn fold_plan_shape_run() {
+    let Some((survivor, shape)) = PLAN_SHAPE_RUN.with(|r| r.take()) else {
+        return;
+    };
+    let census = PLAN_SHAPE_CENSUS.with(|c| std::mem::take(&mut *c.borrow_mut()).census);
+    if let Ok(mut cells) = PLAN_SHAPE_CELLS.lock() {
+        let cell = &mut cells[plan_shape_cell_index(survivor, shape)];
+        cell.add(&census);
+        cell.runs += 1;
+    }
+}
