+    /// The operation is a write or a read-modify-write.
+    pub write_like: bool,
+    /// The server whose reply the client last took before responding,
+    /// with that server's incarnation when it replied.
+    pub responder: Option<(usize, u32)>,
+    /// At least two servers have restarted.
