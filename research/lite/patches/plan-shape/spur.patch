+        return rewrite;
+    }
+    for idx in reserved {
+        let EventAction::ClientRequest(spec) = &graph[idx].action else {
+            continue;
+        };
+        let target = match spec {
+            ClientOpSpec::Write(t, _) | ClientOpSpec::Read(t, _) | ClientOpSpec::Rmw(t, _) => *t,
+        };
+        if !crashing.contains(&target) {
+            continue;
+        }
+        let survivor = survivors[rng.random_range(0..survivors.len())];
+        let readdressed = match spec {
+            ClientOpSpec::Write(_, key) => ClientOpSpec::Write(survivor, key.clone()),
+            ClientOpSpec::Read(_, key) => ClientOpSpec::Read(survivor, key.clone()),
+            ClientOpSpec::Rmw(_, key) => ClientOpSpec::Rmw(survivor, key.clone()),
+        };
+        graph[idx].action = EventAction::ClientRequest(readdressed);
+        rewrite.reserved_retargeted += 1;
+    }
+    rewrite
