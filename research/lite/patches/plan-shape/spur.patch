+fn is_write_like(graph: &ExecutionPlan, idx: NodeIndex) -> bool {
+    matches!(
+        graph[idx].action,
+        EventAction::ClientRequest(ClientOpSpec::Write(..))
+            | EventAction::ClientRequest(ClientOpSpec::Rmw(..))
+    )
+}
+
+fn is_read(graph: &ExecutionPlan, idx: NodeIndex) -> bool {
+    matches!(graph[idx].action, EventAction::ClientRequest(ClientOpSpec::Read(..)))
+}
+
+/// Whether some recover has a mandatory edge to `idx`, which is what the
+/// post-fault pass leaves on the requests it reserves.
+fn reserved_by_a_recover(graph: &ExecutionPlan, idx: NodeIndex) -> bool {
+    graph
+        .neighbors_directed(idx, Direction::Incoming)
+        .any(|p| matches!(graph[p].action, EventAction::RecoverNode(_)))
+}
+
+/// Whether some write-like request has an edge to `idx`, which a read
+/// pulled behind a reserved write carries.
+fn pulled_behind_a_write(graph: &ExecutionPlan, idx: NodeIndex) -> bool {
+    graph
+        .neighbors_directed(idx, Direction::Incoming)
+        .any(|p| is_write_like(graph, p))
+}
+
+fn path_connected(graph: &ExecutionPlan, a: NodeIndex, b: NodeIndex) -> bool {
+    has_path_connecting(graph, a, b, None) || has_path_connecting(graph, b, a, None)
