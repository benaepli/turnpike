+/// The write the write-then-read cell reserves behind `recover`: the first
+/// write-like request in `candidates`, the stock shuffled list, that is
+/// not path-connected with the recover. Held back when it is the last
+/// write-like request outside the post-fault reservations.
+fn prefer_write(graph: &ExecutionPlan, recover: NodeIndex, candidates: &[NodeIndex]) -> WritePick {
+    let Some(write) = candidates
+        .iter()
+        .copied()
+        .find(|&c| is_write_like(graph, c) && !path_connected(graph, recover, c))
+    else {
+        return WritePick::NoWriteAvailable;
+    };
+    let free_after = graph
+        .node_indices()
+        .filter(|&i| i != write && is_write_like(graph, i) && !reserved_by_a_recover(graph, i))
+        .count();
+    if free_after == 0 {
+        WritePick::LastFreeWrite
+    } else {
+        WritePick::Write(write)
+    }
+}
