+        state.reward_mass = 10.0;
+        state.alpha[3] = 3.0;
+        state.beta[3] = 90.0;
+        state.alpha[4] = 9.0;
+        state.beta[4] = 80.0;
+        let pair = &mut state.pairs[PAIR_INDEX[0][3]];
+        *pair = PairEvidence {
+            success: 20.0,
+            failure: 3.0,
+            observations: 23,
+            positives: 20,
+        };
+        assert_eq!(state.conditional_posterior(0, 3), state.posterior(3));
+        let (weights, warmed, supported) = state.conditional_weights(0, 1);
+        assert_eq!(weights, state.marginal_weights(1));
+        assert_eq!(warmed, 0);
+        assert!(!supported);
+        let mut marginal_rng = SmallRng::seed_from_u64(91);
+        let mut conditional_rng = marginal_rng.clone();
+        for _ in 0..100 {
+            assert_eq!(
+                state.sample_axis_leading(1, &mut marginal_rng),
+                CellLearner::pick(1, &weights, &mut conditional_rng)
+            );
+        }
+        state.pairs[PAIR_INDEX[0][3]].observations = 24;
+        let mu = state.mean(3);
+        assert_eq!(
+            state.conditional_posterior(0, 3),
+            (24.0 * mu + 20.0, 24.0 * (1.0 - mu) + 3.0)
+        );
+        state.reward_mass = 50.0;
+        let current_mu = state.mean(3);
+        assert_ne!(current_mu, mu);
+        assert_eq!(
+            state.conditional_posterior(0, 3).0,
+            24.0 * current_mu + 20.0
+        );
+        assert_eq!(state.conditional_weights(0, 1).1, 1);
+        assert_eq!(state.conditional_posterior(0, 4), state.posterior(4));
+    }
