+        let p5 = CellLearner::normalize(state.marginal_weights(2))[0];
+        let conditional5 = CellLearner::normalize(state.conditional_weights(3, 2).0)[0];
+        let conditional3 = CellLearner::normalize(state.conditional_weights(5, 1).0)[0];
+        let residual5 = (24.0 * state.mean(5) + 90.0) / 124.0 - state.mean(5);
+        let residual3 = (24.0 * state.mean(3) + 90.0) / 124.0 - state.mean(3);
+        assert!((scores[1] - p3 * (conditional5 - p5) * residual5).abs() < 1e-12);
+        assert!((scores[2] - p5 * (conditional3 - p3) * residual3).abs() < 1e-12);
+        assert!(scores[1] > 0.0 && scores[2] > 0.0);
+        for a in [0, 3, 4] {
+            assert_eq!(scores[a], 0.0);
+        }
+        state.pairs[PAIR_INDEX[4][5]].success = 23.0;
+        state.pairs[PAIR_INDEX[4][5]].failure = 0.0;
+        assert_eq!(state.interaction_scores(), scores);
+    }
