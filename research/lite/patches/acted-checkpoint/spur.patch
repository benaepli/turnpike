+#[cfg(test)]
+mod checkpoint_tests {
+    use super::*;
+    use crate::simulator::feedback::NoFeedback;
+    use crate::simulator::hash_utils::NoHashing;
+    use std::collections::HashSet;
+
+    const SPEC: &str = r#"
+role Node {
+    async fn Write(key: string, uid: int): int { return uid; }
+    async fn Read(key: string): int { return 0; }
+}
+ClientInterface {
+    async fn Write(dest: Node, key: string, uid: int): int {
+        return <-dest->Write(key, uid);
+    }
+    async fn Read(dest: Node, key: string): int { return <-dest->Read(key); }
+}
+"#;
+
+    type TestPath = PathState<NoHashing, NoFeedback>;
+
+    fn fixture() -> (Program, TestPath, ExecutionPlan) {
+        let program = crate::compiler::compile(SPEC, "checkpoint.spur")
+            .into_program()
+            .unwrap();
+        let role = |name| {
+            program
+                .roles
+                .iter()
+                .find(|(_, n)| n.as_str() == name)
+                .unwrap()
+                .0
+        };
+        let path = TestPath::new(
+            &[(role("Node"), 2)],
+            program.max_node_slots as usize,
+            role("ClientInterface"),
+        );
+        let mut plan = ExecutionPlan::new();
+        for i in 0..8 {
+            plan.add_node(PlannedEvent {
+                action: EventAction::ClientRequest(ClientOpSpec::Write(i % 2, "key".into())),
+            });
+        }
+        (program, path, plan)
+    }
+
+    fn config<'a>(
+        terms: &'a ResolvedTerms,
+        purgatory: &'a PurgatoryConfig,
+        within: &'a WithinQueueSelector,
+    ) -> ExecConfig<'a> {
+        ExecConfig {
+            topology: TopologyInfo {
+                topology: Topology::Full,
+                num_servers: 2,
+            },
+            policy: &SchedulePolicy::Fixed,
+            strict_timers: false,
+            within_queue: within,
+            terms,
+            purgatory_config: purgatory,
+            partial_fanout_crash_bias: 0.0,
+        }
+    }
+
+    fn run_id(probe: bool) -> i64 {
+        (0..1000)
+            .find(|&id| run_cap::is_probe(id) == probe
+                && (probe || timer_context::run_mode(id) != timer_context::RunMode::Probe))
+            .unwrap()
+    }
+
+    #[test]
+    fn checkpoint_keeps_pending_calls_and_reproduces_the_complete_continuation() {
+        let _session = crate::simulator::config_override::exclusive_session();
+        run_cap::reset();
+        let (program, mut parent, plan) = fixture();
+        parent.state.overtaken_ghost_acted = true;
+        let terms = ResolvedTerms::default();
+        let purgatory = PurgatoryConfig::default();
+        let within = WithinQueueSelector::default();
+        let config = config(&terms, &purgatory, &within);
+        let arms = ArmSet {
+            pair_order: true,
+            fresh_first: true,
+            ..ArmSet::default()
+        };
+        let mut locals = exec_start(
+            &mut parent,
+            &program,
+            plan,
+            300,
+            run_id(false),
+            &QueuePolicyConfig::Preemptive {
+                p_timer: 0.0,
+                preempt_interval: 3,
+            },
+            &arms,
+        )
+        .unwrap();
+        let global = GlobalState::<NoFeedback>::new();
+        let mut rng = StreamSet::new(1123, true);
+        let mut checkpoint = None;
+        let parent_outcome = exec_resume(
+            &mut parent,
+            &mut locals,
+            &program,
+            run_id(false),
+            &config,
+            &global,
+            &(),
+            Some(&mut checkpoint),
+            &mut rng,
+        )
+        .unwrap();
+        let checkpoint = checkpoint.expect("acted prefix with pending work is captured");
+        assert_eq!(checkpoint.locals.steps(), 1);
+        assert_eq!(checkpoint.path_state.state.crash_info.current_step, 0);
+        assert_eq!(checkpoint.locals.arms(), arms);
+        assert_eq!(checkpoint.locals.in_progress.len(), 8);
+        assert_eq!(checkpoint.path_state.history.len(), 8);
+        assert_eq!(checkpoint.locals.suffix_message_count(), 0);
+        assert!(
+            checkpoint
+                .path_state
+                .history
+                .iter()
+                .all(|op| matches!(op.kind, OpKind::Invocation) && op.step == 0)
+        );
+        let mut child = checkpoint.path_state.clone();
+        let mut child_locals = checkpoint.locals.clone();
+        let mut exact_rng = checkpoint.streams.as_ref().unwrap().clone();
+        let child_outcome = exec_resume(
+            &mut child,
+            &mut child_locals,
+            &program,
+            500,
+            &config,
+            &global,
+            &(),
+            None,
+            &mut exact_rng,
+        )
+        .unwrap();
+        assert_eq!(parent_outcome, child_outcome);
+        assert_eq!(
+            format!("{:?}", parent.history),
+            format!("{:?}", child.history)
+        );
