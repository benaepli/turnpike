+/// Resume a complete execution state with a fresh scheduling stream.
+pub fn run_checkpoint_simulation<F: Feedback>(
+    program: &Program,
+    writer: &Arc<dyn HistoryWriter>,
+    global_state: &GlobalState<F>,
+    run_id: i64,
+    fork: &ForkPoint<crate::simulator::hash_utils::NoHashing, F>,
+    config: &SingleRunConfig,
+    weights: &CoverageConfig,
+    workload_seed: u64,
+    schedule_seed: u64,
+    attribution: &RunAttribution,
+) -> Result<RunResult, Box<dyn Error>> {
+    let started = std::time::Instant::now();
+    let snapshot = &fork.snapshot;
+    let clone_started = std::time::Instant::now();
+    let mut path_state = fork.path_state.clone();
+    let mut locals = fork.locals.clone();
+    let clone_wall = clone_started.elapsed();
+    util_stats::record_checkpoint_clone(clone_wall);
+    locals.reset_suffix();
+    let arms = locals.arms();
+    let mut streams = StreamSet::new(schedule_seed, config.rng_stream_isolation);
+    let mut tape = LiveRng::new_tape(None);
+    let mut rec = RecRng::<LiveRng> { tape: &mut tape, inner: &mut streams };
+    let exec_config = ExecConfig {
+        topology: TopologyInfo { topology: Topology::Full, num_servers: config.num_servers },
+        policy: &config.schedule_policy,
+        strict_timers: false,
+        within_queue: &config.within_queue_selector,
+        terms: &config.steer_terms,
+        purgatory_config: &config.purgatory,
+        partial_fanout_crash_bias: config.partial_fanout_crash_bias,
+    };
+    let outcome = exec_resume(
+        &mut path_state, &mut locals, program, run_id, &exec_config,
+        global_state, snapshot, None, &mut rec,
+    )?;
+    let score = F::plan_score(&path_state.feedback, snapshot, weights);
+    let tuples = F::timeline_tuples(&path_state.feedback).cloned().unwrap_or_default();
+    F::merge_since(&global_state.feedback, &path_state.feedback, &fork.path_state.feedback);
+    writer.write(
+        run_id,
+        serialize_history(&path_state.history),
+        serialize_logs(std::mem::take(&mut path_state.logs.entries)),
+        serialize_traces(std::mem::take(&mut path_state.logs.traces)),
+    );
+    writer.write_run(run_row(
+        run_id, attribution, workload_seed, schedule_seed, &outcome,
+        config.max_iterations, started.elapsed(), path_state.state.timer_stats,
+        &arms, None, path_state.state.crash_hold_drawn,
+    ));
+    util_stats::record_checkpoint_diagnostic(util_stats::CheckpointDiagnostic {
+        run_id,
+        parent_run_id: fork.parent_run_id,
+        checkpoint_step: fork.locals.steps(),
+        effective_cap: locals.effective_cap(),
+        actual_arm_set: arms.directions(),
+        prefix: true,
+        suffix_message_count: locals.suffix_message_count(),
+        suffix_digest: format!("{:016x}", locals.suffix_digest()),
+        clone_worker_ns: clone_wall.as_nanos().min(u64::MAX as u128) as u64,
+    });
+    util_stats::record_checkpoint_worker(started.elapsed());
+    Ok(RunResult { score, recording: None, tuples, outcome,
+        cut: path_state.state.replay_cut, checkpoint: None, arms })
+}
