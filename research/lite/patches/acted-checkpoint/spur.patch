+    }
+
+    pub fn arms(&self) -> ArmSet {
+        self.arms
+    }
+
+    pub fn reset_suffix(&mut self) {
+        self.suffix_tracking = true;
+        self.suffix_message_count = 0;
+        self.suffix_digest = 0xcbf29ce484222325;
+    }
+
+    pub fn suffix_message_count(&self) -> u64 {
+        self.suffix_message_count
+    }
+
+    pub fn suffix_digest(&self) -> u64 {
+        self.suffix_digest
+    }
+
+    fn record_message_entry(&mut self, entry: Vertex, origin: NodeId, dest: NodeId, incarnation: u32) {
+        if !self.suffix_tracking {
+            return;
+        }
+        if self.suffix_message_count < 32 {
+            for word in [
+                entry as u64,
+                origin.role.0 as u64,
+                origin.index as u64,
+                dest.role.0 as u64,
+                dest.index as u64,
+                u64::from(incarnation),
+            ] {
+                for byte in word.to_le_bytes() {
+                    self.suffix_digest ^= u64::from(byte);
+                    self.suffix_digest = self.suffix_digest.wrapping_mul(0x100000001b3);
+                }
+            }
+        }
+        self.suffix_message_count += 1;
+    }
+}
