+/// Build the bookkeeping of a plan execution and set the run's mechanism
+/// flags on the state. The run has taken no step yet.
+#[allow(clippy::too_many_arguments)]
+fn exec_start<H: HashPolicy, F: Feedback>(
+    path_state: &mut PathState<H, F>,
+    program: &Program,
+    plan: ExecutionPlan,
+    max_iterations: i32,
+    run_id: i64,
+    queue_policy: &QueuePolicyConfig,
+    arms: &ArmSet,
+) -> Result<ExecLocals, RuntimeError> {
+    path_state.state.retarget.enabled = arms.retarget;
+    path_state.state.fresh_first.enabled = arms.fresh_first;
+    path_state.state.pair_order.enabled = arms.pair_order;
+    path_state.state.client_anchor.arm = arms.request;
+    let anchored = path_state.state.client_anchor.holds();
+    path_state.state.pair_order.census =
+        util_stats::enabled() && pair_order_split::is_census_run(run_id);
+    let backup = max_iterations;
+    let is_probe = run_cap::is_probe(run_id);
+    let effective_cap = if is_probe {
+        backup
+    } else {
+        run_cap::effective_cap(backup)
+    };
+
+    // Collect all deliver events from the plan DAG before PlanEngine::new
+    // consumes it.
+    let all_delivers: HashMap<NodeIndex, DeliverSpec> = plan
+        .node_indices()
+        .filter_map(|idx| match &plan[idx].action {
+            EventAction::Deliver(spec) => Some((idx, spec.clone())),
+            _ => None,
+        })
+        .collect();
+
+    let server_role = program
+        .roles
+        .iter()
+        .find(|(_, name)| name == "Node")
+        .map(|(id, _)| *id)
+        .ok_or_else(|| RuntimeError::RoleNotFound("Node".to_string()))?;
+
+    Ok(ExecLocals {
+        arms: *arms,
+        suffix_tracking: false,
+        suffix_message_count: 0,
+        suffix_digest: 0xcbf29ce484222325,
+        anchored,
+        held: HoldQueue::default(),
+        last_window_step: None,
+        backup,
+        is_probe,
+        effective_cap,
+        timer_ctx_mode: timer_context::run_mode(run_id),
+        selector: queue_policy.to_selector(),
+        op_id_counter: 0,
+        in_progress: HashMap::new(),
+        pending_crash: HashMap::new(),
+        pending_recover: HashMap::new(),
+        victim_remap: HashMap::new(),
+        pending_allow_timer: HashMap::new(),
+        pending_partition: None,
+        pending_heal: None,
+        all_delivers,
+        ready_delivers: BTreeSet::new(),
+        completed_delivers: HashSet::new(),
+        engine: PlanEngine::new(plan),
+        crashed_nodes: HashSet::new(),
+        recovered_nodes: HashSet::new(),
+        census: StepCensus::default(),
+        no_progress_count: 0,
+        server_role,
+        step: 0,
+    })
+}
