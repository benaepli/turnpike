+        path.state.overtaken_ghost_acted = true;
+        let mut checkpoint = None;
+        let parent_outcome = exec_plan(
+            &mut path, program.clone(), plan, 300, config.topology.clone(), &global,
+            &(), run_id(false), config.policy, false, &QueuePolicyConfig::default(),
+            &within, &terms, &purgatory, 0.0, &ArmSet::default(), Some(2),
