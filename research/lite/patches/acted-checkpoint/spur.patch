+    }
+    let index = RP_CHECKPOINT_DIAGNOSTICS_ROWS.fetch_add(1, Ordering::Relaxed);
+    if index >= CHECKPOINT_DIAGNOSTIC_LIMIT {
+        RP_CHECKPOINT_DIAGNOSTICS_DROPPED.fetch_add(1, Ordering::Relaxed);
+        return;
+    }
+    let mut lock = CHECKPOINT_DIAGNOSTICS.lock().unwrap_or_else(|p| p.into_inner());
+    let result = lock.as_mut().map(|writer| {
