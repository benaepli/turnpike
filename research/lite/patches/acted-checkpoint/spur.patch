+/// A child owns a clone of the complete prefix and resumes at the next step.
+pub struct ForkPoint<H: HashPolicy, F: Feedback> {
+    pub path_state: PathState<H, F>,
+    pub locals: ExecLocals,
+    pub snapshot: F::Snapshot,
+    /// The parent's generators at the fork, when its source exposes them; a
+    /// child drawing from a copy of these walks in the parent's steps.
+    pub streams: Option<StreamSet>,
+    /// The id of the run that took the fork point.
+    pub parent_run_id: i64,
+}
+
+impl<H: HashPolicy, F: Feedback> ForkPoint<H, F> {
+    fn take(
+        path_state: &PathState<H, F>,
+        locals: &ExecLocals,
+        snapshot: &F::Snapshot,
+        streams: Option<StreamSet>,
+        parent_run_id: i64,
+    ) -> Self {
+        let path_state = path_state.clone();
+        let mut locals = locals.clone();
+        locals.reset_suffix();
+        Self {
+            path_state,
+            locals,
+            snapshot: snapshot.clone(),
+            streams,
+            parent_run_id,
+        }
+    }
+}
