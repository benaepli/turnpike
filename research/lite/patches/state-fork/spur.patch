+/// Continue a run from a fork point under the child's id. `streams` are
+/// the generators the child draws from; `schedule_seed` is recorded on the
+/// row as the seed they came from. The child's history is the parent's
+/// prefix followed by the continuation, written whole under `run_id`; its
+/// row carries the steps of both and the wall of the continuation alone.
+#[allow(clippy::too_many_arguments)]
+pub fn run_continuation<F: Feedback>(
+    program: &Program,
+    writer: &Arc<dyn HistoryWriter>,
+    global_state: &GlobalState<F>,
+    run_id: i64,
+    fork: &ForkPoint<crate::simulator::hash_utils::NoHashing, F>,
+    config: &SingleRunConfig,
+    weights: &CoverageConfig,
+    workload_seed: u64,
+    schedule_seed: u64,
+    mut streams: StreamSet,
+    attribution: &RunAttribution,
+) -> Result<RunResult, Box<dyn Error>> {
+    let started = std::time::Instant::now();
+    let snapshot = F::snapshot(&global_state.feedback);
+    let mut path_state = fork.path_state.clone();
+    let mut locals = fork.locals.clone();
+    let prefix_steps = locals.steps();
+    let mut tape = LiveRng::new_tape(None);
+    let mut rec = RecRng::<LiveRng> {
+        tape: &mut tape,
+        inner: &mut streams,
+    };
+    let exec_config = ExecConfig {
+        max_iterations: config.max_iterations,
+        topology: TopologyInfo {
+            topology: Topology::Full,
+            num_servers: config.num_servers,
+        },
+        policy: &config.schedule_policy,
+        strict_timers: false,
+        within_queue: &config.within_queue_selector,
+        terms: &config.steer_terms,
+        purgatory_config: &config.purgatory,
+        partial_fanout_crash_bias: config.partial_fanout_crash_bias,
+    };
+    let outcome = exec_resume::<crate::simulator::hash_utils::NoHashing, F>(
+        &mut path_state,
+        &mut locals,
+        program,
+        run_id,
+        &exec_config,
+        global_state,
+        &snapshot,
+        None,
+        &mut rec,
+    )?;
+
+    if let RunOutcome::Deadlock { step, pending_ops } = &outcome {
+        warn!(
+            "Run {} deadlocked at step {} ({} pending ops)",
+            run_id, step, pending_ops
+        );
+    }
+
+    let plan_score = F::plan_score(&path_state.feedback, &snapshot, weights);
+    let tuples = F::timeline_tuples(&path_state.feedback)
+        .cloned()
+        .unwrap_or_default();
+    F::merge_since(
+        &global_state.feedback,
+        &path_state.feedback,
+        &fork.path_state.feedback,
+    );
+
+    let serialized = serialize_history(&path_state.history);
+    let serialized_logs = serialize_logs(std::mem::take(&mut path_state.logs.entries));
+    let serialized_traces = serialize_traces(std::mem::take(&mut path_state.logs.traces));
+    writer.write(run_id, serialized, serialized_logs, serialized_traces);
+    let row = run_row(
+        run_id,
+        attribution,
+        workload_seed,
+        schedule_seed,
+        &outcome,
+        config.max_iterations,
+        started.elapsed(),
+        path_state.state.timer_stats,
+        continuation_variant_bits(fork.parent_run_id)
+            | if path_state.state.crash_hold_drawn {
+                crate::simulator::run_variant::CRASH_HOLD_DRAWN
+            } else {
+                0
+            }
+            | attribution.variant_bits,
+    );
+    let total_steps = row.steps_used.max(prefix_steps);
+    util_stats::record_state_fork_child(
+        prefix_steps.max(0) as u64,
+        (total_steps - prefix_steps).max(0) as u64,
+    );
+    writer.write_run(row);
+
+    Ok(RunResult {
+        score: plan_score,
+        recording: None,
+        tuples,
+        outcome,
+        cut: path_state.state.replay_cut,
+        fork: None,
     })
 }
 
