+    /// the transitions that earned it are not known individually.
+    pub fn since(&self, base: &LocalCoverage) -> LocalCoverage {
+        let mut out = LocalCoverage::new();
+        for (edge, count) in &self.edges {
+            let extra = count.saturating_sub(base.edges.get(edge).copied().unwrap_or(0));
+            if extra > 0 {
+                out.edges.insert(*edge, extra);
+            }
+        }
+        for (v, count) in &self.vertices {
+            let extra = count.saturating_sub(base.vertices.get(v).copied().unwrap_or(0));
+            if extra > 0 {
+                out.vertices.insert(*v, extra);
+            }
+        }
+        out.total = self.total.saturating_sub(base.total);
+        out.novelty_score = if self.total > 0 {
+            self.novelty_score * out.total as f64 / self.total as f64
+        } else {
+            0.0
+        };
+        out
+    }
