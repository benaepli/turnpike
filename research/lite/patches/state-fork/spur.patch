+/// A run's state at the step after the once-per-run signal fired, with the
+/// generators it would draw from next. A child continues from a clone of
+/// it; the run that took it continues unchanged.
+pub struct ForkPoint<H: HashPolicy, F: Feedback> {
+    pub path_state: PathState<H, F>,
+    pub locals: ExecLocals,
+    /// The parent's generators at the fork, when its source exposes them; a
+    /// child drawing from a copy of these walks in the parent's steps.
+    pub streams: Option<StreamSet>,
+    /// The id of the run that took the fork point.
+    pub parent_run_id: i64,
+    /// Estimated size of the snapshot: the shallow size of its vectors,
+    /// maps and text, not the heap owned by the values inside them.
+    pub snapshot_bytes: usize,
+}
+
+impl<H: HashPolicy, F: Feedback> ForkPoint<H, F> {
+    fn take(
+        path_state: &PathState<H, F>,
+        locals: &ExecLocals,
+        streams: Option<StreamSet>,
+        parent_run_id: i64,
+    ) -> Self {
+        let path_state = path_state.clone();
+        let mut locals = locals.clone();
+        // A child never feeds a learner: a probe parent's child keeps the
+        // parent's step cap but merges no length, and reads the timer
+        // learner like every steered run.
+        locals.is_probe = false;
+        locals.timer_ctx_mode = timer_context::RunMode::Steered;
+        let snapshot_bytes = snapshot_bytes(&path_state, &locals);
+        Self {
+            path_state,
+            locals,
+            streams,
+            parent_run_id,
+            snapshot_bytes,
+        }
+    }
+}
+
+fn snapshot_bytes<H: HashPolicy, F: Feedback>(
+    path_state: &PathState<H, F>,
+    locals: &ExecLocals,
+) -> usize {
+    use std::mem::size_of;
+    let st = &path_state.state;
+    let queued = st.network_queue.len()
+        + st.timer_queue.len()
+        + st.purgatory.len()
+        + st.local_queues.iter().map(Vec::len).sum::<usize>();
+    size_of::<PathState<H, F>>()
+        + size_of::<ExecLocals>()
+        + path_state.history.len() * size_of::<Operation<H>>()
+        + path_state.logs.entries.len() * size_of::<LogEntry>()
+        + path_state
+            .logs
+            .entries
+            .iter()
+            .map(|e| e.content.len())
+            .sum::<usize>()
+        + path_state.logs.traces.len() * size_of::<TraceEntry>()
+        + path_state
+            .logs
+            .traces
+            .iter()
+            .map(|t| t.payload.len())
+            .sum::<usize>()
+        + st.nodes.len() * size_of::<Env<H>>()
+        + st.nodes.iter().map(|n| n.slots.len()).sum::<usize>() * size_of::<Value<H>>()
+        + queued * size_of::<Runnable<H>>()
+        + locals.all_delivers.len() * size_of::<DeliverSpec>()
+}
