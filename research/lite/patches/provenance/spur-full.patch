+                expected_tv += (shared_q[i] - local_q[a][i]).abs() / 10.0;
+                if shared_q[i] > shared_q[shared_best] { shared_best = i; }
+                if local_q[a][i] > local_q[a][local_best] { local_best = i; }
+            }
