+#[derive(Default)]
+struct ContextEvidence {
+    alpha: [f64; DIRECTIONS],
+    beta: [f64; DIRECTIONS],
+    observations: u64,
+}
+
+impl ContextEvidence {
+    fn credit(&mut self, arms: &ArmSet, reward: bool) {
+        self.observations += 1;
+        let r = reward as u8 as f64;
+        for d in arms.directions() {
+            self.alpha[d] = DISCOUNT * self.alpha[d] + r;
+            self.beta[d] = DISCOUNT * self.beta[d] + (1.0 - r);
+        }
+    }
+}
+
+pub fn context_layout() -> (usize, usize, usize) {
+    (std::mem::size_of::<ContextEvidence>(), std::mem::size_of::<CellLearner>(), std::mem::size_of::<Choice>())
+}
+
+fn probabilities(a: usize, means: &[f64; DIRECTIONS], variances: &[f64; DIRECTIONS]) -> ([f64; 3], [f64; 3]) {
+    let range = AXIS_START[a]..AXIS_START[a + 1];
+    let mut weights = [0.0; 3];
+    for (i, d) in range.clone().enumerate() {
+        weights[i] = range.clone().filter(|&j| j != d).map(|j| {
+            normal_cdf((means[d] - means[j]) / (variances[d] + variances[j]).sqrt())
+        }).product::<f64>() * ArmSet::coin_probability(d);
+    }
+    assert!(weights.iter().all(|w| w.is_finite()), "nonfinite context weights");
+    let total = weights.iter().sum::<f64>();
+    let mut q = [0.0; 3];
+    if total <= 0.0 { q[0] = 1.0; }
+    else { for i in 0..range.len() { q[i] = weights[i] / total; } }
+    (weights, q)
+}
+
+fn argmax(q: &[f64; 3], width: usize) -> usize {
+    let mut best = 0;
+    for i in 1..width { if q[i] > q[best] { best = i; } }
+    best
+}
