+            let mut directions = [0; AXES];
+            for a in 0..AXES {
+                let u = reference_rng.random::<f64>();
+                let width = AXIS_START[a + 1] - AXIS_START[a];
+                let mut cumulative = 0.0;
+                directions[a] = AXIS_START[a + 1] - 1;
+                for i in 0..width {
