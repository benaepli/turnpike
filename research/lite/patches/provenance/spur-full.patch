+            let choice = choose_with_context(run_id, seed, 0, cell, SearchContext::TapeMutation, SearchScope::Aos);
+            let after = util_stats::selector_context::Stats::read();
+            assert!(choice.learner.is_some());
+            assert_eq!(choice.arms, ArmSet::from_directions(directions));
+            let diagnostic = choice.diagnostic.unwrap();
+            for (a, d) in directions.into_iter().enumerate() {
+                assert!((diagnostic.shared_means[a] - shared_mean[d]).abs() < 1e-14);
+                assert!((diagnostic.context_means[a] - local_mean[d]).abs() < 1e-14);
+            }
+            assert_eq!(after.counts.specialized_learner_draws - before.counts.specialized_learner_draws, 1);
+            assert_eq!(after.counts.changed_argmax_runs - before.counts.changed_argmax_runs, expected_changed as u64);
+            assert!((after.counts.tv_sum - before.counts.tv_sum - expected_tv).abs() < 1e-13);
+        }
+        util_stats::set_enabled(false);
+        reset();
+    }
