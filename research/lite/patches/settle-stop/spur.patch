+/// One run on the treated half of the learned stop started; `armed` marks
+/// the runs whose scope held a settle, so the rule could fire, and
+/// `capped` those whose frozen step cap sat below the budget.
+pub fn record_run_stop_treated_run(armed: bool, capped: bool) {
+    if !enabled() {
+        return;
+    }
+    RUN_STOP_TREATED_RUNS.fetch_add(1, Ordering::Relaxed);
+    if armed {
+        RUN_STOP_ARMED_RUNS.fetch_add(1, Ordering::Relaxed);
+        if capped {
+            RUN_STOP_ARMED_RUNS_CAPPED.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+}
+
+/// The learned stop ended one run `steps_saved` steps short of its cap.
+pub fn record_run_stop_taken(steps_saved: u64) {
+    if !enabled() {
+        return;
+    }
+    RUN_STOP_STOPS_TAKEN.fetch_add(1, Ordering::Relaxed);
+    RUN_STOP_STEPS_SAVED_SUM.fetch_add(steps_saved, Ordering::Relaxed);
+}
+
+/// An armed run reached its cap without the stop firing: `keyed` says it
+/// had a recover and a crossing entry after it but a planned fault event
+/// was still outstanding; otherwise it never had a key.
+pub fn record_run_stop_fallback(keyed: bool) {
+    if !enabled() {
+        return;
+    }
+    if keyed {
+        RUN_STOP_PENDING_EVENT_FALLBACKS.fetch_add(1, Ordering::Relaxed);
+    } else {
+        RUN_STOP_NO_KEY_FALLBACKS.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// One run-cap probe ended without applying a recover; it feeds nothing.
+pub fn record_run_stop_probe_without_recover() {
+    if !enabled() {
+        return;
+    }
+    RUN_STOP_PROBES_WITHOUT_RECOVER.fetch_add(1, Ordering::Relaxed);
+}
+
+/// One run-cap probe ended with a recover at `last_recover_step` and no
+/// fault-crossing entry after it; it feeds nothing.
+pub fn record_run_stop_probe_without_key(last_recover_step: u64) {
+    if !enabled() {
+        return;
+    }
+    RUN_STOP_PROBES_WITHOUT_KEY.fetch_add(1, Ordering::Relaxed);
+    RUN_STOP_LAST_RECOVER_STEP_SUM.fetch_add(last_recover_step, Ordering::Relaxed);
+    RUN_STOP_LAST_RECOVER_STEP_COUNT.fetch_add(1, Ordering::Relaxed);
+}
+
+/// One run-cap probe ended keyed: its last recover at `last_recover_step`
+/// and its last fault-crossing entry after that at `last_crossing_step`.
+pub fn record_run_stop_probe_keyed(last_recover_step: u64, last_crossing_step: u64) {
+    if !enabled() {
+        return;
+    }
+    let settled = last_crossing_step.saturating_sub(last_recover_step);
+    RUN_STOP_PROBES_KEYED.fetch_add(1, Ordering::Relaxed);
+    RUN_STOP_LAST_RECOVER_STEP_SUM.fetch_add(last_recover_step, Ordering::Relaxed);
+    RUN_STOP_LAST_RECOVER_STEP_COUNT.fetch_add(1, Ordering::Relaxed);
+    RUN_STOP_LAST_CROSSING_STEP_SUM.fetch_add(last_crossing_step, Ordering::Relaxed);
+    RUN_STOP_LAST_CROSSING_STEP_COUNT.fetch_add(1, Ordering::Relaxed);
+    RUN_STOP_SETTLE_SUM.fetch_add(settled, Ordering::Relaxed);
+    RUN_STOP_SETTLE_COUNT.fetch_add(1, Ordering::Relaxed);
+    RUN_STOP_SETTLE_HIST[hist_bucket(settled as usize)].fetch_add(1, Ordering::Relaxed);
+    RUN_STOP_LAST_CROSSING_STEP_HIST[hist_bucket(last_crossing_step as usize)]
