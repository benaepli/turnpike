+/// The queue a step draws from when no term routes it: the stock roll, or
+/// the timer-biased roll on a steered run with an eligible timer, whose
+/// learned multiplier is read for the context of the first eligible timer
+/// in queue order. The features are copied into owned locals because the
+/// selector call must not overlap a borrow of `state`.
+fn pick_queue<H: HashPolicy, Q: QueueSelector, R: StreamRng>(
+    state: &State<H>,
+    info: &QueueInfo,
+    is_ineligible: &impl Fn(&Runnable<H>) -> bool,
+    strict_timers: bool,
+    timer_ctx_mode: timer_context::RunMode,
+    selector: &mut Q,
+    rng: &mut R,
+) -> Option<QueueSelection> {
+    let bias: Option<f64> = if timer_ctx_mode == timer_context::RunMode::Steered
+        && info.timer_queue_size > 0
+    {
+        let head_timer_node = state.timer_queue.iter().find_map(|r| {
+            if is_ineligible(r) {
+                return None;
+            }
+            if let Runnable::Timer(t) = r {
+                if strict_timers
+                    && let Some(l) = &t.label
+                    && !state.allowed_timers.contains(&(t.node.index, l.clone()))
+                {
+                    return None;
+                }
+                Some(t.node)
+            } else {
+                None
+            }
+        });
+        head_timer_node.and_then(|node| {
+            let ledger = state.send_ledger.get(node.index).copied().unwrap_or_default();
+            let cell = timer_context::cell_key(
+                state.pending_deliveries_to(node),
+                ledger.in_flight,
+                state.max_timer_inert_streak(node.index),
+                state.incarnation(node) > 0 && state.entries_since_restart(node.index) < 8,
+            );
+            timer_context::multiplier(cell)
+        })
+    } else {
+        None
+    };
+    match bias {
+        Some(m) if selector.supports_timer_bias() => {
+            util_stats::record_timer_context_bias(m);
+            selector.select_timer_biased(info, m, rng)
+        }
+        Some(_) => {
+            util_stats::record_timer_context_excluded();
+            selector.select(info, rng)
+        }
+        None => selector.select(info, rng),
+    }
+}
+
+/// How a queued remote record looks to the causal window's skip tests.
+fn causal_window_view<H: HashPolicy>(state: &State<H>, rec: &Record<H>) -> RecordView {
+    RecordView {
+        key: (rec.origin_node.index, rec.send_ordinal),
+        dest: rec.node.index,
+        same_role: rec.origin_node.role == rec.node.role,
+        caused_post_fault: state.client_anchor.caused_post_fault(rec.causal_operation_id),
+        dest_incarnation: state.incarnation(rec.node),
+    }
+}
+
+/// The keys of the network-queue records the causal window skips at this
+/// step, or `None` on a run with nothing open, which reads the queue not
+/// at all. Each record skipped for the first time is counted.
+fn causal_window_skipped<H: HashPolicy>(state: &mut State<H>) -> Option<HashSet<RecordKey>> {
+    if !state.causal_window.active() {
+        return None;
+    }
+    let arm = state.causal_window.arm;
+    let mut keys = HashSet::new();
+    let mut skips = Vec::new();
+    for r in &state.network_queue {
+        let Runnable::Record(rec) = r else { continue };
+        if rec.origin_node == rec.node {
+            continue;
+        }
+        let view = causal_window_view(state, rec);
+        let skip = state.causal_window.skip(&view);
+        if skip != causal_window::Skip::None {
+            keys.insert(view.key);
+            skips.push(skip);
+        }
+    }
+    for skip in skips {
+        util_stats::record_causal_window_skip(arm, skip);
+    }
+    Some(keys)
+}
+
+/// Which senders' records the open window skips at this moment among the
+/// records queued to the first `servers` nodes, by the class of their
+/// sender.
+fn causal_window_competitors<H: HashPolicy>(state: &State<H>, servers: usize) -> util_stats::Competitors {
+    let mut out = util_stats::Competitors::default();
+    for r in &state.network_queue {
+        let Runnable::Record(rec) = r else { continue };
+        if rec.origin_node == rec.node || rec.node.index >= servers {
+            continue;
+        }
+        if !state.causal_window.masks(&causal_window_view(state, rec)) {
+            continue;
+        }
+        if state.fault_crossing(rec.origin_node, rec.origin_incarnation) {
+            out.ghost = true;
+        } else if state.incarnation(rec.origin_node) > 0 {
+            out.live_restarted = true;
+        } else {
+            out.live_never_restarted = true;
+        }
+    }
+    out
+}
+
+/// The network-queue records the flag rule holds at this moment.
+fn causal_window_held<H: HashPolicy>(state: &State<H>) -> usize {
+    state
+        .network_queue
+        .iter()
+        .filter(|r| match r {
+            Runnable::Record(rec) => {
+                rec.origin_node != rec.node
+                    && state.causal_window.holds(&causal_window_view(state, rec))
+            }
+            _ => false,
+        })
+        .count()
+}
+
+/// A window opened for `op_id` at `step`: read what it found queued.
+fn causal_window_opened<H: HashPolicy>(state: &State<H>, op_id: i32, servers: usize) {
+    let first_op = state.client_anchor.first_post_fault_op == Some(op_id);
+    util_stats::record_causal_window_opened(
+        state.causal_window.arm,
+        causal_window_competitors(state, servers),
+        first_op,
+    );
+}
+
+/// A post-fault client operation `op_id` was invoked at `step`; `first`
+/// says it is the run's first. Opens its window on the window direction and
+/// reads the flagged records still held on the flag direction.
+pub fn causal_window_invoked<H: HashPolicy>(
+    state: &mut State<H>,
+    op_id: i32,
+    step: i32,
+    first: bool,
+    servers: usize,
+) {
+    let arm = state.causal_window.arm;
+    util_stats::record_causal_window_post_fault_invocation(arm);
+    if arm == causal_window::Arm::Consequence && first && util_stats::enabled() {
+        util_stats::record_causal_window_first_invocation(arm, causal_window_held(state));
+    }
+    if state.causal_window.invoked(op_id, step) {
+        causal_window_opened(state, op_id, servers);
+    }
+}
+
+/// A step begins at `step` on a run that keeps the table; `idle` says no
+/// post-fault operation is held or outstanding and `outstanding` lists the
+/// ones in flight in id order.
+pub fn causal_window_tick<H: HashPolicy>(
+    state: &mut State<H>,
+    step: i32,
+    idle: bool,
+    outstanding: &[i32],
+    servers: usize,
+) {
+    let tick = state.causal_window.tick(step, idle, outstanding);
+    let arm = state.causal_window.arm;
+    if let Some(close) = tick.closed {
+        util_stats::record_causal_window_closed(arm, close);
+    }
+    if let Some(op) = tick.opened {
+        causal_window_opened(state, op, servers);
+    }
+}
+
+/// The client operation `op_id` completed at `step`.
+pub fn causal_window_completed<H: HashPolicy>(
+    state: &mut State<H>,
+    op_id: i32,
+    step: i32,
+    outstanding: &[i32],
+    servers: usize,
+) {
+    let post_fault = state.client_anchor.caused_post_fault(Some(op_id));
+    let done = state.causal_window.completed(op_id, step, post_fault, outstanding);
+    let arm = state.causal_window.arm;
+    if let Some(close) = done.closed {
+        util_stats::record_causal_window_closed(arm, close);
+    }
+    if let Some(op) = done.opened {
+        causal_window_opened(state, op, servers);
+    }
+}
