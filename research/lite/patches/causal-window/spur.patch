+        let window_and_defer = (0..64_000i64)
+            .filter(|&id| {
+                from_run_id(id) & (CLIENT_FIRST_WINDOW | CONSEQUENCE_DEFER)
+                    == CLIENT_FIRST_WINDOW | CONSEQUENCE_DEFER
+            })
+            .count();
+        assert!(
+            window_runs > 0 && window_runs < 64_000 && defer_runs > 0 && defer_runs < 64_000,
+            "the causal-window split leaves no contrast"
+        );
+        assert_eq!(window_probes, 0, "a probe must never skip records at the draw");
+        assert_eq!(window_and_defer, 0, "the two window directions must never meet on a run");
         assert!(ordinary_stock > 0, "no stock run that is not a probe, so there is no control");
     }
