+    /// closed and a request entered the node before it; it came first when
+    /// no news had acted at the node since that request.
+    pub fn note_answer_news_entry(
+        &mut self,
+        dest: NodeId,
+        kind: EntryKind,
+        step: i32,
+    ) -> Option<AnswerEvent> {
+        let never_restarted = self.incarnation(dest) == 0;
+        let noted = dest.index < u64::BITS as usize;
+        let answer_first_here = noted && self.answer_first_nodes & (1 << dest.index) != 0;
+        let cycle_closed_before = self.absorber_cycle_closed_step.is_some_and(|c| c < step);
+        let l = self.send_ledger.get_mut(dest.index)?;
+        let request_before = l.first_post_fault_entry_step >= 0 && l.first_post_fault_entry_step < step;
