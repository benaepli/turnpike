+    /// The posterior mean a direction would have under boolean credit on
+    /// the core alone, with the same prior placed at that credit's rate.
+    fn core_mean(&self, d: usize) -> f64 {
+        let m = WARMUP_OBSERVATIONS as f64;
+        let mu = if self.mass > 0.0 { self.core_reward_mass / self.mass } else { 0.5 };
+        let a = 1.0 + m * mu + self.core_alpha[d];
+        let b = 1.0 + m * (1.0 - mu) + self.core_beta[d];
