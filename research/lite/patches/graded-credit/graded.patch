+        // or by another node, is not a reply to node 0.
+        let from = st.begin_segment(2);
+        let stale = record(&mut st, n2, n0);
+        st.end_segment(2, from, (0, 1));
+        let from = st.begin_segment(2);
+        let other = record(&mut st, n2, n0);
+        st.end_segment(2, from, (1, 1));
+        assert_eq!(st.classify_same_role_entry(n2, 1, stale.send_ordinal, None, n0), Some(EntryKind::News));
