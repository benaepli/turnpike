+                    self.post_fault_answer_then_news = true;
+                    self.news_after_answer_step =
+                        Some(self.news_after_answer_step.map_or(step, |s| s.min(step)));
+                    return Some(AnswerEvent::NewsAfterAnswer);
+                }
+                None
+            }
+            EntryKind::Answer(route) => {
