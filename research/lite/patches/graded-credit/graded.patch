+    /// The node's send count now, where a segment that starts at `node`
+    /// begins.
+    pub fn begin_segment(&self, node: usize) -> u32 {
+        self.send_ledger.get(node).map_or(0, |l| l.issued)
+    }
+
+    /// The segment at `node` that began at send count `from` and was
+    /// entered by a record from `source` ended; it is kept when it sent
+    /// anything.
+    pub fn end_segment(&mut self, node: usize, from: u32, source: (usize, u32)) {
+        let to = self.begin_segment(node);
+        if to <= from {
+            return;
+        }
+        if let Some(segments) = self.segments.get_mut(node) {
+            segments.push(Segment { from, to, source });
+        }
+    }
+
+    /// The node and incarnation the record that entered the segment at
+    /// `node` that issued send `ordinal` was sent from, if a kept segment
+    /// issued it.
+    pub fn segment_source(&self, node: usize, ordinal: u32) -> Option<(usize, u32)> {
+        let segments = self.segments.get(node)?;
+        let i = segments.partition_point(|s| s.to <= ordinal);
+        let s = segments.get(i)?;
+        (s.from <= ordinal && ordinal < s.to).then_some(s.source)
+    }
