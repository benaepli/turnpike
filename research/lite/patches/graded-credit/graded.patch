+    /// The records addressed to `dest` in the network queue and the delay
+    /// hold that are news from restarted senders of its role, by the
+    /// sending incarnation's class.
+    pub fn competitors_at(&self, dest: NodeId) -> Competitors {
+        let mut out = Competitors::default();
+        let mut count = |r: &Runnable<H>| {
+            let Runnable::Record(s) = r else { return };
+            if s.node != dest {
+                return;
+            }
+            let kind = self.classify_same_role_entry(
+                s.origin_node,
+                s.origin_incarnation,
+                s.send_ordinal,
+                s.causal_operation_id,
+                dest,
+            );
+            if kind != Some(EntryKind::News) {
+                return;
+            }
+            if s.origin_incarnation == self.incarnation(s.origin_node) {
+                out.live_restarted = out.live_restarted.saturating_add(1);
+            } else {
+                out.ghost = out.ghost.saturating_add(1);
+            }
+        };
+        for r in &self.network_queue {
+            count(r);
+        }
+        for (_, r) in &self.purgatory {
+            count(r);
+        }
