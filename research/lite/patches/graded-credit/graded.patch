+    /// What a message entry at `dest` is to the answer facts: None unless
+    /// the sender has the receiver's role and has restarted. An answer is a
+    /// record of the sender's current incarnation that either carries the
+    /// causal id of a post-fault operation whose request entered `dest`, or
+    /// was sent from a segment entered by a record from `dest`'s current
+    /// incarnation while some such request has entered `dest`. Anything
+    /// else from such a sender, at any incarnation, is news.
+    pub fn classify_same_role_entry(
+        &self,
+        origin: NodeId,
+        sent_at: u32,
+        send_ordinal: u32,
+        causal_operation_id: Option<i32>,
+        dest: NodeId,
+    ) -> Option<EntryKind> {
+        if origin == dest || origin.role != dest.role {
+            return None;
+        }
+        let current = self.incarnation(origin);
+        if current == 0 {
+            return None;
+        }
+        if sent_at == current {
+            let targets = self
+                .send_ledger
+                .get(dest.index)
+                .map_or(0, |l| l.post_fault_targets);
+            let caused = self
+                .post_fault_target_bit(causal_operation_id)
+                .is_some_and(|bit| targets & bit != 0);
+            let reply = targets != 0
+                && self.segment_source(origin.index, send_ordinal)
+                    == Some((dest.index, self.incarnation(dest)));
+            if caused || reply {
+                return Some(EntryKind::Answer(AnswerRoute { caused, reply }));
+            }
+        }
