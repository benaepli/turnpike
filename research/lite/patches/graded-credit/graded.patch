+    /// The bit of `post_fault_targets` for a post-fault operation, or None
+    /// for an operation before the first post-fault one or too far past it.
+    fn post_fault_target_bit(&self, causal_operation_id: Option<i32>) -> Option<u64> {
+        let op = causal_operation_id?;
+        let first = self.client_anchor.first_post_fault_op?;
+        let offset = op.checked_sub(first)?;
+        (0..u64::BITS as i32).contains(&offset).then(|| 1u64 << offset)
