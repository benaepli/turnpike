+        let mut st = answer_scene();
+        let n0 = node(SERVER, 0);
+        let n1 = node(SERVER, 1);
+        let n2 = node(SERVER, 2);
+        let client = node(CLIENT, 3);
+        // Dead-incarnation records from nodes 1 and 2, a live view change
+        // from node 1, the answer itself, a request, and a record to another
+        // node.
+        let mut dead_a = record(&mut st, n1, n0);
+        dead_a.origin_incarnation = 0;
+        let mut dead_b = record(&mut st, n2, n0);
+        dead_b.origin_incarnation = 0;
+        let live = record(&mut st, n1, n0);
+        let mut answer = record(&mut st, n2, n0);
+        answer.causal_operation_id = Some(7);
+        let request = record(&mut st, client, n0);
+        let elsewhere = record(&mut st, n1, n2);
+        st.push_runnable(Runnable::Record(dead_a));
+        st.push_runnable(Runnable::Record(live));
+        st.push_runnable(Runnable::Record(answer));
+        st.push_runnable(Runnable::Record(request));
+        st.push_runnable(Runnable::Record(elsewhere));
+        st.delay_runnable(90, Runnable::Record(dead_b));
