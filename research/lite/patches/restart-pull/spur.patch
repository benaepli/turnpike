+/// A planned crash of `planned` is being applied on `victim`: count where
+/// it landed against the other nodes' restarts, and close its pull.
+fn note_restart_pull_apply<H: HashPolicy>(state: &mut State<H>, planned: usize, victim: usize) {
+    let step = state.crash_info.current_step;
+    let rp = &mut state.restart_pull;
+    let later = rp.crashes_applied > 0;
+    rp.crashes_applied = rp.crashes_applied.saturating_add(1);
+    let bit = if planned < u64::BITS as usize {
+        1u64 << planned
+    } else {
+        0
+    };
+    rp.pulled_mask &= !bit;
+    let fired = rp.fired_mask & bit != 0;
+    rp.fired_mask &= !bit;
+    let (cell, window, ghost_node) = (rp.cell, rp.window, rp.ghost_node);
+    if !util_stats::enabled() {
+        return;
+    }
+    let last_other_restart = state
+        .send_ledger
+        .iter()
+        .enumerate()
+        .filter(|(n, _)| *n != victim)
+        .map(|(_, l)| l.last_restart_step)
+        .max()
+        .unwrap_or(-1);
+    let within = window.is_some_and(|w| last_other_restart >= 0 && step - last_other_restart <= w);
+    util_stats::record_restart_pull_apply(cell, later, within);
+    if fired {
+        util_stats::record_restart_pull_fired_apply(
+            state.retarget.enabled,
+            ghost_node == Some(victim),
+        );
+    }
+}
