+    /// A pulling twin, an untreated twin and a twin below the learner's
+    /// floor take the same restart: only the pulling twin's holds move, and
+    /// only the other nodes' holds whose targets lie past the window, each
+    /// to the restart plus the old target reduced modulo the window plus
+    /// one; the restarted node's own hold and a hold already inside the
+    /// window stay. The pull itself takes no random value, and the twins'
+    /// streams stay in step over the offers that follow.
+    #[test]
+    fn a_restart_pulls_the_other_nodes_held_crashes_and_the_untreated_twin_keeps_its_streams() {
+        let _serial = crate::simulator::config_override::exclusive_session();
+        util_stats::set_enabled(true);
+        let before = util_stats::snapshot().crash_place.restart_pull;
+        let build = |cell: util_stats::RestartPullCell, window: Option<i32>| {
+            let mut state = State::<NoHashing>::new(&[(ROLE, 4)], 1);
+            for n in 0..4 {
+                state.push_runnable(Runnable::Crash {
+                    node_id: node(n),
+                    priority: 0.5,
+                });
+            }
+            state.crash_hold_until = vec![900, 500, 431, 110];
+            state.restart_pull.cell = cell;
+            state.restart_pull.window = window;
+            state.crash_info.current_step = 100;
+            state
+        };
+        let mut treated = build(util_stats::RestartPullCell::PullOnly, Some(20));
+        let mut control = build(util_stats::RestartPullCell::Untreated, Some(20));
+        let mut unplaced = build(util_stats::RestartPullCell::Unplaced, Some(20));
+        let mut unlearned = build(util_stats::RestartPullCell::PullOnly, None);
+        for s in [&mut treated, &mut control, &mut unplaced, &mut unlearned] {
+            pull_held_crashes(s, 0, 100);
+        }
+        let t1 = 100 + 500 % 21;
+        let t2 = 100 + 431 % 21;
+        assert_eq!(treated.crash_hold_until, vec![900, t1, t2, 110]);
+        assert_eq!(control.crash_hold_until, vec![900, 500, 431, 110], "the untreated twin");
+        assert_eq!(unplaced.crash_hold_until, vec![900, 500, 431, 110], "an unplaced run");
+        assert_eq!(unlearned.crash_hold_until, vec![900, 500, 431, 110], "below the floor");
+        assert_eq!(treated.restart_pull.trigger, None, "the pull-only half arms no trigger");
+        assert_eq!(treated.restart_pull.pulled_mask, 0b110);
+        assert_eq!(control.restart_pull.pulled_mask, 0);
+
+        // A second restart pulls the hold still past its window and leaves
+        // the holds an earlier pull already put inside it: a pulled hold
+        // never lengthens.
+        pull_held_crashes(&mut treated, 3, 105);
+        let t0 = 105 + 900 % 21;
+        assert_eq!(treated.crash_hold_until, vec![t0, t1, t2, 110]);
+
+        let mut rng_t = StdRng::seed_from_u64(3);
+        let mut rng_c = StdRng::seed_from_u64(3);
+        for step in 100..=200 {
+            treated.crash_info.current_step = step;
+            control.crash_info.current_step = step;
+            let held_t = crash_hold_mask(&mut treated, 4, &mut rng_t);
+            let held_c = crash_hold_mask(&mut control, 4, &mut rng_c);
+            let node3 = if step < 110 { 1u64 << 3 } else { 0 };
+            assert_eq!(held_c, 0b111 | node3, "step {step}: the control twin");
+            let mut want = node3;
+            for (n, t) in [(0, t0), (1, t1), (2, t2)] {
+                if step < t {
+                    want |= 1 << n;
+                }
+            }
+            assert_eq!(held_t, want, "step {step}: the pulling twin");
+        }
+        assert_eq!(rng_t.next_u64(), rng_c.next_u64(), "the twins' streams parted");
+        let after = util_stats::snapshot().crash_place.restart_pull;
+        util_stats::set_enabled(false);
+        assert_eq!(after.pulls - before.pulls, 3);
+        assert_eq!(after.restarts_with_held_crash - before.restarts_with_held_crash, 2);
+        assert_eq!(
+            after.steps_saved_sum - before.steps_saved_sum,
+            (500 - t1) as u64 + (431 - t2) as u64 + (900 - t0) as u64
+        );
+        assert_eq!(after.trigger.armed, before.trigger.armed, "the pull-only half never arms");
+    }
