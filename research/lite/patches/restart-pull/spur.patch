+/// The trigger a restart armed runs out at the window's end: the pulled
+/// crashes are then due at their target and nothing is left to release.
+fn expire_trigger<H: HashPolicy>(state: &mut State<H>, step_now: i32) {
+    if let Some(t) = state.restart_pull.trigger
+        && step_now >= t.expires
+    {
+        state.restart_pull.trigger = None;
+        state.restart_pull.pulled_mask = 0;
+        util_stats::record_restart_pull_trigger(util_stats::RestartPullTrigger::Expired);
+    }
+}
+
+/// A restart of `origin` at `restart_step` on a pulling run re-targets the
+/// other nodes' held crashes into the learned window. On the triggering
+/// half the pulled crashes go to the window's end and the trigger is armed
+/// on `origin`; a trigger still armed from an earlier restart is replaced,
+/// and the crashes it had pulled stay pulled. Below the learner's floor
+/// nothing moves. Nothing here reads a random stream.
+fn pull_held_crashes<H: HashPolicy>(state: &mut State<H>, origin: usize, restart_step: i32) {
+    if !state.restart_pull.pulls() {
+        return;
+    }
+    let Some(window) = state.restart_pull.window else {
+        return;
+    };
+    let to_end = state.restart_pull.triggers();
+    let pull = restart_pull::pull_holds(
+        &mut state.crash_hold_until,
+        &state.send_ledger,
+        origin,
+        restart_step,
+        window,
+        to_end,
+    );
+    util_stats::record_restart_pull(pull.held_crash, pull.pulls, pull.steps_saved);
+    let rp = &mut state.restart_pull;
+    rp.pulled_mask |= pull.mask;
+    if !to_end || pull.pulls == 0 {
+        return;
+    }
+    if rp.trigger.is_some() {
+        util_stats::record_restart_pull_trigger(util_stats::RestartPullTrigger::Superseded);
+    }
+    rp.trigger = Some(restart_pull::Trigger {
+        origin,
+        restart_step,
+        expires: restart_step.saturating_add(window),
+    });
+    util_stats::record_restart_pull_trigger(util_stats::RestartPullTrigger::Armed);
+}
+
+/// A message entry at `dest` sent by `origin` at incarnation `sent_at`
+/// landed at `step` and `acted` says whether it wrote `dest`'s state. An
+/// entry from a dead incarnation of a live origin at a live destination is
+/// a ghost lag sample - the step less the origin's last restart step - fed
+/// to the learner on the runs that feed it. On the triggering half the
+/// first such entry after the armed restart, from the restarted node and
+/// writing state, releases every pulled crash at the next step.
+fn note_restart_pull_entry<H: HashPolicy>(
+    state: &mut State<H>,
+    origin: NodeId,
+    sent_at: u32,
+    dest: NodeId,
+    step: i32,
+    acted: bool,
+) {
+    if origin == dest || sent_at == state.incarnation(origin) {
+        return;
+    }
+    let down = &state.crash_info.currently_crashed;
+    if down.contains(&dest) {
+        return;
+    }
+    let last_restart = state
+        .send_ledger
+        .get(origin.index)
+        .map_or(-1, |l| l.last_restart_step);
+    if !down.contains(&origin) && last_restart >= 0 && state.restart_pull.feeds_learner {
+        restart_pull::merge_probe_lag(state.restart_pull.scope, step - last_restart);
+    }
+    let Some(t) = state.restart_pull.trigger else {
+        return;
+    };
+    if !acted || t.origin != origin.index || step <= t.restart_step {
+        return;
+    }
+    let width = state.crash_hold_until.len().min(u64::BITS as usize);
+    for n in 0..width {
+        if state.restart_pull.pulled_mask & (1u64 << n) == 0
+            || state.send_ledger.get(n).is_none_or(|l| l.crash_pending == 0)
+        {
+            continue;
+        }
+        if state.crash_hold_until[n] > step + 1 {
+            state.crash_hold_until[n] = step + 1;
+        }
+    }
+    let rp = &mut state.restart_pull;
+    rp.fired_mask |= rp.pulled_mask;
+    rp.pulled_mask = 0;
+    rp.ghost_node = Some(dest.index);
+    rp.trigger = None;
+    util_stats::record_restart_pull_trigger(util_stats::RestartPullTrigger::Fired {
+        steps_from_restart: (step - t.restart_step).max(0) as u64,
+    });
+}
