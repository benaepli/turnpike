+
+        util_stats::set_enabled(true);
+        let before = util_stats::snapshot().replay.write_ring.slots_unfilled;
+        let mut arm = arm_with(replay_corpus::CAPACITY as i64, 0);
+        let mut fell_through = 0;
+        for &id in &ids {
+            match arm.assign(id) {
+                GridRun::WriteChild { .. } => panic!("run {id}: a child from an empty write ring"),
+                GridRun::Child { seed, prefix } => {
+                    assert!(replay_corpus::is_slot(id));
+                    assert_eq!(prefix, replay_corpus::is_prefix(id));
+                    assert!(seed.parent_run_id < 1_000_000);
+                    if replay_corpus::is_write_slot(id) {
