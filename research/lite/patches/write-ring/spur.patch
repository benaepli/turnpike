+                        "run {id}: a write parent served the ghost ring"
+                    );
+                }
+                GridRun::Fresh { .. } => {
+                    assert!(
+                        !replay_corpus::is_slot(id),
+                        "run {id}: a slot ran fresh with full rings"
+                    );
+                }
+            }
+        }
