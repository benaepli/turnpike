+        let slots = ids.iter().filter(|&&id| replay_corpus::is_slot(id)).count();
+        let write_slots = ids.iter().filter(|&&id| replay_corpus::is_write_slot(id)).count();
+        assert!(write_slots > 50, "the id range holds {write_slots} write slots");
+        let served = replay_corpus::CAPACITY * replay_corpus::CHILDREN_PER_PARENT as usize;
+        assert!(served > slots, "a full ring serves every slot of the range");
+
+        let mut arm = arm_with(replay_corpus::CAPACITY as i64, replay_corpus::CAPACITY as i64);
+        let mut write_children = 0;
