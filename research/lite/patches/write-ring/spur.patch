+    /// Whether a client operation invoked now at server `target` meets the
+    /// write signal: the target never restarted and has no crash queued, at
+    /// least two of the first `num_servers` nodes have restarted, and the
+    /// network queue holds fault-crossing records addressed to the target
+    /// from at least two distinct remote origins.
+    pub fn write_signal(&self, target: usize, num_servers: usize) -> bool {
+        if self.incarnation_at(target) != 0
+            || self.send_ledger.get(target).is_none_or(|l| l.crash_pending != 0)
+        {
+            return false;
+        }
+        let restarted = self
+            .incarnations
+            .iter()
+            .take(num_servers)
+            .filter(|&&i| i > 0)
+            .count();
+        if restarted < 2 {
+            return false;
+        }
+        let mut origins: Vec<usize> = Vec::new();
+        for r in &self.network_queue {
+            let Runnable::Record(rec) = r else { continue };
+            if rec.node.index != target
+                || rec.origin_node.index == target
+                || !self.fault_crossing(rec.origin_node, rec.origin_incarnation)
+                || origins.contains(&rec.origin_node.index)
+            {
+                continue;
+            }
+            origins.push(rec.origin_node.index);
+            if origins.len() >= 2 {
+                return true;
+            }
+        }
+        false
+    }
