+                    assert!(
+                        seed.parent_run_id >= 1_000_000,
+                        "run {id}: a ghost parent served a write slot"
+                    );
+                    assert_eq!(uniform, replay_corpus::is_uniform_suffix(id));
+                    write_children += 1;
+                }
+                GridRun::Child { seed, prefix } => {
+                    assert!(replay_corpus::is_slot(id) && !replay_corpus::is_write_slot(id));
+                    assert_eq!(prefix, replay_corpus::is_prefix(id));
+                    assert!(
