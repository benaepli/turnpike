+fn replay_frontier(m: &mut Marks) -> FrontierStats {
+    FrontierStats {
+        totals: frontier_counters(m),
+        by_arm: vec![FrontierArmStats {
+            arm_index: 2,
+            counters: frontier_counters(m),
+        }],
+        parent_diagnostics: vec![FrontierParentDiagnostic {
+            parent_run_id: 47,
+            arm_index: 2,
+            offer_count: 3,
+            original_words: 111,
+            retained_words: 122,
+            metadata_bytes: 333,
+            max_nodes: 444,
+            max_offer_owned_bytes: 555,
+            children: Vec::new(),
+        }],
+        retained_parent_rows: m.int(),
+        dropped_parent_rows: m.int(),
+        dropped_child_rows: m.int(),
+        diagnostic_applied_children: m.int(),
+        diagnostic_repeated_applied_pairs: m.int(),
+    }
+}
+
+fn replay_frontier_leaves(prefix: &str, stats: &FrontierStats) -> Vec<(String, Value)> {
+    let FrontierStats {
+        totals,
+        by_arm,
+        parent_diagnostics,
+        retained_parent_rows,
+        dropped_parent_rows,
+        dropped_child_rows,
+        diagnostic_applied_children,
+        diagnostic_repeated_applied_pairs,
+    } = stats;
+    let mut out = frontier_counter_leaves(prefix, totals);
+    out.extend([
+        leaf(prefix, "retained_parent_rows", *retained_parent_rows),
+        leaf(prefix, "dropped_parent_rows", *dropped_parent_rows),
+        leaf(prefix, "dropped_child_rows", *dropped_child_rows),
+        leaf(
+            prefix,
+            "diagnostic_applied_children",
+            *diagnostic_applied_children,
+        ),
+        leaf(
+            prefix,
+            "diagnostic_repeated_applied_pairs",
+            *diagnostic_repeated_applied_pairs,
+        ),
+    ]);
+    for (index, arm) in by_arm.iter().enumerate() {
+        let FrontierArmStats {
+            arm_index,
+            counters,
+        } = arm;
+        let path = format!("{prefix}.by_arm.{index}");
+        out.push(leaf(&path, "arm_index", *arm_index));
+        out.extend(frontier_counter_leaves(&path, counters));
+    }
+    for (index, parent) in parent_diagnostics.iter().enumerate() {
+        let FrontierParentDiagnostic {
+            parent_run_id,
+            arm_index,
+            offer_count,
+            original_words,
+            retained_words,
+            metadata_bytes,
+            max_nodes,
+            max_offer_owned_bytes,
+            children,
+        } = parent;
+        let path = format!("{prefix}.parent_diagnostics.{index}");
+        out.extend([
+            leaf(&path, "parent_run_id", *parent_run_id),
+            leaf(&path, "arm_index", *arm_index),
+            leaf(&path, "offer_count", *offer_count as u64),
+            leaf(&path, "original_words", *original_words as u64),
+            leaf(&path, "retained_words", *retained_words as u64),
+            leaf(&path, "metadata_bytes", *metadata_bytes as u64),
+            leaf(&path, "max_nodes", *max_nodes as u64),
+            leaf(
+                &path,
+                "max_offer_owned_bytes",
+                *max_offer_owned_bytes as u64,
+            ),
+        ]);
+        assert!(children.is_empty());
+    }
+    out
+}
