diff --git a/spur-core/src/simulator/replay_frontier.rs b/spur-core/src/simulator/replay_frontier.rs
new file mode 100644
index 0000000..03e325c
--- /dev/null
+++ b/spur-core/src/simulator/replay_frontier.rs
@@ -0,0 +1,474 @@
+use crate::simulator::core::state::{NodeId, State};
+use crate::simulator::hash_utils::HashPolicy;
+use crate::simulator::rng::splitmix;
+use serde::Serialize;
+use std::hash::{Hash, Hasher};
+
+pub const MAX_OFFERS: usize = 8;
+pub const WINDOW: usize = 8;
+pub const MAX_DIAGNOSTICS: usize = 4096;
+
+pub fn parent_header_bytes() -> usize {
+    std::mem::size_of::<(
+        i64,
+        usize,
+        Vec<Offer>,
+        Option<Offer>,
+        u32,
+        u32,
+        u8,
+        std::sync::Arc<std::sync::atomic::AtomicU8>,
+    )>() + 3 * std::mem::size_of::<usize>()
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize)]
+pub struct EventKey {
+    pub kind: u8,
+    pub node: NodeId,
+    pub origin: NodeId,
+    pub incarnation: u32,
+    pub ordinal: u32,
+    pub pc: usize,
+    pub entry_pc: usize,
+    pub link: Option<(usize, u32)>,
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct NodeWindow {
+    pub node: NodeId,
+    pub before: u64,
+    pub deltas: [i128; WINDOW],
+    pub first_touch: u8,
+}
+
+#[derive(Clone, Debug, Default, Serialize)]
+pub struct WriteWindow {
+    pub nodes: Vec<NodeWindow>,
+    pub steps: u8,
+}
+
+impl WriteWindow {
+    pub fn new<H: HashPolicy>(state: &State<H>, node_id: impl Fn(usize) -> NodeId) -> Self {
+        Self {
+            nodes: state
+                .nodes
+                .iter()
+                .enumerate()
+                .map(|(i, env)| NodeWindow {
+                    node: node_id(i),
+                    before: env.writes,
+                    deltas: [0; WINDOW],
+                    first_touch: u8::MAX,
+                })
+                .collect(),
+            steps: 0,
+        }
+    }
+
+    pub fn observe<H: HashPolicy>(&mut self, state: &State<H>, touched: Option<NodeId>) {
+        if usize::from(self.steps) >= WINDOW {
+            return;
+        }
+        for n in &mut self.nodes {
+            if touched == Some(n.node) && n.first_touch == u8::MAX {
+                n.first_touch = self.steps;
+            }
+            n.deltas[usize::from(self.steps)] =
+                i128::from(state.node_state_token(n.node)) - i128::from(n.before);
+        }
+        self.steps += 1;
+    }
+
+    pub fn owned_bytes(&self) -> usize {
+        self.nodes.capacity() * std::mem::size_of::<NodeWindow>()
+    }
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct Offer {
+    pub tape_pos: usize,
+    pub step: i32,
+    pub selected: EventKey,
+    pub alternative: EventKey,
+    pub rank: u64,
+    pub reference: WriteWindow,
+}
+
+impl Offer {
+    pub fn pair(&self) -> [EventKey; 2] {
+        ordered_pair(self.selected, self.alternative)
+    }
+    pub fn owned_bytes(&self) -> usize {
+        std::mem::size_of::<Self>() + self.reference.owned_bytes()
+    }
+}
+
+pub fn ordered_pair(a: EventKey, b: EventKey) -> [EventKey; 2] {
+    if a < b { [a, b] } else { [b, a] }
+}
+
+pub fn private_hash<T: Hash>(seed: u64, value: &T) -> u64 {
+    let mut h = rustc_hash::FxHasher::default();
+    value.hash(&mut h);
+    splitmix(seed ^ h.finish())
+}
+
+#[derive(Clone, Copy, Debug, Default, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum RequestOutcome {
+    #[default]
+    Unencountered,
+    PassedBoundary,
+    Missing,
+    Ambiguous,
+    Ineligible,
+    AlreadyChosen,
+    Applied,
+}
+
+#[derive(Clone, Debug)]
+pub struct Request {
+    pub offer_index: u8,
+    pub applied_pairs: std::sync::Arc<std::sync::atomic::AtomicU8>,
+    pub parent_run_id: i64,
+    pub child_index: u32,
+    pub offer: Offer,
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct RunState {
+    pub capture: bool,
+    pub filled_prefix: bool,
+    pub server_nodes: usize,
+    pub server_role: Option<crate::analysis::resolver::NameId>,
+    pub client_role: Option<crate::analysis::resolver::NameId>,
+    pub seed: u64,
+    pub offers: Vec<Offer>,
+    pub request: Option<Request>,
+    pub attempted: bool,
+    pub outcome: RequestOutcome,
+    pub child_window: Option<WriteWindow>,
+    pub effective_cap: i32,
+    pub remaining_cap: i32,
+    pub stock_mismatch: bool,
+    pub stock_event: Option<EventKey>,
+    pub final_event: Option<EventKey>,
+    pub stock_queue: u8,
+    pub final_queue: u8,
+    pub touched: Option<NodeId>,
+    pub proposed: u64,
+    pub duplicates: u64,
+    pub evicted: u64,
+    pub metadata_peak: usize,
+}
+
+impl RunState {
+    pub fn node_id(&self, index: usize) -> NodeId {
+        NodeId {
+            role: if index < self.server_nodes {
+                self.server_role
+            } else {
+                self.client_role
+            }
+            .expect("frontier role identity"),
+            index,
+        }
+    }
+    pub fn observe<H: HashPolicy>(&mut self, state: &State<H>) {
+        let servers = self.server_nodes;
+        let server_role = self.server_role;
+        let client_role = self.client_role;
+        let node_id = |index| NodeId {
+            role: if index < servers {
+                server_role
+            } else {
+                client_role
+            }
+            .expect("frontier role identity"),
+            index,
+        };
+        for window in self
+            .offers
+            .iter_mut()
+            .map(|o| &mut o.reference)
+            .chain(self.child_window.iter_mut())
+        {
+            if window.steps < WINDOW as u8 {
+                if state.nodes.len() > window.nodes.len() {
+                    window
+                        .nodes
+                        .reserve_exact(state.nodes.len() - window.nodes.len());
+                    for i in window.nodes.len()..state.nodes.len() {
+                        window.nodes.push(NodeWindow {
+                            node: node_id(i),
+                            before: 0,
+                            deltas: [0; WINDOW],
+                            first_touch: u8::MAX,
+                        });
+                    }
+                }
+                window.observe(state, self.touched);
+            }
+        }
+        self.metadata_peak = self.metadata_peak.max(self.owned_bytes());
+    }
+
+    pub fn wants_capture(&self) -> bool {
+        self.capture
+    }
+    pub fn retain(&mut self, offer: Offer) {
+        self.proposed += 1;
+        if self.offers.iter().any(|o| o.pair() == offer.pair()) {
+            self.duplicates += 1;
+            return;
+        }
+        if self.offers.capacity() == 0 {
+            self.offers = Vec::with_capacity(MAX_OFFERS);
+        }
+        if self.offers.len() < MAX_OFFERS {
+            self.offers.push(offer);
+        } else {
+            let (idx, worst) = self
+                .offers
+                .iter()
+                .enumerate()
+                .max_by_key(|(_, o)| (o.rank, o.pair()))
+                .unwrap();
+            if (offer.rank, offer.pair()) < (worst.rank, worst.pair()) {
+                self.offers[idx] = offer;
+                self.evicted += 1;
+            }
+        }
+        self.metadata_peak = self.metadata_peak.max(self.owned_bytes());
+    }
+    pub fn owned_bytes(&self) -> usize {
+        std::mem::size_of::<Self>()
+            + self.offers.capacity() * std::mem::size_of::<Offer>()
+            + self
+                .offers
+                .iter()
+                .map(|o| o.reference.owned_bytes())
+                .sum::<usize>()
+            + self
+                .request
+                .as_ref()
+                .map_or(0, |r| r.offer.reference.owned_bytes())
+            + self
+                .child_window
+                .as_ref()
+                .map_or(0, WriteWindow::owned_bytes)
+    }
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct ChildDiagnostic {
+    pub run_id: i64,
+    pub child_index: u32,
+    pub pair: [EventKey; 2],
+    pub requested_position: usize,
+    pub parent_selected: EventKey,
+    pub requested_alternative: EventKey,
+    pub outcome: RequestOutcome,
+    pub stock_mismatch: bool,
+    pub stock_event: Option<EventKey>,
+    pub final_event: Option<EventKey>,
+    pub stock_queue: u8,
+    pub final_queue: u8,
+    pub remaining_cap: i32,
+    pub parent_steps: u8,
+    pub child_steps: u8,
+    pub common_node: Option<NodeId>,
+    pub parent_deltas: Option<[i128; WINDOW]>,
+    pub child_deltas: Option<[i128; WINDOW]>,
+    pub divergent: bool,
+}
+
+pub fn diagnostic(run_id: i64, state: &RunState) -> Option<ChildDiagnostic> {
+    let r = state.request.as_ref()?;
+    let parent = &r.offer.reference;
+    let child = state.child_window.as_ref();
+    let common = child.and_then(|child| {
+        parent
+            .nodes
+            .iter()
+            .filter(|p| p.first_touch != u8::MAX)
+            .filter_map(|p| {
+                child
+                    .nodes
+                    .iter()
+                    .find(|c| c.node == p.node && c.first_touch != u8::MAX)
+                    .map(|c| (p, c))
+            })
+            .min_by_key(|(p, _)| (p.first_touch, p.node))
+    });
+    let complete = parent.steps == WINDOW as u8 && child.is_some_and(|c| c.steps == WINDOW as u8);
+    Some(ChildDiagnostic {
+        run_id,
+        child_index: r.child_index,
+        pair: r.offer.pair(),
+        requested_position: r.offer.tape_pos,
+        parent_selected: r.offer.selected,
+        requested_alternative: r.offer.alternative,
+        stock_event: state.stock_event,
+        final_event: state.final_event,
+        outcome: state.outcome,
+        stock_mismatch: state.stock_mismatch,
+        stock_queue: state.stock_queue,
+        final_queue: state.final_queue,
+        remaining_cap: state.remaining_cap,
+        parent_steps: parent.steps,
+        child_steps: child.map_or(0, |c| c.steps),
+        common_node: common.map(|(p, _)| p.node),
+        parent_deltas: common.map(|(p, _)| p.deltas),
+        child_deltas: common.map(|(_, c)| c.deltas),
+        divergent: complete && common.is_some_and(|(p, c)| p.deltas != c.deltas),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn metadata_has_a_bounded_node_cost() {
+        assert!(std::mem::size_of::<Offer>() <= 512);
+        assert!(std::mem::size_of::<NodeWindow>() <= 192);
+    }
+    fn key(ordinal: u32) -> EventKey {
+        let node = NodeId {
+            role: crate::analysis::resolver::NameId(3),
+            index: 0,
+        };
+        EventKey {
+            kind: 0,
+            node,
+            origin: node,
+            incarnation: 0,
+            ordinal,
+            pc: 0,
+            entry_pc: 0,
+            link: None,
+        }
+    }
+
+    #[test]
+    fn write_windows_preserve_resets_and_new_node_role_identity() {
+        use crate::simulator::hash_utils::NoHashing;
+        let server = crate::analysis::resolver::NameId(3);
+        let client = crate::analysis::resolver::NameId(7);
+        let mut state = State::<NoHashing>::new(&[(server, 1)], 1);
+        state.nodes[0].writes = 20;
+        let mut run = RunState {
+            server_nodes: 1,
+            server_role: Some(server),
+            client_role: Some(client),
+            ..Default::default()
+        };
+        run.child_window = Some(WriteWindow::new(&state, |i| run.node_id(i)));
+        state.nodes[0].writes = 24;
+        run.touched = Some(run.node_id(0));
+        run.observe(&state);
+        state.nodes[0].writes = 2;
+        state
+            .nodes
+            .push(crate::simulator::core::values::Env::with_slots(1));
+        state.nodes[1].writes = 3;
+        run.touched = Some(run.node_id(1));
+        run.observe(&state);
+        let window = run.child_window.unwrap();
+        assert_eq!(&window.nodes[0].deltas[..2], &[4, -18]);
+        assert_eq!(window.nodes[1].node.role, client);
+        assert_eq!(&window.nodes[1].deltas[..2], &[0, 3]);
+        assert_eq!(window.nodes[1].first_touch, 1);
+        assert!(window.owned_bytes() <= 192 * state.nodes.len());
+    }
+
+    #[test]
+    fn comparison_uses_parent_touch_order_and_censors_short_windows() {
+        let a = key(0).node;
+        let b = NodeId { index: 1, ..a };
+        let node_window = |node, first_touch, delta| NodeWindow {
+            node,
+            before: 100,
+            deltas: [delta; WINDOW],
+            first_touch,
+        };
+        let parent = WriteWindow {
+            nodes: vec![node_window(b, 2, 7), node_window(a, 0, 4)],
+            steps: 8,
+        };
+        let child = WriteWindow {
+            nodes: vec![node_window(b, 0, 7), node_window(a, 4, 5)],
+            steps: 8,
+        };
+        let mut run = RunState {
+            outcome: RequestOutcome::Applied,
+            child_window: Some(child),
+            request: Some(Request {
+                offer_index: 0,
+                applied_pairs: Default::default(),
+                parent_run_id: 1,
+                child_index: 1,
+                offer: Offer {
+                    tape_pos: 1,
+                    step: 0,
+                    selected: key(0),
+                    alternative: key(1),
+                    rank: 0,
+                    reference: parent,
+                },
+            }),
+            ..Default::default()
+        };
+        let d = diagnostic(2, &run).unwrap();
+        assert_eq!(d.common_node, Some(a));
+        assert!(d.divergent);
+        run.child_window.as_mut().unwrap().steps = 7;
+        assert!(!diagnostic(2, &run).unwrap().divergent);
+        run.child_window
+            .as_mut()
+            .unwrap()
+            .nodes
+            .iter_mut()
+            .for_each(|n| n.first_touch = u8::MAX);
+        assert!(diagnostic(2, &run).unwrap().common_node.is_none());
+    }
+
+    #[test]
+    fn stable_pair_priorities_keep_distinct_offers_without_a_seen_table() {
+        let mut run = RunState::default();
+        for ordinal in (1..50).chain(1..50) {
+            let selected = key(0);
+            let alternative = key(ordinal);
+            let rank = private_hash(9, &ordered_pair(selected, alternative));
+            run.retain(Offer {
+                tape_pos: ordinal as usize,
+                step: 0,
+                selected,
+                alternative,
+                rank,
+                reference: WriteWindow::default(),
+            });
+        }
+        assert_eq!(run.offers.len(), MAX_OFFERS);
+        let mut expected: Vec<_> = (1..50)
+            .map(|i| (private_hash(9, &ordered_pair(key(0), key(i))), i))
+            .collect();
+        expected.sort_unstable();
+        for offer in &run.offers {
+            assert!(
+                expected[..MAX_OFFERS]
+                    .iter()
+                    .any(|(rank, i)| *rank == offer.rank && *i == offer.alternative.ordinal)
+            );
+        }
+        for offer in &run.offers {
+            assert_eq!(
+                run.offers
+                    .iter()
+                    .filter(|o| o.pair() == offer.pair())
+                    .count(),
+                1
+            );
+        }
+    }
+}
