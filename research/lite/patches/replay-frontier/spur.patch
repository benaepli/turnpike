+    pub parents: u64,
+    pub signal_cut_parents: u64,
+    pub parents_with_offer: u64,
+    pub filled_prefix_children: u64,
+    pub assigned_requests: u64,
+    pub proposed: u64,
+    pub duplicates: u64,
+    pub evicted: u64,
+    pub applied_runs: u64,
+    pub applied_pair_repeats: u64,
+    pub passed_boundary: u64,
+    pub missing: u64,
+    pub ambiguous: u64,
+    pub ineligible: u64,
+    pub already_chosen: u64,
+    pub unencountered: u64,
+    pub stock_mismatch: u64,
+    pub complete_windows: u64,
+    pub no_common_node: u64,
+    pub censored_runs: u64,
+    pub divergent_runs: u64,
+    pub usable_suffix_runs: u64,
+    pub child_steps_sum: u64,
+    pub parent_steps_sum: u64,
+    pub cumulative_retained_words: u64,
+    pub cumulative_original_cut_words: u64,
+    pub max_offers_per_parent: u64,
+    pub max_metadata_bytes_per_parent: u64,
+    pub max_offer_owned_bytes: u64,
+    pub max_parent_nodes: u64,
+    pub max_in_progress_bytes_per_run: u64,
+    pub peak_live_retained_words: u64,
+    pub peak_live_original_cut_words: u64,
+    pub actual_live_retained_words: u64,
+    pub actual_live_original_cut_words: u64,
+    pub remaining_cap_hist: [u64; 6],
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct FrontierArmStats {
+    pub arm_index: i32,
+    #[serde(flatten)]
+    pub counters: FrontierCounters,
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct FrontierParentDiagnostic {
+    pub parent_run_id: i64,
+    pub arm_index: i32,
+    pub offer_count: usize,
+    pub original_words: usize,
+    pub retained_words: usize,
+    pub metadata_bytes: usize,
+    pub max_nodes: usize,
+    pub max_offer_owned_bytes: usize,
+    pub children: Vec<crate::simulator::replay_frontier::ChildDiagnostic>,
+}
+
+#[derive(Clone, Debug, Default, Serialize)]
+pub struct FrontierStats {
+    #[serde(flatten)]
+    pub totals: FrontierCounters,
+    pub by_arm: Vec<FrontierArmStats>,
+    pub parent_diagnostics: Vec<FrontierParentDiagnostic>,
+    pub retained_parent_rows: u64,
+    pub dropped_parent_rows: u64,
+    pub dropped_child_rows: u64,
+    pub diagnostic_applied_children: u64,
+    pub diagnostic_repeated_applied_pairs: u64,
+}
+
+#[derive(Default)]
+struct FrontierState {
+    totals: FrontierCounters,
+    by_arm: std::collections::BTreeMap<i32, FrontierCounters>,
+    parents: std::collections::BTreeMap<(i32, i64), FrontierParentDiagnostic>,
+    dropped_parent_rows: u64,
+    dropped_child_rows: u64,
+    diagnostic_applied_children: u64,
+    diagnostic_repeated_applied_pairs: u64,
+}
+
+impl FrontierState {
+    fn update(&mut self, arm: i32, f: impl Fn(&mut FrontierCounters)) {
+        f(&mut self.totals);
+        f(self.by_arm.entry(arm).or_default());
+    }
+
+    fn snapshot(&self) -> FrontierStats {
+        FrontierStats {
+            totals: self.totals.clone(),
+            by_arm: self
+                .by_arm
+                .iter()
+                .map(|(&arm_index, counters)| FrontierArmStats {
+                    arm_index,
+                    counters: counters.clone(),
+                })
+                .collect(),
+            parent_diagnostics: self.parents.values().cloned().collect(),
+            retained_parent_rows: self.parents.len() as u64,
+            dropped_parent_rows: self.dropped_parent_rows,
+            dropped_child_rows: self.dropped_child_rows,
+            diagnostic_applied_children: self.diagnostic_applied_children,
+            diagnostic_repeated_applied_pairs: self.diagnostic_repeated_applied_pairs,
+        }
+    }
+
+    fn record_run(
+        &mut self,
+        run_id: i64,
+        arm: i32,
+        state: &crate::simulator::replay_frontier::RunState,
+    ) {
+        use crate::simulator::replay_frontier::{self, RequestOutcome, WINDOW};
+        let diagnostic = replay_frontier::diagnostic(run_id, state);
+        let repeated = state.outcome == RequestOutcome::Applied
+            && state.request.as_ref().is_some_and(|request| {
+                let bit = 1u8 << request.offer_index;
+                request.applied_pairs.fetch_or(bit, Ordering::Relaxed) & bit != 0
+            });
+        self.update(arm, |c| {
+            c.filled_prefix_children += u64::from(state.filled_prefix);
+            c.applied_pair_repeats += u64::from(repeated);
+            c.proposed += state.proposed;
+            c.duplicates += state.duplicates;
+            c.evicted += state.evicted;
+            c.max_in_progress_bytes_per_run = c
+                .max_in_progress_bytes_per_run
+                .max(state.metadata_peak.max(state.owned_bytes()) as u64);
+            if let Some(d) = diagnostic.as_ref() {
+                c.assigned_requests += 1;
+                c.stock_mismatch += u64::from(d.stock_mismatch);
+                match d.outcome {
+                    RequestOutcome::Applied => c.applied_runs += 1,
+                    RequestOutcome::PassedBoundary => c.passed_boundary += 1,
+                    RequestOutcome::Missing => c.missing += 1,
+                    RequestOutcome::Ambiguous => c.ambiguous += 1,
+                    RequestOutcome::Ineligible => c.ineligible += 1,
+                    RequestOutcome::AlreadyChosen => c.already_chosen += 1,
+                    RequestOutcome::Unencountered => c.unencountered += 1,
+                }
+                if d.outcome == RequestOutcome::Applied {
+                    let complete = usize::from(d.parent_steps) == WINDOW
+                        && usize::from(d.child_steps) == WINDOW;
+                    c.complete_windows += u64::from(complete);
+                    c.no_common_node += u64::from(d.common_node.is_none());
+                    c.censored_runs += u64::from(!complete || d.common_node.is_none());
+                    c.divergent_runs += u64::from(d.divergent);
+                    c.usable_suffix_runs +=
+                        u64::from(d.remaining_cap >= 32 && usize::from(d.child_steps) >= WINDOW);
+                    c.child_steps_sum += u64::from(d.child_steps);
+                    c.parent_steps_sum += u64::from(d.parent_steps);
+                    let bin = match d.remaining_cap {
+                        ..=-1 => 0,
+                        0..=7 => 1,
+                        8..=31 => 2,
+                        32..=63 => 3,
+                        64..=127 => 4,
+                        _ => 5,
+                    };
+                    c.remaining_cap_hist[bin] += 1;
+                }
+            }
+        });
+        if let (Some(request), Some(diagnostic)) = (state.request.as_ref(), diagnostic) {
+            let Some(parent) = self.parents.get_mut(&(arm, request.parent_run_id)) else {
+                self.dropped_child_rows += 1;
+                return;
+            };
+            if parent.children.len()
+                >= crate::simulator::replay_corpus::CHILDREN_PER_PARENT as usize
+            {
+                self.dropped_child_rows += 1;
+                return;
+            }
+            if diagnostic.outcome == RequestOutcome::Applied {
+                self.diagnostic_applied_children += 1;
+                self.diagnostic_repeated_applied_pairs +=
+                    u64::from(parent.children.iter().any(|d| {
+                        d.outcome == RequestOutcome::Applied && d.pair == diagnostic.pair
+                    }));
+            }
+            parent.children.push(diagnostic);
+        }
+    }
+
+    fn record_parent(
+        &mut self,
+        run_id: i64,
+        arm: i32,
+        offers: &[crate::simulator::replay_frontier::Offer],
+        original: usize,
+        retained: usize,
+        metadata_bytes: usize,
+    ) {
+        let max_offer_bytes = offers.iter().map(|o| o.owned_bytes()).max().unwrap_or(0);
+        let max_nodes = offers
+            .iter()
+            .map(|o| o.reference.nodes.len())
+            .max()
+            .unwrap_or(0);
+        self.update(arm, |c| {
+            c.parents += 1;
+            c.signal_cut_parents += 1;
+            c.parents_with_offer += u64::from(!offers.is_empty());
+            c.cumulative_retained_words += retained as u64;
+            c.cumulative_original_cut_words += original as u64;
+            c.max_offers_per_parent = c.max_offers_per_parent.max(offers.len() as u64);
+            c.max_metadata_bytes_per_parent =
+                c.max_metadata_bytes_per_parent.max(metadata_bytes as u64);
+            c.max_offer_owned_bytes = c.max_offer_owned_bytes.max(max_offer_bytes as u64);
+            c.max_parent_nodes = c.max_parent_nodes.max(max_nodes as u64);
+        });
+        if self.parents.len() < crate::simulator::replay_frontier::MAX_DIAGNOSTICS {
+            self.parents.insert(
+                (arm, run_id),
+                FrontierParentDiagnostic {
+                    parent_run_id: run_id,
+                    arm_index: arm,
+                    offer_count: offers.len(),
+                    original_words: original,
+                    retained_words: retained,
+                    metadata_bytes,
+                    max_nodes,
+                    max_offer_owned_bytes: max_offer_bytes,
+                    children: Vec::new(),
+                },
+            );
+        } else {
+            self.dropped_parent_rows += 1;
+        }
+    }
+
+    fn record_live(&mut self, arm: i32, retained: usize, original: usize) {
+        let c = self.by_arm.entry(arm).or_default();
+        c.actual_live_retained_words = retained as u64;
+        c.actual_live_original_cut_words = original as u64;
+        c.peak_live_retained_words = c.peak_live_retained_words.max(retained as u64);
+        c.peak_live_original_cut_words = c.peak_live_original_cut_words.max(original as u64);
+        self.totals.actual_live_retained_words = self
+            .by_arm
+            .values()
+            .map(|c| c.actual_live_retained_words)
+            .sum();
+        self.totals.actual_live_original_cut_words = self
+            .by_arm
+            .values()
+            .map(|c| c.actual_live_original_cut_words)
+            .sum();
+        self.totals.peak_live_retained_words = self
+            .totals
+            .peak_live_retained_words
+            .max(self.totals.actual_live_retained_words);
+        self.totals.peak_live_original_cut_words = self
+            .totals
+            .peak_live_original_cut_words
+            .max(self.totals.actual_live_original_cut_words);
+    }
+}
+
+static REPLAY_FRONTIER: LazyLock<Mutex<FrontierState>> =
+    LazyLock::new(|| Mutex::new(FrontierState::default()));
+
+pub fn record_frontier_run(
+    run_id: i64,
+    arm_index: i32,
+    state: &crate::simulator::replay_frontier::RunState,
+) {
+    if !enabled() {
+        return;
+    }
+    REPLAY_FRONTIER
+        .lock()
+        .unwrap_or_else(|p| p.into_inner())
+        .record_run(run_id, arm_index, state);
+}
+
+pub fn record_frontier_parent(
+    run_id: i64,
+    arm_index: i32,
+    offers: &[crate::simulator::replay_frontier::Offer],
+    original_words: usize,
+    retained_words: usize,
+    metadata_bytes: usize,
+) {
+    if !enabled() {
+        return;
+    }
+    REPLAY_FRONTIER
+        .lock()
+        .unwrap_or_else(|p| p.into_inner())
+        .record_parent(
+            run_id,
+            arm_index,
+            offers,
+            original_words,
+            retained_words,
+            metadata_bytes,
+        );
+}
+
+pub fn record_frontier_live(arm_index: i32, retained: usize, original: usize) {
+    if !enabled() {
+        return;
+    }
+    REPLAY_FRONTIER
+        .lock()
+        .unwrap_or_else(|p| p.into_inner())
+        .record_live(arm_index, retained, original);
+}
