+fn retarget_preview<H: HashPolicy>(state: &State<H>, planned: NodeId, servers: usize) -> NodeId {
+    if state.retarget.enabled
+        && let ghost_absorber::Choice::Retarget { node, .. } =
+            absorber_decision(state, planned, servers).choice
+    {
+        NodeId {
+            role: planned.role,
+            index: node,
+        }
+    } else {
+        planned
+    }
+}
+
+fn touch_node<H: HashPolicy>(state: &State<H>, r: &Runnable<H>, servers: usize) -> Option<NodeId> {
+    match r {
+        Runnable::Crash { node_id, .. } => Some(retarget_preview(state, *node_id, servers)),
+        _ => r.node(),
+    }
+}
+
+fn event_key<H: HashPolicy>(
+    state: &State<H>,
+    r: &Runnable<H>,
+    servers: usize,
+) -> Option<crate::simulator::replay_frontier::EventKey> {
+    use crate::simulator::replay_frontier::EventKey;
+    match r {
+        Runnable::Record(r) => Some(EventKey {
+            kind: if r.origin_node != r.node && r.pc == r.entry_pc {
+                0
+            } else {
+                1
+            },
+            node: r.node,
+            origin: r.origin_node,
+            incarnation: r.origin_incarnation,
+            ordinal: r.send_ordinal,
+            pc: r.pc,
+            entry_pc: r.entry_pc,
+            link: r.link_seq.map(|(link, seq)| (link.0, seq)),
+        }),
+        Runnable::Crash { node_id, .. } | Runnable::Recover { node_id, .. } => {
+            let victim = if matches!(r, Runnable::Crash { .. }) {
+                retarget_preview(state, *node_id, servers)
+            } else {
+                *node_id
+            };
+            Some(EventKey {
+                kind: if matches!(r, Runnable::Crash { .. }) {
+                    2
+                } else {
+                    3
+                },
+                node: *node_id,
+                origin: victim,
+                incarnation: state.incarnation(*node_id),
+                ordinal: state.incarnation(victim),
+                pc: 0,
+                entry_pc: 0,
+                link: None,
+            })
+        }
+        _ => None,
+    }
+}
+
+fn dependent(
+    a: crate::simulator::replay_frontier::EventKey,
+    b: crate::simulator::replay_frontier::EventKey,
+) -> bool {
+    (a.kind == 0 && b.kind == 0 && a.node == b.node)
+        || (a.kind >= 2 && b.kind <= 1 && a.origin == b.node)
+        || (b.kind >= 2 && a.kind <= 1 && b.origin == a.node)
+}
+
+fn slot_runnable<H: HashPolicy>(state: &State<H>, slot: QueueSlot) -> &Runnable<H> {
+    match slot {
+        QueueSlot::Local(n, i) => &state.local_queues[n][i],
+        QueueSlot::Network(i) => &state.network_queue[i],
+        QueueSlot::Timer(i) => &state.timer_queue[i],
+    }
+}
+
+fn frontier_slots<H: HashPolicy>(state: &State<H>) -> impl Iterator<Item = QueueSlot> + '_ {
+    state
+        .local_queues
+        .iter()
+        .enumerate()
+        .flat_map(|(n, q)| (0..q.len()).map(move |i| QueueSlot::Local(n, i)))
+        .chain((0..state.network_queue.len()).map(QueueSlot::Network))
+}
+
+fn queue_class(slot: QueueSlot) -> u8 {
+    match slot {
+        QueueSlot::Local(..) => 0,
+        QueueSlot::Network(..) => 1,
+        QueueSlot::Timer(..) => 2,
+    }
+}
+
+fn write_window<H: HashPolicy>(state: &State<H>) -> crate::simulator::replay_frontier::WriteWindow {
+    crate::simulator::replay_frontier::WriteWindow::new(state, |i| state.replay_frontier.node_id(i))
+}
+
+fn frontier_choice<H: HashPolicy>(
+    state: &mut State<H>,
+    servers: usize,
+    is_ineligible: &impl Fn(&Runnable<H>) -> bool,
+    network_eligible: &[usize],
+    stock: QueueSlot,
+    position: Option<usize>,
+    replay_position: Option<(usize, usize)>,
+) -> QueueSlot {
+    use crate::simulator::replay_frontier::{Offer, RequestOutcome, ordered_pair, private_hash};
+    let legal = |slot: QueueSlot| {
+        !is_ineligible(slot_runnable(state, slot))
+            && match slot {
+                QueueSlot::Network(i) => network_preview(state, network_eligible, i) == i,
+                QueueSlot::Local(..) => true,
+                QueueSlot::Timer(..) => false,
+            }
+    };
+    let stock_key = event_key(state, slot_runnable(state, stock), servers);
+    if let Some(request) = state.replay_frontier.request.as_ref()
+        && !state.replay_frontier.attempted
+    {
+        let target = request.offer.tape_pos;
+        if position.is_some_and(|p| p >= target) {
+            let selected = request.offer.selected;
+            let alternative = request.offer.alternative;
+            let (outcome, alternative_slot) =
+                if position != Some(target) || replay_position != Some((target, target)) {
+                    (RequestOutcome::PassedBoundary, None)
+                } else {
+                    let mut counts = [0usize; 2];
+                    let mut slots = [None; 2];
+                    for slot in frontier_slots(state) {
+                        if let Some(key) = event_key(state, slot_runnable(state, slot), servers) {
+                            for (i, saved) in [selected, alternative].iter().enumerate() {
+                                if key == *saved {
+                                    counts[i] += 1;
+                                    slots[i] = Some(slot);
+                                }
+                            }
+                        }
+                    }
+                    if counts.contains(&0) {
+                        (RequestOutcome::Missing, None)
+                    } else if counts.iter().any(|n| *n != 1) {
+                        (RequestOutcome::Ambiguous, None)
+                    } else if !slots.iter().all(|s| legal(s.unwrap()))
+                        || !dependent(selected, alternative)
+                    {
+                        (RequestOutcome::Ineligible, None)
+                    } else if stock_key == Some(alternative) {
+                        (RequestOutcome::AlreadyChosen, None)
+                    } else {
+                        (RequestOutcome::Applied, slots[1])
+                    }
+                };
+            let window = (outcome == RequestOutcome::Applied).then(|| write_window(state));
+            let remaining = state.replay_frontier.effective_cap - state.crash_info.current_step;
+            let frontier = &mut state.replay_frontier;
+            frontier.attempted = true;
+            frontier.outcome = outcome;
+            frontier.stock_mismatch = stock_key != Some(selected);
+            frontier.stock_event = stock_key;
+            frontier.final_event = if alternative_slot.is_some() {
+                Some(alternative)
+            } else {
+                stock_key
+            };
+            frontier.stock_queue = queue_class(stock);
+            frontier.final_queue = queue_class(alternative_slot.unwrap_or(stock));
+            frontier.remaining_cap = remaining;
+            frontier.child_window = window;
+            return alternative_slot.unwrap_or(stock);
+        }
+    }
+    if !state.replay_frontier.capture || state.replay_cut.is_none() {
+        return stock;
+    }
+    let Some(position) = position else {
+        return stock;
+    };
+    let Some(selected) = stock_key else {
+        return stock;
+    };
+    if !legal(stock) {
+        return stock;
+    }
+    let count_key = |key| {
+        frontier_slots(state)
+            .filter(|s| event_key(state, slot_runnable(state, *s), servers) == Some(key))
+            .count()
+    };
+    if count_key(selected) != 1 {
+        return stock;
+    }
+    let mut best = None;
+    for slot in frontier_slots(state) {
+        let Some(key) = event_key(state, slot_runnable(state, slot), servers) else {
+            continue;
+        };
+        if key == selected || !dependent(selected, key) || !legal(slot) || count_key(key) != 1 {
+            continue;
+        }
+        let rank = private_hash(
+            state.replay_frontier.seed,
+            &(state.crash_info.current_step, ordered_pair(selected, key)),
+        );
+        if best.is_none_or(|(r, k)| (rank, key) < (r, k)) {
+            best = Some((rank, key));
+        }
+    }
+    if let Some((_, alternative)) = best {
+        let pair = ordered_pair(selected, alternative);
+        let rank = private_hash(state.replay_frontier.seed, &pair);
+        // Stable pair priorities prevent an evicted pair from returning to the bounded reservoir.
+        let wanted = !state
+            .replay_frontier
+            .offers
+            .iter()
+            .any(|o| o.pair() == pair)
+            && (state.replay_frontier.offers.len() < crate::simulator::replay_frontier::MAX_OFFERS
+                || state
+                    .replay_frontier
+                    .offers
+                    .iter()
+                    .any(|o| (rank, pair) < (o.rank, o.pair())));
+        if wanted {
+            if state.replay_frontier.offers.len() == crate::simulator::replay_frontier::MAX_OFFERS {
+                let idx = state
+                    .replay_frontier
+                    .offers
+                    .iter()
+                    .enumerate()
+                    .max_by_key(|(_, o)| (o.rank, o.pair()))
+                    .unwrap()
+                    .0;
+                state.replay_frontier.offers.remove(idx);
+                state.replay_frontier.evicted += 1;
+            }
+            let reference = write_window(state);
+            state.replay_frontier.retain(Offer {
+                tape_pos: position,
+                step: state.crash_info.current_step,
+                selected,
+                alternative,
+                rank,
+                reference,
+            });
+        } else {
+            state.replay_frontier.proposed += 1;
+            state.replay_frontier.duplicates += u64::from(
+                state
+                    .replay_frontier
+                    .offers
+                    .iter()
+                    .any(|o| o.pair() == pair),
+            );
+        }
+    }
+    stock
+}
