+/// `arm_index` the campaign arm the run's cell belongs to.
+pub fn record_arm_selector_observation(
+    treated: bool,
+    arms: &run_variant::ArmSet,
+    reward: bool,
+    no_keys: bool,
+    arm_index: i32,
+) {
+    if !enabled() {
+        return;
+    }
+    AX_OBSERVATIONS.fetch_add(1, Ordering::Relaxed);
+    if no_keys {
+        AX_RUNS_WITHOUT_KEYS.fetch_add(1, Ordering::Relaxed);
+    }
+    let slot = ((arm_index + 1).max(0) as usize).min(AX_ARM_SLOTS - 1);
+    AX_REWARD_RUNS_BY_ARM[slot].fetch_add(1, Ordering::Relaxed);
+    if reward {
+        AX_REWARD_POSITIVE_BY_ARM[slot].fetch_add(1, Ordering::Relaxed);
+    }
+    let half = treated as usize;
+    AX_REWARD_RUNS[half].fetch_add(1, Ordering::Relaxed);
+    if reward {
+        AX_REWARD_POSITIVE[half].fetch_add(1, Ordering::Relaxed);
+    }
+    if treated {
+        return;
+    }
+    for d in arms.directions() {
+        AX_CONTROL_RUNS_BY_DIRECTION[d].fetch_add(1, Ordering::Relaxed);
+        if reward {
+            AX_CONTROL_REWARD_POSITIVE_BY_DIRECTION[d].fetch_add(1, Ordering::Relaxed);
+        }
+    }
+    let c = arms.index();
+    AX_CONTROL_RUNS_BY_COMBINATION[c].fetch_add(1, Ordering::Relaxed);
+    if reward {
