+pub fn record_arm_selector_treated_run(
+    chosen: Option<&run_variant::ArmSet>,
+    coins: &run_variant::ArmSet,
+    leader_agreements: u64,
+) {
+    if !enabled() {
+        return;
+    }
+    AX_TREATED_RUNS.fetch_add(1, Ordering::Relaxed);
