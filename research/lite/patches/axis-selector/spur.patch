+    if arms != coins {
+        AX_DEPARTURES.fetch_add(1, Ordering::Relaxed);
+    }
+    if arms.placed() {
+        AX_CHOSEN_PLACED_RUNS.fetch_add(1, Ordering::Relaxed);
+    }
+    for d in arms.directions() {
+        AX_CHOSEN_BY_DIRECTION[d].fetch_add(1, Ordering::Relaxed);
+    }
+    AX_CHOSEN_BY_COMBINATION[arms.index()].fetch_add(1, Ordering::Relaxed);
