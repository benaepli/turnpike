+            V::int(-1),
+            V::int(-42),
+            V::int(7),
+            V::bool(true),
+            V::bool(false),
+            V::unit(),
+            s(""),
+            s("plain"),
+            s("with \"quotes\""),
+            s("back\\slash"),
+            s("new\nline\ttab\r"),
+            s("control \u{0}\u{1}\u{1f}\u{7f}"),
+            s("unicode \u{e9}\u{4e2d}\u{1f600}"),
+            V::node(node(0, 0)),
+            V::node(node(usize::MAX, 17)),
+            V::channel(ChannelId {
