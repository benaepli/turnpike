+        let mut appended = String::from("prefix|");
+        v.write_to(&mut appended).unwrap();
+        assert_eq!(appended, format!("prefix|{expected}"), "{v:?}");
+        assert_eq!(v.to_string(), expected, "{v:?}");
+        assert_eq!(format!("<{v}>"), format!("<{expected}>"), "{v:?}");
+    }
