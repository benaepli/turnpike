+        let s = |t: &str| V::string(EcoString::from(t));
+        let seq = |items: Vec<V>| ValueSeq::from(items);
+        let map = |entries: Vec<(V, V)>| {
+            let mut m = ValueMap::<WithHashing>::default();
+            for (k, v) in entries {
+                m.insert(k, v);
+            }
