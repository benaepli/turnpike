+        leaf(prefix, "lag_p90", *lag_p90),
+        leaf(prefix, "scopes_engaged", *scopes_engaged),
+    ];
+    for (name, cell) in [
+        ("untreated", untreated),
+        ("release_all", release_all),
+        ("single", single_cell),
+        ("treated", treated),
