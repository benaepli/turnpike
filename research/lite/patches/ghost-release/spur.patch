+        untreated,
+        release_all,
+        single: single_cell,
+        treated,
+    } = cells;
+    let GhostReleaseSingleStats {
+        releases,
+        released_own_crash,
+        released_via_ranking,
+        released_forced,
+        no_release_case,
+        cells: single_cells,
