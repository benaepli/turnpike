+/// What one firing released: how many holds moved and, over the first 64
+/// nodes, whose.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+struct Released {
+    count: u64,
+    mask: u64,
+}
+
+fn node_bit(n: usize) -> u64 {
+    if n < u64::BITS as usize {
+        1u64 << n
+    } else {
+        0
+    }
+}
