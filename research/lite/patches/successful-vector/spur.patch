+/// One rewarded run a cell remembers: its arm set by `ArmSet::index` and
+/// the cell's observation count when the run was credited.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Success {
+    at: u64,
+    arms: u8,
+}
+
+/// The rewarded runs a cell's learner resamples from, in credit order, and
+/// the distribution a supported draw samples from them.
+struct Population {
+    entries: [Success; POPULATION_CAPACITY],
+    /// Slot of the oldest live entry; the live entries follow it in credit
+    /// order, wrapping at the capacity.
+    head: usize,
+    live: usize,
+    /// Live entries per arm set, by `ArmSet::index`.
+    multiplicity: [u8; COMBINATIONS],
+    distinct: usize,
+    /// How many live entries carry the most repeated arm set.
+    top_multiplicity: usize,
+    /// The probability that a mutation lands on each axis, refreshed from
+    /// the posteriors every `WARMUP_OBSERVATIONS` credits; uniform until
+    /// the first refresh.
+    axis_weights: [f64; AXES],
+    /// Mass per arm set, by `ArmSet::index`, of one parent drawn uniformly
+    /// from the live entries and changed on one axis. Rebuilt whenever the
+    /// entries or the axis weights change, so it is current whenever the
+    /// population is supported.
+    mixture: [f64; COMBINATIONS],
+    /// The mass the mixture holds. Below one when a parent's axis has no
+    /// other direction with a positive coin share; the draw then samples
+    /// the mass that remains.
+    mixture_total: f64,
+    /// Draws served from this population while it was supported.
+    supported_draws: AtomicU64,
+}
+
+impl Population {
+    fn new() -> Self {
+        Self {
+            entries: [Success { at: 0, arms: 0 }; POPULATION_CAPACITY],
+            head: 0,
+            live: 0,
+            multiplicity: [0; COMBINATIONS],
+            distinct: 0,
+            top_multiplicity: 0,
+            axis_weights: [1.0 / AXES as f64; AXES],
+            mixture: [0.0; COMBINATIONS],
+            mixture_total: 0.0,
+            supported_draws: AtomicU64::new(0),
+        }
+    }
+
+    fn supported(&self) -> bool {
+        self.live >= POPULATION_SUPPORT_ENTRIES && self.distinct >= POPULATION_SUPPORT_DISTINCT
+    }
+
+    /// The live entries, oldest first.
+    fn entries(&self) -> impl Iterator<Item = Success> + '_ {
+        (0..self.live).map(move |i| self.entries[(self.head + i) % POPULATION_CAPACITY])
+    }
+
+    fn census(&self) -> PopulationCensus {
+        PopulationCensus {
+            live: self.live,
+            distinct: self.distinct,
+            top_multiplicity: self.top_multiplicity,
+        }
+    }
+
+    /// Drops the entries older than the age limit at observation `now`
+    /// and says whether any went. Entries sit in credit order, so the
+    /// oldest is always at the head.
+    fn expire(&mut self, now: u64) -> bool {
+        let mut dropped = false;
+        while self.live > 0 && now - self.entries[self.head].at > POPULATION_AGE_LIMIT {
+            self.head = (self.head + 1) % POPULATION_CAPACITY;
+            self.live -= 1;
+            dropped = true;
+        }
+        if dropped {
+            self.recount();
+        }
+        dropped
+    }
+
+    /// Appends a rewarded arm set credited at observation `now`, dropping
+    /// the oldest entry when the population is full.
+    fn insert(&mut self, arms: u8, now: u64) {
+        if self.live == POPULATION_CAPACITY {
+            self.head = (self.head + 1) % POPULATION_CAPACITY;
+            self.live -= 1;
+        }
+        self.entries[(self.head + self.live) % POPULATION_CAPACITY] = Success { at: now, arms };
+        self.live += 1;
+        self.recount();
+    }
+
+    fn recount(&mut self) {
+        let mut multiplicity = [0u8; COMBINATIONS];
+        for s in self.entries() {
+            multiplicity[s.arms as usize] += 1;
+        }
+        self.multiplicity = multiplicity;
+        self.distinct = multiplicity.iter().filter(|&&m| m > 0).count();
+        self.top_multiplicity = multiplicity.iter().copied().max().unwrap_or(0) as usize;
+    }
+
+    /// Sums, over every live entry, every axis and every other direction
+    /// of that axis, the mass `(1 / live) * axis_weight * coin(d) / (sum of
+    /// the coin shares of the axis's other directions)` onto the arm set
+    /// that differs from the entry on that axis alone. Paths that reach
+    /// the same arm set add.
+    fn rebuild(&mut self, coins: &[f64; DIRECTIONS]) {
+        let mut mixture = [0.0f64; COMBINATIONS];
+        if self.live > 0 {
+            let per_parent = 1.0 / self.live as f64;
+            for s in self.entries() {
+                let parent = ArmSet::from_index(s.arms as usize).directions();
+                for a in 0..AXES {
+                    let weight = per_parent * self.axis_weights[a];
+                    if weight <= 0.0 {
+                        continue;
+                    }
+                    let range = AXIS_START[a]..AXIS_START[a + 1];
+                    let others: f64 =
+                        range.clone().filter(|&j| j != parent[a]).map(|j| coins[j]).sum();
+                    if others <= 0.0 {
+                        continue;
+                    }
+                    for d in range.filter(|&j| j != parent[a]) {
+                        let mut child = parent;
+                        child[a] = d;
+                        mixture[ArmSet::from_directions(child).index()] +=
+                            weight * coins[d] / others;
+                    }
+                }
+            }
+        }
+        self.mixture_total = mixture.iter().sum();
+        self.mixture = mixture;
+    }
+}
+
+/// The coin share of every direction, in direction order.
+fn coin_table() -> [f64; DIRECTIONS] {
+    std::array::from_fn(ArmSet::coin_probability)
+}
+
+/// The index at which the running sum of `p` first exceeds `u` times the
+/// total of `p`, taken in index order; the last index with positive mass
+/// when rounding carries the target past the sum, and index zero when no
+/// mass is positive.
+fn invert(p: &[f64; COMBINATIONS], u: f64) -> usize {
+    let total: f64 = p.iter().sum();
+    if total <= 0.0 {
+        return 0;
+    }
+    let target = u * total;
+    let mut acc = 0.0;
+    let mut last = 0;
+    for (i, &m) in p.iter().enumerate() {
+        if m <= 0.0 {
+            continue;
+        }
+        acc += m;
+        last = i;
+        if target < acc {
+            return i;
+        }
+    }
+    last
+}
