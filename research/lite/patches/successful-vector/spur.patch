+    #[test]
+    fn the_coupled_inversion_reads_both_distributions_in_one_order() {
+        for i in 0..COMBINATIONS {
+            assert_eq!(ArmSet::from_index(i).index(), i);
+        }
+        let mut p = [0.0f64; COMBINATIONS];
+        for (i, m) in p.iter_mut().enumerate() {
+            *m = (i + 1) as f64 / (COMBINATIONS * (COMBINATIONS + 1) / 2) as f64;
+        }
+        let q = p;
+        for u in [0.0, 0.1, 0.25, 0.5, 0.75, 0.999_999] {
+            assert_eq!(invert(&p, u), invert(&q, u), "u {u}");
+        }
+        assert_eq!(total_variation(&p, &q), 0.0);
+        assert_eq!(invert(&p, 0.0), 0);
+        assert_eq!(invert(&p, 0.999_999_999), COMBINATIONS - 1);
+        // A two-point distribution: the running sum passes one half at the
+        // second point, and a variate at exactly one half falls there.
+        let mut two = [0.0f64; COMBINATIONS];
+        two[3] = 0.5;
+        two[10] = 0.5;
+        assert_eq!(invert(&two, 0.4999), 3);
+        assert_eq!(invert(&two, 0.5), 10);
+        assert_eq!(invert(&two, 0.9999), 10);
+        assert_eq!(invert(&two, 1.0), 10, "past the sum, the last set with mass");
+        // Mass in a different scale inverts the same way.
+        let mut scaled = two;
+        scaled[3] = 2.0;
+        scaled[10] = 2.0;
+        assert_eq!(invert(&scaled, 0.4999), 3);
+        assert_eq!(invert(&scaled, 0.5), 10);
+        assert_eq!(invert(&[0.0; COMBINATIONS], 0.7), 0);
+        // Total variation and Hamming distance by hand.
+        let mut one_hot_3 = [0.0f64; COMBINATIONS];
+        one_hot_3[3] = 1.0;
+        let mut one_hot_10 = [0.0f64; COMBINATIONS];
+        one_hot_10[10] = 1.0;
+        assert_eq!(total_variation(&one_hot_3, &one_hot_10), 1.0);
+        assert_eq!(total_variation(&two, &one_hot_3), 0.5);
+        assert_eq!(hamming(&ArmSet::from_index(0), &ArmSet::from_index(COMBINATIONS - 1)), 5);
+        assert_eq!(
+            hamming(
+                &ArmSet::default(),
+                &ArmSet {
+                    retarget: true,
+                    ..ArmSet::default()
+                }
+            ),
+            1
+        );
+        assert_eq!(hamming(&ArmSet::default(), &ArmSet::default()), 0);
+        // Equal marginals give equal product and mixture comparisons only
+        // when the mixture equals the product; a fresh state's product
+        // inverts to the same set for the same variate twice.
+        let state = CellLearner::new();
+        for a in 0..AXES {
+            let m = state.marginal_distribution(a);
+            let width = AXIS_START[a + 1] - AXIS_START[a];
+            assert!((m[..width].iter().sum::<f64>() - 1.0).abs() < 1e-12);
+            assert_eq!(m[width..].iter().sum::<f64>(), 0.0);
+        }
+    }
