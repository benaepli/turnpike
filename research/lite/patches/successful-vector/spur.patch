+        assert_eq!(after.arm_selector_axis.reward_runs_treated - before.arm_selector_axis.reward_runs_treated, 4);
+        assert_eq!(after.arm_selector_axis.reward_positive_treated - before.arm_selector_axis.reward_positive_treated, 2);
+        reset();
+    }
+
+    #[test]
+    fn populations_stay_with_their_cell_and_die_with_the_tables() {
+        let _serial = config_override::exclusive_session();
+        fault_timing::reset();
+        util_stats::set_enabled(true);
+        reset();
+        let shared = cell(0, 5);
+        let own = cell(4, -1);
+        let arms = ArmSet::from_index(30);
+        let id = unprobed_id();
+        for i in 0..10 {
+            observe(
+                i % 2,
+                shared,
+                id,
+                &coin(arms),
+                &Rewards {
+                    cycle_before_request: true,
+                    ..rewarded(true, true)
+                },
+            );
+        }
+        for _ in 0..3 {
+            observe(4, own, id, &coin(arms), &rewarded(false, false));
+        }
+        for l in Learner::ALL {
+            let cells = &CELLS[l.index()];
+            assert_eq!(cells.len(), 2, "{l:?}");
+            assert_eq!(cells.get(&shared).unwrap().population.live, 10, "{l:?}: the shared cell");
+            assert_eq!(cells.get(&own).unwrap().population.live, 0, "{l:?}: the arm's own cell");
+            assert_eq!(cells.get(&own).unwrap().observations, 3);
+        }
+        let snapshot = util_stats::snapshot().arm_selector_population;
+        assert_eq!(snapshot.cells_created, 6);
+        assert_eq!(snapshot.layout_bytes, vec![cell_bytes() as u64, population_bytes() as u64]);
+        assert!(population_bytes() < cell_bytes());
+        assert_eq!(snapshot.storage_bytes, 6 * cell_bytes() as u64);
+        assert_eq!(snapshot.population_storage_bytes, 6 * population_bytes() as u64);
+        eprintln!("cell {} bytes, population {} bytes", cell_bytes(), population_bytes());
+        // The tables and their gauges go together; a new session starts
+        // its populations empty.
+        reset();
+        for l in Learner::ALL {
+            assert!(CELLS[l.index()].is_empty(), "{l:?}");
+        }
+        let cleared = util_stats::snapshot().arm_selector_population;
+        assert_eq!(cleared.cells_created, 0);
+        assert_eq!(cleared.storage_bytes, 0);
+        assert_eq!(cleared.population_storage_bytes, 0);
+        observe(0, shared, id, &coin(arms), &rewarded(true, true));
+        assert_eq!(CELLS[0].get(&shared).unwrap().population.live, 1);
+        assert_eq!(util_stats::snapshot().arm_selector_population.cells_created, 3);
+        util_stats::set_enabled(false);
+        reset();
+    }
 }
