+    /// Coin-drawn runs cycling six arm sets, rewarded for every learner
+    /// exactly when the set carries the pair-order direction: four of the
+    /// six sets are rewarded, so the population holds four distinct sets
+    /// and the pair-order axis is decided.
+    fn support_pair_order(cell: Cell) {
+        let id = unprobed_id();
+        for i in 0..120usize {
+            let arms = ArmSet::from_index([0, 3, 30, 71, 27, 39][i % 6]);
+            let reward = arms.pair_order;
+            observe(
+                cell.0,
+                cell,
+                id,
+                &coin(arms),
+                &Rewards {
+                    cycle_before_request: reward,
+                    ..rewarded(reward, reward)
+                },
+            );
+        }
+    }
