+    #[test]
+    fn a_population_run_is_scored_by_its_own_reward_whatever_its_cell_does_later() {
+        let _serial = config_override::exclusive_session();
+        fault_timing::reset();
+        util_stats::set_enabled(true);
+        reset();
+        let cell = (11, 11);
+        let a = Learner::OvertakenGhost;
+        let arms = ArmSet::from_index(3);
+        let choice = population_drawn(arms, a);
+        let before = util_stats::snapshot();
+        let completed = |s: &util_stats::UtilizationSnapshot| {
+            let p = &s.arm_selector_population;
+            (
+                p.supported_completed_runs_by_learner[0] - before.arm_selector_population.supported_completed_runs_by_learner[0],
+                p.supported_successful_runs_by_learner[0] - before.arm_selector_population.supported_successful_runs_by_learner[0],
+            )
+        };
+        // The marker alone routes the outcome; the cell need not hold a
+        // supported population, or exist.
+        observe(cell.0, cell, assigned_id(a), &choice, &rewarded(false, true));
+        assert_eq!(completed(&util_stats::snapshot()), (1, 0));
+        // A population of rewarded copies of the set does not lend the run
+        // its reward.
+        feed(cell, 10, &arms, true);
