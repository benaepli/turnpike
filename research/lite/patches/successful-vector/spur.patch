+    #[test]
+    fn the_mixture_is_the_enumerated_parent_axis_replacement_sum() {
+        let mut pop = Population::new();
+        for (i, arms) in [0u8, 0, 5, 71, 0, 5, 30, 66].iter().enumerate() {
+            pop.insert(*arms, i as u64 + 1);
+        }
+        assert!(pop.supported());
+        assert_eq!((pop.live, pop.distinct, pop.top_multiplicity), (8, 5, 3));
+        let weights = [0.4, 0.05, 0.0, 0.25, 0.3];
+        pop.axis_weights = weights;
+        let coins = [0.6, 0.3, 0.1, 0.5, 0.5, 0.2, 0.8, 0.35, 0.65, 0.5, 0.25, 0.25];
+        pop.rebuild(&coins);
+        // Enumerate every parent, axis and replacement by hand.
+        let mut want = [0.0f64; COMBINATIONS];
+        for s in pop.entries() {
+            let parent = ArmSet::from_index(s.arms as usize).directions();
+            for a in 0..AXES {
+                let range = AXIS_START[a]..AXIS_START[a + 1];
+                let others: f64 = range.clone().filter(|&j| j != parent[a]).map(|j| coins[j]).sum();
+                for d in range.filter(|&j| j != parent[a]) {
+                    let mut child = parent;
+                    child[a] = d;
+                    want[ArmSet::from_directions(child).index()] +=
+                        weights[a] / 8.0 * coins[d] / others;
+                }
+            }
+        }
+        for i in 0..COMBINATIONS {
+            assert!((pop.mixture[i] - want[i]).abs() < 1e-12, "set {i}: {} against {}", pop.mixture[i], want[i]);
+            assert!(pop.mixture[i].is_finite() && pop.mixture[i] >= 0.0);
+        }
+        let total: f64 = pop.mixture.iter().sum();
+        assert!((total - 1.0).abs() < 1e-12, "mass {total}");
+        assert!((pop.mixture_total - 1.0).abs() < 1e-12);
+        // Every set with mass is one axis away from a live entry, and no
+        // set differs from every entry only on the axis with no weight.
+        for i in 0..COMBINATIONS {
+            if pop.mixture[i] > 0.0 {
+                let set = ArmSet::from_index(i);
+                assert!(
+                    pop.entries().any(|s| hamming(&set, &ArmSet::from_index(s.arms as usize)) == 1),
+                    "set {i} carries mass but is no neighbour"
+                );
+            }
+        }
+        let fresh_first_only = ArmSet::from_directions([0, 3, 6, 8, 11]);
+        assert_eq!(fresh_first_only.index(), 11);
+        assert_eq!(pop.mixture[11], 0.0, "reachable only over the axis with no weight");
+        // Two parents reach one child: three entries of set 0 over the
+        // pair-order axis and two entries of set 5 over the request axis.
+        let shared_child = ArmSet::from_directions([0, 3, 5, 8, 9]);
+        assert_eq!(shared_child.index(), 3);
+        let from_zero = 3.0 / 8.0 * weights[3] * coins[8] / coins[8];
+        let from_five = 2.0 / 8.0 * weights[4] * coins[9] / (coins[9] + coins[10]);
+        assert!((pop.mixture[3] - (from_zero + from_five)).abs() < 1e-12);
+        assert!((from_zero + from_five - 0.14375).abs() < 1e-12);
+        // A parent's axis without another direction of positive coin share
+        // contributes nothing on that axis; the mass that remains is
+        // what a draw samples, and every draw lands on a set with mass.
+        let mut no_placed = coins;
+        no_placed[1] = 0.0;
+        no_placed[2] = 0.0;
+        pop.rebuild(&no_placed);
+        let stock_parents = pop.entries().filter(|s| ArmSet::from_index(s.arms as usize).crash == CrashArm::Stock).count();
+        assert_eq!(stock_parents, 5);
+        let want_total = 1.0 - weights[0] * stock_parents as f64 / 8.0;
+        assert!((pop.mixture_total - want_total).abs() < 1e-12, "{} against {want_total}", pop.mixture_total);
+        for u in [0.0, 0.3, 0.5, 0.999_999] {
+            let i = invert(&pop.mixture, u);
+            assert!(pop.mixture[i] > 0.0, "u {u} landed on set {i} without mass");
+        }
+    }
