+/// Half the absolute difference of two distributions, summed.
+fn total_variation(p: &[f64; COMBINATIONS], q: &[f64; COMBINATIONS]) -> f64 {
+    0.5 * p.iter().zip(q).map(|(x, y)| (x - y).abs()).sum::<f64>()
+}
+
+/// The axes on which two arm sets differ.
+fn hamming(a: &ArmSet, b: &ArmSet) -> usize {
+    a.directions().iter().zip(b.directions()).filter(|(x, y)| *x != y).count()
+}
