+    /// The distribution `sample_axis_leading` draws from on axis `a`,
+    /// normalized to one; the first direction alone when no weight is
+    /// positive, where `pick` falls back to it.
+    fn marginal_distribution(&self, a: usize) -> [f64; 3] {
+        let range = AXIS_START[a]..AXIS_START[a + 1];
+        let mut weights = self.leading_probability(a);
+        for (slot, d) in range.clone().enumerate() {
+            weights[slot] *= ArmSet::coin_probability(d);
+        }
+        let total: f64 = weights[..range.len()].iter().sum();
+        if total <= 0.0 {
+            let mut first = [0.0; 3];
+            first[0] = 1.0;
+            return first;
+        }
+        weights.map(|w| w / total)
+    }
+
+    /// The probability that a population draw changes each axis: the
+    /// Shannon entropy of the axis's leading probabilities, normalized
+    /// within the axis first, then the five entropies normalized to one.
+    /// A direction with no leading probability contributes nothing, an
+    /// axis with none has no entropy, and when no axis has any the axes
+    /// are equally likely.
+    fn mutation_axis_weights(&self) -> [f64; AXES] {
+        let mut entropy = [0.0f64; AXES];
+        for (a, h) in entropy.iter_mut().enumerate() {
+            let width = AXIS_START[a + 1] - AXIS_START[a];
+            let leading = self.leading_probability(a);
+            let total: f64 = leading[..width].iter().sum();
+            if total <= 0.0 {
+                continue;
+            }
+            *h = leading[..width]
+                .iter()
+                .filter(|&&p| p > 0.0)
+                .map(|&p| {
+                    let q = p / total;
+                    -q * q.ln()
+                })
+                .sum();
+        }
+        let total: f64 = entropy.iter().sum();
+        if total > 0.0 { entropy.map(|h| h / total) } else { [1.0 / AXES as f64; AXES] }
+    }
+
+    /// The arm set of a supported learner draw at unit variate `u`, with
+    /// what is recorded about it. The draw inverts the cached mixture's
+    /// distribution function in `ArmSet::index` order. For observation
+    /// only, the same variate inverts, in the same order, the product of
+    /// the marginal distributions the independent pick uses now, so two
+    /// equal distributions give one tuple, and the total variation between
+    /// the two distributions is read off directly.
+    fn population_draw(&self, u: f64) -> (ArmSet, SupportedDraw) {
+        let pop = &self.population;
+        let mut joint = pop.mixture;
+        if pop.mixture_total > 0.0 {
+            for m in &mut joint {
+                *m /= pop.mixture_total;
+            }
+        }
+        let marginals: [[f64; 3]; AXES] = std::array::from_fn(|a| self.marginal_distribution(a));
+        let mut product = [0.0f64; COMBINATIONS];
+        for (i, p) in product.iter_mut().enumerate() {
+            let d = ArmSet::from_index(i).directions();
+            *p = (0..AXES).map(|a| marginals[a][d[a] - AXIS_START[a]]).product();
+        }
+        let actual = ArmSet::from_index(invert(&joint, u));
+        let comparison = ArmSet::from_index(invert(&product, u));
+        let draw = SupportedDraw {
+            hamming: hamming(&actual, &comparison),
+            total_variation: total_variation(&joint, &product),
+            axis_mass: pop.axis_weights,
+        };
+        (actual, draw)
+    }
