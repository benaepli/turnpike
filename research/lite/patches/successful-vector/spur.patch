+    #[test]
+    fn the_cache_follows_membership_changes_and_the_weights_the_warmup_boundary() {
+        let _serial = config_override::exclusive_session();
+        fault_timing::reset();
+        let mut state = CellLearner::new();
+        let uniform = [1.0 / AXES as f64; AXES];
+        let a = ArmSet::default();
+        let b = ArmSet {
+            retarget: true,
+            ..ArmSet::default()
+        };
+        let c = ArmSet {
+            pair_order: true,
+            ..ArmSet::default()
+        };
+        assert_eq!(state.population.axis_weights, uniform);
+        assert_eq!(state.population.mixture_total, 0.0);
+        // Twenty-three rewards: the population is supported and its mixture
+        // stands on the uniform weights, since no boundary has passed.
+        for i in 0..23 {
+            state.credit(if i % 2 == 0 { &a } else { &b }, true);
+        }
+        assert!(state.population.supported());
+        assert_eq!(state.population.axis_weights, uniform);
+        assert_eq!(state.population.mixture, recomputed(&state.population, uniform));
+        assert!(state.population.mixture_total > 0.0);
+        // The twenty-fourth observation, with no reward and nothing to
+        // expire, refreshes the weights and rebuilds the mixture on them.
+        state.alpha[AXIS_START[1] + 1] = 200.0;
+        let before = state.population.mixture;
+        state.credit(&a, false);
+        assert_eq!(state.observations, WARMUP_OBSERVATIONS);
+        let refreshed = state.population.axis_weights;
+        assert_eq!(refreshed, state.mutation_axis_weights());
+        assert_ne!(refreshed, uniform);
+        assert_eq!(state.population.mixture, recomputed(&state.population, refreshed));
+        assert_ne!(state.population.mixture, before, "the weights changed and so did the mixture");
+        // Between boundaries the weights stay frozen although the
+        // posteriors move, and without a membership change so does the
+        // mixture.
+        state.alpha[AXIS_START[3] + 1] = 300.0;
+        let frozen = state.population.mixture;
+        for _ in 0..5 {
+            state.credit(&a, false);
+        }
+        assert_eq!(state.observations, 29);
+        assert_eq!(state.population.axis_weights, refreshed);
+        assert_ne!(state.mutation_axis_weights(), refreshed);
+        assert_eq!(state.population.mixture, frozen);
+        // A reward off the boundary rebuilds on the frozen weights.
+        state.credit(&c, true);
+        assert_eq!(state.observations, 30);
+        assert_eq!(state.population.axis_weights, refreshed);
+        assert_ne!(state.population.mixture, frozen);
+        assert_eq!(state.population.mixture, recomputed(&state.population, refreshed));
+        // The next boundary refreshes again.
+        while state.observations < 2 * WARMUP_OBSERVATIONS {
+            state.credit(&a, false);
+        }
+        let second = state.population.axis_weights;
+        assert_eq!(second, state.mutation_axis_weights());
+        assert_ne!(second, refreshed);
+        assert_eq!(state.population.mixture, recomputed(&state.population, second));
+        // An expiry on a zero reward rebuilds on the weights of the time.
+        while state.observations < 1 + POPULATION_AGE_LIMIT {
+            state.credit(&a, false);
+        }
+        assert_eq!(state.population.entries().next().unwrap().at, 1, "age 500 is live");
+        let held = state.population.mixture;
+        let weights = state.population.axis_weights;
+        state.credit(&a, false);
+        assert_eq!(state.observations, 502);
+        assert_eq!(state.population.entries().next().unwrap().at, 2);
+        assert_eq!(state.population.axis_weights, weights, "502 is no boundary");
+        assert_ne!(state.population.mixture, held);
+        assert_eq!(state.population.mixture, recomputed(&state.population, weights));
+        for m in state.population.mixture {
+            assert!(m.is_finite() && m >= 0.0);
+        }
+    }
