+/// The arm selector's population draws. Every learner draw past warmup is
+/// one of `supported_draws` or `unsupported_draws`; `changed_joint_draws`
+/// is the firing counter, the supported draws whose arm set differs from
+/// the product-of-marginals set inverted at the same unit variate, and
+/// `hamming_hist[k]` splits the supported draws by the number of axes the
+/// two sets differ on. `tv_at_least_tenth` counts supported draws whose
+/// total variation between the mixture and the product of the marginals
+/// reached one tenth; `tv_micro_sum` sums that distance in millionths and
+/// `tv_hist` bins it in tenths. `mutation_axis_mass_micro[a]` sums, in
+/// millionths, the probability the mixture gave axis `a` of being the
+/// mutated one, so divided by `supported_draws * 1_000_000` it is that
+/// axis's share of the mutation mass. `live_entries_hist` and
+/// `distinct_hist` bin every learner draw past warmup by the live entries
+/// and distinct sets its population held, capacity in the last bin;
+/// `supported_draws_with_four_distinct` counts the supported draws whose
+/// population held at least four distinct sets; the most repeated set's
+/// count and its share of the live entries, in millionths, are summed in
+/// `supported_top_multiplicity_sum` and `supported_top_share_micro`. The
+/// `by_learner` arrays follow `arm_selector::Learner::ALL`; the
+/// `supported_completed_runs` and `supported_successful_runs` pairs count
+/// the runs a supported draw chose and the ones whose own reward was
+/// true. `cells_created`, `cells_reaching_supported_draws` (one slot per
+/// value of `cell_draw_thresholds`, a cell counted once when its
+/// cumulative supported draws reach that value) and its per-learner
+/// hundred-draw split are gauges cleared with the learner tables.
+/// `layout_bytes` is the memory one cell occupies in all and, second, for
+/// its population; `storage_bytes` and `population_storage_bytes` are
+/// those sizes times `cells_created`.
+#[derive(Serialize, Debug, Clone)]
+pub struct ArmSelectorPopulationStats {
+    pub supported_draws: u64,
+    pub unsupported_draws: u64,
+    pub changed_joint_draws: u64,
+    pub supported_draws_by_learner: Vec<u64>,
+    pub changed_joint_draws_by_learner: Vec<u64>,
+    pub hamming_hist: Vec<u64>,
+    pub tv_at_least_tenth: u64,
+    pub tv_micro_sum: u64,
+    pub tv_hist: Vec<u64>,
+    pub mutation_axis_mass_micro: Vec<u64>,
+    pub live_entries_hist: Vec<u64>,
+    pub distinct_hist: Vec<u64>,
+    pub supported_draws_with_four_distinct: u64,
+    pub supported_top_multiplicity_sum: u64,
+    pub supported_top_share_micro: u64,
+    pub supported_completed_runs_by_learner: Vec<u64>,
+    pub supported_successful_runs_by_learner: Vec<u64>,
+    pub cells_created: u64,
+    pub cell_draw_thresholds: Vec<u64>,
+    pub cells_reaching_supported_draws: Vec<u64>,
+    pub cells_reaching_hundred_supported_draws_by_learner: Vec<u64>,
+    pub layout_bytes: Vec<u64>,
+    pub storage_bytes: u64,
+    pub population_storage_bytes: u64,
+}
+
+impl ArmSelectorPopulationStats {
+    fn read() -> Self {
+        let p = &AX_POPULATION;
+        let load = |a: &[AtomicU64]| a.iter().map(|n| n.load(Ordering::Relaxed)).collect();
+        let cells_created = p.cells_created.load(Ordering::Relaxed);
+        let cell_bytes = arm_selector::cell_bytes() as u64;
+        let population_bytes = arm_selector::population_bytes() as u64;
+        Self {
+            supported_draws: p.supported_draws.load(Ordering::Relaxed),
+            unsupported_draws: p.unsupported_draws.load(Ordering::Relaxed),
+            changed_joint_draws: p.changed_joint_draws.load(Ordering::Relaxed),
+            supported_draws_by_learner: load(&p.supported_draws_by_learner),
+            changed_joint_draws_by_learner: load(&p.changed_joint_draws_by_learner),
+            hamming_hist: load(&p.hamming_hist),
+            tv_at_least_tenth: p.tv_at_least_tenth.load(Ordering::Relaxed),
+            tv_micro_sum: p.tv_micro_sum.load(Ordering::Relaxed),
+            tv_hist: load(&p.tv_hist),
+            mutation_axis_mass_micro: load(&p.mutation_axis_mass_micro),
+            live_entries_hist: load(&p.live_entries_hist),
+            distinct_hist: load(&p.distinct_hist),
+            supported_draws_with_four_distinct: p
+                .supported_draws_with_four_distinct
+                .load(Ordering::Relaxed),
+            supported_top_multiplicity_sum: p.supported_top_multiplicity_sum.load(Ordering::Relaxed),
+            supported_top_share_micro: p.supported_top_share_micro.load(Ordering::Relaxed),
+            supported_completed_runs_by_learner: load(&p.supported_completed_runs_by_learner),
+            supported_successful_runs_by_learner: load(&p.supported_successful_runs_by_learner),
+            cells_created,
+            cell_draw_thresholds: AX_POP_CELL_THRESHOLDS.to_vec(),
+            cells_reaching_supported_draws: load(&p.cells_reaching_supported_draws),
+            cells_reaching_hundred_supported_draws_by_learner: load(
+                &p.cells_reaching_hundred_supported_draws_by_learner,
+            ),
+            layout_bytes: vec![cell_bytes, population_bytes],
+            storage_bytes: cells_created * cell_bytes,
+            population_storage_bytes: cells_created * population_bytes,
+        }
+    }
+}
