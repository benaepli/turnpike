+        let last = util_stats::snapshot().arm_selector_population;
+        assert_eq!(last.supported_draws - after.supported_draws, supported);
+        for &(id, choice) in choices.iter().filter(|(_, c)| c.population).take(5) {
+            assert_eq!(choose(id, seed, cell.0, cell), choice, "run {id}: not reproducible");
+        }
+        util_stats::set_enabled(false);
+        reset();
+    }
