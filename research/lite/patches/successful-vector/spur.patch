+    #[test]
+    fn supported_draws_are_counted_against_the_product_of_the_marginals() {
+        let _serial = config_override::exclusive_session();
+        fault_timing::reset();
+        util_stats::set_enabled(true);
+        reset();
+        let cell = (9, 9);
+        support_pair_order(cell);
+        let a = Learner::OvertakenGhost;
+        {
+            let state = CELLS[a.index()].get(&cell).unwrap();
+            let p = &state.population;
+            assert_eq!((p.live, p.distinct, p.top_multiplicity), (24, 4, 6));
+            assert!(p.supported());
+        }
+        let before = util_stats::snapshot();
+        let ids: Vec<i64> = (0..1_000_000i64).filter(|&id| learner(id) == Some(a)).take(300).collect();
+        let seed = 4u64;
+        let mut supported = 0u64;
+        let mut coins = 0u64;
+        let mut hamming_hist = [0u64; AXES + 1];
+        let mut tv_tenth = 0u64;
+        let mut tv_micro = 0u64;
+        let mut axis_micro = [0u64; AXES];
+        let choices: Vec<(i64, Choice)> =
+            ids.iter().map(|&id| (id, choose(id, seed, cell.0, cell))).collect();
+        let state = CELLS[a.index()].get(&cell).unwrap();
+        for &(id, choice) in &choices {
+            let Some(l) = choice.learner else {
+                assert!(!choice.population);
+                assert_eq!(choice.arms, ArmSet::coins(id));
+                coins += 1;
+                continue;
+            };
+            assert_eq!(l, a);
+            assert!(choice.population, "run {id}: a supported cell fell back");
+            let u = SmallRng::seed_from_u64(derive_seed(seed, id, DRAW_SALT)).random::<f64>();
+            let (arms, draw) = state.population_draw(u);
+            assert_eq!(arms, choice.arms, "run {id}: not the mixture's set");
+            supported += 1;
+            hamming_hist[draw.hamming] += 1;
+            tv_tenth += (draw.total_variation >= 0.1) as u64;
+            tv_micro += (draw.total_variation * 1_000_000.0).round() as u64;
+            for x in 0..AXES {
+                axis_micro[x] += (draw.axis_mass[x].clamp(0.0, 1.0) * 1_000_000.0).round() as u64;
+            }
+        }
+        drop(state);
+        assert!(supported >= 100, "only {supported} supported draws with {coins} coin runs");
+        let after = util_stats::snapshot();
+        let p = &after.arm_selector_population;
+        let p0 = &before.arm_selector_population;
+        let d = |x: u64, y: u64| x - y;
+        assert_eq!(d(p.supported_draws, p0.supported_draws), supported);
+        assert_eq!(d(p.unsupported_draws, p0.unsupported_draws), 0);
+        assert_eq!(d(p.supported_draws_by_learner[0], p0.supported_draws_by_learner[0]), supported);
+        assert_eq!(d(p.supported_draws_by_learner[1], p0.supported_draws_by_learner[1]), 0);
+        let changed: u64 = hamming_hist[1..].iter().sum();
+        assert!(changed > 0, "the mixture never departed from the product");
+        assert_eq!(d(p.changed_joint_draws, p0.changed_joint_draws), changed);
