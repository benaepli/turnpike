+        state.credit(&a, true);
+        assert_eq!(pop(&state), (8, 1, 8, false), "one distinct set supports a draw");
+        state.credit(&b, true);
+        assert_eq!(pop(&state), (9, 2, 8, true));
+        // Repeated sets are repeated entries up to the capacity, then the
+        // oldest goes for the newest.
+        for _ in 0..15 {
+            state.credit(&a, true);
+        }
+        assert_eq!(pop(&state), (24, 2, 23, true));
+        assert_eq!(state.population.entries().next().unwrap().at, 1);
+        state.credit(&a, true);
+        assert_eq!(pop(&state), (24, 2, 23, true));
+        assert_eq!(state.population.entries().next().unwrap().at, 2, "the oldest entry went");
+        assert_eq!(state.observations, 25);
+        // Zero rewards move the clock. The oldest live entry was credited
+        // at observation 2: it stays through age 500 and goes at 501.
+        while state.observations < 2 + POPULATION_AGE_LIMIT - 1 {
+            state.credit(&a, false);
+        }
+        assert_eq!(state.population.entries().next().unwrap().at, 2, "age 499 is live");
+        assert_eq!(pop(&state).0, 24);
+        state.credit(&b, false);
+        assert_eq!(state.observations, 502);
+        assert_eq!(state.population.entries().next().unwrap().at, 2, "age 500 is live");
+        assert_eq!(pop(&state).0, 24);
+        state.credit(&b, false);
+        assert_eq!(state.population.entries().next().unwrap().at, 3, "age 501 expired");
+        assert_eq!(pop(&state), (23, 2, 22, true));
+        // The one entry of the second set was credited at observation 9:
+        // once it expires the population loses support on distinctness
+        // with sixteen live entries, and one rewarded run restores it,
+        // expiring the entry of observation 10 on the same credit.
+        while state.observations < 9 + POPULATION_AGE_LIMIT + 1 {
+            state.credit(&a, false);
+        }
+        assert_eq!(pop(&state), (16, 1, 16, false), "support lost on distinctness");
+        state.credit(&b, true);
+        assert_eq!(pop(&state), (16, 2, 15, true), "support regained");
+        // Everything expires; eight fresh alternating rewards support again.
+        let newest = state.population.entries().last().unwrap().at;
+        while state.observations < newest + POPULATION_AGE_LIMIT + 1 {
+            state.credit(&a, false);
+        }
+        assert_eq!(pop(&state), (0, 0, 0, false));
+        assert_eq!(state.population.mixture_total, 0.0);
+        for i in 0..8 {
+            state.credit(if i % 2 == 0 { &a } else { &b }, true);
+            assert_eq!(pop(&state).3, i == 7, "after {} rewards", i + 1);
+        }
+    }
