+/// draws in all, and is counted once at each threshold it reaches.
+pub fn record_arm_selector_population_cell_draws(learner: usize, cumulative: u64) {
+    let p = &AX_POPULATION;
+    for (i, threshold) in AX_POP_CELL_THRESHOLDS.iter().enumerate() {
+        if cumulative == *threshold {
+            p.cells_reaching_supported_draws[i].fetch_add(1, Ordering::Relaxed);
+            if *threshold == 100 {
