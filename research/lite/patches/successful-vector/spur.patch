+    #[test]
+    fn an_unsupported_cell_takes_the_independent_pick_and_a_supported_one_the_mixture() {
+        let _serial = config_override::exclusive_session();
+        fault_timing::reset();
+        util_stats::set_enabled(true);
+        reset();
+        let cell = (10, 10);
+        let a = Learner::OvertakenGhost;
+        separate_retarget(cell);
+        {
+            let state = CELLS[a.index()].get(&cell).unwrap();
+            let p = &state.population;
+            assert!(p.live >= POPULATION_SUPPORT_ENTRIES, "{} live", p.live);
+            assert_eq!(p.distinct, 1);
+            assert!(!p.supported());
+        }
+        let before = util_stats::snapshot().arm_selector_population;
+        let ids: Vec<i64> = (0..1_000_000i64).filter(|&id| learner(id) == Some(a)).take(200).collect();
+        let seed = 7u64;
+        let mut learner_runs = 0u64;
+        let choices: Vec<(i64, Choice)> =
+            ids.iter().map(|&id| (id, choose(id, seed, cell.0, cell))).collect();
+        let state = CELLS[a.index()].get(&cell).unwrap();
+        for &(id, choice) in &choices {
+            assert!(!choice.population, "run {id}: an unsupported cell drew from its population");
+            if choice.learner.is_none() {
+                assert_eq!(choice.arms, ArmSet::coins(id));
+                continue;
+            }
+            // The independent pick, one categorical draw per axis from the
+            // selector's generator at the run's seed.
+            let mut rng = SmallRng::seed_from_u64(derive_seed(seed, id, DRAW_SALT));
+            let mut directions = [0usize; AXES];
+            for (x, d) in directions.iter_mut().enumerate() {
+                *d = state.sample_axis_leading(x, &mut rng);
+            }
+            assert_eq!(choice.arms, ArmSet::from_directions(directions), "run {id}");
+            learner_runs += 1;
+        }
+        drop(state);
+        assert!(learner_runs > 150, "{learner_runs} learner runs");
+        let after = util_stats::snapshot().arm_selector_population;
+        assert_eq!(after.unsupported_draws - before.unsupported_draws, learner_runs);
+        assert_eq!(after.supported_draws, before.supported_draws);
+        assert_eq!(after.distinct_hist[1] - before.distinct_hist[1], learner_runs);
+        // A second distinct rewarded set supports the cell: the same runs
+        // now take the mixture, reproducibly, and the probe and coin runs
+        // are as before.
+        let id = unprobed_id();
+        for i in 0..8 {
+            let arms = ArmSet {
+                retarget: i % 2 == 1,
+                ..ArmSet::default()
+            };
+            observe(cell.0, cell, id, &coin(arms), &rewarded(true, true));
+        }
+        assert!(CELLS[a.index()].get(&cell).unwrap().population.supported());
+        let probe = id_where(run_cap::is_probe);
+        assert_eq!(choose(probe, seed, cell.0, cell), coin(ArmSet::coins(probe)));
