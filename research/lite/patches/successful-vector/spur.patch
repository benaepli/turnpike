+    #[test]
+    fn the_mutation_axis_weights_follow_the_normalized_leading_entropies() {
+        let mut state = CellLearner::new();
+        state.observations = WARMUP_OBSERVATIONS;
+        state.mass = 500.0;
+        state.reward_mass = 25.0;
+        for d in 0..DIRECTIONS {
+            state.alpha[d] = 10.0;
+            state.beta[d] = 190.0;
+        }
+        // Flat posteriors: the leading probabilities of an axis are equal,
+        // so a three-way axis has entropy ln 3 and a binary one ln 2.
+        let ln2 = 2f64.ln();
+        let ln3 = 3f64.ln();
+        let want = [ln3, ln2, ln2, ln2, ln3].map(|h| h / (2.0 * ln3 + 3.0 * ln2));
+        let got = state.mutation_axis_weights();
+        for a in 0..AXES {
+            assert!((got[a] - want[a]).abs() < 1e-12, "axis {a}: {} against {}", got[a], want[a]);
+        }
+        assert!((got.iter().sum::<f64>() - 1.0).abs() < 1e-12);
+        // A fully separated axis has one leading direction and no entropy.
+        let (lo, hi) = (AXIS_START[1], AXIS_START[1] + 1);
+        state.alpha[hi] = 1e6;
+        state.beta[lo] = 1e6;
+        let leading = state.leading_probability(1);
+        assert_eq!(leading[0], 0.0);
+        assert_eq!(leading[1], 1.0);
+        let got = state.mutation_axis_weights();
+        assert_eq!(got[1], 0.0);
+        let rest = 2.0 * ln3 + 2.0 * ln2;
+        for (a, h) in [(0, ln3), (2, ln2), (3, ln2), (4, ln3)] {
+            assert!((got[a] - h / rest).abs() < 1e-12, "axis {a}");
+        }
+        // Every axis separated: no entropy anywhere, so the axes are
+        // equally likely.
+        for a in 0..AXES {
+            let first = AXIS_START[a];
+            state.alpha[first + 1] = 1e6;
+            state.beta[first] = 1e6;
+            for d in first + 2..AXIS_START[a + 1] {
+                state.beta[d] = 1e6;
+            }
+        }
+        for a in 0..AXES {
+            let leading = state.leading_probability(a);
+            assert_eq!(leading[1], 1.0, "axis {a}");
+            assert_eq!(leading[0] + leading[2], 0.0, "axis {a}");
+        }
+        assert_eq!(state.mutation_axis_weights(), [1.0 / AXES as f64; AXES]);
+    }
