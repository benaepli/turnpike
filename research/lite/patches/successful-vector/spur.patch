+        assert_eq!(seen(b), (2, 1));
+        assert_eq!(seen(c), (1, 1));
+        // A probe reaches nobody.
+        let probe = id_where(run_cap::is_probe);
+        observe(
+            cell.0,
+            cell,
+            probe,
+            &coin(arms),
+            &Rewards {
+                cycle_before_request: true,
+                ..rewarded(true, true)
+            },
+        );
+        assert_eq!(seen(a), (1, 1));
+        assert_eq!(seen(b), (2, 1));
+        assert_eq!(seen(c), (1, 1));
+        // A's population-drawn run without A's reward ticks A once and
+        // admits nothing, whatever the other rewards say.
+        observe(cell.0, cell, assigned_id(a), &population_drawn(arms, a), &rewarded(false, true));
+        assert_eq!(seen(a), (2, 1));
+        assert_eq!(seen(b), (2, 1));
+        assert_eq!(seen(c), (1, 1));
+        // A's marginal state is the discounted update of one reward then
+        // one non-reward on the set's directions.
+        let state = CELLS[a.index()].get(&cell).unwrap();
+        assert!((state.reward_mass - DISCOUNT).abs() < 1e-12);
+        assert!((state.mass - (DISCOUNT + 1.0)).abs() < 1e-12);
+        for d in 0..DIRECTIONS {
+            let carried = arms.directions().contains(&d);
+            let want_alpha = if carried { DISCOUNT } else { 0.0 };
+            let want_beta = if carried { 1.0 } else { 0.0 };
+            assert!((state.alpha[d] - want_alpha).abs() < 1e-12, "alpha[{d}]");
+            assert!((state.beta[d] - want_beta).abs() < 1e-12, "beta[{d}]");
+        }
+        drop(state);
+        reset();
+    }
