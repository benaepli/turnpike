+/// One timer's selection score was reduced because its class had fired past
+/// its learned budget this run.
+#[inline]
+pub fn record_refire_damped() {
+    if !enabled() {
+        return;
+    }
+    TIMER_REFIRE_DAMPED.fetch_add(1, Ordering::Relaxed);
+}
+
+/// One timer fired while its class was past its learned budget.
+#[inline]
+pub fn record_refire_over_budget() {
+    if !enabled() {
+        return;
+    }
+    TIMER_REFIRE_OVER_BUDGET.fetch_add(1, Ordering::Relaxed);
+}
