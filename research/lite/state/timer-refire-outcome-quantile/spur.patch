+            let channel = ChannelId { node: node_id, id };
+            let mut chan = ChannelState::new();
+            let reader = parked_reader(state, pc);
+            chan.push_waiting_reader(reader, lhs.clone());
+            state.channels.insert(channel, chan);
+            channel
+        };
+        let budgeted_chan = channel_at(&mut state, 0, budgeted_pc);
+        let free_chan = channel_at(&mut state, 1, free_pc);
+        let empty_chan = ChannelId { node: node_id, id: 2 };
+        state.channels.insert(empty_chan, ChannelState::new());
+
+        timer_budget::reset();
+        for _ in 0..100 {
+            timer_budget::merge_run(timer_budget::Outcome::Completed, &[(0, budgeted_pc, 2)]);
+        }
+        state.timer_budget = timer_budget::snapshot();
+        assert_eq!(state.timer_budget.budget(budgeted_pc), Some(2));
+        for pc in [budgeted_pc, free_pc] {
+            state.note_timer_refire(0, pc);
+            state.note_timer_refire(0, pc);
+        }
+
+        let timer_on = |channel: ChannelId| {
+            Runnable::Timer(Timer {
+                pc: 0,
+                node: node_id,
+                channel,
+                priority: 0.5,
+                label: None,
+            })
+        };
+        let terms = ResolvedTerms::default();
+        let score = |state: &State<NoHashing>, r: &Runnable<NoHashing>| {
+            score_runnable::<NoHashing, NoFeedback>(r, &(), &(), state, &terms)
+        };
+        let over = score(&state, &timer_on(budgeted_chan));
+        let under = score(&state, &timer_on(free_chan));
+        let classless = score(&state, &timer_on(empty_chan));
+        assert!(
+            (over - timer_budget::REFIRE_DAMP * under).abs() < 1e-12,
+            "over-budget score {over} is not the damp multiple of {under}"
+        );
+        assert_eq!(under, classless, "an unbudgeted class scores as identity");
+
+        // One firing short of the budget is identity too.
+        state.timer_firings.clear();
+        state.note_timer_refire(0, budgeted_pc);
+        assert_eq!(score(&state, &timer_on(budgeted_chan)), under);
+        timer_budget::reset();
+    }
