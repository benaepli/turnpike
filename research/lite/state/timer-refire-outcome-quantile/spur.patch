+    /// Timer firings so far this run at `pc` on node `node`.
+    pub fn timer_refires(&self, node: usize, pc: Vertex) -> u32 {
+        self.timer_firings
+            .iter()
+            .find(|(n, p, _)| *n == node && *p == pc)
+            .map(|(_, _, c)| *c)
+            .unwrap_or(0)
+    }
+
+    /// Count one timer firing that woke a record at `pc` on node `node`.
+    pub fn note_timer_refire(&mut self, node: usize, pc: Vertex) {
+        match self
+            .timer_firings
+            .iter_mut()
+            .find(|(n, p, _)| *n == node && *p == pc)
+        {
+            Some(e) => e.2 += 1,
+            None => self.timer_firings.push((node, pc, 1)),
+        }
+    }
+
+    /// The vertex the front waiting reader of `channel` resumes at, which is
+    /// the class a firing of the channel's timer would be attributed to. A
+    /// channel with no parked reader fires into the buffer and has no class.
+    pub fn timer_resume_vertex(&self, channel: ChannelId) -> Option<Vertex> {
+        self.channels
+            .get(&channel)
+            .and_then(|c| c.waiting_readers.front())
+            .map(|w| w.0.pc)
+    }
