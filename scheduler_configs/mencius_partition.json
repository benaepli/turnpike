{
  "deploy": "Main",
  "params": { "n": 3 },
  "num_runs": 200000,
  "max_iterations": 6000,
  "events": {
    "w0_a": { "write": { "dest": "nodes[0]", "key": "x" } },
    "w1_a": { "write": { "dest": "nodes[1]", "key": "y" } },
    "w2_a": { "write": { "dest": "nodes[2]", "key": "z" } },
    "p1":   { "partition": { "type": "isolate_one", "node": "nodes[1]" } },
    "w0_b": { "write": { "dest": "nodes[0]", "key": "x" } },
    "w2_b": { "write": { "dest": "nodes[2]", "key": "z" } },
    "h1":   "heal",
    "r0":   { "read": { "dest": "nodes[0]", "key": "x" } },
    "r1":   { "read": { "dest": "nodes[1]", "key": "y" } },
    "r2":   { "read": { "dest": "nodes[2]", "key": "z" } }
  },
  "dependencies": [
    ["w0_a", "p1"],
    ["w1_a", "p1"],
    ["w2_a", "p1"],
    ["p1",   "w0_b"],
    ["p1",   "w2_b"],
    ["w0_b", "h1"],
    ["w2_b", "h1"],
    ["h1",   "r0"],
    ["h1",   "r1"],
    ["h1",   "r2"]
  ]
}
