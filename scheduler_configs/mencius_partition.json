{
  "num_servers": 3,
  "num_runs": 200000,
  "max_iterations": 6000,
  "events": {
    "w0_a": { "write": [0, "x"] },
    "w1_a": { "write": [1, "y"] },
    "w2_a": { "write": [2, "z"] },
    "p1":   { "partition": { "type": "isolate_one", "node": 1 } },
    "w0_b": { "write": [0, "x"] },
    "w2_b": { "write": [2, "z"] },
    "h1":   "heal",
    "r0":   { "read": [0, "x"] },
    "r1":   { "read": [1, "y"] },
    "r2":   { "read": [2, "z"] }
  },
  "dependencies": [
    ["w0_a", "p1"],
    ["w1_a", "p1"],
    ["w2_a", "p1"],
    ["p1",   "w0_b"],
    ["p1",   "w2_b"],
    ["w0_b", "h1"],
    ["w2_b", "h1"],
    ["h1",   "r0"],
    ["h1",   "r1"],
    ["h1",   "r2"]
  ]
}
