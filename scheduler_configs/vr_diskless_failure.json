{
  "deploy": "Main",
  "params": { "n": 3 },
  "num_runs": 2000000,
  "max_iterations": 5000,
  "strict_timers": true,
  "events": {
    "w1": { "write": { "dest": "nodes[0]", "key": "x" } },
    "allow_t1": { "allow_timer": { "node": "nodes[1]", "label": "timeout" } },
    "crash1": { "crash": "nodes[1]" },
    "recover1": { "recover": "nodes[1]" },
    "crash2": { "crash": "nodes[2]" },
    "recover2": { "recover": "nodes[2]" },
    "p1": { "partition": { "type": "isolate_one", "node": "nodes[1]" } },
    "w2": { "write": { "dest": "nodes[0]", "key": "x" } },
    "h1": "heal",
    "r1": { "read": { "dest": "nodes[0]", "key": "x" } },
    "r2": { "read": { "dest": "nodes[1]", "key": "x" } },
    "r3": { "read": { "dest": "nodes[2]", "key": "x" } }
  },
  "dependencies": [
    ["w1", "allow_t1"],
    ["allow_t1", "crash1"],
    ["crash1", "recover1"],
    ["recover1", "crash2"],
    ["crash2", "recover2"],
    ["recover2", "p1"],
    ["p1", "w2"],
    ["w2", "h1"],
    ["h1", "r1"],
    ["h1", "r2"],
    ["h1", "r3"]
  ]
}
