{
    "deploy": "Main",
    "params": { "n": 3 },
    "num_runs": 50,
    "max_iterations": 5000,
    "events": {
        "w1": { "write": { "dest": "nodes[0]", "key": "key1" } },
        "w2": { "write": { "dest": "nodes[1]", "key": "key1" } },
        "r1": { "read": { "dest": "nodes[2]", "key": "key1" } },
        "crash1": { "crash": "nodes[1]" },
        "recover1": { "recover": "nodes[1]" }
    },
    "dependencies": [
        ["w1", "r1"],
        ["w2", "r1"],
        ["crash1", "recover1"]
    ]
}
