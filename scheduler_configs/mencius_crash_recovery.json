{
  "deploy": "Main",
  "params": { "n": 3 },
  "num_runs": 500000,
  "max_iterations": 8000,
  "events": {
    "w0":    { "write": { "dest": "nodes[0]", "key": "x" } },
    "w1":    { "write": { "dest": "nodes[1]", "key": "y" } },
    "crash1":{ "crash": "nodes[1]" },
    "w2":    { "write": { "dest": "nodes[2]", "key": "z" } },
    "w0b":   { "write": { "dest": "nodes[0]", "key": "x" } },
    "rec1":  { "recover": "nodes[1]" },
    "r0":    { "read": { "dest": "nodes[0]", "key": "x" } },
    "r1":    { "read": { "dest": "nodes[1]", "key": "y" } },
    "r2":    { "read": { "dest": "nodes[2]", "key": "z" } }
  },
  "dependencies": [
    ["w0",     "crash1"],
    ["w1",     "crash1"],
    ["crash1", "w2"],
    ["crash1", "w0b"],
    ["w2",     "rec1"],
    ["w0b",    "rec1"],
    ["rec1",   "r0"],
    ["rec1",   "r1"],
    ["rec1",   "r2"]
  ]
}
