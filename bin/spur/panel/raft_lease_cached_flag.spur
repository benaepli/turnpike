// Raft with lease reads (thesis section 6.4.1). A leader that has heard a
// majority acknowledge a heartbeat may answer reads from its own state
// machine, without a log round, for as long as its lease holds.
//
// This variant caches the answer. The leader decides once per heartbeat
// whether its lease holds and remembers the verdict in `lease_ok`; a read
// then consults the flag rather than the clock.
//
// The clock read that sets the flag is written directly in an async body, so
// it is a process checkpoint: the leader may be interrupted between reading
// the clock and storing what it read. Time keeps running while it is held,
// and the verdict it wakes up with is the one it took before. A later read
// answers from a flag that was true when it was computed and is false by the
// time it is used.
//
// The manifest calls this an implementation-pattern mutant rather than a
// paper bug: the thesis says to check the lease, not to cache the check.

// This control domain keeps heartbeats below the election timeout and
// shortens leases enough for every clock rate in the configured band.
// These are explicit control assumptions, not inferred protocol guarantees.
timing durations {
    election;
    heartbeat;
    lease;
    margin;
    require lease == election;
    require heartbeat < election;
    require margin < lease;
    require (lease - margin) * rate_max < election * rate_min;
}

type Command {
    kind: int; // 0: Read, 1: Write, 2: the no-op a new leader commits
    key: string;
    uid: int?; // Write's unique id; nil for reads and no-ops
};

type LogEntry {
    term: int;
    op: Command;
};

type ClientResponse {
    is_leader: bool;
    key: string?;
    value: list<int>;
    leader: Node;
};

type PersistentState {
    current_term: int;
    voted_for: int;
    log: list<LogEntry>;
};

type Cluster {
    @quorum nodes: list<Node>;
};

type ClusterParams {
    @scale n: int;
};

role Node(cluster: Cluster) {
    // Identity
    var me: int = index_of(cluster.nodes, self)!;
    var replicas: list<Node> = cluster.nodes;

    // Persistent state (saved via persist_data)
    var current_term: int = 0;
    var voted_for: int = -1; // -1 means none
    var log: list<LogEntry> = [];

    // Volatile state
    var commit_index: int = 0;
    var last_applied: int = 0;
    var state: int = 0; // 0: follower, 1: candidate, 2: leader

    // State machine: per-key log of write uids
    var kv_store: map<string, list<int>> = {};
    // Dedup: per-key set of already-applied uids
    var applied_uids: map<string, map<int, bool>> = {};
    var pending_requests: map<int, chan<ClientResponse>> = {};

    // Leader volatile state
    var next_index: map<int, int> = {};
    var match_index: map<int, int> = {};

    // Candidate volatile state
    var votes_received: int = 0;

    // The index of the no-op this leader appended on election. A leader
    // inherits a log it has not been told the commit index of, so until an
    // entry of its own term commits it does not know what is committed and
    // must not answer from its state machine (thesis section 6.4).
    var noop_index: int = 0;

    // Lease state (leader only). `lease_round` numbers the heartbeat rounds
    // so an acknowledgment is counted against the round it answers;
    // `lease_round_at` is the leader's reading when that round was SENT.
    var lease_round: int = 0;
    var lease_round_at: MonoInstant? = nil;
    var lease_round_acks: int = 0;
    var has_lease: bool = false;
    var lease_expiry: MonoInstant? = nil;
    // The cached verdict, refreshed once per heartbeat.
    var lease_ok: bool = false;

    // Timeout tracking
    var received_leader_message: bool = false;
    var known_leader: int = -1; // last known leader, -1 = unknown
    // When this node last took a valid AppendEntries, on its own clock, and
    // in which term.
    var leader_heard_at: MonoInstant? = nil;
    var leader_heard_term: int = -1;

    fn Init() {
        println("Node {me} initialized");
        spawn monitor_timeouts();
    }

    @trace
    async fn RecoverInit() {
        // Restore persistent state
        var saved: PersistentState? = retrieve_data<PersistentState>();
        if (saved != nil) {
            var s: PersistentState = saved!;
            current_term = s.current_term;
            voted_for = s.voted_for;
            log = s.log;
        }

        // Volatile state resets on recovery
        state = 0;
        commit_index = 0;
        last_applied = 0;
        pending_requests = {};
        next_index = {};
        match_index = {};
        votes_received = 0;
        received_leader_message = false;
        has_lease = false;

        println("Node {me} recovered. term={current_term} log_len={len(log)}");

        // First yield point — after this, messages start being delivered
        spawn monitor_timeouts();
    }

    // Helper to send on a channel from a sync context
    async fn send_async(ch: chan<ClientResponse>, resp: ClientResponse) {
        send(ch, resp);
    }

    fn persist() {
        persist_data(PersistentState{
            current_term: current_term,
            voted_for: voted_for,
            log: log
        });
    }

    fn last_log_index(): int {
        len(log)
    }

    fn last_log_term(): int {
        if (len(log) == 0) {
            0
        } else {
            log[len(log) - 1].term
        }
    }

    fn log_term_at(index: int): int {
        if (index <= 0 or index > len(log)) {
            0
        } else {
            log[index - 1].term
        }
    }

    // Apply committed but unapplied entries to the state machine
    fn apply_committed_entries() {
        for ; last_applied < commit_index and last_applied < len(log); {
            last_applied = last_applied + 1;
            var entry: LogEntry = log[last_applied - 1];
            var cmd: Command = entry.op;
            var result: list<int> = [];

            if (cmd.kind == 1) {
                var seen: map<int, bool> = {};
                if (exists(applied_uids, cmd.key)) {
                    seen = applied_uids[cmd.key];
                }
                if (exists(seen, cmd.uid!)) {
                    println("Apply: index {last_applied} WRITE key={cmd.key} DEDUP");
                } else {
                    var prior: list<int> = [];
                    if (exists(kv_store, cmd.key)) {
                        prior = kv_store[cmd.key];
                    }
                    kv_store = kv_store[cmd.key] := append(prior, cmd.uid!);
                    applied_uids = applied_uids[cmd.key] := (seen[cmd.uid!] := true);
                    println("Apply: index {last_applied} WRITE key={cmd.key}");
                }
            } else if (cmd.kind == 2) {
                println("Apply: index {last_applied} NOOP");
            } else if (cmd.kind == 0) {
                if (exists(kv_store, cmd.key)) {
                    result = kv_store[cmd.key];
                }
                println("Apply: index {last_applied} READ key={cmd.key}");
            }

            if (exists(pending_requests, last_applied)) {
                var resp: ClientResponse = ClientResponse{
                    is_leader: true,
                    key: cmd.key,
                    value: result,
                    leader: replicas[me]
                };
                send_async(pending_requests[last_applied], resp);
                pending_requests = erase(pending_requests, last_applied);
            }
        }
    }

    // Check if we can advance commitIndex (leader only)
    // Only commits entries from the current term (§5.4.2)
    fn advance_commit_index() {
        for var n = len(log); n > commit_index; n = n - 1 {
            if (log_term_at(n) != current_term) {
                continue;
            }
            // Count replicas with matchIndex >= n (including self)
            var count: int = 1;
            for var i = 0; i < len(replicas); i = i + 1 {
                if (i != me and exists(match_index, i) and match_index[i] >= n) {
                    count = count + 1;
                }
            }
            var majority: int = len(replicas) / 2 + 1;
            if (count >= majority) {
                commit_index = n;
                apply_committed_entries();
                return ();
            }
        }
    }

    // Step down to follower if we see a higher term
    fn step_down(new_term: int) {
        println("Node {me} stepping down. old_term={current_term} new_term={new_term}");
        current_term = new_term;
        voted_for = -1;
        state = 0;
        votes_received = 0;
        has_lease = false;
        lease_ok = false;
        persist();

        // Reject all pending client requests so they retry
        for (idx, ch) in pending_requests {
            var resp: ClientResponse = ClientResponse{
                is_leader: false,
                key: nil,
                value: [],
                leader: replicas[me]
            };
            send_async(ch, resp);
        }
        pending_requests = {};
    }

    fn become_leader() {
        println("Node {me} became leader for term {current_term}");
        state = 2;
        votes_received = 0;
        known_leader = me;
        // A new leader holds no lease until a heartbeat round of its own is
        // acknowledged by a majority.
        has_lease = false;
        lease_ok = false;
        lease_round = 0;

        // Commit an entry of this term before answering anything from the
        // state machine, so the commit index is known rather than inherited.
        log = append(log, LogEntry{
            term: current_term,
            op: Command{ kind: 2, key: "", uid: nil }
        });
        noop_index = len(log);
        persist();

        // Initialize nextIndex and matchIndex (§5.3)
        next_index = {};
        match_index = {};
        var last_idx: int = last_log_index();
        for var i = 0; i < len(replicas); i = i + 1 {
            if (i != me) {
                next_index = next_index[i] := last_idx + 1;
                match_index = match_index[i] := 0;
            }
        }

        // Send initial heartbeats to establish authority
        broadcast_heartbeat();
    }

    // One heartbeat round. The reading is taken before the round goes out,
    // so the lease it establishes is anchored at the send.
    fn broadcast_heartbeat() {
        lease_round = lease_round + 1;
        lease_round_at = mono_now();
        lease_round_acks = 1; // this node
        for var i = 0; i < len(replicas); i = i + 1 {
            if (i != me) {
                send_heartbeat(i, lease_round);
            }
        }
    }

    // What a leader may answer from its own state machine, or nil when it
    // may not. The lease check and the answer are one synchronous helper:
    // nothing runs on this node between them, so the reading cannot go
    // stale before it is used.
    fn lease_read(key: string): ClientResponse? {
        if (state != 2 or !has_lease or commit_index < noop_index) {
            return nil;
        }
        if (!lease_ok) {
            return nil;
        }
        var value: list<int> = [];
        if (exists(kv_store, key)) {
            value = kv_store[key];
        }
        println("Node {me} lease read key={key}");
        ClientResponse{
            is_leader: true,
            key: key,
            value: value,
            leader: replicas[me]
        }
    }

    fn start_election() {
        state = 1;
        current_term = current_term + 1;
        voted_for = me;
        votes_received = 1; // vote for self
        known_leader = -1;
        persist();

        println("Node {me} starting election for term {current_term}");

        var last_idx: int = last_log_index();
        var last_term: int = last_log_term();

        for var i = 0; i < len(replicas); i = i + 1 {
            if (i != me) {
                replicas[i]->RequestVote(current_term, me, last_idx, last_term);
            }
        }
    }

    // Build and send AppendEntries to a follower (fire-and-forget; response
    // comes via AppendEntriesReply). Round 0 is not a lease round: only a
    // heartbeat round's acknowledgments extend the lease.
    fn send_append_entries(peer_idx: int) {
        send_heartbeat(peer_idx, 0);
    }

    fn send_heartbeat(peer_idx: int, round: int) {
        var ni: int = next_index[peer_idx];
        var prev_log_index: int = ni - 1;
        var prev_log_term: int = log_term_at(prev_log_index);

        var entries: list<LogEntry> = [];
        for var i = ni; i <= len(log); i = i + 1 {
            entries = append(entries, log[i - 1]);
        }

        replicas[peer_idx]->AppendEntries(
            current_term,
            me,
            prev_log_index,
            prev_log_term,
            entries,
            commit_index,
            round
        );
    }

    // AppendEntries RPC handler (receiver implementation from Figure 2)
    @trace
    async fn AppendEntries(
        leader_term: int,
        leader_id: int,
        prev_log_index: int,
        prev_log_term: int,
        entries: list<LogEntry>,
        leader_commit: int,
        round: int
    ) {
        println("AppendEntries: from leader {leader_id} term={leader_term} prev_idx={prev_log_index} entries={len(entries)}");

        // Rule for all servers: if term > currentTerm, step down
        if (leader_term > current_term) {
            step_down(leader_term);
        }

        // 1. Reply false if term < currentTerm
        if (leader_term < current_term) {
            replicas[leader_id]->AppendEntriesReply(me, current_term, false, 0, round);
            return ();
        }

        // Valid AppendEntries from leader — reset election timer
        received_leader_message = true;
        known_leader = leader_id;
        leader_heard_at = mono_now();
        leader_heard_term = current_term;

        // If we're a candidate and see a leader with >= our term, become follower
        if (state == 1) {
            state = 0;
            voted_for = -1;
            votes_received = 0;
        }

        // 2. Reply false if log doesn't contain entry at prevLogIndex with matching term
        if (prev_log_index > 0) {
            if (prev_log_index > len(log)) {
                persist();
                replicas[leader_id]->AppendEntriesReply(me, current_term, false, 0, round);
                return ();
            }
            if (log[prev_log_index - 1].term != prev_log_term) {
                // Delete conflicting entry and all that follow
                var new_log: list<LogEntry> = [];
                for var i = 0; i < prev_log_index - 1; i = i + 1 {
                    new_log = append(new_log, log[i]);
                }
                log = new_log;
                persist();
                replicas[leader_id]->AppendEntriesReply(me, current_term, false, 0, round);
                return ();
            }
        }

        // 3 & 4. If existing entry conflicts with new one, delete it and all that follow.
        //         Append any new entries not already in the log.
        var insert_index: int = prev_log_index;
        for var i = 0; i < len(entries); i = i + 1 {
            var log_index: int = insert_index + 1 + i;
            if (log_index <= len(log)) {
                if (log[log_index - 1].term != entries[i].term) {
                    // Conflict: truncate from here and append rest
                    var new_log: list<LogEntry> = [];
                    for var j = 0; j < log_index - 1; j = j + 1 {
                        new_log = append(new_log, log[j]);
                    }
                    log = new_log;
                    for var j = i; j < len(entries); j = j + 1 {
                        log = append(log, entries[j]);
                    }
                    break;
                }
                // Entry matches — skip (already in log)
            } else {
                // Beyond current log — append
                log = append(log, entries[i]);
            }
        }

        persist();

        // 5. If leaderCommit > commitIndex, set commitIndex = min(leaderCommit, index of last new entry)
        if (leader_commit > commit_index) {
            var last_new_entry: int = prev_log_index + len(entries);
            commit_index = min(leader_commit, last_new_entry);
            apply_committed_entries();
        }

        var my_match: int = prev_log_index + len(entries);
        replicas[leader_id]->AppendEntriesReply(me, current_term, true, my_match, round);
    }

    // AppendEntries response callback (processed by leader)
    @trace
    async fn AppendEntriesReply(
        follower_id: int,
        resp_term: int,
        success: bool,
        resp_match_index: int,
        round: int
    ) {
        var success_str: string = "false";
        if (success) { success_str = "true"; }
        println("AppendEntriesReply: from {follower_id} term={resp_term} success={success_str}");

        // Rule: if term > currentTerm, step down
        if (resp_term > current_term) {
            step_down(resp_term);
            return ();
        }

        // A reply carrying an older term belongs to a superseded incarnation
        // of this node and says nothing about the current one.
        if (resp_term != current_term) {
            return ();
        }

        // Ignore if no longer leader
        if (state != 2) {
            return ();
        }

        // A majority has now acknowledged the round this reply answers, so
        // the lease runs from when that round was sent.
        if (round == lease_round and round > 0) {
            lease_round_acks = lease_round_acks + 1;
            var quorum: int = len(replicas) / 2 + 1;
            if (lease_round_acks == quorum) {
                has_lease = true;
                lease_ok = true;
                lease_expiry = lease_round_at! + durations().lease - durations().margin;
                println("Node {me} lease to {lease_expiry!} from round {round}");
            }
        }

        if (success) {
            if (resp_match_index > 0) {
                next_index = next_index[follower_id] := resp_match_index + 1;
                match_index = match_index[follower_id] := resp_match_index;
            }
            advance_commit_index();
        } else {
            // Decrement nextIndex and retry
            if (exists(next_index, follower_id) and next_index[follower_id] > 1) {
                next_index = next_index[follower_id] := next_index[follower_id] - 1;
            }
            send_append_entries(follower_id);
        }
    }

    // RequestVote RPC handler (receiver implementation from Figure 2)
    @trace
    async fn RequestVote(
        candidate_term: int,
        candidate_id: int,
        candidate_last_log_index: int,
        candidate_last_log_term: int
    ) {
        println("RequestVote: from candidate {candidate_id} term={candidate_term}");

        // A server that has heard from the leader of its current term within
        // the minimum election timeout ignores the request (thesis section
        // 4.2.3): it keeps its term and its vote. A lease rests on this: the
        // followers that acknowledged it must not help elect a new leader
        // before it runs out.
        if (leader_heard_term == current_term and leader_heard_at != nil
            and mono_now() < leader_heard_at! + durations().election) {
            replicas[candidate_id]->RequestVoteReply(current_term, false);
            return ();
        }

        // Rule: if term > currentTerm, step down
        if (candidate_term > current_term) {
            step_down(candidate_term);
        }

        // 1. Reply false if term < currentTerm
        if (candidate_term < current_term) {
            replicas[candidate_id]->RequestVoteReply(current_term, false);
            return ();
        }

        // 2. If votedFor is null (-1) or candidateId, and candidate's log is at least as up-to-date
        if (voted_for == -1 or voted_for == candidate_id) {
            var my_last_term: int = last_log_term();
            var my_last_index: int = last_log_index();

            var log_ok: bool = false;
            if (candidate_last_log_term > my_last_term) {
                log_ok = true;
            } else if (candidate_last_log_term == my_last_term and candidate_last_log_index >= my_last_index) {
                log_ok = true;
            }

            if (log_ok) {
                voted_for = candidate_id;
                received_leader_message = true; // reset election timer on grant
                persist();
                println("Node {me} voted for {candidate_id} in term {current_term}");
                replicas[candidate_id]->RequestVoteReply(current_term, true);
                return ();
            }
        }

        replicas[candidate_id]->RequestVoteReply(current_term, false);
    }

    // RequestVote response callback (processed by candidate)
    @trace
    async fn RequestVoteReply(resp_term: int, vote_granted: bool) {
        var granted_str: string = "false";
        if (vote_granted) { granted_str = "true"; }
        println("RequestVoteReply: term={resp_term} granted={granted_str}");

        // Rule: if term > currentTerm, step down
        if (resp_term > current_term) {
            step_down(resp_term);
            return ();
        }

        // A reply carrying an older term belongs to a superseded incarnation
        // of this node and says nothing about the current one.
        if (resp_term != current_term) {
            return ();
        }

        // Ignore if no longer candidate
        if (state != 1) {
            return ();
        }

        if (vote_granted) {
            votes_received = votes_received + 1;
            var majority: int = len(replicas) / 2 + 1;
            if (votes_received >= majority) {
                become_leader();
            }
        }
    }

    // Accept a client command, replicate it
    fn NewEntry(cmd: Command): chan<ClientResponse> {
        if (state != 2) {
            var ch: chan<ClientResponse> = make();
            // Redirect to known leader; if unknown, round-robin to next node
            var redirect_to: Node = replicas[(me + 1) % len(replicas)];
            if (known_leader >= 0) {
                redirect_to = replicas[known_leader];
            }
            var resp: ClientResponse = ClientResponse{
                is_leader: false,
                key: nil,
                value: [],
                leader: redirect_to
            };
            send_async(ch, resp);
            return ch;
        }

        // Append to local log
        log = append(log, LogEntry{ term: current_term, op: cmd });
        persist();
        var new_index: int = len(log);

        // Create promise for client
        var ch: chan<ClientResponse> = make();
        pending_requests = pending_requests[new_index] := ch;

        // Single-node cluster: commit immediately
        if (len(replicas) == 1) {
            commit_index = new_index;
            apply_committed_entries();
        } else {
            // Replicate to all followers
            for var i = 0; i < len(replicas); i = i + 1 {
                if (i != me) {
                    send_append_entries(i);
                }
            }
        }

        ch
    }

    async fn Write(key: string, uid: int): ClientResponse {
        println("HandleClientWrite: key={key}, uid={int_to_string(uid)}");
        var cmd: Command = Command{ kind: 1, key: key, uid: uid };
        <- NewEntry(cmd)
    }

    async fn Read(key: string): ClientResponse {
        println("HandleClientRead: key={key}");
        var served: ClientResponse? = lease_read(key);
        if (served != nil) {
            return served!;
        }
        var cmd: Command = Command{ kind: 0, key: key, uid: nil };
        <- NewEntry(cmd)
    }

    async fn monitor_timeouts() {
        for ;; {
            if (state == 2) {
                // Leader: a heartbeat round every heartbeat interval, which
                // is what keeps the lease alive.
                <- set_timer_after(durations().heartbeat, "heartbeat");
                if (state == 2) {
                    // The checkpoint: the reading is taken here and stored
                    // in node state, where every read until the next
                    // heartbeat will find it.
                    lease_ok = lease_expiry != nil and mono_now() < lease_expiry!;
                    broadcast_heartbeat();
                }
                continue;
            }

            // Follower or candidate: an election timeout is a duration on
            // this node's own clock, which may run faster than the leader's.
            <- set_timer_after(durations().election, "election");
            if (state == 2) {
                continue;
            }

            if (received_leader_message) {
                received_leader_message = false;
                continue;
            }

            println("Node {me} election timeout at term {current_term}");
            start_election();
        }
    }
}

fn cluster(n: int): Cluster {
    var nodes: list<Node> = spawn<Node>(n);
    var c: Cluster = Cluster { nodes: nodes };
    provide_all(nodes, c);
    c
}

@deploy(client = KVClient)
fn Main(p: ClusterParams): Cluster? {
    if (p.n < 1) {
        return nil;
    }
    cluster(p.n)
}

client KVClient(sys: Cluster) {
    async fn Write(dest: Node, key: string, uid: int) {
        var current_target: Node = dest;
        for ;; {
            var resp: ClientResponse = <- current_target->Write(key, uid);
            if (resp.is_leader == true) {
                return ();
            }
            current_target = resp.leader;
        }
    }

    async fn Read(dest: Node, key: string): list<int> {
        var current_target: Node = dest;
        for ;; {
            var resp: ClientResponse = <- current_target->Read(key);
            if (resp.is_leader == true) {
                return resp.value;
            }
            current_target = resp.leader;
        }
        []
    }
}
