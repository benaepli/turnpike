// Mencius Protocol P (Appendix B) over Coordinated Paxos (Appendix A).
//   Mao, Junqueira, Marzullo. "Mencius: Building Efficient Replicated State
//   Machines for WANs." OSDI 2008.
//
// This is the *standalone* Protocol P — none of the optimizations from
// Section 4 are applied. Each instance i has owner owner(i) = i % n. Owners
// suggest at ballot (0, owner(i)); non-owners must Revoke (full Phase 1 +
// Phase 2 at a higher ballot) to propose. Skipped slots are propagated by
// explicit SKIP messages — there is no piggyback, no deferred batching, no
// est_index tracking, and no Accelerator-1 timers.
//
// In scope:
//   - Rotating coordinators (owner(i) = i % n)
//   - Suggest (PROPOSE(0, cmd)) and Skip (PROPOSE(0, no-op))
//   - OnSuggestion: when receiving SUGGEST(i), explicitly Skip every
//     self-owned slot in [my_index, i)
//   - OnLearned re-suggest (Rule 4)
//   - OnSuspect: full Paxos Phase 1 + 2 Revoke at ballot > 0
//   - Persistence + crash recovery via persist_data/retrieve_data
//
// Out of scope (these are the things Mencius.spur adds):
//   - Optimization 1 (piggyback SKIP on the ACCEPT for SUGGEST)
//   - Optimization 2 + Accelerator 1 (defer SKIPs, batch via α/τ)
//   - Optimization 3 (β-bounded revoke window)
//   - est_index[] tracking
//
// Channel model: direct RPCs (no FifoLink). Bare Protocol P never infers
// no-ops from another server's progress — every no-op is communicated by
// an explicit Skip(k) from k's owner. Reordering between Skip and Suggest
// from the same sender is harmless because each PROPOSE acts on a distinct
// slot.

type Command {
    client_node: int;
    req_id: int;
    kind: int;      // 0 = Read, 1 = Write
    key: string;
    uid: int?;      // Write's unique id; nil for reads
};

type Ballot {
    round: int;
    leader: int;
};

// Phase 1b (ACK) response content.
type AckInfo {
    prepared_ballot: Ballot;
    has_accepted: bool;
    accepted_ballot: Ballot;
    accepted_value: Command?; // when has_accepted: nil => no-op, else the cmd
};

type ClientResponse {
    success: bool;
    key: string?;
    value: list<int>;
    redirect: Node;
};

type PersistentState {
    prepared_ballot: map<int, Ballot>;
    has_prepared: map<int, bool>;
    accepted_ballot: map<int, Ballot>;
    has_accepted: map<int, bool>;
    accepted_value: map<int, Command?>;
    learned_flags: map<int, bool>;
    learned_value: map<int, Command?>;
    expected: int;
    my_index: int;
    proposed: map<int, Command>;
};

role Node {
    // ── Identity ─────────────────────────────────────────────
    var self: int = 0;
    var replicas: list<Node> = [];
    var n: int = 0;

    // ── Protocol P state ─────────────────────────────────────
    var proposed: map<int, Command> = {};  // values I suggested per slot
    var expected: int = 0;                  // next slot to commit
    var my_index: int = 0;                  // next slot I will coordinate

    // ── Per-slot Coordinated Paxos acceptor state ────────────
    // prepared_ballot[i] is the highest ballot promised for slot i.
    // If unset, the implicit promise is (0, owner(i)).
    var prepared_ballot: map<int, Ballot> = {};
    var has_prepared: map<int, bool> = {};
    var accepted_ballot: map<int, Ballot> = {};
    var has_accepted: map<int, bool> = {};
    var accepted_value: map<int, Command?> = {}; // nil => no-op

    // ── Per-slot committed value ─────────────────────────────
    var learned_flags: map<int, bool> = {};
    var learned_value: map<int, Command?> = {}; // nil => no-op

    // ── Revoke state (proposer side, per slot) ───────────────
    var revoke_ballot: map<int, Ballot> = {};
    var revoke_phase: map<int, int> = {};        // 1 = phase 1, 2 = phase 2, 0 = idle
    var revoke_ack_count: map<int, int> = {};
    var revoke_best_ballot: map<int, Ballot> = {};
    var revoke_best_has_val: map<int, bool> = {};
    var revoke_best_value: map<int, Command?> = {};
    var revoke_accept_count: map<int, int> = {};

    // ── State machine / client tracking ──────────────────────
    var kv_store: map<string, list<int>> = {};
    var pending_requests: map<int, chan<ClientResponse>> = {};
    var next_req_id: int = 0;
    var applied_cmds: map<string, bool> = {};

    // ─────────────────────────────────────────────────────────
    // Init / Recover
    // ─────────────────────────────────────────────────────────

    fn Init(me: int, peers: list<Node>) {
        self = me;
        replicas = peers;
        n = len(peers);
        my_index = self;          // first slot owned by self (owner(i) = i % n)
        next_req_id = self;       // unique across nodes via stride n
        persist();
        println("Node {self} initialized. n={n}");
        monitor_suspicions();
    }

    @trace
    async fn RecoverInit(me: int, peers: list<Node>) {
        self = me;
        replicas = peers;
        n = len(peers);

        var saved: PersistentState? = retrieve_data<PersistentState>();
        if saved != nil {
            var s = saved!;
            prepared_ballot = s.prepared_ballot;
            has_prepared = s.has_prepared;
            accepted_ballot = s.accepted_ballot;
            has_accepted = s.has_accepted;
            accepted_value = s.accepted_value;
            learned_flags = s.learned_flags;
            learned_value = s.learned_value;
            expected = s.expected;
            my_index = s.my_index;
            proposed = s.proposed;
        } else {
            my_index = self;
        }

        revoke_ballot = {};
        revoke_phase = {};
        revoke_ack_count = {};
        revoke_best_ballot = {};
        revoke_best_has_val = {};
        revoke_best_value = {};
        revoke_accept_count = {};
        pending_requests = {};
        applied_cmds = {};
        next_req_id = self + n * 1000; // avoid colliding with pre-crash req_ids

        // Rebuild kv_store by replaying committed slots in order.
        kv_store = {};
        for var i = 0; i < expected; i = i + 1 {
            if exists(learned_flags, i) and learned_flags[i] {
                var v = learned_value[i];
                if v != nil {
                    apply_to_kv(v!);
                }
            }
        }

        println("Node {self} recovered. expected={expected} my_index={my_index}");
        // First yield point — messages start flowing after this.
        monitor_suspicions();
    }

    // ─────────────────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────────────────

    fn owner_of(i: int): int {
        i % n
    }

    fn first_owned_from(start: int, q: int): int {
        var j = start;
        for ;; {
            if j % n == q { return j; }
            j = j + 1;
        }
        0
    }

    fn next_owned(after: int, q: int): int {
        first_owned_from(after + 1, q)
    }

    fn majority(): int {
        n / 2 + 1
    }

    fn ballot_gt(a: Ballot, b: Ballot): bool {
        a.round > b.round or (a.round == b.round and a.leader > b.leader)
    }

    fn ballot_gte(a: Ballot, b: Ballot): bool {
        a.round > b.round or (a.round == b.round and a.leader >= b.leader)
    }

    fn ballot_eq(a: Ballot, b: Ballot): bool {
        a.round == b.round and a.leader == b.leader
    }

    fn get_prepared(slot: int): Ballot {
        if exists(has_prepared, slot) and has_prepared[slot] {
            prepared_ballot[slot]
        } else {
            // Implicit promise: the owner holds ballot 0.
            Ballot{ round: 0, leader: owner_of(slot) }
        }
    }

    fn get_accepted_ballot(slot: int): Ballot {
        if exists(has_accepted, slot) and has_accepted[slot] {
            accepted_ballot[slot]
        } else {
            Ballot{ round: -1, leader: -1 }
        }
    }

    fn is_learned(slot: int): bool {
        exists(learned_flags, slot) and learned_flags[slot]
    }

    fn persist() {
        persist_data(PersistentState{
            prepared_ballot: prepared_ballot,
            has_prepared: has_prepared,
            accepted_ballot: accepted_ballot,
            has_accepted: has_accepted,
            accepted_value: accepted_value,
            learned_flags: learned_flags,
            learned_value: learned_value,
            expected: expected,
            my_index: my_index,
            proposed: proposed,
        });
    }

    fn cmd_key(cmd: Command): string {
        "{int_to_string(cmd.client_node)}-{int_to_string(cmd.req_id)}"
    }

    fn cmds_eq(a: Command, b: Command): bool {
        a.client_node == b.client_node and a.req_id == b.req_id
    }

    fn apply_to_kv(cmd: Command) {
        var k = cmd_key(cmd);
        if exists(applied_cmds, k) { return (); }
        applied_cmds = applied_cmds[k] := true;

        if cmd.kind == 1 {
            var prior: list<int> = [];
            if exists(kv_store, cmd.key) {
                prior = kv_store[cmd.key];
            }
            kv_store = kv_store[cmd.key] := append(prior, cmd.uid!);
        }
    }

    async fn resolve_ch(ch: chan<ClientResponse>, resp: ClientResponse) {
        resp >- ch;
    }

    // ─────────────────────────────────────────────────────────
    // Learning / CheckCommit (the log → state machine path)
    // ─────────────────────────────────────────────────────────

    // Set slot i's learned value, then walk forward from `expected`,
    // committing consecutive learned slots into the state machine.
    fn learn_slot(i: int, value: Command?) {
        if is_learned(i) { return (); }
        learned_flags = learned_flags[i] := true;
        learned_value = learned_value[i] := value;
        if value == nil {
            println("Node {self} LEARN slot {i} = no-op (expected={expected})");
        } else {
            var vv = value!;
            println("Node {self} LEARN slot {i} req=({vv.client_node},{vv.req_id}) uid={vv.uid ?? -1} kind={vv.kind} (expected={expected})");
        }
        on_learned(i, value);
        check_commit();
    }

    fn on_learned(i: int, value: Command?) {
        // Rule 4: if I suggested v for slot i but a different value was
        // chosen, re-suggest. (Under Coordinated Paxos, "different" implies
        // no-op for an owner's own slot.)
        if owner_of(i) == self and exists(proposed, i) {
            var my_val = proposed[i];
            var lost = false;
            if value == nil {
                lost = true;
            } else {
                var learned_cmd = value!;
                if !cmds_eq(learned_cmd, my_val) {
                    lost = true;
                }
            }
            if lost and !is_committed_cmd(my_val) {
                on_client_request(my_val);
            }
        }
    }

    fn is_committed_cmd(cmd: Command): bool {
        for var i = 0; i < expected; i = i + 1 {
            if exists(learned_flags, i) and learned_flags[i] {
                var v = learned_value[i];
                if v != nil and cmds_eq(v!, cmd) { return true; }
            }
        }
        false
    }

    fn check_commit() {
        for ; is_learned(expected); {
            var v = learned_value[expected];
            if v != nil {
                on_commit(v!);
            }
            expected = expected + 1;
        }
    }

    fn on_commit(cmd: Command) {
        var already = exists(applied_cmds, cmd_key(cmd));
        var result: list<int> = [];

        if !already {
            apply_to_kv(cmd);
        }

        if cmd.kind == 0 and exists(kv_store, cmd.key) {
            result = kv_store[cmd.key];
        }
        if cmd.kind == 0 {
            println("Node {self} COMMIT read key={cmd.key} result_len={len(result)} req=({cmd.client_node},{cmd.req_id})");
        }

        if cmd.client_node == self and exists(pending_requests, cmd.req_id) {
            var ch = pending_requests[cmd.req_id];
            pending_requests = erase(pending_requests, cmd.req_id);
            resolve_ch(ch, ClientResponse{
                success: true,
                key: cmd.key,
                value: result,
                redirect: replicas[self],
            });
        }
    }

    // ─────────────────────────────────────────────────────────
    // OnSuggestion (Rule 2)
    // ─────────────────────────────────────────────────────────

    // Triggered on a non-owner p when it receives PROPOSE(0, v) with v != no-op
    // for slot i (owner(i) = q, q != p). p Skips its own unused slots in
    // [my_index, i) — explicit Skip messages, no piggybacking, no batching.
    fn on_suggestion(i: int) {
        var k = my_index;
        for ; k < i; {
            if k % n == self and !is_learned(k) {
                // DownCall Skip(k): broadcast PROPOSE(0, no-op) for slot k.
                broadcast_propose(k, Ballot{ round: 0, leader: self }, nil);
                // Locally learn (matches the SKIP fast-path in HandlePropose).
                learn_slot(k, nil);
            }
            k = k + 1;
        }
        if i > my_index {
            my_index = next_owned(i, self);
        }
    }

    // ─────────────────────────────────────────────────────────
    // Client entry (Rule 1)
    // ─────────────────────────────────────────────────────────

    fn on_client_request(cmd: Command) {
        var i = my_index;
        proposed = proposed[i] := cmd;
        my_index = next_owned(i, self);
        persist();
        // DownCall Suggest(i, cmd): broadcast PROPOSE(0, cmd).
        broadcast_propose(i, Ballot{ round: 0, leader: self }, cmd);
    }

    async fn ClientWrite(key: string, uid: int): ClientResponse {
        println("ClientWrite: key={key} uid={int_to_string(uid)}");
        var req_id = next_req_id;
        next_req_id = next_req_id + n;
        var cmd = Command{ client_node: self, req_id: req_id, kind: 1, key: key, uid: uid };
        var ch: chan<ClientResponse> = make();
        pending_requests = pending_requests[req_id] := ch;
        on_client_request(cmd);
        <- ch
    }

    async fn ClientRead(key: string): ClientResponse {
        println("ClientRead: key={key}");
        var req_id = next_req_id;
        next_req_id = next_req_id + n;
        var cmd = Command{ client_node: self, req_id: req_id, kind: 0, key: key, uid: nil };
        var ch: chan<ClientResponse> = make();
        pending_requests = pending_requests[req_id] := ch;
        on_client_request(cmd);
        <- ch
    }

    // ─────────────────────────────────────────────────────────
    // Broadcast helpers
    // ─────────────────────────────────────────────────────────

    fn broadcast_propose(slot: int, ballot: Ballot, value: Command?) {
        for var i = 0; i < n; i = i + 1 {
            replicas[i]->HandlePropose(self, slot, ballot, value);
        }
    }

    fn broadcast_prepare(slot: int, ballot: Ballot) {
        for var i = 0; i < n; i = i + 1 {
            replicas[i]->HandlePrepare(self, slot, ballot);
        }
    }

    fn broadcast_learn(slot: int, value: Command?) {
        for var i = 0; i < n; i = i + 1 {
            replicas[i]->HandleLearn(slot, value);
        }
    }

    // ─────────────────────────────────────────────────────────
    // Coordinated Paxos message handlers (Appendix A)
    // ─────────────────────────────────────────────────────────

    // PROPOSE — SUGGEST (b=0, v≠no-op), SKIP (b=0, v=no-op), or revoker Phase 2a.
    @trace
    async fn HandlePropose(sender_id: int, slot: int, ballot: Ballot, value: Command?) {
        if is_learned(slot) {
            // OnMessage ANY OnCondition learned ≠ ⊥ → reply with LEARN.
            replicas[sender_id]->HandleLearn(slot, learned_value[slot]);
            return ();
        }

        // Fast path: SKIP at ballot 0 — the owner unilaterally chose no-op.
        if ballot.round == 0 and value == nil {
            learn_slot(slot, nil);
            persist();
            return ();
        }

        var prep = get_prepared(slot);
        var acc = get_accepted_ballot(slot);
        // prepared_ballot ≤ ballot AND accepted_ballot < ballot
        if ballot_gte(ballot, prep) and ballot_gt(ballot, acc) {
            if ballot.round == 0 and owner_of(slot) != self {
                // SUGGEST from the owner, received by a non-owner.
                on_suggestion(slot);
                if is_learned(slot) { return (); }
            }
            accepted_ballot = accepted_ballot[slot] := ballot;
            has_accepted = has_accepted[slot] := true;
            accepted_value = accepted_value[slot] := value;
            persist();
            replicas[sender_id]->HandleAccept(self, slot, ballot, value);
        } else {
            persist();
        }
    }

    // ACCEPT — Phase 2b ack to the proposer (coordinator or revoker).
    @trace
    async fn HandleAccept(sender_id: int, slot: int, ballot: Ballot, value: Command?) {
        if is_learned(slot) { return (); }

        // The proposer is the only one that should count toward quorum.
        // Pick the active ballot we are driving for this slot, if any.
        var active: Ballot = Ballot{ round: -1, leader: -1 };
        var have_active = false;

        if ballot.round == 0 and owner_of(slot) == self {
            active = Ballot{ round: 0, leader: self };
            have_active = true;
        } else if exists(revoke_ballot, slot) and exists(revoke_phase, slot) and revoke_phase[slot] == 2 {
            active = revoke_ballot[slot];
            have_active = true;
        }

        if !have_active or !ballot_eq(ballot, active) { return (); }

        var count = 1;
        if exists(revoke_accept_count, slot) {
            count = revoke_accept_count[slot] + 1;
        }
        revoke_accept_count = revoke_accept_count[slot] := count;

        if count >= majority() {
            learn_slot(slot, value);
            persist();
            broadcast_learn(slot, value);
        }
    }

    // LEARN — peer tells us a slot was chosen.
    @trace
    async fn HandleLearn(slot: int, value: Command?) {
        if is_learned(slot) { return (); }
        learn_slot(slot, value);
        persist();
    }

    // PREPARE — revoker Phase 1a.
    @trace
    async fn HandlePrepare(sender_id: int, slot: int, ballot: Ballot) {
        if is_learned(slot) {
            replicas[sender_id]->HandleLearn(slot, learned_value[slot]);
            return ();
        }

        var prep = get_prepared(slot);
        if ballot_gt(ballot, prep) {
            prepared_ballot = prepared_ballot[slot] := ballot;
            has_prepared = has_prepared[slot] := true;
            persist();

            var info = AckInfo{
                prepared_ballot: ballot,
                has_accepted: exists(has_accepted, slot) and has_accepted[slot],
                accepted_ballot: get_accepted_ballot(slot),
                accepted_value: if exists(has_accepted, slot) and has_accepted[slot] {
                    accepted_value[slot]
                } else {
                    nil
                },
            };
            replicas[sender_id]->HandleAck(self, slot, ballot, info);
        } else {
            persist();
        }
    }

    // ACK — revoker Phase 1b.
    @trace
    async fn HandleAck(sender_id: int, slot: int, ballot: Ballot, info: AckInfo) {
        if is_learned(slot) { return (); }
        if !exists(revoke_ballot, slot) { return (); }
        if !ballot_eq(revoke_ballot[slot], ballot) { return (); }
        if !exists(revoke_phase, slot) or revoke_phase[slot] != 1 { return (); }

        if info.has_accepted {
            if !exists(revoke_best_has_val, slot) or !revoke_best_has_val[slot]
                or ballot_gt(info.accepted_ballot, revoke_best_ballot[slot]) {
                revoke_best_has_val = revoke_best_has_val[slot] := true;
                revoke_best_ballot = revoke_best_ballot[slot] := info.accepted_ballot;
                revoke_best_value = revoke_best_value[slot] := info.accepted_value;
            }
        }

        var count = revoke_ack_count[slot] + 1;
        revoke_ack_count = revoke_ack_count[slot] := count;

        if count >= majority() {
            // Phase 2: propose hv (highest accepted), or no-op if none seen.
            revoke_phase = revoke_phase[slot] := 2;
            revoke_accept_count = revoke_accept_count[slot] := 0;

            var hv: Command? = nil;
            if exists(revoke_best_has_val, slot) and revoke_best_has_val[slot] {
                hv = revoke_best_value[slot];
            }
            println("Revoke slot {slot}: phase2 ballot=({ballot.round},{ballot.leader})");
            broadcast_propose(slot, ballot, hv);
        }
    }

    // ─────────────────────────────────────────────────────────
    // Revoke (Rule 3 — on suspicion of peer q)
    // ─────────────────────────────────────────────────────────

    fn start_revoke(slot: int) {
        if is_learned(slot) { return (); }

        var prior = get_prepared(slot);
        var new_round = prior.round + 1;
        var b = Ballot{ round: new_round, leader: self };

        revoke_ballot = revoke_ballot[slot] := b;
        revoke_phase = revoke_phase[slot] := 1;
        revoke_ack_count = revoke_ack_count[slot] := 0;
        revoke_best_has_val = revoke_best_has_val[slot] := false;
        revoke_best_ballot = revoke_best_ballot[slot] := Ballot{ round: -1, leader: -1 };
        revoke_best_value = revoke_best_value[slot] := nil;
        revoke_accept_count = revoke_accept_count[slot] := 0;

        println("Revoke start: slot={slot} ballot=({new_round},{self})");
        broadcast_prepare(slot, b);
    }

    // OnSuspect(q): Revoke every q-owned unlearned slot in [first q-slot, my_index).
    // We bound the per-tick revoke count so a single suspicion doesn't flood the
    // network; the simulator keeps firing the timer until liveness is restored.
    fn on_suspect(q: int) {
        var c = first_owned_from(0, q);
        var limit = 3;
        var revoked = 0;
        var i = c;
        for ; revoked < limit; {
            if i >= my_index { return (); }
            if i % n == q and !is_learned(i) and !exists(revoke_ballot, i) {
                start_revoke(i);
                revoked = revoked + 1;
            }
            i = i + 1;
        }
    }

    // ─────────────────────────────────────────────────────────
    // Suspicion monitor (drives OnSuspect)
    // ─────────────────────────────────────────────────────────

    async fn monitor_suspicions() {
        for ;; {
            <- set_timer("suspect");
            for var q = 0; q < n; q = q + 1 {
                if q != self {
                    on_suspect(q);
                }
            }
        }
    }
}

ClientInterface {
    async fn Write(dest: Node, key: string, uid: int) {
        var target = dest;
        for ;; {
            var resp = <- target->ClientWrite(key, uid);
            if resp.success { return (); }
            target = resp.redirect;
        }
    }

    async fn Read(dest: Node, key: string): list<int> {
        var target = dest;
        for ;; {
            var resp = <- target->ClientRead(key);
            if resp.success { return resp.value; }
            target = resp.redirect;
        }
        []
    }
}
