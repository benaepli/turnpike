type Cluster {
    @quorum nodes: list<Node>;
};

type ClusterParams {
    @scale n: int;
};

role Node(cluster: Cluster) {
    var kv_store: map<string, list<int>> = {};

    fn Init() {
        kv_store = {};
    }

    async fn Read(key: string): list<int> {
        if (exists(kv_store, key)) {
            return kv_store[key];
        }
        return [];
    }

    async fn Write(key: string, uid: int) {
        kv_store = kv_store[key] := [uid];
    }

    async fn RMW(key: string, uid: int): list<int> {
        var old: list<int> = [];
        if (exists(kv_store, key)) {
            old = kv_store[key];
        }
        kv_store = kv_store[key] := append(old, uid);
        return old;
    }
}

fn cluster(n: int): Cluster {
    var nodes: list<Node> = spawn<Node>(n);
    var c: Cluster = Cluster { nodes: nodes };
    provide_all(nodes, c);
    c
}

@deploy(client = KVClient)
fn Main(p: ClusterParams): Cluster? {
    if (p.n < 1) {
        return nil;
    }
    cluster(p.n)
}

client KVClient(sys: Cluster) {
    async fn Read(dest: Node, key: string): list<int> {
        var val = <- dest->Read(key);
        return val;
    }

    async fn Write(dest: Node, key: string, uid: int) {
        <- dest->Write(key, uid);
    }

    async fn RMW(dest: Node, key: string, uid: int): list<int> {
        var old = <- dest->RMW(key, uid);
        return old;
    }
}
